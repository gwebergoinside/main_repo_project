expression AgrupadorCanais =
		let
		    Origem = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [canCodigo = _t, Canal_Agrupador = _t, Canal = _t, Ordem = _t, ORDEM_AGRUPADOS = _t]),
