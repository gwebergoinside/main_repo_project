	column 'Periodo da Semana' =
			SWITCH(
			  TRUE,
			  ISBLANK('Calendario'[Dia Semana]),
			  "(Blank)",
			  'Calendario'[Dia Semana] IN {"Seg",
			    "Ter",
			    "Qua",
			    "Qui",
			    "Sex"},
			  "Dia de Semana",
			  'Calendario'[Dia Semana] IN {"Dom",
			    "Sab"},
			  "Fim de Semana",
			  'Calendario'[Dia Semana]
			)
		lineageTag: 92579d6d-ade8-49ab-9c36-7b20ddb6badd
		summarizeBy: none

