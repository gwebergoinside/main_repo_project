		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dia Semana LY' =
			
			VAR _day = WEEKDAY(DATE(YEAR(Calendario[Date])-1,MONTH(Calendario[Date]),DAY(Calendario[Date])))
			RETURN
			SWITCH(_day, 1,"Dom",2,"Seg",3,"Ter",4,"Qua",5,"Qui",6,"Sex",7,"Sab")
		lineageTag: 71ae4274-68a0-41d4-adc6-1e14b1f04efc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Weeks = ```
			
			VAR Week_start = FORMAT( Calendario[Date] - WEEKDAY('Calendario'[Date],2) +1, "dd/MM/yyyy" )
			VAR Week_end = FORMAT(Calendario[Date] - WEEKDAY(Calendario[Date],2) + 7, "dd/MM/yyyy" )
			RETURN
			Week_start &" 
			 "& Week_end
			```
		lineageTag: 0c37e169-6e55-4132-bb6b-847baa9f4b7c
		summarizeBy: none
		sortByColumn: 'Week Start'

		annotation SummarizationSetBy = Automatic

	column 'Week Start' = Calendario[Date] - WEEKDAY('Calendario'[Date],2) +1
		formatString: General Date
		lineageTag: fd9ccb36-bcc9-45ea-8741-b0f941874740
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ano_Classificação =
			
			var _2 = YEAR(now()) //Atual
			Var _3 = YEAR(now())  -1 //Anterior
			
			Return
			
			        IF( 'Calendario'[Ano]> YEAR(NOW()), "Futuro", IF( 'Calendario'[Ano] = _2, "Corrente", IF( 'Calendario'[Ano] = _3, "Anterior", "Passado" ) ) )
		lineageTag: f406c2e5-f54f-456e-9687-00c0e833261a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

