	partition Encomendas-04e831a7-4853-434e-bed0-a8eeb98624ab = m
		mode: import
		queryGroup: Encomendas
		source =
				let
				    Source = Sql.Database(Server, BD, [Query="select#(lf)      'PEDIDOS' as [Origem],#(lf)sum(Round(isnull(pedidoreceitas.pub,0)*(IsNull(pedidos.IPC,0)/100),2)) as [IPC Valor],#(lf)sum(isnull(pedidoreceitas.bonus,0)) as [Valor Bónus],#(lf)sum(Round(isnull(pedidoreceitas.pub,0)*(isnull(campanhas.camdescontoAgencia,0)/100),2)) as [Valor Comissao],#(lf)sum(Round((isnull(pedidoreceitas.pub,0) - Round(isnull(pedidoreceitas.pub,0)*(isnull(campanhas.camdescontoAgencia,0)/100),2))*(isnull(rappel.rapTaxaNegociada,0)),2)) as [Valor Rappel],#(lf)      pedidoreceitas.pedidoid as pedidoid,#(lf)      entidadefacturar.entid as [ID Entidade a Facturar],#(lf)      entidadefacturar.entnome as [Nome Entidade a Facturar],#(lf)      centralcompras.entid as [ID Central],#(lf)      centralcompras.entnome as[Nome Central],#(lf)      agenciameios.entid as [ID Agência de Meios],#(lf)      agenciameios.entnome as [Nome Agência de Meios],#(lf)      agenciacriativa.entid as [ID Agência],#(lf)      agenciacriativa.entnome as [Nome Agência],#(lf)      anunciante.entid as [ID Anunciante],#(lf)      anunciante.entnome as [Nome Anunciante],#(lf)      tiposClientes.tipCliId as [ID Agrupador Anunciante],#(lf)      tiposClientes.tipCliDescricao as [Agrupador Anunciante],#(lf)      grupos.gruId as [Grupo],#(lf)      grupos.gruDescricao as [Nome Grupo],#(lf)      executivo.utinome as [Vendedor],#(lf)      canais.candescricao as [Canal],#(lf)#(tab)  canais.cancodigo,#(lf)      canais.canFolder as [Marca],#(lf)      pedidos.ordpubano as [Ano],#(lf)      pedidos.ordpubmes as [Mês],#(lf)#(tab)  pedidos.distribuidorId,#(lf)      SUM(IsNull(pedidos.ordpubvalor,0)) as  [Ordem - Valor Publicidade],#(lf)      tipopublicidade.tippubdescricao as [Tipo de Publicidade],#(lf)      tipopublicidade.TipPubId as [ID Tipo de Publicidade],#(lf)      IsNull(pedidos.IPC,0) as [IPC],#(lf)      IsNull(ordempub.ordpubflagvalorbrutovendas,0) as [Bruto Vendas],#(lf)      IsNull(ordempub.ordpubflagvalorliquidovendas,0) as [Liquido Vendas],#(lf)      pedidos.datafact as [Data Pedido],#(lf)      --NULL as [Data Exibição],#(lf)      SUM(isnull(pedidoreceitas.pub,0)) as [Valor Publicidade],#(lf)      SUM(isnull(pedidoreceitas.pub,0) - Round(isnull(pedidoreceitas.pub,0)*(isnull(campanhas.camdescontoAgencia,0)/100),2)) as [Valor Net 1],#(lf)      SUM(isnull(pedidoreceitas.pub,0) - Round(isnull(pedidoreceitas.pub,0)*(isnull(campanhas.camdescontoAgencia,0)/100),2) - Round((isnull(pedidoreceitas.pub,0) - Round(isnull(pedidoreceitas.pub,0)*(isnull(campanhas.camdescontoAgencia,0)/100),2))*(isnull(rappel.rapTaxaNegociada,0)),2)) as [Valor Net 2]#(lf)from#(lf)pedidoreceitas with(nolock)#(lf)join pedidos with(nolock) on pedidos.pedidoid=pedidoreceitas.pedidoid#(lf)join ordempub with(nolock) on ordempub.ordpubcodigo=pedidos.ordpubcodigo#(lf)join campanhas with(nolock) on campanhas.camid=pedidos.camid#(lf)join entidades entidadefacturar with(nolock) on entidadefacturar.entid=pedidos.entFactId#(lf)join entidades centralcompras with(nolock) on centralcompras.entid=pedidos.centralId#(lf)join entidades agenciameios with(nolock) on agenciameios.entid=pedidos.distribuidorId#(lf)join entidades agenciacriativa with(nolock) on agenciacriativa.entId=campanhas.camagencia#(lf)join entidades anunciante with(nolock) on anunciante.entid=pedidos.anuncianteId#(lf)join grupos grupos with(nolock) on grupos.gruid=pedidos.gruid#(lf)join utilizadores executivo with(nolock) on executivo.utiid=pedidos.vendedorId#(lf)join canais with(nolock) on canais.cancodigo=pedidos.cancodigo#(lf)join tipopublicidade with(nolock) on tipopublicidade.tippubid=pedidos.tippubid#(lf)left outer join rappel with(nolock) on pedidos.flgrappel=1 and pedidos.dataFact between rappel.rapDataInicio and rappel.rapDataFim and (rappel.entIdCliente=campanhas.camEntidadeFacturar or (rappel.entIdCliente=campanhas.camCentralCompras and rappel.flgCentral=1))#(lf)left outer join tiposClientes with(nolock) on tiposClientes.tipCliId=anunciante.tipCliId#(lf)where#(lf)      --pedidoreceitas.pedrecid not in (select isnull(pedrecid,0) from pedidoencomendas where pedidoencomendas.pedrecid=pedidoreceitas.pedrecid) and#(lf)year(pedidos.datafact) >= year(getdate())-5#(lf)--and month(pedidos.datafact) = 1#(lf)--and pedidoreceitas.pedidoid in (78146, 78147)#(lf)Group by#(lf)entidadefacturar.entid,#(lf)      entidadefacturar.entnome,#(lf)      centralcompras.entid,#(lf)      centralcompras.entnome,#(lf)      agenciameios.entid,#(lf)      agenciameios.entnome,#(lf)      agenciacriativa.entid,#(lf)      agenciacriativa.entnome,#(lf)      anunciante.entid,#(lf)      anunciante.entnome,#(lf)      tiposClientes.tipCliId,#(lf)      tiposClientes.tipCliDescricao,#(lf)      grupos.gruId,#(lf)      grupos.gruDescricao,#(lf)      executivo.utinome,#(lf)      canais.candescricao,#(lf)#(tab)  canais.cancodigo,#(lf)      canais.canFolder,#(lf)      pedidos.ordpubano,#(lf)      pedidos.ordpubmes,#(lf)#(tab)  pedidos.distribuidorId,#(lf)      tipopublicidade.tippubdescricao,#(lf)      tipopublicidade.TipPubId,#(lf)      IsNull(pedidos.IPC,0),#(lf)      pedidos.datafact,#(lf)ordempub.ordpubflagvalorbrutovendas,#(lf)ordempub.ordpubflagvalorliquidovendas,#(lf)pedidoreceitas.pedidoid"])
				in
				    Source

	annotation PBI_ResultType = Table

