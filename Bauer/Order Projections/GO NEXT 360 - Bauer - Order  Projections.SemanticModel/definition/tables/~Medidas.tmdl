	measure 'Receita CentroCusto' =
			SWITCH(TRUE(),
			    SELECTEDVALUE('Centro Custo'[numero]) = "3.0", CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[Grupo] =3)
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.2.2", CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =2)
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.2.1", CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =1)
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.2",  CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =1) + CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =2)
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.0", CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =1) + CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =2) + CALCULATE(SUM(Encomendas[IPC Valor])) +  ((CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =1)*0.03)*-1) +  CALCULATE(SUM(Encomendas[Valor Rappel]))*-1
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "2.0", CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[Grupo] =5)+0
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "5.0", CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] = 13)
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.4", (CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =1)*0.03)*-1
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "6.0", CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {12,10})
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.3",CALCULATE(SUM(Encomendas[IPC Valor]))
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.5",CALCULATE(SUM(Encomendas[Valor Rappel]))*-1
			    )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 23318edf-d253-408f-805f-5d8a1229d2fc

		changedProperty = FormatString

	measure 'External Cash Net 2' = CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =1) + CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =2) + CALCULATE(SUM(Encomendas[IPC Valor])) +  ((CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =1)*0.03)*-1) +  CALCULATE(SUM(Encomendas[Valor Rappel]))*-1
