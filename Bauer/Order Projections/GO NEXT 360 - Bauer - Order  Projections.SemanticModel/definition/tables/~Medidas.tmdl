	measure 'Budget CentroCusto' = ```
			SWITCH(TRUE(),
			    SELECTEDVALUE('Centro Custo'[numero]) = "3.0", CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "3.0")
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.2", CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] IN  {"1.2.1","1.2.2"} )
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.2.2", CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "1.2.2")
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.2.1", CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "1.2.1")
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.0", CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] IN  {"1.2.1","1.2.2","1.3","1.4","1.5"})
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "2.0", CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "2.0")
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "5.0", CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "5.0")
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.4", CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "1.4") 
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "6.0", CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "6.0")
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.3",CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "1.3")
			    ,SELECTEDVALUE('Centro Custo'[numero]) = "1.5",CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "1.5")
			    )
			```
		lineageTag: 4e1969e2-1761-4c60-bc0c-c917cb71eee1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Budget = CALCULATE( SUM(Objetivos[valor]), Objetivos[centroCusto] in {"1.2.1", "1.2.2", "1.5", "1.4"} )
