	measure 'Budget CC' = ```
			
			VAR _3 =  CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "3.0")
			VAR _1 =  CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "1.0")  + CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "1.2.1") +  CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "1.2.2") +  CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "1.3") +  CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "1.4") + CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "1.5")
			VAR _2 = CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "2.0")
			VAR _5 = CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "5.0")
			VAR _6 = CALCULATE(SUM(Objetivos[Valor]), Objetivos[centroCusto] = "6.0")
			VAR _total = _1+_2+_3+_5+_6
			
			RETURN
			IF( 
			   ISINSCOPE( 'Centro Custo'[Centro Custo] ) ,
			      SUMX( VALUES( 'Centro Custo'[Centro Custo]),CALCULATE([Budget CentroCusto]     )     ) ,
			    IF (ISINSCOPE( 'Centro Custo'[Agrupador] ) && SELECTEDVALUE( 'Centro Custo'[Agrupador] ) = "Other Revenues"
			      , SUMX( VALUES( 'Centro Custo'[Centro Custo]),CALCULATE([Budget CentroCusto]     )     ) 
			      ,
			        IF (ISINSCOPE( 'Centro Custo'[Agrupador] ) && SELECTEDVALUE( 'Centro Custo'[Agrupador] ) = "Advertising"
			        , _1 + _2 + _3, _total
			 )))
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 1d6141e5-d3ab-408d-8d3d-cfe6b85af57d

		changedProperty = FormatString

	measure 'External Cash Net 2 Budget' =
			
