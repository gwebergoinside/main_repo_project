	measure 'Title Var' = "Evolução comparativa com Dia Anterior | " & FORMAT( DATE(YEAR(NOW()),MONTH(NOW()) , 1) , "MMMM", "pt-PT")
		displayFolder: Outros
		lineageTag: 5badf5ca-3668-418b-87ab-c73bf11a83f9

	measure 'Receita CC' = ```
			
			VAR _3 = CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[Grupo] =3)
			VAR _1 =
			 CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =1) + CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =2) + CALCULATE(SUM(Encomendas[IPC Valor])) +  ((CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {9,3,1,11,2,7,6,8,15,16,17}, Encomendas[Grupo] =1)*0.03)*-1) +  CALCULATE(SUM(Encomendas[Valor Rappel]))*-1
			VAR _2 = CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[Grupo] =5)
			VAR _5 = CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] = 13)
			VAR _6 = CALCULATE(SUM(Encomendas[Valor Net 1]), Encomendas[ID Tipo de Publicidade] in {12,10})
			VAR _total = _1+_2+_3+_5+_6
			
			RETURN
			IF( 
			   ISINSCOPE( 'Centro Custo'[Centro Custo] ) ,
			      SUMX( VALUES( 'Centro Custo'[Centro Custo]),CALCULATE([Receita CentroCusto]     )     ) ,
			    IF (ISINSCOPE( 'Centro Custo'[Agrupador] ) && SELECTEDVALUE( 'Centro Custo'[Agrupador] ) = "Other Revenues"
			      , SUMX( VALUES( 'Centro Custo'[Centro Custo]),CALCULATE([Receita CentroCusto]     )     ) 
			      ,
			        IF (ISINSCOPE( 'Centro Custo'[Agrupador] ) && SELECTEDVALUE( 'Centro Custo'[Agrupador] ) = "Advertising"
			        , _1 + _2 + _3, _total
			 )))
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 6310e77a-cdc6-4cf2-9859-42624a798d8e

		changedProperty = FormatString

	measure 'Titulo_Ganhos Perdidos' = ```
			
			vAR _1 = concatenatex(SUMMARIZE('Calendario','Calendario'[Mes]), 'Calendario'[Mes],", " )
			vAR _12 = MIN('Calendario'[Mês])
			VAR _11 = MONTH(now())
			--VAR _2 =  IF.EAGER(ISFILTERED('Calendario Carteira'[Mes]),  MONTH(CALEND), BLANK())
			--Var _3 = Titulos[ID]
			// IF.EAGER(
			//     ISFILTERED('Calendario Carteira'[Mes]) && Titulos[Selected TituloParameter] = 10, [Titulo] & " " & ,
			//     )
			RETURN 
			 --_1
			IF.EAGER( ISFILTERED('Calendario'[Mes])
			    ,"Ganhos e Perdidos (" & _1 & ")"
			    ,CALCULATE( [Titulo], Titulos[ID] = 10 ) & " (" & SWITCH(
			    _12
			    ,1,"Jan",2,"Fev",3,"Mar",4,"Abr"
			    ,5,"Mai",6,"Jun",7,"Jul",8,"Ago"
			    ,9,"Set",10,"Out",11,"Nov",12,"Dez") & " - " & SWITCH(
			    _11
			    ,1,"Jan",2,"Fev",3,"Mar",4,"Abr"
			    ,5,"Mai",6,"Jun",7,"Jul",8,"Ago"
			    ,9,"Set",10,"Out",11,"Nov",12,"Dez") & ")"
			) 
			```
		displayFolder: Ganhos e Perdidos
		lineageTag: 215a8f71-1ab6-4763-a55b-4a5495f32b34

