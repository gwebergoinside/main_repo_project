table Metricas
	lineageTag: ad25ceda-2a6a-4d37-892f-feb989cf62e0

	measure sum_duracao = ```
			
			    VAR FPS = 24
			    RETURN DIVIDE( SUM( fat_vGrelha_Lms[duracao Frames] ), FPS * 60 * 60 )
			```
		lineageTag: 479dac4d-1108-4478-b4cd-f4ec864bf162

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure sum_duracao_ytd_DIRECT =
			// CALCULATE( [sum_duracao_ytd], dim_emissao_tipo[cod_emi_tip] = 1 ) // Direto
			    VAR calculo = CALCULATE( [sum_duracao], dim_emissao_tipo[cod_emi_tip] = 1 ) // Direto
			    VAR Horas = INT(calculo)
			    VAR Minutos = INT((calculo - Horas) * 60)
			    VAR Segundos = (calculo - Horas - DIVIDE(Minutos, 60)) * 3600
			    RETURN FORMAT(Horas, "00") & ":" & FORMAT(Minutos, "00") & ":" & FORMAT(Segundos, "00")
		lineageTag: 96ff1007-6b3a-443f-8297-064952469da4

	measure sum_duracao_ytd = TOTALYTD( [sum_duracao], fat_vGrelha_Lms[Data])
		formatString: General Date
		lineageTag: 2944c2e5-a1a0-4ecd-a6d0-6fbfee99ce8d

	measure sum_duracao_ytd_RECORD = ```
			
			    VAR calculo = CALCULATE( [sum_duracao], dim_emissao_tipo[cod_emi_tip] = 2 ) // Gravado
			    VAR Horas = INT(calculo)
			    VAR Minutos = INT(MOD(calculo, 3600) / 60)
			    VAR Segundos = MOD(calculo, 60)
			    RETURN FORMAT(Horas, "00") & ":" & FORMAT(Minutos, "00") & ":" & FORMAT(Segundos, "00")
			```
		lineageTag: f23e8783-ae91-4365-afe5-d70638149e90

	measure sum_duracao_ytd_DIRECT_RECORD =
			// CALCULATE( [sum_duracao_ytd], dim_emissao_tipo[cod_emi_tip] IN {1, 2}) // Direto + Gravado
			    VAR calculo = CALCULATE( [sum_duracao], dim_emissao_tipo[cod_emi_tip] IN {1, 2}) // Direto + Gravado
			    VAR Horas = INT(calculo)
			    VAR Minutos = INT((calculo - Horas) * 60)
			    VAR Segundos = (calculo - Horas - DIVIDE(Minutos, 60)) * 3600
			    RETURN FORMAT(Horas, "00") & ":" & FORMAT(Minutos, "00") & ":" & FORMAT(Segundos, "00")
		lineageTag: 46689b55-3a65-49d1-9e23-42fa7a5864bf

