table dim_Tipo_Item
	lineageTag: 6883a4bb-e50c-4af8-a22d-0c19d95dfb1d

	column tipo_evento
		dataType: string
		lineageTag: 090ae06c-0ed0-48b0-b59d-36caedb47180
		summarizeBy: none
		sourceColumn: tipo_evento

		annotation SummarizationSetBy = Automatic

	column descricao
		dataType: string
		lineageTag: 6077eb45-841c-47a6-9ea5-dcff972ea789
		summarizeBy: none
		sourceColumn: descricao

		annotation SummarizationSetBy = Automatic

	column flag_item
		dataType: string
		lineageTag: d5f5bc09-f4ee-4c2b-85a6-f97a32d9aff5
		summarizeBy: none
		sourceColumn: flag_item

