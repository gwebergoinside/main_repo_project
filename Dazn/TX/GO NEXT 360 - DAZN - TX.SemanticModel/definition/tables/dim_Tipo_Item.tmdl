	column Abreviatura
		dataType: string
		lineageTag: 216d4c30-a523-4d47-b6fb-937dbdb209dd
		summarizeBy: none
		sourceColumn: Abreviatura

		annotation SummarizationSetBy = Automatic

	column segmetacao = ```
			
			    SWITCH( TRUE(),
			        dim_Tipo_Item[tipo_evento] IN {"H","U"}, "FILLER",
			        LEFT(dim_Tipo_Item[descricao], 3) = "SEP", "SEPARATORS",
			        dim_Tipo_Item[tipo_evento] IN {"PRE", "F11", "HALF", "F", "X", "POST", "F10", "F09", "CFE", "CAE", "F01"}, "ADVERTISING",
			        dim_Tipo_Item[tipo_evento] = "2", "PROMOTION",
			        "OTHERS")
			```
		lineageTag: 37903b03-dd1f-424c-8637-ca741c4ad6b7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_Tipo_Item = m
		mode: import
		source =
				let
				    Texto = "SELECT tipo_item tipo_evento, descricao, flag_item, Abreviatura FROM Tipo_Item",
				    Fonte = Sql.Database(Servidor, Databasee, [Query = Texto])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

