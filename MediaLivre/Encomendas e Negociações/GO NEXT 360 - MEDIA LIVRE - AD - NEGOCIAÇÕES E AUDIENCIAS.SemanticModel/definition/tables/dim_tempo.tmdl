	partition dim_tempo = m
		mode: import
		source =
				let
				    SQL = "SELECT *, CAST(cd_tempo AS STRING) AS ds_tempo
				        FROM medialivre.pbi_out.dim_tempo
				        WHERE 1 = 1
				            AND nr_year >= YEAR(GETDATE()) - " & AnoUpdate & "
				            AND nr_year <= YEAR(GETDATE()) + 5",
				    Source = fx_dbricks(SQL)
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

