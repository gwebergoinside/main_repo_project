table pbi_dim_campaigns
	lineageTag: 'tbl-dim-campaigns'

	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 3
		incrementalGranularity: month
		incrementalPeriods: 1
		sourceExpression =
			let
			    SQL = "SELECT * EXCEPT( dt_modified_on ) FROM medialivre.pbi_out.pbi_dim_campaigns
			        WHERE dt_modified_on between '"& Text.From( DateTime.ToText(RangeStart,"yyyy-MM-dd") ) &"'
			            and '"& Text.From( DateTime.ToText(RangeEnd,"yyyy-MM-dd") ) &"'",
			    pbi_dim_campaigns = fx_dbricks(SQL),
			    #"JSON Channel" = Table.TransformColumns(pbi_dim_campaigns, {"cd_list_channel", each Json.Document(_){0}, type text}),
			    #"Ajuste CONTINENTE" = Table.ReplaceValue(#"JSON Channel", each [cd_ad_type], each if Text.Contains([cd_ad_type], "boost", Comparer.OrdinalIgnoreCase) and [cd_account_client] = "36" then "NORMAL" else [cd_ad_type], Replacer.ReplaceText, {"cd_ad_type"})
			in
			    #"Ajuste CONTINENTE"

	column cd_campaign
		dataType: string
		isKey
		isNullable: false
		lineageTag: 'col-cam-key'
		summarizeBy: none
		sourceColumn: cd_campaign

		changedProperty = IsHidden

	column nm_campaign
