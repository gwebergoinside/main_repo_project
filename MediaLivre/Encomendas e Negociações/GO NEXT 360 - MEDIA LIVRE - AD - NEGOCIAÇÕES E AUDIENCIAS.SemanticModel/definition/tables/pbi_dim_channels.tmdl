table pbi_dim_channels
	lineageTag: 'tbl-dim-channels'

	column cd_channel
		dataType: string
		isKey
		isNullable: false
		lineageTag: 'col-cha-key'
		summarizeBy: none
		sourceColumn: cd_channel

		changedProperty = IsHidden

	column nm_channel
		dataType: string
		lineageTag: 'col-cha-name'
		summarizeBy: none
		sourceColumn: nm_channel

		changedProperty = IsHidden

	column ds_channel
		dataType: string
		lineageTag: 'col-cha-desc'
		summarizeBy: none
		sourceColumn: ds_channel

		changedProperty = IsHidden

	column nr_standard_duration_sec
		dataType: int64
		lineageTag: 'col-cha-dur'
		summarizeBy: sum
		sourceColumn: nr_standard_duration_sec

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition pbi_dim_channels-partition = m
		mode: import
		source =
				let
				    SQL = "SELECT * EXCEPT( dt_modified_on )
						FROM medialivre.pbi_out.pbi_dim_channels
				        WHERE dt_modified_on BETWEEN '"& Text.From( DateTime.ToText(RangeStart,"yyyy-MM-dd") ) &"'
				            AND '"& Text.From( DateTime.ToText(RangeEnd,"yyyy-MM-dd") ) &"'",
				    Source = fx_dbricks(SQL)
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

	annotation PBI_IsMQueryFoldable = True

