table pbi_dim_programs
	lineageTag: 'tbl-dim-programs'

	column cd_program
		dataType: string
		isKey
		isNullable: false
		lineageTag: 'col-pro-key'
		summarizeBy: none
		sourceColumn: cd_program

		changedProperty = IsHidden

	column nm_program
		dataType: string
		lineageTag: 'col-pro-name'
		summarizeBy: none
		sourceColumn: nm_program

		changedProperty = IsHidden

	partition pbi_dim_programs-partition = m
		mode: import
		source =
				let
				    SQL = "SELECT * EXCEPT( dt_modified_on )
						FROM medialivre.pbi_out.pbi_dim_programs
				        WHERE dt_modified_on BETWEEN '"& Text.From( DateTime.ToText(RangeStart,"yyyy-MM-dd") ) &"'
				            AND '"& Text.From( DateTime.ToText(RangeEnd,"yyyy-MM-dd") ) &"'",
				    Source = fx_dbricks(SQL)
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

	annotation PBI_IsMQueryFoldable = True

