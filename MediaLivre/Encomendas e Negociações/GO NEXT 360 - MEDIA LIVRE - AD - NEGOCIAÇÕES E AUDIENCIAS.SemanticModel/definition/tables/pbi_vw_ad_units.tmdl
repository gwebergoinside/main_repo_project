	partition pbi_vw_ad_units = m
		mode: import
		source = ```
				let
				    SQL = "SELECT * 
				            FROM medialivre.pbi_out.pbi_vw_ad_units
				            WHERE YEAR(dt_air) >= YEAR(GETDATE()) - " & AnoUpdate & "
				            AND dt_air BETWEEN '"& Text.From( DateTime.ToText(RangeStart,"yyyy-MM-dd") ) &"'
				            AND '"& Text.From( DateTime.ToText(RangeEnd,"yyyy-MM-dd") ) &"'",
				    Source = fx_dbricks(SQL)
				in
				    Source
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Exception

	annotation PBI_IsMQueryFoldable = True

