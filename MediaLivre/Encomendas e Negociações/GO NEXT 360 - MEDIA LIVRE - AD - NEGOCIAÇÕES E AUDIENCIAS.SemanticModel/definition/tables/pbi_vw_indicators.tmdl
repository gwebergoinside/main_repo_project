	partition pbi_vw_indicators = m
		mode: import
		source = ```
				let
				    SQL = "SELECT A.st_part
				            , A.cd_ad_insertion
				            , A.cd_target
				            , A.TRP
				            , A.GRP_EQ_XT
				            , A.GRP_EQ30_XT
				            , A.GRP_EQ
				            , A.CPR_XT
				            , A.GRP_EQ30
				        FROM medialivre.pbi_out.pbi_vw_indicators AS A
				        JOIN medialivre.pbi_out.pbi_vw_ad_insertion AS B
				            ON A.cd_ad_insertion = B.cd_ad_insertion
				            AND YEAR(B.dt_air) >= YEAR(GETDATE()) - 2
				            AND B.dt_air BETWEEN '" 
				        & Date.ToText(DateTime.Date(RangeStart), "yyyy-MM-dd") 
				        & "' AND '" 
				        & Date.ToText(DateTime.Date(RangeEnd), "yyyy-MM-dd") 
				        & "'
				        ",
				    Source = fx_dbricks(SQL)
				in
				    Source
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

