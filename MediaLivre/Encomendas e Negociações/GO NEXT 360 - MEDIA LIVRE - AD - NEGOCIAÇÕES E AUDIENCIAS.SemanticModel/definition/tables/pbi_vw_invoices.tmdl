		annotation UnderlyingDateTimeDataType = Date

	partition pbi_vw_invoices = m
		mode: import
		source = ```
				let
				    SQL = "SELECT * FROM medialivre.pbi_out.pbi_vw_invoices
				            WHERE YEAR(dt_init) >= YEAR(GETDATE()) - " & AnoUpdate &" 
				                AND dt_init BETWEEN '"& Text.From( DateTime.ToText(RangeStart,"yyyy-MM-dd") ) &"'
				                AND '"& Text.From( DateTime.ToText(RangeEnd,"yyyy-MM-dd") ) &"'",
				    Source = fx_dbricks(SQL)
				in
				    Source
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

	annotation PBI_IsMQueryFoldable = True

