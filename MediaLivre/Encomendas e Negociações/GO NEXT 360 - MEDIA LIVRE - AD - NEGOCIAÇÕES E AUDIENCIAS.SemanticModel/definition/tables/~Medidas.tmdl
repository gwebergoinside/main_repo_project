			            // SUM ( pbi_vw_invoices[vl_invoice_gross] ),
			            VALUES ( pbi_vw_targets[ds_variant] ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets[ds_variant_adults]
			            )
			        ),
			        CALCULATE (
			            SUMX( FILTER( pbi_vw_invoices, pbi_vw_invoices[nr_quantity] = 1 ), pbi_vw_invoices[vl_invoice_gross] ),
			            // SUM ( pbi_vw_invoices[vl_invoice_gross] ),
			            VALUES ( pbi_vw_targets[ds_variant] ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets_simulado[ds_variant]
			            )
			        )
			    )
			// VAR _CALC = 
			//     CALCULATE (
			//         SUMX( FILTER( pbi_vw_invoices, pbi_vw_invoices[nr_quantity] = 1 ), pbi_vw_invoices[vl_invoice_gross] ),
			//         REMOVEFILTERS( pbi_vw_targets ) )
			RETURN
			    IF ( ABS ( _CALC ) > 0, _CALC, BLANK () )
