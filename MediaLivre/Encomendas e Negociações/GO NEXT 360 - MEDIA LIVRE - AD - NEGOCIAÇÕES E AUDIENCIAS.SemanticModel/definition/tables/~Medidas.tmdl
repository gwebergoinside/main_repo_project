table ~Medidas
	lineageTag: 990b436c-ad8f-404f-b743-871182f2fd81

	/// Definição: Duração média por inserção ativa (segundos).
	/// Fórmula: total_seconds / nr_insertions_active.
	/// Observações: depende do critério de “ativa” (status incluídos em nr_insertions_active); DIVIDE trata divisão por zero.
	measure avg_duration =
			
			DIVIDE ( [total_seconds], [nr_insertions_active] )
		formatString: #,##0.0
		displayFolder: '02 Duration'
		lineageTag: 'meas-avg-duration'

		changedProperty = IsHidden

	/// Definição: Posição média no break (ordem média da inserção).
	/// Fórmula: AVERAGE(nr_position) onde nr_position > 0.
	/// Observações: ignora zeros/negativos (nr_position <= 0); sensível ao contexto de filtros (programa, dia, campanha, etc.).
	measure avg_position =
			
			AVERAGEX (
			    FILTER ( pbi_vw_ad_insertion, pbi_vw_ad_insertion[nr_position] > 0 ),
			    pbi_vw_ad_insertion[nr_position]
			)
		formatString: #,##0.0
		displayFolder: '06 Breaks'
		lineageTag: 'meas-avg-position'

		changedProperty = IsHidden

	/// Definição: Crescimento MoM (%) das inserções ativas.
	/// Fórmula: (nr_insertions_active - nr_insertions_prev_month) / nr_insertions_prev_month.
	/// Observações: se nr_insertions_prev_month = 0, DIVIDE retorna BLANK/0 conforme padrão; comparar meses depende de dim_tempo[data] contínua e relacionada.
	measure mom_insertions_growth_pct =
			
			DIVIDE (
			    [nr_insertions_active] - [nr_insertions_prev_month],
			    [nr_insertions_prev_month]
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: '05 Time Intelligence'
		lineageTag: 'meas-mom-insertions-growth'

		changedProperty = IsHidden

	/// Definição: Crescimento MoM (%) do total líquido.
	/// Fórmula: (total_net - total_net_prev_month) / total_net_prev_month.
	/// Observações: se total_net_prev_month = 0, DIVIDE retorna BLANK/0 conforme padrão; depende de dim_tempo[data] relacionada.
	measure mom_billing_growth_pct =
			
			DIVIDE ( [total_billing] - [total_billing_prev_month], [total_billing_prev_month] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: '05 Time Intelligence'
		lineageTag: 'meas-mom-net-growth'

		changedProperty = IsHidden

	/// Definição: CPT médio (Custo por TRP).
	/// Fórmula: SUM(audience[vl_net]) / SUM(audience[vl_trp]).
	/// Observações: se SUM(vl_trp)=0, DIVIDE retorna BLANK/0; consistente para comparação entre períodos quando TRP é calculado na mesma base.
	measure CPS =
			
			VAR _fl_adults =
			    SELECTEDVALUE ( pmt_adults_GRP[fl_adults_eq] )
			VAR _CALC =
			    IF (
			        _fl_adults,
			        CALCULATE (
			            DIVIDE ( [total_billing], [total_seconds] ),
			            REMOVEFILTERS ( pbi_vw_targets_simulado ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets[ds_variant_adults]
			            )
			        ),
			        CALCULATE (
			            DIVIDE ( [total_billing], [total_seconds] ),
			            REMOVEFILTERS ( pbi_vw_targets_simulado ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets[ds_variant]
			            )
			        )
			    )
			RETURN
			    IF ( ABS ( [total_billing] ) > 0, _CALC, BLANK () )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: '08 Audience'
		lineageTag: 'meas-aud-cpt'

		changedProperty = IsHidden

	/// Definição: Máximo bruto total por negociação.
	/// Fórmula: MAX(negotiations[vl_gross_total]) no contexto.
	/// Observações: retorna o maior contrato no recorte atual; sensível a filtros (cliente, período, canal).
	measure mt_max_gross_per_neg =
			
			MAXX ( pbi_vw_negotiations, pbi_vw_negotiations[vl_gross_total] )
		formatString: #,0.00
		displayFolder: '09 Negotiations'
		lineageTag: 'meas-neg-max-gross'

		changedProperty = IsHidden

	/// Definição: Nº de dias de exibição distintos (airing days).
	/// Fórmula: DISTINCTCOUNT(ad_insertion[dt_air]).
	/// Observações: conta dias únicos no contexto; sensível a filtros de canal/campanha/programa.
	measure nr_airing_days =
			
			DISTINCTCOUNT ( pbi_vw_ad_insertion[dt_air] )
		formatString: #,0
		displayFolder: '01 Volume'
		lineageTag: 'meas-nr-airing-days'

		changedProperty = IsHidden

	/// Definição: Nº de campanhas distintas.
	/// Fórmula: DISTINCTCOUNT(ad_insertion[cd_campaign]).
	/// Observações: depende da granularidade/codificação de campanha na fonte.
	measure nr_campaigns =
			
			DISTINCTCOUNT ( pbi_dim_campaigns[cd_campaign] )
		formatString: #,0
		displayFolder: '01 Volume'
		lineageTag: 'meas-nr-campaigns'

		changedProperty = IsHidden

	/// Definição: Nº de canais distintos.
	/// Fórmula: DISTINCTCOUNT(ad_insertion[cd_channel]).
	/// Observações: considera apenas canais presentes no recorte filtrado (período, cliente, etc.).
	measure nr_channels =
			
			DISTINCTCOUNT ( pbi_dim_channels[cd_channel] )
		formatString: #,0
		displayFolder: '01 Volume'
		lineageTag: 'meas-nr-channels'

		changedProperty = IsHidden

	/// Definição: Nº de inserções em 1ª posição no break.
	/// Fórmula: COUNTROWS(ad_insertion) onde nr_position = 1.
	/// Observações: depende do preenchimento de nr_position; se houver posições inválidas, elas não entram (exceto as =1).
	measure nr_first_position =
			
			CALCULATE (
			    COUNTROWS ( pbi_vw_ad_insertion ),
			    pbi_vw_ad_insertion[nr_position] = 1
			)
		formatString: #,0
		displayFolder: '06 Breaks'
		lineageTag: 'meas-first-position'

		changedProperty = IsHidden

	/// Definição: Nº total de inserções (todas).
	/// Fórmula: COUNTROWS(ad_insertion).
	/// Observações: inclui qualquer status; é base para taxas como pc_active_rate.
	measure nr_insertions =
			
			COUNTROWS ( pbi_vw_ad_insertion )
		formatString: #,0
		displayFolder: '01 Volume'
		lineageTag: 'meas-nr-insertions'

		changedProperty = IsHidden

	/// Definição: Nº de inserções ativas (entregues/em execução).
	/// Fórmula: COUNTROWS(ad_insertion) filtrando st_status ∈ {Broadcasted, Delivered, In Playlist}.
	/// Observações: status incluídos definem “ativa”; qualquer mudança nos status altera todas as métricas derivadas (ex.: avg_duration_seconds, pc_active_rate).
	measure nr_insertions_active =
			
			CALCULATE (
			    [nr_insertions],
			    pbi_vw_ad_insertion[st_status] IN { "Broadcasted", "Delivered", "In Playlist" }
			)
		formatString: #,0
		displayFolder: '01 Volume'
		lineageTag: 'meas-nr-insertions-active'

		changedProperty = IsHidden

	/// Definição: Nº de inserções booked (reservadas).
	/// Fórmula: COUNTROWS(ad_insertion) onde st_status = "Booked".
	/// Observações: não inclui entregues; útil para pipeline/futuro inventário.
	measure nr_insertions_booked =
			
			CALCULATE (
			    COUNTROWS ( pbi_vw_ad_insertion ),
			    pbi_vw_ad_insertion[st_status] = "Booked"
			)
		formatString: #,0
		displayFolder: '01 Volume'
		lineageTag: 'meas-nr-insertions-booked'

		changedProperty = IsHidden

	/// Definição: Inserções ativas no mês anterior.
	/// Fórmula: CALCULATE(nr_insertions_active, PREVIOUSMONTH(dim_tempo[data])).
	/// Observações: exige relação correta com dim_tempo[data]; PREVIOUSMONTH depende de calendário contínuo.
	measure nr_insertions_prev_month =
			
			CALCULATE ( [nr_insertions_active], PREVIOUSMONTH ( dim_tempo[data] ) )
		formatString: #,0
		displayFolder: '05 Time Intelligence'
		lineageTag: 'meas-nr-prev-month'

		changedProperty = IsHidden

	/// Definição: Inserções ativas YTD (acumulado no ano).
	/// Fórmula: CALCULATE(nr_insertions_active, DATESYTD(dim_tempo[data])).
	/// Observações: depende do “ano fiscal” implícito do calendário; se ano fiscal ≠ ano civil, precisa ajuste.
	measure nr_insertions_ytd =
			
			CALCULATE ( [nr_insertions_active], DATESYTD ( dim_tempo[data] ) )
		formatString: #,0
		displayFolder: '05 Time Intelligence'
		lineageTag: 'meas-nr-ytd'

		changedProperty = IsHidden

	/// Definição: Nº de negotiações distintas (derivado das inserções).
	/// Fórmula: DISTINCTCOUNT(ad_insertion[cd_negotiation]).
	/// Observações: conta negotiações que aparecem em inserções; pode divergir de nr_negotiations_total (tabela de negotiações).
	measure nr_register =
			
			[nr_campaigns] + [nr_insertions]
		formatString: #,0
		displayFolder: '01 Volume'
		lineageTag: 'meas-nr-negotiations'

		changedProperty = IsHidden

	/// Definição: Nº total de negotiações (tabela de negotiações).
	/// Fórmula: COUNTROWS(negotiations).
	/// Observações: inclui negotiações sem inserções; comparar com nr_negotiations (derivado) para identificar “negotiações vazias”.
	measure nr_negotiations_total =
			
			COUNTROWS ( pbi_vw_negotiations )
		formatString: #,0
		displayFolder: '09 Negotiations'
		lineageTag: 'meas-neg-total'

		changedProperty = IsHidden

	/// Definição: Nº de negotiações com inserções (>0).
	/// Fórmula: COUNTROWS(FILTER(negotiations, nr_insertions_total > 0)).
	/// Observações: remove negotiações sem veiculação; base para mt_avg_net_per_neg.
	measure nr_negotiations_with_insertions =
			
			COUNTROWS (
			    FILTER ( pbi_vw_negotiations, pbi_vw_negotiations[nr_insertions_total] > 0 )
			)
		formatString: #,0
		displayFolder: '09 Negotiations'
		lineageTag: 'meas-neg-with-ins'

		changedProperty = IsHidden

	/// Definição: Nº de programas distintos.
	/// Fórmula: DISTINCTCOUNT(ad_insertion[cd_program]).
	/// Observações: depende do cadastro de programas e da estabilidade do identificador cd_program.
	measure nr_programs =
			
			DISTINCTCOUNT ( pbi_vw_ad_insertion[cd_program] )
		formatString: #,0
		displayFolder: '01 Volume'
		lineageTag: 'meas-nr-programs'

		changedProperty = IsHidden

	/// Definição: Taxa de inserções ativas.
	/// Fórmula: nr_insertions_active / nr_insertions.
	/// Observações: numerador usa status incluídos (ativa); se nr_insertions = 0, DIVIDE retorna BLANK/0.
	measure pc_active_rate =
			
			DIVIDE ( [nr_insertions_active], [nr_insertions] )
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: '01 Volume'
		lineageTag: 'meas-pc-active-rate'

		changedProperty = IsHidden

	/// Definição: % realizado vs contratado (financeiro).
	/// Fórmula: SUM(negotiations[vl_net_total]) / SUM(negotiations[vl_negotiation_gross_contracted]).
	/// Observações: se contratado = 0, DIVIDE retorna BLANK/0; garante consistência se ambas as colunas vêm da mesma base de negociação.
	measure pc_contracted_realised =
			
			DIVIDE (
			    SUM ( pbi_vw_negotiations[vl_net_total] ),
			    SUM ( pbi_vw_negotiations[vl_negotiation_gross_contracted] )
			)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: '09 Negotiations'
		lineageTag: 'meas-neg-pc-realised'

		changedProperty = IsHidden

	/// Definição: Desconto médio (%).
	/// Fórmula: (total_gross - total_net) / total_gross.
	/// Observações: se total_gross = 0, DIVIDE retorna BLANK/0; desconto reflete diferença agregada (não média linha a linha).
	measure pc_discount_avg =
			
			var _calc = DIVIDE ( [total_gross] - [total_billing], [total_gross] )
			return
			    SWITCH( TRUE()
			        , ISBLANK( [total_gross] ) || NOT( ABS( [total_gross] ) > 0 ), BLANK()
			        , ISBLANK( [total_billing] ) || NOT( ABS( [total_billing] ) > 0 ), BLANK()
			        , _calc )
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: '03 Financial'
		lineageTag: 'meas-pc-discount-avg'

		changedProperty = IsHidden

	/// Definição: % de inserções em 1ª posição (sobre ativas).
	/// Fórmula: nr_first_position / nr_insertions_active.
	/// Observações: depende do preenchimento de nr_position; se nr_insertions_active = 0, DIVIDE retorna BLANK/0.
	measure pc_first_position =
			
			DIVIDE ( [nr_first_position], [nr_insertions_active] )
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: '06 Breaks'
		lineageTag: 'meas-pc-first-position'

		changedProperty = IsHidden

	/// Definição: Total bruto contratado (negotiações).
	/// Fórmula: SUM(negotiations[vl_negotiation_gross_contracted]).
	/// Observações: montante contratado, independentemente de entrega; sensível ao recorte de negotiações.
	measure total_contracted_gross = ```
			
			    CALCULATE(
			        SUM ( pbi_vw_negotiations[vl_negotiation_gross_contracted] )
			        , USERELATIONSHIP( pbi_vw_negotiations[dt_first_air], dim_tempo[data] )
			    )
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: '09 Negotiations'
		lineageTag: 'meas-neg-contracted'

		changedProperty = IsHidden

	/// Definição: Total bruto (inserções).
	/// Fórmula: SUM(ad_insertion[vl_gross]).
	/// Observações: bruto agregado; se houver estornos/ajustes na fonte, refletirá aqui.
	measure total_gross =
			
			VAR _fl_adults =
			    SELECTEDVALUE ( pmt_adults_GRP[fl_adults_eq] )
			VAR _CALC =
			    IF (
			        _fl_adults,
			        CALCULATE (
			            SUM ( pbi_vw_ad_insertion[vl_gross] ),
			            VALUES ( pbi_vw_targets[ds_variant] ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets[ds_variant_adults]
			            )
			        ),
			        CALCULATE (
			            SUM ( pbi_vw_ad_insertion[vl_gross] ),
			            VALUES ( pbi_vw_targets[ds_variant] ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets_simulado[ds_variant]
			            )
			        )
			    )
			RETURN
			    IF ( ABS ( _CALC ) > 0, _CALC, BLANK () )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: '03 Financial'
		lineageTag: 'meas-total-gross'

		changedProperty = IsHidden

	/// Definição: Duração total em horas.
	/// Fórmula: total_seconds / 3600.
	/// Observações: conversão direta; depende de total_seconds (vl_duration_fitting) estar em segundos.
	measure total_hours =
			
			DIVIDE ( [total_seconds], 3600 )
		formatString: #,0
		displayFolder: '02 Duration'
		lineageTag: 'meas-total-hours'

		changedProperty = IsHidden

	/// Definição: Duração total em minutos.
	/// Fórmula: total_seconds / 60.
	/// Observações: conversão direta; depende de total_seconds estar em segundos.
	measure total_minutes =
			
			DIVIDE ( [total_seconds], 60 )
		formatString: #,0
		displayFolder: '02 Duration'
		lineageTag: 'meas-total-minutes'

		changedProperty = IsHidden

	/// Definição: Total líquido (inserções).
	/// Fórmula: SUM(ad_insertion[vl_net]).
	/// Observações: líquido agregado por inserções; pode divergir do líquido na audiência/faturas (bases diferentes).
	measure total_billing = ```
			
			// VAR _valor = SUM( pbi_vw_ad_insertion[vl_billing] )
			VAR _fl_adults =
			    SELECTEDVALUE ( pmt_adults_GRP[fl_adults_eq] )
			VAR _postion_tax =
			    SELECTEDVALUE ( pmt_exclude_position_tax[fl_validate] )
			VAR _multiproduct_tax =
			    SELECTEDVALUE ( pmt_exclude_multiproduct_tax[fl_validate] )
			VAR _fl_VBN_consider =
			    SELECTEDVALUE( pmt_values_KPI[ds_metrics] ) 
			        // {"vl_biiling", "Encomendas", 0},
			        // {"vl_invoice_billing", "Facturação", 1}
			VAR _CALC =
			    IF (
			        _fl_adults,
			        CALCULATE ( IF( _fl_VBN_consider = "vl_invoice_billing"
			            , SUMX( FILTER( pbi_vw_invoices, pbi_vw_invoices[nr_quantity] = 1 ), pbi_vw_invoices[vl_invoice_gross] )
			            , SWITCH( TRUE()
			                , AND( _postion_tax <> 0, _multiproduct_tax <> 0 ), SUMX( pbi_vw_ad_insertion, pbi_vw_ad_insertion[vl_billing] - pbi_vw_ad_insertion[vl_billing_position] - pbi_vw_ad_insertion[vl_billing_multiproduct] )
			                , _postion_tax <> 0, SUMX( pbi_vw_ad_insertion, pbi_vw_ad_insertion[vl_billing] - pbi_vw_ad_insertion[vl_billing_position] )
			                , _multiproduct_tax <> 0, SUMX( pbi_vw_ad_insertion, pbi_vw_ad_insertion[vl_billing] - pbi_vw_ad_insertion[vl_billing_multiproduct] )
			                , SUM( pbi_vw_ad_insertion[vl_billing] )
			            )),
			            VALUES ( pbi_vw_targets[ds_variant] ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets[ds_variant_adults]
			            )
			        ),
			        CALCULATE ( IF( _fl_VBN_consider = "vl_invoice_billing"
			            , SUMX( FILTER( pbi_vw_invoices, pbi_vw_invoices[nr_quantity] = 1 ), pbi_vw_invoices[vl_invoice_gross] )
			            , SWITCH( TRUE()
			                , AND( _postion_tax <> 0, _multiproduct_tax <> 0 ), SUMX( pbi_vw_ad_insertion, pbi_vw_ad_insertion[vl_billing] - pbi_vw_ad_insertion[vl_billing_position] - pbi_vw_ad_insertion[vl_billing_multiproduct] )
			                , _postion_tax <> 0, SUMX( pbi_vw_ad_insertion, pbi_vw_ad_insertion[vl_billing] - pbi_vw_ad_insertion[vl_billing_position] )
			                , _multiproduct_tax <> 0, SUMX( pbi_vw_ad_insertion, pbi_vw_ad_insertion[vl_billing] - pbi_vw_ad_insertion[vl_billing_multiproduct] )
			                , SUM( pbi_vw_ad_insertion[vl_billing] )
			            )),
			            VALUES ( pbi_vw_targets[ds_variant] ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets_simulado[ds_variant]
			            )
			        )
			    )
			RETURN
			    IF ( ABS ( _CALC ) > 0, _CALC, BLANK () )
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: '03 Financial'
		lineageTag: 'meas-total-net'

		changedProperty = IsHidden

	/// Definição: Total líquido no mês anterior.
	/// Fórmula: CALCULATE(total_net, PREVIOUSMONTH(dim_tempo[data])).
	/// Observações: exige calendário contínuo; útil para MoM (total_net_prev_month é denominador do mom_net_growth_pct).
	measure total_billing_prev_month =
			
			CALCULATE ( [total_billing], PREVIOUSMONTH ( dim_tempo[data] ) )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: '05 Time Intelligence'
		lineageTag: 'meas-net-prev-month'

		changedProperty = IsHidden

	/// Definição: Total líquido YTD (acumulado no ano).
	/// Fórmula: CALCULATE(total_net, DATESYTD(dim_tempo[data])).
	/// Observações: ano civil por padrão; se calendário fiscal for diferente, precisa ajuste; depende de dim_tempo[data] relacionada.
	measure total_billing_ytd =
			
			CALCULATE ( [total_billing], DATESYTD ( dim_tempo[data] ) )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: '05 Time Intelligence'
		lineageTag: 'meas-net-ytd'

		changedProperty = IsHidden

	/// Definição: Duração total (segundos) ajustada/fitting.
	/// Fórmula: SUM(ad_insertion[vl_duration_fitting]).
	/// Observações: base de todas as conversões (minutos/horas) e do custo por segundo; se a coluna já vier “ajustada”, o conceito de duração real pode diferir.
	measure total_seconds =
			
			VAR _fl_adults =
			    SELECTEDVALUE ( pmt_adults_GRP[fl_adults_eq] )
			RETURN
			    IF (
			        _fl_adults,
			        CALCULATE (
			            SUM ( pbi_vw_ad_insertion[vl_duration_fitting] ),
			            VALUES ( pbi_vw_targets[ds_variant] ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets[ds_variant_adults]
			            ),
			            TREATAS ( VALUES ( dim_tempo[data] ), pbi_dim_campaigns[dt_init] )
			        ),
			        CALCULATE (
			            SUM ( pbi_vw_ad_insertion[vl_duration_fitting] ),
			            VALUES ( pbi_vw_targets[ds_variant] ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets[ds_variant]
			            ),
			            TREATAS ( VALUES ( dim_tempo[data] ), pbi_dim_campaigns[dt_init] )
			        )
			    )
		formatString: #,0
		displayFolder: '02 Duration'
		lineageTag: 'meas-total-seconds'

		changedProperty = IsHidden

	/// Definição: CPR médio (Custo por Rating Equivalente).
	/// Fórmula: SUM(audience[vl_net]) / mt_grp_equiv_total.
	/// Observações: se mt_grp_equiv_total = 0, DIVIDE retorna BLANK/0; usa líquido da audiência (não necessariamente o mesmo líquido de inserções).
	measure CPR =
			
			DIVIDE ( [total_billing], [GRP] )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: '08 Audience'
		lineageTag: 'meas-aud-cpr'

		changedProperty = IsHidden

	/// Definição: Total líquido MTD (mês até a data).
	/// Fórmula: CALCULATE(total_net, DATESMTD(dim_tempo[data])).
	/// Observações: depende de dim_tempo[data] contínua e relacionada; recorta do 1º dia do mês até a data corrente no contexto.
	measure total_billing_mtd =
			
			CALCULATE ( [total_billing], DATESMTD ( dim_tempo[data] ) )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: '05 Time Intelligence'
		lineageTag: 'meas-net-mtd'

		changedProperty = IsHidden

