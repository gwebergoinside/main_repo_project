	measure yoy_CPS_growth_pct = ```
			
			var _calc = DIVIDE ( [CPS] - [CPS_LY], [CPS_LY] ) 
			return
			    SWITCH( TRUE()
			        , AND( ISBLANK( [CPS] ) || [CPS] = 0, ISBLANK( [CPS_LY] ) || [CPS_LY] = 0 ), BLANK()
			        , AND( OR( ISBLANK( [CPS] ) || [CPS] = 0, ISBLANK( [CPS_LY] ) || [CPS_LY] = 0 ), CONTAINSSTRING( SELECTEDVALUE( dim_tempo[ds_atual_date] ), "Future" )), BLANK()
			        , ISBLANK( [CPS] ) || [CPS] = 0, -1
			        , ISBLANK( [CPS_LY] ) || [CPS_LY] = 0, 1
			        , _calc )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: '05 Time Intelligence'
		lineageTag: b7cf8819-7458-4357-9bc1-2af858e9de62

