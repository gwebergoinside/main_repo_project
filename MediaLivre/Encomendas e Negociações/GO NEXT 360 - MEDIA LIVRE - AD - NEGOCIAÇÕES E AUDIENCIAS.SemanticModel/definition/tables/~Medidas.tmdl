	measure tx_last_update_grp = ```
			
			VAR _lastUpdateData =
			    MAX ( pbi_last_data_updated[last_update] ) // Gets the most recent update date/time from the source table.
			   
			VAR _lastUpdateGRPs =
			    MAX ( pbi_vw_max_date_indicators[max_dt_air] ) // Gets the most recent update date/time from the source table.
			
			VAR _behavior = "scroll" // Controls the marquee animation behavior.
			VAR _direction = "left" // Sets the direction of the scrolling text.
			VAR _text_align = "right" // Sets the aligning text.
			VAR _scrollamount = "5" // Sets the scrolling speed.
			VAR _text =
			    SWITCH (
			        USERCULTURE (),
			        "en-GB", "Updates: Data at " & FORMAT ( _lastUpdateData, "dd/MM/yyyy HH:mm" ) & " - UTC (0h); GRPs at " & FORMAT ( _lastUpdateGRPs, "dd/MM/yyyy" ) & ".",
			        "en-US", "Updates: Data at " & FORMAT ( _lastUpdateData, "MM/dd/yyyy hh:mm" ) & " " & FORMAT ( _lastUpdateData, "AM/PM" ) & " - UTC (0h); GRPs at " & FORMAT ( _lastUpdateGRPs, "MM/dd/yyyy" ) & ".",
			        "es-ES", "Actualizaciones: Datos a las " & FORMAT ( _lastUpdateData, "dd/MM/yyyy HH:mm" ) & " - UTC (0h); GRPs a las " & FORMAT ( _lastUpdateGRPs, "dd/MM/yyyy" ) & ".",
			        "pt-PT", "Atualizações: Dados em " & FORMAT ( _lastUpdateData, "dd/MM/yyyy HH:mm" ) & " - UTC (0h); GRPs em " & FORMAT ( _lastUpdateGRPs, "dd/MM/yyyy" ) & ".",
			        "pt-BR", "Atualizações: Dados em " & FORMAT ( _lastUpdateData, "dd/MM/yyyy HH:mm" ) & " - UTC (0h); GRPs em " & FORMAT ( _lastUpdateGRPs, "dd/MM/yyyy" ) & ".",
			        "Updates: Data at " & FORMAT ( _lastUpdateData, "dd/MM/yyyy HH:mm" ) & " - UTC (0h); GRPs at " & FORMAT ( _lastUpdateGRPs, "dd/MM/yyyy" ) & "."
			    ) // Returns the localized text based on the user culture.
			RETURN
			    "<marquee behavior='" & _behavior & "' direction='" & _direction & "' scrollamount='" & _scrollamount & "'>" & _text & "</marquee>"
