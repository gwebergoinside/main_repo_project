			        CALCULATE (
			            SUMX (
			                FILTER (
			                    pbi_vw_indicators,
			                    CONTAINSSTRING ( pbi_vw_indicators[st_part], "original" )
			                ),
			                IF( _fl_duration = 30, [GRP_EQ30], [GRP_EQ])
			            ),
			            REMOVEFILTERS ( pbi_vw_targets_simulado ),
			            KEEPFILTERS (
			                TREATAS (
			                    VALUES ( pbi_vw_targets_var[ds_variant] ),
			                    pbi_vw_targets[ds_variant]
			                )
			            )
			        )
			    )
