	measure tx_answer_pmt_add_projected =
			
			VAR _behavior = "scroll"
			VAR _direction = "left"
			VAR _scrollamount = "0"
			VAR _answer = // Checks whether the Adults Equivalent toggle is enabled.
			    SELECTEDVALUE( pmt_add_projections[ds_description]) = "on"
			VAR _textOn = // Returns the translated text when the toggle is on.
			    SWITCH(
			        USERCULTURE(),
			        "en-GB", "Yes",
			        "en-US", "Yes",
			        "es-ES", "Sí",
			        "pt-PT", "Sim",
			        "pt-BR", "Sim",
			        "Yes"
			    )
			VAR _textOff = // Returns the translated text when the toggle is off.
			    SWITCH(
			        USERCULTURE(),
			        "en-GB", "No",
			        "en-US", "No",
			        "es-ES", "No",
			        "pt-PT", "Não",
			        "pt-BR", "Não",
			        "No"
			    )
			
			VAR _finalText = // Chooses which translated text should be displayed.
			    IF(_answer, _textOn, _textOff)
			
			RETURN
			        "<marquee behavior='" & _behavior &
			        "' direction='" & _direction &
			        "' scrollamount='" & _scrollamount &
			        "'>" & _finalText & "</marquee>"
		displayFolder: '07 Texts'
		lineageTag: e33c207b-cc0c-4829-b5a6-5b303bec9edf

	measure tx_add_projected =
			
			VAR _behavior = "scroll" // Controls the marquee animation behavior.
			VAR _direction = "left" // Sets the direction of the scrolling text.
			VAR _text_align = "right" // Sets the aligning text.
			VAR _scrollamount = "5" // Sets the scrolling speed.
			VAR _text =
			    SWITCH (
			        USERCULTURE (),
			        "en-GB", "Add the Projections to the Expectation Percentages?",
			        "en-US", "Add the Projections to the Expectation Percentages?",
			        "es-ES", "¿Añadir las Proyecciones a los Porcentajes de Expectativa?",
			        "pt-PT", "Adicionar as Projeções nas Percentagens de Expectativa?",
			        "pt-BR", "Adicionar as Projeções nos Percentuais de Expectativa?",
			        "Add the Projections to the Expectation Percentages?"
			    )
			RETURN
			    "<marquee behavior='" & _behavior & "' direction='" & _direction & "' scrollamount='" & _scrollamount & "'>" & _text & "</marquee>"
			    // "<span style='text-align:" & _text_align & "; display:block;'>" & _text & "</span>"
		displayFolder: '07 Texts'
		lineageTag: bad22cf4-087f-4aba-b58c-92fa2f43ca15

