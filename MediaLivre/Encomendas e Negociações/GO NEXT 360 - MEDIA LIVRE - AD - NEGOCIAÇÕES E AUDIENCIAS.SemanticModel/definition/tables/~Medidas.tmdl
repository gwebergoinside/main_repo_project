	measure dt_first_air_ =
			
			CALCULATE(
			    MIN( pbi_vw_negotiations[dt_first_air] )
			    , USERELATIONSHIP( pbi_vw_negotiations[dt_first_air], dim_tempo[data] )
			)
		formatString: Short Date
		displayFolder: '09 Negotiations'
		lineageTag: af6976b1-947f-41d8-b7cc-097243881103

	measure dt_last_air_ =
			
			CALCULATE(
			    MAX( pbi_vw_negotiations[dt_last_air] )
			    , USERELATIONSHIP( pbi_vw_negotiations[dt_first_air], dim_tempo[data] )
			)
		formatString: Short Date
		displayFolder: '09 Negotiations'
		lineageTag: 08b1d600-c601-4cfa-a53a-589fecded9dc

	measure pc_contracted_shouldBe_realised = ```
			
			VAR _total = SUMX( pbi_vw_negotiations, CALCULATE( DATEDIFF( MIN( pbi_vw_negotiations[dt_first_air] ), MAX( pbi_vw_negotiations[dt_last_air] ), DAY ) 
			    , USERELATIONSHIP( pbi_vw_negotiations[dt_first_air], dim_tempo[data] ))
			)
			VAR _actual = SUMX( pbi_vw_negotiations, CALCULATE( DATEDIFF( MIN( pbi_vw_negotiations[dt_first_air] ), MIN( MAX( pbi_vw_negotiations[dt_last_air] ), MAX ( pbi_last_data_updated[last_update] ) ) , DAY )
			    , USERELATIONSHIP( pbi_vw_negotiations[dt_first_air], dim_tempo[data] ))
			)
			VAR _divide = DIVIDE( _actual, _total )
			RETURN _divide
			    // SWITCH( TRUE()
			    // , _divide > 1, 1
			    // , _divide < 0, 0
			    // , _divide )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: '09 Negotiations'
