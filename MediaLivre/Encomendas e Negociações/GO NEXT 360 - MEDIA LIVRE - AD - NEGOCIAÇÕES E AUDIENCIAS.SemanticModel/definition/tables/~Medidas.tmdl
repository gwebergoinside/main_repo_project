	measure tx_mensage_alert =
			
			VAR _behavior = "scroll" // Defines the marquee animation mode.
			VAR _direction = "left" // Defines the scrolling direction.
			VAR _scrollamount = "5" // Defines the scrolling speed.
			VAR _textAlign = "right" // Defines the horizontal text alignment.
			VAR _text =
			    SWITCH (
			        USERCULTURE (),
			        "en-GB", "For this visual, only 'Adults' should be applied in the Equivalent grouping, allowing simulation for the other targets.",
			        "en-US", "For this visual, only 'Adults' should be applied in the Equivalent grouping, allowing simulation for the other targets.",
			        "es-ES", "Para este visual, solo se aplicará 'Adultos' en la agrupación Equivalente, permitiendo la simulación para los demás objetivos.",
			        "pt-PT", "Para este visual, apenas será aplicado 'Adultos' no agrupamento Equivalente, permitindo a simulação para os demais alvos.",
			        "pt-BR", "Para este visual, apenas será aplicado 'Adultos' no agrupamento Equivalente, permitindo a simulação para os demais alvos.",
			        "For this visual, only 'Adults' should be applied in the Equivalent grouping, allowing simulation for the other targets."
			    ) // Returns the translated text based on the user culture.
			RETURN
			    // "<span style='text-align:" & _textAlign & "; display:block;'>" & _text & "</span>"
			    "<marquee behavior='" & _behavior & "' direction='" & _direction & "' scrollamount='" & _scrollamount & "'>" & _text & "</marquee>"
		displayFolder: '07 Texts'
		lineageTag: db5e7848-0832-41e9-8392-31f6062ceca7

	measure total_net =
			
			// VAR _valor = SUM( pbi_vw_ad_insertion[vl_net] )
			VAR _fl_adults =
			    SELECTEDVALUE ( pmt_adults_GRP[fl_adults_eq] )
			VAR _postion_tax =
			    SELECTEDVALUE ( pmt_exclude_position_tax[fl_validate] )
			// VAR _multiproduct_tax =
			//     SELECTEDVALUE ( pmt_exclude_multiproduct_tax[fl_validate] )
			VAR _CALC =
			    IF (
			        _fl_adults,
			        CALCULATE (
			            SWITCH( TRUE()
			                // , AND( _postion_tax <> 0, _multiproduct_tax <> 0 ), SUMX( pbi_vw_ad_insertion, pbi_vw_ad_insertion[vl_net] * ( 1 - MAX( pbi_vw_ad_insertion[pc_position_tax], pbi_vw_ad_insertion[pc_multiproduct_tax] ) ) )
			                , _postion_tax <> 0, SUMX( pbi_vw_ad_insertion, pbi_vw_ad_insertion[vl_net] * ( 1 - MAX( pbi_vw_ad_insertion[pc_position_tax] ) ) )
			                // , _multiproduct_tax <> 0, SUMX( pbi_vw_ad_insertion, pbi_vw_ad_insertion[vl_net] * ( 1 - MAX( pbi_vw_ad_insertion[pc_multiproduct_tax] ) ) )
			                , SUM( pbi_vw_ad_insertion[vl_net] )
			            ),
			            VALUES ( pbi_vw_targets[ds_variant] ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets[ds_variant_adults]
			            )
			        ),
			        CALCULATE (
			            SWITCH( TRUE()
			                // , AND( _postion_tax <> 0, _multiproduct_tax <> 0 ), SUMX( pbi_vw_ad_insertion, pbi_vw_ad_insertion[vl_net] * ( 1 - MAX( pbi_vw_ad_insertion[pc_position_tax], pbi_vw_ad_insertion[pc_multiproduct_tax] ) ) )
			                , _postion_tax <> 0, SUMX( pbi_vw_ad_insertion, pbi_vw_ad_insertion[vl_net] * ( 1 - MAX( pbi_vw_ad_insertion[pc_position_tax] ) ) )
			                // , _multiproduct_tax <> 0, SUMX( pbi_vw_ad_insertion, pbi_vw_ad_insertion[vl_net] * ( 1 - MAX( pbi_vw_ad_insertion[pc_multiproduct_tax] ) ) )
			                , SUM( pbi_vw_ad_insertion[vl_net] )
			            ),
			            VALUES ( pbi_vw_targets[ds_variant] ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets_simulado[ds_variant]
			            )
			        )
			    )
			RETURN
			    IF ( ABS ( _CALC ) > 0, _CALC, BLANK () )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: '03 Financial'
		lineageTag: ac02e12c-df79-4b67-a2a0-595b8d80668c

