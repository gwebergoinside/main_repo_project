	measure total_invoice_net =
			
			VAR _fl_adults =
			    SELECTEDVALUE ( pmt_adults_GRP[fl_adults_eq] )
			VAR _CALC =
			    IF (
			        _fl_adults,
			        CALCULATE (
			            SUMX( FILTER( pbi_vw_invoices, pbi_vw_invoices[nr_quantity] = 1 ), pbi_vw_invoices[vl_invoice_net] ),
			            // SUM ( pbi_vw_invoices[vl_invoice_net] ),
			            VALUES ( pbi_vw_targets[ds_variant] ),
			            CROSSFILTER( pbi_dim_campaigns[cd_campaign], pbi_vw_ad_insertion[cd_campaign], Both ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets[ds_variant_adults]
			            )
			        ),
			        CALCULATE (
			            SUMX( FILTER( pbi_vw_invoices, pbi_vw_invoices[nr_quantity] = 1 ), pbi_vw_invoices[vl_invoice_net] ),
			            // SUM ( pbi_vw_invoices[vl_invoice_net] ),
			            VALUES ( pbi_vw_targets[ds_variant] ),
			            CROSSFILTER( pbi_dim_campaigns[cd_campaign], pbi_vw_ad_insertion[cd_campaign], Both ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[ds_variant] ),
			                pbi_vw_targets_simulado[ds_variant]
			            )
			        )
			    )
			RETURN
			    IF ( ABS ( [total_seconds] ) > 0, IF ( ABS ( _CALC ) > 0, _CALC ), BLANK () )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: '03 Financial'
		lineageTag: 0987926d-e2ec-4fa9-813a-0152ae5c3e18

