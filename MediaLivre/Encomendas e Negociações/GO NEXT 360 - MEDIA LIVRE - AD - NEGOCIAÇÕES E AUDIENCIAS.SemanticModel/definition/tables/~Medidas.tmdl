	measure yoy_billing_growth_pct =
			
			var _calc = DIVIDE ( [total_billing] - [total_billing_LY], [total_billing_LY] )
			return
			    SWITCH( TRUE()
			        , AND( ISBLANK( [total_billing] ) || [total_billing] = 0, ISBLANK( [total_billing_LY] ) || [total_billing_LY] = 0 ), BLANK()
			        , AND( OR( ISBLANK( [total_billing] ) || [total_billing] = 0, ISBLANK( [total_billing_LY] ) || [total_billing_LY] = 0 ), CONTAINSSTRING( SELECTEDVALUE( dim_tempo[ds_atual_date] ), "Future" )), BLANK()
			        , ISBLANK( [total_billing] ) || [total_billing] = 0, -1
			        , ISBLANK( [total_billing_LY] ) || [total_billing_LY] = 0, 1
			        , _calc )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: '05 Time Intelligence'
		lineageTag: ba785fd7-3d0e-4010-a307-1964de88821f

	measure yoy_CPR_EQ_growth_pct =
			
