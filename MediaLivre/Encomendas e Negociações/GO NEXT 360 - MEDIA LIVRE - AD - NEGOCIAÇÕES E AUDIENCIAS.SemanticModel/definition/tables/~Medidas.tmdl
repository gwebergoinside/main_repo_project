			                CALCULATE (
			                    IF ( _fl_duration = 30,
			                        SUM ( pbi_vw_indicators[GRP_EQ30_XT] ),
			                        SUM ( pbi_vw_indicators[GRP_EQ_XT] )
			                    ),
			                    TREATAS ( { _CdVariantLinha }, pbi_vw_indicators[cd_target] )
			                )
			            ),
			            CALCULATE (
			                IF ( _fl_duration = 30,
			                    SUM ( pbi_vw_indicators[GRP_EQ30_XT] ),
			                    SUM ( pbi_vw_indicators[GRP_EQ_XT] )
			                ),
			                TREATAS ( _CodigosSelecionados, pbi_vw_indicators[cd_target] )
			            )
			        )
			    )
