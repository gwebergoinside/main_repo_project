			VAR _fl_duration =
			    SELECTEDVALUE ( pmt_duration_equivancy[nm_duration_equivancy] )
			
			// Códigos selecionados no slicer (mesma tabela → filtro já propaga naturalmente)
			VAR _CodigosSelecionados =
			    VALUES ( pbi_vw_targets_simulado[cd_variant] )
			VAR _TemSelecao =
			    COUNTROWS ( _CodigosSelecionados ) > 0
			
			// Linha atual da matriz, traduzida para cd_variant
			VAR _VariantLinha =
			    SELECTEDVALUE ( pbi_vw_targets_var[ds_variant] )
			VAR _CdVariantLinha =
			    SELECTEDVALUE ( pbi_vw_targets_var[cd_variant] )
			
			VAR _LinhaSelecionada =
			    CONTAINS ( VALUES ( pbi_vw_targets_simulado[ds_variant] ), pbi_vw_targets_simulado[ds_variant], _VariantLinha )
			
			RETURN
			    IF (
