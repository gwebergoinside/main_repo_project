	measure tx_title_register_until_last_update =
			
			VAR _behavior = "scroll" // Defines the marquee animation behavior.
			VAR _direction = "left" // Defines the scrolling direction of the marquee text.
			VAR _scrollamount = "5" // Defines the scrolling speed of the marquee.
			VAR _text =
			    SWITCH (
			        USERCULTURE (),
			        "en-GB", "Records until the last GRP update?",
			        "en-US", "Records until the last GRP update?",
			        "es-ES", "¿Registros hasta la última actualización de GRP?",
			        "pt-PT", "Registos até à última atualização de GRP?",
			        "pt-BR", "Registros até a última atualização de GRP?",
			        "Records until the last GRP update?"
			    )
			RETURN
			    "<marquee behavior='" & _behavior & "' direction='" & _direction & "' scrollamount='" & _scrollamount & "'>" & _text & "</marquee>"
		displayFolder: '07 Texts'
		lineageTag: 9568a8a6-863e-4b70-8b53-5b5670b3fc70

	measure tx_answer_register_until_last_update =
			
			VAR _behavior = "scroll"
			VAR _direction = "left"
			VAR _scrollamount = "0"
			VAR _answer = // Checks whether the Adults Equivalent toggle is enabled.
			    SELECTEDVALUE(until_last_updated[until_last_updated]) = "yes"
			VAR _textOn = // Returns the translated text when the toggle is on.
			    SWITCH(
			        USERCULTURE(),
			        "en-GB", "Yes",
			        "en-US", "Yes",
			        "es-ES", "Sí",
			        "pt-PT", "Sim",
			        "pt-BR", "Sim",
			        "Yes"
			    )
			VAR _textOff = // Returns the translated text when the toggle is off.
			    SWITCH(
			        USERCULTURE(),
			        "en-GB", "No",
			        "en-US", "No",
			        "es-ES", "No",
			        "pt-PT", "Não",
			        "pt-BR", "Não",
			        "No"
			    )
			
			VAR _finalText = // Chooses which translated text should be displayed.
			    IF(_answer, _textOn, _textOff)
			
			RETURN
			        "<marquee behavior='" & _behavior &
			        "' direction='" & _direction &
			        "' scrollamount='" & _scrollamount &
			        "'>" & _finalText & "</marquee>"
