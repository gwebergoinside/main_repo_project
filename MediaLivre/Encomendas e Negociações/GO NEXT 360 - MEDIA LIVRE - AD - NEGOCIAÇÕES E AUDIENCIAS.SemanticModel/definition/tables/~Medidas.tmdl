	measure tx_answer_ds_adults =
			
			VAR _behavior = "scroll"
			VAR _direction = "left"
			VAR _scrollamount = "0"
			VAR _isAdultsEqOn = // Checks whether the Adults Equivalent toggle is enabled.
			    SELECTEDVALUE(pmt_adults_GRP[ds_adults_eq]) = "on"
			VAR _textOn = // Returns the translated text when the toggle is on.
			    SWITCH(
			        USERCULTURE(),
			        "en-GB", "Yes",
			        "en-US", "Yes",
			        "es-ES", "Sí",
			        "pt-PT", "Sim",
			        "pt-BR", "Sim",
			        "Yes"
			    )
			VAR _textOff = // Returns the translated text when the toggle is off.
			    SWITCH(
			        USERCULTURE(),
			        "en-GB", "No",
			        "en-US", "No",
			        "es-ES", "No",
			        "pt-PT", "Não",
			        "pt-BR", "Não",
			        "No"
			    )
			
			VAR _finalText = // Chooses which translated text should be displayed.
			    IF(_isAdultsEqOn, _textOn, _textOff)
			
			RETURN
			        "<marquee behavior='" & _behavior &
			        "' direction='" & _direction &
			        "' scrollamount='" & _scrollamount &
			        "'>" & _finalText & "</marquee>"
