			        , AND( OR( ISBLANK( [CPR_EQ] ) || [CPR_EQ] = 0, ISBLANK( [CPR_EQ_LY] ) || [CPR_EQ_LY] = 0 ), CONTAINSSTRING( SELECTEDVALUE( dim_tempo[ds_atual_date] ), "Future" )), BLANK()
