	measure GRP_media_investment = ```
			
			VAR _adults = {"adult", "adults", "adulto", "adultos"}
			VAR _type =
			    SELECTEDVALUE ( pmt_types_targets_calc_media_investment[grouped] )
			VAR _calc =
			    SWITCH( _type, "Equivalent",
			        CALCULATE (
			            SUM( pbi_vw_media_investment_GRP[GRP] ),
			            KEEPFILTERS( pbi_vw_media_investment_GRP[cd_target] IN _adults ),
			            REMOVEFILTERS( pbi_vw_targets_simulado[ds_variant] ),
			            TREATAS (
			                VALUES ( pbi_vw_targets_var[cd_variant] ),
			                pbi_vw_media_investment_GRP[cd_target]
			            )
			        ),
			        IF( ISFILTERED( pbi_vw_targets_simulado[cd_variant] ),
			            CALCULATE (
			                SUM( pbi_vw_media_investment_GRP[GRP] ),
			                TREATAS (
			                    VALUES ( pbi_vw_targets_var[cd_variant] ),
			                    pbi_vw_media_investment_GRP[cd_target] 
			                )
			            )
			        )
			    )
			RETURN
			    IF ( ABS ( _CALC ) > 0, _CALC, BLANK () )
			```
		displayFolder: '08 Audience'
		lineageTag: df5f463b-d746-447c-84d0-cc004a108e3d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure GRP_media_investment_XT =
			
			VAR _Selecionados =
			    VALUES ( pbi_vw_targets_simulado[ds_variant] )
			VAR _TemSelecao =
			    COUNTROWS ( _Selecionados ) > 0
			VAR _VariantLinha =
			    SELECTEDVALUE ( pbi_vw_targets_var[ds_variant] )
			VAR _LinhaSelecionada =
			    CONTAINS ( _Selecionados, pbi_vw_targets_simulado[ds_variant], _VariantLinha )
			RETURN
			    IF (
			        NOT ISFILTERED ( pbi_vw_targets_simulado[ds_variant] ),
			        BLANK (),
			        IF (
			            ISINSCOPE ( pbi_vw_targets_var[ds_variant] ),
			            IF (
			                NOT _LinhaSelecionada,
			                BLANK (),
			                CALCULATE ( CALCULATE(
			                    SUM( pbi_vw_media_investment_GRP[GRP] ),
			                    TREATAS (
			                        VALUES ( pbi_vw_targets_var[cd_variant] ),
			                        pbi_vw_media_investment_GRP[cd_target]
			                    )),
			                    TREATAS ( { _VariantLinha }, pbi_vw_targets_simulado[ds_variant] )
			                )
			            ),
			            CALCULATE ( CALCULATE(
			                    SUM( pbi_vw_media_investment_GRP[GRP] ),
			                    TREATAS (
			                        VALUES ( pbi_vw_targets_var[cd_variant] ),
			                        pbi_vw_media_investment_GRP[cd_target]
			                    )),
			                TREATAS ( _Selecionados, pbi_vw_targets_simulado[ds_variant] )
			            )
			        )
			    )
		displayFolder: '08 Audience'
		lineageTag: b57148e5-6a3e-4469-8aae-767bf0b19330

		annotation PBI_FormatHint = {"isGeneralNumber":true}

