	measure vl_table_investment =
			
			VAR _adults = {"adults", "adult", "adultos", "adulto" }
			VAR _type =
			    SELECTEDVALUE ( pmt_types_targets_calc_media_investment[grouped] )
			VAR _calc =
			    SWITCH( _type, "Equivalent", IF( SELECTEDVALUE( pbi_vw_targets_var[ds_variant] ) in _adults,
			        CALCULATE (
			            SUM( pbi_vw_media_investment[vl_investment] ),
			            KEEPFILTERS( pbi_vw_media_investment_GRP[cd_target] IN _adults ),
			            REMOVEFILTERS( pbi_vw_targets_simulado[ds_variant] ),
			            TREATAS ( _adults, pbi_vw_targets_var[cd_variant] ),
			            TREATAS ( _adults, pbi_vw_media_investment_GRP[cd_target] )
			        )), BLANK()
			    )
			RETURN
			    IF ( ABS ( _calc ) > 0, _calc, BLANK () )
		displayFolder: '04 Investment'
		lineageTag: 1032ae21-ef4a-4720-932e-b7d09793b1f9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

