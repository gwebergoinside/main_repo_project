# Copiar para api/.env e preencher. O .env NAO e versionado.
#
# O PAT do Databricks fica so no servidor. Nunca colocar credenciais
# em ficheiros dentro de src/ (sao servidos ao browser).

# Host do workspace, sem barra final
DATABRICKS_HOST=https://<workspace>.azuredatabricks.net

# Id do SQL Warehouse (ultimo segmento do caminho /sql/1.0/warehouses/<id>)
DATABRICKS_WAREHOUSE_ID=

# Personal Access Token ou token de service principal
DATABRICKS_TOKEN=

# Catalogo e schema (default: os do modelo PBI)
DATABRICKS_CATALOG=medialivre
DATABRICKS_SCHEMA=pbi_out

# Porta do servidor
PORT=8080

# Token partilhado da API. Vazio = autenticacao desativada (desenvolvimento).
# PLACEHOLDER - ver docs/05-fase1-backend.md antes de usar em producao.
API_TOKEN=

# TTL do cache em ms
CACHE_TTL_MS=300000
