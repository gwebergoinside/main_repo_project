{
  "name": "Metricalist - Simply Modern Light",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F1F2F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#DFDFE9"
              }
            }
          }
        ],
        "displayArea": [
          {
            "verticalAlignment": "Middle"
          }
        ]
      }
    },
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#DFDFE9"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#323447"
              }
            },
            "checkboxAndApplyColor": {
              "solid": {
                "color": "#15CAB6"
              }
            },
            "headerSize": 10
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#FCFDFE"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#323447"
              }
            },
            "transparency": 0,
            "textSize": 10
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#F1F2F7"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#323447"
              }
            },
            "transparency": 0,
            "textSize": 10
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "transparency": 60
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "show": false,
            "radius": 5
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#F8FAF7"
              }
            },
            "foreground": {
              "solid": {
                "color": "#323447"
              }
            },
            "border": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "transparency": 60
          }
        ],
        "visualTooltip": [
          {
            "titleFontColor": {
              "solid": {
                "color": "#DFDFE9"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#F1F2F7"
              }
            },
            "background": {
              "solid": {
                "color": "#323447"
              }
            }
          }
        ],
        "visualHeaderTooltip": [
          {
            "titleFontColor": {
              "solid": {
                "color": "#DFDFE9"
              }
            },
            "background": {
              "solid": {
                "color": "#323447"
              }
            }
          }
        ],
        "dropShadow": [
          {
            "position": "Outer",
            "show": false,
            "color": {
              "solid": {
                "color": "#CAD4E7"
              }
            }
          }
        ]
      }
    }
  },
  "dataColors": [
    "#A5A5A5",
    "#4F81BD",
    "#FFC000",
    "#E24C4B",
    "#9BBB59",
    "#696CB5",
    "#0F488C",
    "#323447"
  ],
  "textClasses": {
    "label": {
      "fontFace": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "color": "#323447",
      "fontSize": 12
    },
    "callout": {
      "color": "#323447",
      "fontSize": 12,
      "fontFace": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif"
    },
    "title": {
      "color": "#323447",
      "fontFace": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
      "fontSize": 12
    },
    "header": {
      "color": "#323447",
      "fontSize": 12,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif"
    }
  },
  "bad": "#E85E76",
  "neutral": "#CCCCCC",
  "good": "#15CAB6",
  "minimum": "#E85E76",
  "center": "#CCCCCC",
  "maximum": "#15CAB6",
  "foreground": "#323447",
  "background": "#F1F2F7"
}