	column 'Periodo da Semana' =
			SWITCH(
				TRUE,
				ISBLANK('Calendario'[Dia Semana (nome)]),
				"(Blank)",
				'Calendario'[Dia Semana (nome)] IN {"lu.",
					"ma.",
					"mi.",
					"ju.",
					"vi."},
				"Dia de la Semana",
				'Calendario'[Dia Semana (nome)] IN {"Seg",
					"Ter",
					"Qua",
					"Qui",
					"Sex"},
				"Dia de Semana",
				'Calendario'[Dia Semana (nome)] IN {"Dom",
					"Sab"},
				"Fim de Semana",
				'Calendario'[Dia Semana (nome)] IN {"do.",
					"sá."},
				"Fin de Semana",
				'Calendario'[Dia Semana (nome)]
			)
		lineageTag: 92579d6d-ade8-49ab-9c36-7b20ddb6badd
