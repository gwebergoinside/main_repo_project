	column 'Dia Semana LY (nome)' =
			
			VAR _day = WEEKDAY(DATE(YEAR(Calendario[Data])-1,MONTH(Calendario[Data]),DAY(Calendario[Data])))
			RETURN
			--SWITCH(_day, 1,"Dom",2,"Seg",3,"Ter",4,"Qua",5,"Qui",6,"Sex",7,"Sab")
			
			SWITCH(
			    TRUE()
			    ,setuserculture = "es-ES", SWITCH(_day, 1,"do.",2,"lu.",3,"ma.",4,"mi.",5,"ju.",6,"vi.",7,"sa.")
			    ,setuserculture = "pt-PT", SWITCH(_day, 1,"Dom",2,"Seg",3,"Ter",4,"Qua",5,"Qui",6,"Sex",7,"Sab")
			    ,SWITCH(_day, 1,"Dom",2,"Seg",3,"Ter",4,"Qua",5,"Qui",6,"Sex",7,"Sab")
			)
		isHidden
