	column 'Posição Atual' = ```
			
			IF( 
			    Calendario[Ano] = YEAR( NOW() ) && Calendario[Mês (número)] <= month( NOW() )
			    || Calendario[Ano] < YEAR( NOW() ) --&& Calendario[Mês (número)] <= month( NOW() )
			    ,"YTD"
			    ,"Normal"
			    --,Calendario[Mês (nome)]
			)
