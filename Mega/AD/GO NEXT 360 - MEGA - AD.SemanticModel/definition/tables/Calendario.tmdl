	column 'Posição Atual Mes e Dia' = ```
			
			VAR _1 = FORMAT( month( Calendario[Data] ), "00") & FORMAT( DAY( Calendario[Data] ), "00")
			VAR _2 = FORMAT( month( NOW() ), "00") & FORMAT( DAY( NOW() ), "00")
			RETURN
			IF( 
			    CONVERT( _1, INTEGER ) < CONVERT( _2, INTEGER )
			    --|| Calendario[Ano] < YEAR( NOW() ) --&& Calendario[Mês (número)] <= month( NOW() )
			    ,"Sim"
			    ,"Não"
			    --,Calendario[Mês (nome)]
			)
			```
