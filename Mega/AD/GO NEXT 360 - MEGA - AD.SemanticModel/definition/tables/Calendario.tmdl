		annotation SummarizationSetBy = Automatic

	column Semana = ```
			
			VAR Week_start = FORMAT( Calendario[Data] - WEEKDAY('Calendario'[Data],2) +1, "dd/MM/yyyy" )
			VAR Week_end = FORMAT(Calendario[Data] - WEEKDAY(Calendario[Data],2) + 7, "dd/MM/yyyy" )
			RETURN
			Week_start &" 
			 "& Week_end
			```
