	partition Encomendas-748911e9-513d-4cc5-893d-2ee7cc33bd27 = m
		mode: import
		queryGroup: Encomendas
		source = ```
				let
				    Source = Sql.Database(ServerP, BD, [Query="
				set datefirst 1;
				--declare @AlvoCanal int
				--set @AlvoCanal= "&AlvoPadrao&" 
				--declare @durBase int = "&DuracaoBase&" 
				--declare @durBaseOther int = "&DuracaoBaseOther&" 
				
				Select
				    encomendas.ordPubCodigo,
				    encomendas.canCodigo,
				    campanhas.camAnunciante As anuncianteId,
				    campanhas.camEntidadeFacturar As EntidadeFacturarId,
				    campanhas.camCentralCompras As CentralComprasId,
				    campanhas.camDistribuidor As AgenciaMeiosId,
				    campanhas.camAgencia As AgenciaId,
				    campanhas.camDescricao As DescricaoCampanhas,
				    ordemPub.proId,
				    Case
				        When IsNull(ordemPub.ordPubNegociacao, 0) = 0
				        Then Null
				        Else ordemPub.ordPubNegociacao
				    End As ordPubNegociacao,
				    encomendas.greComHoraInicio As horaExib,
				    encomendas.encDataExibicao As diaExib,
				    'E' As tipo,
				    campanhas.camVendedor As vendedor,
				    IsNull(encomendas.encValorPub, 0) As valorPub,
				    IsNull(encomendas.encValorTab, 0) As valorTab,
				    IsNull(encomendas.encValorBonus, 0) As valorBonus,
					0 As Impressoes, --[QtdImpressões]
				    Pacotes.pacId,
				    --IsNull(encomendas.encValorPub, 0) * (IsNull(campanhas.camDescontoAgencia, 0) / 100) As valorComissaoAgencia,
				    --IsNull(EncomendasAudiencias.encRating, IsNull(aud_prev_faixa.Rating, 0)) As grpPrevisto,
				    --0 As grpReal,
				    --indiceeq.ratValor As indice_equi,
				    --indiceeqOther.ratValor As indice_equiOther,
				    encomendas.encMaterialDuracaoEmissao As durEmissao,
				    ordemPub.ordPubClaId,
				    encomendas.bonId,
				    ordemPub.tipPubId,
				    encomendas.priId As PrioridadeId,
				    tipoPublicidade.tipEcrIdOcupacao As tipoOcupacao,
				    --aud_alvos.cod_alvo,
				    Case ordemPub.ordPubFlagFixo
				        When 2
				        Then negPeriodos.negPerTipo
				        When 1
				        Then 'V'
				        Else 'D'
				    End As negPerTipo,
				    ordemPub.ordPubFlagValorBrutoVendas,
				    ordemPub.ordPubFlagValorLiquidoVendas,
				    encomendas.greComId,
				    campanhas.camGrupoId,
					ordempub.ordpubreferencia,
					IsNull(ordemPub.ordPubDescontoGlobal, 0) As Desconto,
					ROUND((isnull(encomendas.encvalorpub,0)*(isnull(ordempub.IPC,0)/100)),4) As ValorDifusao,
					ordempub.ordpubobs As Observacoes,
					ordempub.ordpubobsfact As ObservacoesFatura,
					encomendas.tipForFaixaId
				From
				    encomendas With(NoLock) 
					Inner Join ordemPub With(NoLock) On encomendas.ordPubCodigo = ordemPub.ordPubCodigo 
					Left Join tipoPublicidade With(NoLock) On tipoPublicidade.tipPubId = ordemPub.tipPubId 
					Left Join pacotes With(NoLock) On ordemPub.pacId = Pacotes.pacId 
					Left Outer Join encomendasAudiencias EncomendasAudiencias With(NoLock) On EncomendasAudiencias.encId = encomendas.encid
				    Left Outer Join campanhas With(NoLock) On campanhas.camId = ordemPub.camId 
					Left Outer Join negPeriodos With(NoLock) On negPeriodos.negPerId = ordemPub.ordPubNegociacao 
				 --	Left Outer Join ratingsTabela indiceeq With(NoLock) On (IsNull(indiceeq.canCodigo, 0) = 0
				 --               Or indiceeq.canCodigo = ordemPub.canCodigo)
				 --           And indiceeq.ratDuracaoIntermed = encomendas.encMaterialDuracaoFacturacao
				 --           And indiceeq.ratDuracaoBase = @durBase
				 --           And encomendas.encDataExibicao Between indiceeq.ratDataInicio And indiceeq.ratDataFim 
					--Left Join ratingsTabela indiceeq2030 With(NoLock) On (IsNull(indiceeq2030.canCodigo, 0) = 0
				 --               Or indiceeq2030.canCodigo = ordemPub.canCodigo)
				 --           And indiceeq2030.ratDuracaoBase = @durBase
				 --           And indiceeq2030.ratDuracaoIntermed = 30
				 --           And encomendas.encDataExibicao Between indiceeq2030.ratDataInicio And indiceeq2030.ratDataFim
				 --   Left Outer Join ratingsTabela indiceeqOther With(NoLock) On (IsNull(indiceeqOther.canCodigo, 0) = 0
				 --               Or indiceeqOther.canCodigo = ordemPub.canCodigo)
				 --           And indiceeqOther.ratDuracaoIntermed = encomendas.encMaterialDuracaoFacturacao
				 --           And indiceeqOther.ratDuracaoBase = @durBaseOther
				 --           And encomendas.encDataExibicao Between indiceeqOther.ratDataInicio And indiceeqOther.ratDataFim 
					--Left Join ratingsTabela indiceeq2030Other With(NoLock) On (IsNull(indiceeq2030Other.canCodigo, 0) = 0
				 --               Or indiceeq2030Other.canCodigo = ordemPub.canCodigo)
				 --           And indiceeq2030Other.ratDuracaoBase = @durBaseOther
				 --           And indiceeq2030Other.ratDuracaoIntermed = 30
				 --           And encomendas.encDataExibicao Between indiceeq2030Other.ratDataInicio And indiceeq2030Other.ratDataFim
				 --   Left Join aud_alvos With(NoLock) On aud_alvos.cod_alvo = IsNull(ordemPub.codAlvo, @AlvoCanal) 
					--Left Join aud_prev_faixa With(NoLock) On aud_prev_faixa.Cod_Alvo = aud_alvos.cod_alvo
				 --           And aud_prev_faixa.CanCodigo = encomendas.canCodigo
				 --           And encomendas.encDataExibicao >= aud_prev_faixa.dataInicio
				 --           And (encomendas.encDataExibicao < aud_prev_faixa.dataFim
				 --               Or aud_prev_faixa.dataFim Is Null)
				 --           And encomendas.greComHoraInicio >= aud_prev_faixa.horaInicio
				 --           And encomendas.greComHoraInicio < aud_prev_faixa.horaFim
				 --           And DatePart(dw, encomendas.encDataExibicao) + 1 = aud_prev_faixa.DiaSemId
				Where
				    Year(encomendas.encDataExibicao) >= Year(GetDate()) - "&AnoUpdate&"
				Union All
				Select
				    encomendasExibidas.ordPubCodigo,
				    encomendasExibidas.canCodigo,
				    campanhas.camAnunciante As anuncianteId,
				    campanhas.camEntidadeFacturar As EntidadeFacturarId,
				    campanhas.camCentralCompras As CentralComprasId,
				    campanhas.camDistribuidor As AgenciaMeiosId,
				    campanhas.camAgencia As AgenciaId,
				    campanhas.camDescricao As DescricaoCampanhas,
				    ordemPub.proId,
				    Case
				        When IsNull(ordemPub.ordPubNegociacao, 0) = 0
				        Then Null
				        Else ordemPub.ordPubNegociacao
				    End As ordPubNegociacao,
				    encomendasExibidas.greComHoraInicio As horaExib,
				    encomendasExibidas.encDataExibicao As diaExib,
				    'E' As tipo,
				    campanhas.camVendedor As vendedor,
				    IsNull(encomendasExibidas.encValorPub, 0) As valorPub,
				    IsNull(encomendasExibidas.encValorTab, 0) As valorTab,
				    IsNull(encomendasExibidas.encValorBonus, 0) As valorBonus,
					0 As Impressoes,
				    Pacotes.pacId,
				    --IsNull(encomendasExibidas.encValorPub, 0) * (IsNull(campanhas.camDescontoAgencia, 0) / 100) As valorComissaoAgencia,
				    --IsNull(aud_prev_faixa.Rating, 0) As grpPrevisto,
				    --IsNull(EncomendasAudiencias.encRating, IsNull(aud_exib_id.audiencia, 0)) As grpReal,
				    --indiceeq.ratValor As indice_equi,
				    --indiceeqOther.ratValor As indice_equiOther,
				    encomendasExibidas.encMaterialDuracaoEmissao As durEmissao,
				    ordemPub.ordPubClaId,
				    encomendasExibidas.bonId,
				    ordemPub.tipPubId,
				    encomendasExibidas.priId As PrioridadeId,
				    tipoPublicidade.tipEcrIdOcupacao As tipoOcupacao,
				    --aud_alvos.cod_alvo,
				    Case ordemPub.ordPubFlagFixo
				        When 2
				        Then negPeriodos.negPerTipo
				        When 1
				        Then 'V'
				        Else 'D'
				    End As negPerTipo,
				    ordemPub.ordPubFlagValorBrutoVendas,
				    ordemPub.ordPubFlagValorLiquidoVendas,
				    encomendasExibidas.greComId,
				    campanhas.camGrupoId,
					ordempub.ordpubreferencia,
					IsNull(ordemPub.ordPubDescontoGlobal, 0) As Desconto,
					ROUND((isnull(encomendasexibidas.encvalorpub,0)*(isnull(ordempub.IPC,0)/100)),4) As ValorDifusao,
					ordempub.ordpubobs As Observacoes,
					ordempub.ordpubobsfact As ObservacoesFatura,
					encomendasExibidas.tipForFaixaId
				From
				    encomendasExibidas With(NoLock) 
					Inner Join ordemPub With(NoLock) On encomendasExibidas.ordPubCodigo = ordemPub.ordPubCodigo 
					Left Join tipoPublicidade With(NoLock) On tipoPublicidade.tipPubId = ordemPub.tipPubId 
					Left Join pacotes With(NoLock) On ordemPub.pacId = Pacotes.pacId 
					Left Outer Join encomendasAudiencias EncomendasAudiencias With(NoLock) On EncomendasAudiencias.encId = encomendasExibidas.encId
				            And EncomendasAudiencias.audPaiId = 1 
					Left Outer Join campanhas With(NoLock) On campanhas.camId = ordemPub.camId 
					Left Outer Join negPeriodos With(NoLock) On negPeriodos.negPerId = ordemPub.ordPubNegociacao 
					--Left Outer Join ratingsTabela indiceeq With(NoLock) On (IsNull(indiceeq.canCodigo, 0) = 0
				 --               Or indiceeq.canCodigo = ordemPub.canCodigo)
				 --           And indiceeq.ratDuracaoIntermed = encomendasExibidas.encMaterialDuracaoFacturacao
				 --           And indiceeq.ratDuracaoBase = @durBase
				 --           And encomendasExibidas.encDataExibicao Between indiceeq.ratDataInicio And indiceeq.ratDataFim 
					--Left Join ratingsTabela indiceeq2030 With(NoLock) On (IsNull(indiceeq2030.canCodigo, 0) = 0
				 --               Or indiceeq2030.canCodigo = ordemPub.canCodigo)
				 --           And indiceeq2030.ratDuracaoBase = @durBase
				 --           And indiceeq2030.ratDuracaoIntermed = 30
				 --           And encomendasExibidas.encDataExibicao Between indiceeq2030.ratDataInicio And indiceeq2030.ratDataFim
				 --   Left Outer Join
				 --   ratingsTabela indiceeqOther With(NoLock) On (IsNull(indiceeqOther.canCodigo, 0) = 0
				 --               Or indiceeqOther.canCodigo = ordemPub.canCodigo)
				 --           And indiceeqOther.ratDuracaoIntermed = encomendasExibidas.encMaterialDuracaoFacturacao
				 --           And indiceeqOther.ratDuracaoBase = @durBaseOther
				 --           And encomendasExibidas.encDataExibicao Between indiceeqOther.ratDataInicio And indiceeqOther.ratDataFim
				 --   Left Join
				 --   ratingsTabela indiceeq2030Other With(NoLock) On (IsNull(indiceeq2030Other.canCodigo, 0) = 0
				 --               Or indiceeq2030Other.canCodigo = ordemPub.canCodigo)
				 --           And indiceeq2030Other.ratDuracaoBase = @durBaseOther
				 --           And indiceeq2030Other.ratDuracaoIntermed = 30
				 --           And encomendasExibidas.encDataExibicao Between indiceeq2030Other.ratDataInicio And
				 --           indiceeq2030Other.ratDataFim Left Join
				 --   aud_alvos With(NoLock) On aud_alvos.cod_alvo = IsNull(ordemPub.codAlvo, @AlvoCanal) 
					--Left Join  aud_prev_faixa With(NoLock) On aud_prev_faixa.CanCodigo = encomendasExibidas.canCodigo
				 --           And DatePart(dw, encomendasExibidas.encDataExibicao) + 1 = aud_prev_faixa.DiaSemId
				 --           And aud_prev_faixa.Cod_Alvo = aud_alvos.cod_alvo
				 --           And encomendasExibidas.encDataExibicao >= aud_prev_faixa.dataInicio
				 --           And (encomendasExibidas.encDataExibicao < aud_prev_faixa.dataFim
				 --               Or aud_prev_faixa.dataFim Is Null)
				 --           And encomendasExibidas.greComHoraInicio >= aud_prev_faixa.horaInicio
				 --           And encomendasExibidas.greComHoraInicio < aud_prev_faixa.horaFim 
					--Left Join aud_alinhamento_publicidade With(NoLock) On aud_alinhamento_publicidade.encId = encomendasExibidas.encId
				 --           And aud_alinhamento_publicidade.spoAutId = 0 
					--Left Join  aud_rel_alinhamento_publicidade With(NoLock) On aud_rel_alinhamento_publicidade.id_pub =
				 --           aud_alinhamento_publicidade.id_pub 
					--Left Join aud_exib With(NoLock) On aud_exib.id_exib = aud_rel_alinhamento_publicidade.id_pubreport 
					--Left Join aud_exib_id With(NoLock) On aud_exib_id.id_exib = aud_exib.id_exib
				 --           And aud_exib_id.cod_alvo = aud_alvos.cod_alvo
				Where
				    Year(encomendasExibidas.encDataExibicao) >= Year(GetDate()) - "&AnoUpdate&" 
				Union All
				Select
				    ordemPub.ordPubCodigo,
				    ordemPub.canCodigo,
				    campanhas.camAnunciante As anuncianteId,
				    campanhas.camEntidadeFacturar As EntidadeFacturarId,
				    campanhas.camCentralCompras As CentralComprasId,
				    campanhas.camDistribuidor As AgenciaMeiosId,
				    campanhas.camAgencia As AgenciaId,
				    campanhas.camDescricao As DescricaoCampanhas,
				    ordemPub.proId,
				    Case
				        When IsNull(ordemPub.ordPubNegociacao, 0) = 0
				        Then Null
				        Else ordemPub.ordPubNegociacao
				    End As ordPubNegociacao,
				    0 As horaExib,
				    Cast(Convert(VARCHAR,ordemPub.ordPubAno) + '-' + Convert(VARCHAR,ordemPub.ordPubMes) + '-' + Convert(VARCHAR,1) As
				    DATETIME) As diaExib,
				    'O' As tipo,
				    campanhas.camVendedor As vendedor,
				    IsNull(ordemPub.ordPubValor, 0) As valorPub,
				    IsNull(ordemPub.ordPubValorTab, 0) As valorTab,
				    IsNull(ordemPub.valorBonus, 0) As valorBonus,
					IsNull(ordemPub.ordPubTotalGRPs, 0) As Impressoes,
				    Pacotes.pacId,
				    --IsNull(ordemPub.ordPubValor, 0) * (IsNull(campanhas.camDescontoAgencia, 0) / 100) As valorComissaoAgencia,
				    --0 As grpPrevisto,
				    --0 As grpReal,
				    --0 As indice_equi,
				    --0 As indice_equiOther,
				    0 As durEmissao,
				    ordemPub.ordPubClaId,
				    ordemPub.ordPubBonus As bonId,
				    ordemPub.tipPubId,
				    ordemPub.priId As PrioridadeId,
				    tipoPublicidade.tipEcrIdOcupacao As tipoOcupacao,
				    --aud_alvos.cod_alvo,
				    Case ordemPub.ordPubFlagFixo
				        When 2
				        Then negPeriodos.negPerTipo
				        When 1
				        Then 'V'
				        Else 'D'
				    End As negPerTipo,
				    ordemPub.ordPubFlagValorBrutoVendas,
				    ordemPub.ordPubFlagValorLiquidoVendas,
				    Null As greComId,
				    campanhas.camGrupoId,
					ordempub.ordpubreferencia,
					IsNull(ordemPub.ordPubDescontoGlobal, 0) As Desconto,
					ROUND((isnull(ordemPub.ordPubValor,0)*(isnull(ordempub.IPC,0)/100)),4) As ValorDifusao,
					ordempub.ordpubobs As Observacoes,
					ordempub.ordpubobsfact As ObservacoesFatura,
					Null as tipForFaixaId
				From
				    ordemPub With(NoLock) 
					Left Outer Join campanhas With(NoLock) On campanhas.camId = ordemPub.camId 
					Left Join tipoPublicidade With(NoLock) On tipoPublicidade.tipPubId = ordemPub.tipPubId 
					Left Join pacotes With(NoLock) On ordemPub.pacId = Pacotes.pacId 
					--Left Join aud_alvos With(NoLock) On aud_alvos.cod_alvo = IsNull(ordemPub.codAlvo, @AlvoCanal) 
					Left Join negPeriodos With(NoLock) On negPeriodos.negPerId = ordemPub.ordPubNegociacao
				Where
				    ordemPub.ordPubAno >= Year(GetDate()) - "&AnoUpdate&" And
				    ordemPub.ordPubCodigo Not In (Select
				         e.ordPubCodigo
				     From
				         encomendas e With(NoLock)
				     Where
				         e.ordPubCodigo = ordemPub.ordPubCodigo
				     Group By
				         e.ordPubCodigo
				     Union
				     Select
				         e.ordPubCodigo
				     From
				         encomendasExibidas e With(NoLock)
				     Where
				         e.ordPubCodigo = ordemPub.ordPubCodigo
				     Group By
				         e.ordPubCodigo
				     Union
				     Select
				         e.ordPubCodigo
				     From
				         encomendasExcepcoes e With(NoLock)
				     Where
				         IsNull(e.encValorPub, 0) <> 0 And
				         e.ordPubCodigo = ordemPub.ordPubCodigo
				     Group By
				         e.ordPubCodigo)
				Union All
				Select
				    encomendas.ordPubCodigo,
				    encomendas.canCodigo,
				    campanhas.camAnunciante As anuncianteId,
				    campanhas.camEntidadeFacturar As EntidadeFacturarId,
				    campanhas.camCentralCompras As CentralComprasId,
				    campanhas.camDistribuidor As AgenciaMeiosId,
				    campanhas.camAgencia As AgenciaId,
				    campanhas.camDescricao As DescricaoCampanhas,
				    ordemPub.proId,
				    Case
				        When IsNull(ordemPub.ordPubNegociacao, 0) = 0
				        Then Null
				        Else ordemPub.ordPubNegociacao
				    End As ordPubNegociacao,
				    encomendas.greComHoraInicio As horaExib,
				    encomendas.encDataExibicao As diaExib,
				    'X' As tipo,
				    campanhas.camVendedor As vendedor,
				    IsNull(encomendas.encValorPub, 0) As valorPub,
				    IsNull(encomendas.encValorTab, 0) As valorTab,
				    0 As valorBonus,
					0 As Impressoes,
				    Pacotes.pacId,
				    --IsNull(encomendas.encValorPub, 0) * (IsNull(campanhas.camDescontoAgencia, 0) / 100) As valorComissaoAgencia,
				    --IsNull(EncomendasAudiencias.encRating, IsNull(aud_prev_faixa.Rating, 0)) As grpPrevisto,
				    --0 As grpReal,
				    --indiceeq.ratValor As indice_equi,
				    --indiceeqOther.ratValor As indice_equiOther,
				    encomendas.encMaterialDuracaoEmissao As durEmissao,
				    ordemPub.ordPubClaId,
				    encomendas.bonId,
				    ordemPub.tipPubId,
				    encomendas.priId As PrioridadeId,
				    tipoPublicidade.tipEcrIdOcupacao As tipoOcupacao,
				    --aud_alvos.cod_alvo,
				    Case ordemPub.ordPubFlagFixo
				        When 2
				        Then negPeriodos.negPerTipo
				        When 1
				        Then 'V'
				        Else 'D'
				    End As negPerTipo,
				    ordemPub.ordPubFlagValorBrutoVendas,
				    ordemPub.ordPubFlagValorLiquidoVendas,
				    encomendas.greComId,
				    campanhas.camGrupoId,
					ordempub.ordpubreferencia,
					IsNull(ordemPub.ordPubDescontoGlobal, 0) As Desconto,
					ROUND((isnull(encomendas.encValorPub,0)*(isnull(ordempub.IPC,0)/100)),4) As ValorDifusao,
					ordempub.ordpubobs As Observacoes,
					ordempub.ordpubobsfact As ObservacoesFatura,
					encomendas.tipForFaixaId
				From
				    encomendasExcepcoes encomendas With(NoLock) 
					Inner Join ordemPub With(NoLock) On encomendas.ordPubCodigo = ordemPub.ordPubCodigo 
					Left Join tipoPublicidade With(NoLock) On tipoPublicidade.tipPubId = ordemPub.tipPubId 
					Left Join pacotes With(NoLock) On ordemPub.pacId = Pacotes.pacId 
					Left Outer Join grelhaComercial With(NoLock) On grelhaComercial.greComId = encomendas.greComId 
					Left Outer Join encomendasAudiencias EncomendasAudiencias With(NoLock) On EncomendasAudiencias.encId = encomendas.encId
				    Left Outer Join campanhas With(NoLock) On campanhas.camId = ordemPub.camId
					Left Outer Join negPeriodos With(NoLock) On negPeriodos.negPerId = ordemPub.ordPubNegociacao 
					--Left Outer Join ratingsTabela indiceeq With(NoLock) On (IsNull(indiceeq.canCodigo, 0) = 0
				 --               Or indiceeq.canCodigo = ordemPub.canCodigo)
				 --           And indiceeq.ratDuracaoIntermed = encomendas.encMaterialDuracaoFacturacao
				 --           And indiceeq.ratDuracaoBase = @durBase
				 --           And encomendas.encDataExibicao Between indiceeq.ratDataInicio And indiceeq.ratDataFim 
					--Left Join ratingsTabela indiceeq2030 With(NoLock) On (IsNull(indiceeq2030.canCodigo, 0) = 0
				 --               Or indiceeq2030.canCodigo = ordemPub.canCodigo)
				 --           And indiceeq2030.ratDuracaoBase = @durBase
				 --           And indiceeq2030.ratDuracaoIntermed = 30
				 --           And encomendas.encDataExibicao Between indiceeq2030.ratDataInicio And indiceeq2030.ratDataFim
				 --   Left Outer Join ratingsTabela indiceeqOther With(NoLock) On (IsNull(indiceeqOther.canCodigo, 0) = 0
				 --               Or indiceeqOther.canCodigo = ordemPub.canCodigo)
				 --           And indiceeqOther.ratDuracaoIntermed = encomendas.encMaterialDuracaoFacturacao
				 --           And indiceeqOther.ratDuracaoBase = @durBaseOther
				 --           And encomendas.encDataExibicao Between indiceeqOther.ratDataInicio And indiceeqOther.ratDataFim 
					--Left Join ratingsTabela indiceeq2030Other With(NoLock) On (IsNull(indiceeq2030Other.canCodigo, 0) = 0
				 --               Or indiceeq2030Other.canCodigo = ordemPub.canCodigo)
				 --           And indiceeq2030Other.ratDuracaoBase = @durBaseOther
				 --           And indiceeq2030Other.ratDuracaoIntermed = 30
				 --           And encomendas.encDataExibicao Between indiceeq2030Other.ratDataInicio And indiceeq2030Other.ratDataFim
				 --   Left Join aud_alvos With(NoLock) On aud_alvos.cod_alvo = IsNull(ordemPub.codAlvo, @AlvoCanal) 
					--Left Join aud_prev_faixa With(NoLock) On aud_prev_faixa.Cod_Alvo = aud_alvos.cod_alvo
				 --           And aud_prev_faixa.CanCodigo = encomendas.canCodigo
				 --           And encomendas.encDataExibicao >= aud_prev_faixa.dataInicio
				 --           And (encomendas.encDataExibicao < aud_prev_faixa.dataFim
