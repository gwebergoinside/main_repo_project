	column 'Data Exibição' = ```
			
			VAR _1 =
			TIME(
			    INT(DIVIDE(Encomendas[MinutosExib], 60)),  // Obtém as horas a partir dos minutos
			    MOD(Encomendas[MinutosExib], 60),     // Obtém os minutos restantes após a conversão para horas
			    0                  // Defina os segundos como zero
			)
			VAR _2 = Encomendas[diaExib]
			VAR _3 = _2 + _1 
			RETURN
			_3
			```
