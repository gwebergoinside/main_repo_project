		summarizeBy: none
		isNameInferred
		sourceColumn: Encomendas[negPerTipo]

		annotation SummarizationSetBy = Automatic

	column 'Tipo Negociação' =
			
			SWITCH(
			    TRUE()
			    ,SetUserCulture = "pt-PT",
			
			SWITCH(
			    TRUE()
			    ,[negPerTipo] = "F" , "Desconto"
			    ,[negPerTipo] = "G" , "GRP"
			    ,[negPerTipo] = "T" , "Tabela"
			    ,[negPerTipo] = "D" , "Desconto"
			    ,[negPerTipo] = "V" , "Valor Fixo"
			    ,[negPerTipo] = BLANK(), "Outros"
			)
			
			    ,SetUserCulture = "es-ES",
			
			SWITCH(
			    TRUE()
			    ,[negPerTipo] = "F" , "Descuento"
			    ,[negPerTipo] = "G" , "GRP"
			    ,[negPerTipo] = "T" , "Tabla"
			    ,[negPerTipo] = "D" , "Descuento"
			    ,[negPerTipo] = "V" , "Valor Fijo"
			    ,[negPerTipo] = BLANK(), "Otros"
			))
		lineageTag: a5813d52-c416-4bfa-8e22-3e266df8b6c8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition TipoNeg-1f099ba6-131f-478e-a379-a0983f31c1a7 = calculated
		mode: import
		source = FILTER( SUMMARIZE(Encomendas, Encomendas[negPerTipo]), Encomendas[negPerTipo] <> BLANK() )

