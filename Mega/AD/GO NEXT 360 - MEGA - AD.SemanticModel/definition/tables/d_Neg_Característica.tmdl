				    Source = Sql.Database(ServerP, BD, [Query="Select#(lf)    caracteristica.negId,#(lf)    caracteristica.carHoraInicio,#(lf)    caracteristica.carHoraFim,#(lf)    caracteristica.carValor,#(lf)    caracteristica.carTipoItem,#(lf)    caracteristica.carDias,#(lf)    caracteristica.carDataInicio,#(lf)    caracteristica.carDataFim,#(lf)    caracteristica.tipPubId,#(lf)    caracteristica.tipEcrId,#(lf)    caracteristica.carEcrCodigo,#(lf)    caracteristica.priId,#(lf)    negociacao.negPerId#(lf)From#(lf)    caracteristica Inner Join#(lf)    negociacao On caracteristica.negId = negociacao.negId"])
