	measure 'Receita Var €_Comparativo' = ```
			
			VAR _val1 = ROUND(SUM( 'Variacao Receita'[ValorPub] ),0) //Valor da data inicial
			//VAR _val2 = CALCULATE( ROUND(CALCULATE( SUM( 'Variacao Receita'[sumValorPub] ), PREVIOUSDAY( 'Variacao Receita'[data_carregamento] ) ),0))
			//var _result = _val1-_val2
			var _3 = CALCULATE(ROUND(CALCULATE( SUM( 'Variacao Receita'[ValorPub] ), ALL(Calendario[Data]), USERELATIONSHIP(Calendario[Data],'Calendario comparativo'[Date])),0)) * [Normalization Factor] //Valor da data comparativa 
			var _result2 = _val1-_3
			var _c = SELECTEDVALUE('calendario comparativo'[date])
			var _i = SELECTEDVALUE('Calendario'[Data])
			
			RETURN
			
			IF(_result2 =0, BLANK(),
			            IF.EAGER( _c > _i , _3 - _val1 , 
			                     _val1-_3 ) )
			
