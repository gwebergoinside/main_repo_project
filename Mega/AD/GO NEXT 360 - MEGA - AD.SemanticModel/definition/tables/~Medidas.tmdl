			--Var __blank = SUM( GMediaBI_Encomendas[GRP Equivalente]) <> BLANK() && SUM(GMediaBI_Encomendas[GRP Previsto Equivalente]) <> BLANK()
			RETURN
			IF( __Ocu = __OcuLY , 0 , 
			IF( __Ocu > __OcuLY , 1 , 2 ) )
