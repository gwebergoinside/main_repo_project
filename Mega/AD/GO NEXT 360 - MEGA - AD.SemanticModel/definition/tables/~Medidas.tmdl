	measure 'Ocupação Normal (HH:MM:SS)' = ```
			
			VAR _00 = 
			--CALCULATE( DIVIDE( SUM( Ocupacao[OcupacaoNormal] ), [QTD Spots] ) )
			--CALCULATE( DIVIDE( SUM( Ocupacao[OcupacaoNormal] ), DISTINCTCOUNT( Ocupacao[DataFaixaHoraria] ) ), Ocupacao[NumeroSpots] > 0 )
			--CALCULATE( DIVIDE( SUM( Ocupacao[OcupacaoNormal] ), DISTINCTCOUNT( Ocupacao[DayPart Ocupação] ) ), Ocupacao[NumeroSpots] > 0 )
			--CALCULATE( AVERAGE( Ocupacao[OcupacaoNormal] ) )
			--AVERAGEX( VALUES( Anunciante[Anunciante] ), CALCULATE( SUM( Ocupacao[OcupacaoNormal] ) ) )
			CALCULATE( SUM( Ocupacao[OcupacaoNormal] ) )
			VAR _0 = IF( _00 = 0, BLANK(), _00 )
			VAR _1 =
			IF( 
			    _0 = 0, BLANK(),
			    _0
			)
			VAR _Dias = INT(_1 / 86400) // 86400 segundos em um dia (24 * 60 * 60)
			VAR _Horas = INT ( _0 / 3600)
			VAR _Minutos = INT ( MOD( _0 - ( _Horas * 3600 ),3600 ) / 60)
			VAR _Segundos = ROUNDUP(MOD ( MOD( _0 - ( _Horas * 3600 ),3600 ), 60 ),0 )
			VAR _Formato = _Horas * 10000 + _minutos * 100 + _segundos
			RETURN
			IF( 
			    _Formato = 0, BLANK(),
			    _Formato
			)
			```
		formatString: 00:00:00
		displayFolder: Ocupação
		lineageTag: 0feca18e-77c5-4afc-9c63-262faf4a9b58

		annotation PBI_FormatHint = {"isCustom":true}

