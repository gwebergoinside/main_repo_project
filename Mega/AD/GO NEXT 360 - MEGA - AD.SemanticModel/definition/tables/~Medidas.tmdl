	measure 'Bonus Var €_Comparativo' =
			
			VAR _val1 =
			    ROUND ( SUM ( 'Variacao Receita'[ValorBonus] ), 0 ) //Valor da data inicial
			VAR _3 =
			    CALCULATE (
			        ROUND (
			            CALCULATE (
			                SUM ( 'Variacao Receita'[ValorBonus] ),
			                ALL ( Calendario[Data] ),
			                USERELATIONSHIP ( Calendario[Data], 'Calendario comparativo'[Date] )
			            ),
			            0
			        )
			    ) * [Normalization Factor]
			VAR _result2 = _val1 - _3
			VAR _c =
			    SELECTEDVALUE ( 'calendario comparativo'[date] )
			VAR _i =
			    SELECTEDVALUE ( 'Calendario'[Data] )
			RETURN
			    IF ( _result2 = 0, BLANK (), IF.EAGER ( _c > _i, _3 - _val1, _val1 - _3 ) )
