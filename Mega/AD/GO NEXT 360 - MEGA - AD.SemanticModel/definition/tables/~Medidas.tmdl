	measure 'Receita % YTD (AY-LY Ytd)' = ```
			
			CALCULATE( 
			    DIVIDE([Receita YTD Atual Month] - [Receita LY YTD Atual Month],[Receita LY YTD Atual Month] )
			    ,Calendario[Posição Atual] = "YTD"
			)
