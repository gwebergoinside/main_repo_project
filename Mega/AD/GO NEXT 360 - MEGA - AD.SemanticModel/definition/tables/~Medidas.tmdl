	measure 'Titulo_Ganhos Perdidos' = ```
			
			vAR _1 = concatenatex(SUMMARIZE('Calendario','Calendario'[Mês (nome)]), 'Calendario'[Mês (nome)],", " )
			vAR _12 = MIN('Calendario'[Mês (número)])
			VAR _11 = MONTH(now())
