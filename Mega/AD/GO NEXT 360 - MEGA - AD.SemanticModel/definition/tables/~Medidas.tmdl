			VAR _dem = SUMX(SUMMARIZE(Ocupacao, Calendario[Dia mês (número)], Canais[Canal], Ocupacao[BandaHoraria]), IF([Filtro Simulador % Ocup Banda] = 1 && [Filtro Simulador Dur Ocup Banda] = 1, [Canal Max Normal], BLANK()))
