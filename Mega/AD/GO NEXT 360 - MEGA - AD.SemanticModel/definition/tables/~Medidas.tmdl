			   "es-ES", 
			            IF.EAGER( ISFILTERED('Calendario'[Mês (nome)])
			    ,"Ganados y Perdidos (" & _1 & ")"
			    ,CALCULATE( [Titulo], Titulos[ID] = 10 ) & " (" & SWITCH(
			    _12
			    ,1,"Ene",2,"Feb",3,"Mar",4,"Abr",5,"May",6,"Jun",7,"Jul",8,"Ago",9,"Sep",10,"Oct",11,"Nov",12,"Dic") & " - " & SWITCH(
			    _11
			    ,1,"Ene",2,"Feb",3,"Mar",4,"Abr",5,"May",6,"Jun",7,"Jul",8,"Ago",9,"Sep",10,"Oct",11,"Nov",12,"Dic") & ")"
			) , -- bruto,
