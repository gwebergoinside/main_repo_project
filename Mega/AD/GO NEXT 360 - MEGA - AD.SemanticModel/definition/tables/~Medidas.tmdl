	measure Receita =
			
			VAR _1 =
			SWITCH([Selected SalesParameter],
			    1, CALCULATE( SUM(Encomendas[Valor Publicidade Bruto]) , Encomendas[ordPubClaId] <> 2 ), -- [Desconto das Taxas],
			    3, [Valor Faturado Total] --CALCULATE( SUM('Faturação'[valorFaturado]) - sum(Encomendas[valorComissaoAgencia] ) - [ValorRappel_Atual] )
			)
			RETURN
			IF( _1 = 0, BLANK(), _1 )
		displayFolder: Receita
		lineageTag: f9393cd9-2227-4a62-9a4d-f64a3591c69d

		formatStringDefinition =
				VAR _Realizado = [Receita]
				VAR _SelectDisplay =
				SWITCH(
				    TRUE()
				    ,_Realizado < 1000, "$0"
				    ,_Realizado >= 1000 && _Realizado < 1000000, "$#,.#K"
				    ,_Realizado >= 1000000, "$#,,.#M"
				)
				RETURN
				_SelectDisplay
				// ""R$" #,0.00;-"R$" #,0.00;"R$" #,0.00"

		changedProperty = FormatString

