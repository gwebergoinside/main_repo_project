	measure 'Gauge End Receita' =
			
			VAR SourceMeasure = [Receita] //Actual value
			VAR TargetMeasure = [Objetivo] //Target value (end of the yellow zone)
			VAR RedZoneMeasure = [Objetivo]*0.5 //Minimum target value (end of the red zone)
			VAR MaxValue = SWITCH(TRUE(),SourceMeasure>TargetMeasure,SourceMeasure*1.2,TargetMeasure*1.2) //Defines max value of the scale
			
			Return
			
			MaxValue
		displayFolder: Gauge
		lineageTag: 48e89eb9-51fd-4cd1-94d1-5fca37678954

