			VAR RedZoneMeasure =  [Objetivo YTD Atual Month]*0.5 --[Objetivo liq YTD Atual Month]*0.5 //Minimum target value (end of the red zone)
			VAR MaxValue = SWITCH(TRUE(),SourceMeasure>TargetMeasure,SourceMeasure*1.2,TargetMeasure*1.2) //Defines max value of the scale
			Return
			TargetMeasure
		isHidden
		displayFolder: Gauge
		lineageTag: 8b4bfa50-fc8e-4288-86e4-fc277b1cf1c6

