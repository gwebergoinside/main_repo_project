	measure 'Receita Dia LY aux' = ```
			
			IF( 
			    SELECTEDVALUE( 'Encomendas'[Tipo de Encomenda] ) = "AE"
			    ,[Receita LY]
			    ,CALCULATE([Receita LY]
			        ,FILTER(ALL(Calendario)
			            ,YEAR(Calendario[Data]) = SELECTEDVALUE(Calendario[Ano LY (número)])
			            --&& MONTH(Calendario[Data]) = SELECTEDVALUE(Calendario[Mês (número)])
			            --&& WEEKDAY(Calendario[Data],1) = SELECTEDVALUE(Calendario[Dia Semana (número)]) 
			            --&& DAY(Calendario[Data]) = SELECTEDVALUE(Calendario[Dia LY])
			            && MONTH(Calendario[Data]) = SELECTEDVALUE(Calendario[Mês LY (número)])
			            && DAY(Calendario[Data]) = SELECTEDVALUE(Calendario[Dia LY (número)])
			
			        )
			    )
			)
			```
		displayFolder: Receita
		lineageTag: 56a14446-50d9-46cb-adc9-4af72b111950

	measure 'Receita Dia LY' =
			
