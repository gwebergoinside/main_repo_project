	measure 'Objetivo YTD % Atual Month' = ```
			--([Receita YTD Atual Month]/[Objetivo YTD Atual Month])-1
			
			--if ([Objetivo YTD Atual Month]=0, 
			--if([Receita YTD Atual Month]=0,BLANK(),1) , (DIVIDE([Receita YTD Atual Month],[Objetivo YTD Atual Month])-1))
			DIVIDE([Receita YTD Atual Month]-[Objetivo YTD Atual Month],[Objetivo YTD Atual Month])
