table 'Agencia Meios'
	lineageTag: 6270275f-2ef5-45d3-86f5-0083d3a0b8b3

	column entId
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c2253b57-42c0-46a6-9f0d-b5609320792f
		summarizeBy: none
		sourceColumn: entId

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Agência Meios C/ Encomendas' = ```
			
			VAR _1 =
			CALCULATE(
			    YEAR( MAX( Encomendas[Data Exibição] ) )
			    ,FILTER(
			        ALL( Encomendas )
			        ,Encomendas[AgenciaMeiosId] = 'Agencia Meios'[entId]
			    )
			)
			// LOOKUPVALUE( 
			//     Encomendas[UltimaEncomenda]
			//     ,Encomendas[AgenciaMeiosId]
			//     ,'Agencia Meios'[entId]
			// )
			VAR _2 =
			IF( _1 = BLANK(), 0, _1 )
			RETURN
			IF( _2 = 0, "OUTROS", 'Agencia Meios'[Agencia Meios] )
			```
		isHidden
		lineageTag: e7ab2842-9697-445f-b3c4-9d8ce77095b8
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

