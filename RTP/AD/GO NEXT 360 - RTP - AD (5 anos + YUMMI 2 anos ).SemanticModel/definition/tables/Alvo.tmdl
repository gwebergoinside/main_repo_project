table Alvo
	lineageTag: 83cf3fc8-4f8d-4ca3-a001-f9644a072f39

	column cod_alvo
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e2a5355d-9722-4c98-aa95-a81b35834305
		summarizeBy: none
		sourceColumn: cod_alvo

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Alvo C/ Encomendas' = ```
			
			VAR _1 =
			CALCULATE(
			    YEAR( MAX( Encomendas[Data Exibição] ) )
			    ,FILTER(
			        ALL( Encomendas )
			        ,Encomendas[cod_alvo] = Alvo[cod_alvo]
			    )
			)
			// LOOKUPVALUE( 
			//     Encomendas[UltimaEncomenda]
			//     ,Encomendas[AgenciaMeiosId]
			//     ,'Agencia Meios'[entId]
			// )
			VAR _2 =
			IF( _1 = BLANK(), 0, _1 )
			RETURN
			IF( _2 = 0, "OUTROS", Alvo[Alvo (negociação)] )
			```
		isHidden
		lineageTag: 2d678642-474b-4f17-a1c3-f38ecfa3ac5c
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

