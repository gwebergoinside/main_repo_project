	partition Alvo-8617abae-d9db-44c5-900d-87a5d2a612f9 = m
		mode: import
		queryGroup: Encomendas
		source =
				let
				    SQL = "SELECT cod_alvo
				            , abr_alvo AS [Alvo (negociação)]
				        --  , abr_alvo_old as [Alvo Yummi]
				            , CASE abr_alvo_old
				                WHEN NULL THEN 0
				                WHEN '' THEN 0
				                ELSE 1 END AS AlvoPreenchido
				            , CASE abr_alvo_old
				                WHEN NULL THEN abr_alvo
				                WHEN '' THEN abr_alvo
				                ELSE abr_alvo_old END AS [Alvo Yummi]
				        FROM Aud_Alvos",
				    Source = Sql.Database(ServerP, BD, [Query = SQL])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

