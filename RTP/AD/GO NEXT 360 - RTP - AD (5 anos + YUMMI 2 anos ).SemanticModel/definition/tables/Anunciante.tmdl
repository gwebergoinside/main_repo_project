table Anunciante
	lineageTag: 13a9293c-7f1e-4f15-b2ee-c9a5046012b1

	column entId
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4f71e52a-0de9-41db-b243-f953e1f14b51
		summarizeBy: none
		sourceColumn: entId

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Anunciante C/ Encomendas' =
			
			VAR _1 =
			CALCULATE(
			    YEAR( MAX( Encomendas[Data Exibição] ) )
			    ,FILTER(
			        ALL( Encomendas )
			        ,Encomendas[anuncianteId] = Anunciante[entId]
			    )
			)
			
			VAR _11 =
			CALCULATE(
			    YEAR( MAX( Propostas[proDataCria] ) )
			    ,FILTER(
			        ALL( Propostas )
			        ,Propostas[proANId] = Anunciante[entId]
			    )
			)
			
			VAR _12 =
			CALCULATE(
			    MAX( Yumi_Anunciante[Yumi_Anunciante_Key] )
			    ,FILTER(
			        ALL( Yumi_Anunciante )
			        ,Yumi_Anunciante[IdAdv] = Anunciante[entId]
			    )
			)
			
			VAR _2 =
			IF( _1 = BLANK() && _11 = BLANK() && _12 = BLANK(), 0, _1+_11+_12 )
			RETURN
			IF( _2 = 0, "OUTROS", Anunciante[Anunciante] )
		isHidden
		lineageTag: a18b3399-a07a-43ff-b8d8-47a996b62e8d
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Anunciante
		dataType: string
		lineageTag: be71f870-3d3d-486b-899e-3e1feedaa2b6
		summarizeBy: none
		sourceColumn: Anunciante

		annotation SummarizationSetBy = Automatic

	partition Anunciante-05f4ec63-e93e-4ca0-9acc-25a0c1ea37a5 = m
		mode: import
		queryGroup: Encomendas
		source =
				let
				    SQL = "SELECT
				            entNome AS Anunciante,
				            entId
				        FROM entidades",
				    Source = Sql.Database(ServerP, BD, [Query = SQL])
				in
				    Source

