	partition Audiencias-f51c0679-fce3-4b81-a110-9172a84ea6b3 = m
		mode: import
		queryGroup: Audiências
		source =
				let
				    SQL = "SELECT#(lf)#(tab)apf.CanCodigo as IdChannel#(lf)#(tab),apf.DiaSemId as [Dia da Semana]#(lf)#(tab),CONVERT(VARCHAR(8), DATEADD(MINUTE, apf.horaInicio, 0), 108) AS Faixa#(lf)    ,CONVERT(VARCHAR(8), DATEADD(MINUTE, apf.horaFim, 0), 108) AS FimFaixa#(lf)#(tab),apf.Rating as Valor#(lf)#(tab),a.abr_alvo as Alvo#(lf)FROM #(lf)#(tab)aud_prev_faixa apf#(lf)#(tab)LEFT JOIN  Aud_Alvos a on apf.Cod_Alvo = a.cod_alvo#(lf)WHERE#(lf)#(tab)apf.dataFim is NULL",
				    Source = Sql.Database(ServerP, BD, [Query = SQL])
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

