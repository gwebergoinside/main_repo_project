	column 'Nome do Dia (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('Audiencias'[Dia da Semana]),
				"(Blank)",
				'Audiencias'[Dia da Semana] IN {2,
					3,
					4,
					5,
					6},
				"Dia de Semana",
				'Audiencias'[Dia da Semana] IN {1,
					7},
				"Fim de Semana",
				"Other"
			)
