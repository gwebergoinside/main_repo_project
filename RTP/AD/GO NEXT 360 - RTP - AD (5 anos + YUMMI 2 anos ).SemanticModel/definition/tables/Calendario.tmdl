	column 'Dia Semana LY (nome)' =
			
			VAR _day = WEEKDAY(DATE(YEAR(Calendario[Data])-1,MONTH(Calendario[Data]),DAY(Calendario[Data])))
			RETURN
			SWITCH(_day, 1,"Dom",2,"Seg",3,"Ter",4,"Qua",5,"Qui",6,"Sex",7,"Sab")
		isHidden
		lineageTag: 71ae4274-68a0-41d4-adc6-1e14b1f04efc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Semana = ```
			
			VAR Week_start = FORMAT( Calendario[Data] - WEEKDAY('Calendario'[Data],2) +1, "dd/MM/yyyy" )
			VAR Week_end = FORMAT(Calendario[Data] - WEEKDAY(Calendario[Data],2) + 7, "dd/MM/yyyy" )
			RETURN
			Week_start &" 
			 "& Week_end
			```
		lineageTag: 0c37e169-6e55-4132-bb6b-847baa9f4b7c
		summarizeBy: none
		sortByColumn: 'Inicio da Semana'

		annotation SummarizationSetBy = Automatic

	column 'Inicio da Semana' = Calendario[Data] - WEEKDAY('Calendario'[Data],2) +1
		isHidden
		formatString: General Date
		lineageTag: fd9ccb36-bcc9-45ea-8741-b0f941874740
