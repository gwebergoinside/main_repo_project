	partition Calendario-6a20f9c8-c72f-4130-81cb-d714fa5bff1f = calculated
		mode: import
		source =
				
				VAR _check_mes =
				    MONTH ( NOW () ) >= 10
				RETURN
				    CALENDAR (
				        DATE ( YEAR ( NOW () ) - AnoUpdateGMedia, 1, 1 ),
				        DATE ( YEAR ( NOW () ) + IF ( _check_mes, 2, 1 ), 1, 1 ) - 1
				    )

