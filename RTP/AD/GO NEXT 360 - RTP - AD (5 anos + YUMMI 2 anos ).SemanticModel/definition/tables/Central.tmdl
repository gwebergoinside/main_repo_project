	column 'Central de Compras'
		lineageTag: ea1c09c8-8725-47a4-b7e5-b11946fa696f
		summarizeBy: none
		sourceColumn: [Central]

		annotation SummarizationSetBy = Automatic

	column 'Central C/ Encomendas' = ```
			
			VAR _1 =
			CALCULATE(
			    YEAR( MAX( Encomendas[Data Exibição] ) )
			    ,FILTER(
			        ALL( Encomendas )
			        ,Encomendas[CentralComprasId] = Central[IdCentralCompras]
			    )
			)
			// LOOKUPVALUE( 
			//     Encomendas[UltimaEncomenda]
			//     ,Encomendas[AgenciaMeiosId]
			//     ,'Agencia Meios'[entId]
			// )
			VAR _2 =
			IF( _1 = BLANK(), 0, _1 )
			RETURN
			IF( _2 = 0, "OUTROS", Central[Central de Compras] )
			```
		isHidden
		lineageTag: b391fa2b-74f7-4a9d-b5d5-393526071fa9
