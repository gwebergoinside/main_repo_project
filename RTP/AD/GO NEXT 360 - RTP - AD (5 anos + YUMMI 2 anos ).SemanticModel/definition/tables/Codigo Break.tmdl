	partition 'Codigo Break-34964ec2-bc2f-4568-b53d-f84ba3f45caf' = m
		mode: import
		queryGroup: Encomendas
		source =
				let
				    SQL = "SELECT
				              greComId
				            , ecrCodigo AS [Codigo Break]
				            , ecrDescricao AS [Descrição Cod_Break]
				        FROM Grelhacomercial
				        WHERE YEAR(grecomdata) >= YEAR(GETDATE()) - " & AnoUpdateGMedia,
				    Source = Sql.Database(ServerP, BD, [Query = SQL])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

