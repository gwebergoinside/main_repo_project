	partition Descricao_Campanhas-80d2e7cc-5c5c-4bd7-a5d7-8203923e027e = calculated
		mode: import
		source = ```
				
				VAR _enc = 
				    SELECTCOLUMNS(
				        Encomendas
				        ,"DescricaoCampanhas", Encomendas[DescricaoCampanhas]
				    )
				VAR _fat = 
				    SELECTCOLUMNS(
				        Faturacao
				        ,"DescricaoCampanhas", Faturacao[DescricaoCampanhas]
				    )
				VAR _rap = 
				    SELECTCOLUMNS(
				        Rappel
				        ,"DescricaoCampanhas", Rappel[DescricaoCampanhas]
				    )
				VAR _out = 
				    SELECTCOLUMNS(
				        'Outros Custos'
				        ,"DescricaoCampanhas", 'Outros Custos'[DescricaoCampanhas]
				    )
				VAR _mul = 
				    SELECTCOLUMNS(
				        Multiprodutos
				        ,"DescricaoCampanhas", Multiprodutos[DescricaoCampanhas]
				    )
				VAR _Union = UNION(_enc,_fat,_rap,_out,_mul)
				VAR Result = FILTER( SUMMARIZE(_Union, [DescricaoCampanhas] ), [DescricaoCampanhas] <> BLANK() )
				RETURN
				Result
				```

