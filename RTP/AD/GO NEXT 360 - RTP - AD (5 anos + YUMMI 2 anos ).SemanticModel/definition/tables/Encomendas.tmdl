	partition Encomendas-748911e9-513d-4cc5-893d-2ee7cc33bd27 = m
		mode: import
		queryGroup: Encomendas
		source = ```
				let
				    SQL = "
				        Select
				            encomendas.ordPubCodigo,
				            encomendas.canCodigo,
				            campanhas.camAnunciante As anuncianteId,
				            campanhas.camEntidadeFacturar As EntidadeFacturarId,
				            campanhas.camCentralCompras As CentralComprasId,
				            campanhas.camDistribuidor As AgenciaMeiosId,
				            campanhas.camAgencia As AgenciaId,
				            campanhas.camDescricao As DescricaoCampanhas,
				            ordemPub.proId,
				            Case
				                When IsNull(ordemPub.ordPubNegociacao, 0) = 0
				                Then Null
				                Else ordemPub.ordPubNegociacao
				            End As ordPubNegociacao,
				            encomendas.greComHoraInicio As horaExib,
				            encomendas.encDataExibicao As diaExib,
				            'E' As tipo,
				            campanhas.camVendedor As vendedor,
				            IsNull(encomendas.encValorPub, 0) As valorPub,
				            IsNull(encomendas.encValorTab, 0) As valorTab,
				            IsNull(encomendas.encValorBonus, 0) As valorBonus,
				            IsNull(ordemPub.ordPubTotalGRPs, 0) As GRPObjetivo,
				            Pacotes.pacId,
				            IsNull(encomendas.encValorPub, 0) * (IsNull(campanhas.camDescontoAgencia, 0) / 100) As valorComissaoAgencia,
				            IsNull(EncomendasAudiencias.encRating, IsNull((
				                SELECT MAX(apf.Rating)
				                FROM aud_prev_faixa apf
				                WHERE 1 = 1
				                    And apf.CanCodigo = encomendas.canCodigo
				                    And DatePart(dw, encomendas.encDataExibicao) + 1 = apf.DiaSemId
				                    And apf.Cod_Alvo = aud_alvos.cod_alvo
				                    And encomendas.encDataExibicao >= apf.dataInicio
				                    And (encomendas.encDataExibicao <= apf.dataFim
				                        Or apf.dataFim Is Null)
				                    And encomendas.greComHoraInicio >= apf.horaInicio
				                    And encomendas.greComHoraInicio <= apf.horaFim
				            ), 0)) As grpPrevisto,
				            0 As [GRP_Equivalente],
				            0 As [GRP_EquivalenteOther],
				            0 As grpReal,
				            indiceeq.ratValor As indice_equi,
				            indiceeqOther.ratValor As indice_equiOther,
				            encomendas.encMaterialDuracaoEmissao As durEmissao,
				            ordemPub.ordPubClaId,
				            encomendas.bonId,
				            ordemPub.tipPubId,
				            encomendas.priId As PrioridadeId,
				            tipoPublicidade.tipEcrIdOcupacao As tipoOcupacao,
				            aud_alvos.cod_alvo,
				            Case ordemPub.ordPubFlagFixo
				                When 2
				                Then negPeriodos.negPerTipo
				                When 1
				                Then 'V'
				                Else 'D'
				            End As negPerTipo,
				            ordemPub.ordPubFlagValorBrutoVendas,
				            ordemPub.ordPubFlagValorLiquidoVendas,
				            encomendas.greComId,
				            campanhas.camGrupoId,
				            encomendas.encid
				        From
				            encomendas With(NoLock)
				            Inner Join ordemPub With(NoLock) On encomendas.ordPubCodigo = ordemPub.ordPubCodigo
				            Left Join tipoPublicidade With(NoLock) On tipoPublicidade.tipPubId = ordemPub.tipPubId
				            Left Join pacotes With(NoLock) On ordemPub.pacId = Pacotes.pacId
				            Left Join encomendasAudiencias EncomendasAudiencias With(NoLock) On EncomendasAudiencias.encId = encomendas.encid
				            Left Join campanhas With(NoLock) On campanhas.camId = ordemPub.camId
				            Left Join negPeriodos With(NoLock) On negPeriodos.negPerId = ordemPub.ordPubNegociacao
				            Left Join ratingsTabela indiceeq With(NoLock)
				                    On (IsNull(indiceeq.canCodigo, 0) = 0
				                        Or indiceeq.canCodigo = ordemPub.canCodigo)
				                    And indiceeq.ratDuracaoIntermed =
				                            CASE WHEN encomendas.encMaterialDuracaoFacturacao = 0 THEN encomendas.encMaterialDuracaoEmissao
				                                ELSE encomendas.encMaterialDuracaoFacturacao END
				                    And indiceeq.ratDuracaoBase = " & DuracaoBase & "
				                    And encomendas.encDataExibicao Between indiceeq.ratDataInicio And indiceeq.ratDataFim
				            Left Join ratingsTabela indiceeq2030 With(NoLock)
				                    On (IsNull(indiceeq2030.canCodigo, 0) = 0
				                        Or indiceeq2030.canCodigo = ordemPub.canCodigo)
				                    And indiceeq2030.ratDuracaoBase = " & DuracaoBase & "
				                    And indiceeq2030.ratDuracaoIntermed = " & DuracaoBaseOther & "
				                    And encomendas.encDataExibicao Between indiceeq2030.ratDataInicio And indiceeq2030.ratDataFim
				            Left Join ratingsTabela indiceeqOther With(NoLock)
				                    On (IsNull(indiceeqOther.canCodigo, 0) = 0
				                        Or indiceeqOther.canCodigo = ordemPub.canCodigo)
				                    And indiceeqOther.ratDuracaoIntermed =
				                            CASE WHEN encomendas.encMaterialDuracaoFacturacao = 0 THEN encomendas.encMaterialDuracaoEmissao
				                                ELSE encomendas.encMaterialDuracaoFacturacao END
				                    And indiceeqOther.ratDuracaoBase = " & DuracaoBaseOther & "
				                    And encomendas.encDataExibicao Between indiceeqOther.ratDataInicio And indiceeqOther.ratDataFim
				            Left Join ratingsTabela indiceeq2030Other With(NoLock)
				                    On (IsNull(indiceeq2030Other.canCodigo, 0) = 0
				                        Or indiceeq2030Other.canCodigo = ordemPub.canCodigo)
				                    And indiceeq2030Other.ratDuracaoBase = " & DuracaoBaseOther & "
				                    And indiceeq2030Other.ratDuracaoIntermed = " & DuracaoBaseOther & "
				                    And encomendas.encDataExibicao Between indiceeq2030Other.ratDataInicio And indiceeq2030Other.ratDataFim
				            Left Join aud_alvos With(NoLock)
				                    On aud_alvos.cod_alvo = IsNull(ordemPub.codAlvo, " & AlvoPadrao & ")
				            Left Join aud_prev_faixa With(NoLock)
				                    On aud_prev_faixa.Cod_Alvo = aud_alvos.cod_alvo
				                    And aud_prev_faixa.CanCodigo = encomendas.canCodigo
				                    And encomendas.encDataExibicao >= aud_prev_faixa.dataInicio
				                    And (encomendas.encDataExibicao <= aud_prev_faixa.dataFim
				                        Or aud_prev_faixa.dataFim Is Null)
				                    And encomendas.greComHoraInicio >= aud_prev_faixa.horaInicio
				                    And encomendas.greComHoraInicio <= aud_prev_faixa.horaFim
				                    And DatePart(dw, encomendas.encDataExibicao) + 1 = aud_prev_faixa.DiaSemId
				        Where
				            Year(encomendas.encDataExibicao) >= Year(GetDate()) - " & AnoUpdateGMedia & "
				
				    Union
				        
				        Select
				            encomendasExibidas.ordPubCodigo,
				            encomendasExibidas.canCodigo,
				            campanhas.camAnunciante As anuncianteId,
				            campanhas.camEntidadeFacturar As EntidadeFacturarId,
				            campanhas.camCentralCompras As CentralComprasId,
				            campanhas.camDistribuidor As AgenciaMeiosId,
				            campanhas.camAgencia As AgenciaId,
				            campanhas.camDescricao As DescricaoCampanhas,
				            ordemPub.proId,
				            Case
				                When IsNull(ordemPub.ordPubNegociacao, 0) = 0
				                Then Null
				                Else ordemPub.ordPubNegociacao
				            End As ordPubNegociacao,
				            encomendasExibidas.greComHoraInicio As horaExib,
				            encomendasExibidas.encDataExibicao As diaExib,
				            'EE' As tipo,
				            campanhas.camVendedor As vendedor,
				            IsNull(encomendasExibidas.encValorPub, 0) As valorPub,
				            IsNull(encomendasExibidas.encValorTab, 0) As valorTab,
				            IsNull(encomendasExibidas.encValorBonus, 0) As valorBonus,
				            IsNull(ordemPub.ordPubTotalGRPs, 0) As GRPObjetivo,
				            Pacotes.pacId,
				            IsNull(encomendasExibidas.encValorPub, 0) * (IsNull(campanhas.camDescontoAgencia, 0) / 100) As valorComissaoAgencia,
				            IsNull((
				                SELECT MAX(apf.Rating)
				                FROM aud_prev_faixa apf
				                WHERE 1 = 1
				                    And apf.CanCodigo = encomendasExibidas.canCodigo
				                    And DatePart(dw, encomendasExibidas.encDataExibicao) + 1 = apf.DiaSemId
				                    And apf.Cod_Alvo = aud_alvos.cod_alvo
				                    And encomendasExibidas.encDataExibicao >= apf.dataInicio
				                    And (encomendasExibidas.encDataExibicao <= apf.dataFim
				                        Or apf.dataFim Is Null)
				                    And encomendasExibidas.greComHoraInicio >= apf.horaInicio
				                    And encomendasExibidas.greComHoraInicio <= apf.horaFim
				            ), 0) As grpPrevisto,
				            IsNull(EncomendasAudiencias.encRating, IsNull(
				                    (SELECT aei.audiencia
				                    FROM aud_exib AS ae WITH(NOLOCK)
				                    INNER JOIN aud_exib_id AS aei WITH(NOLOCK)
				                        ON aei.id_exib = ae.id_exib
				                    WHERE ae.id_exib = aud_rel_alinhamento_publicidade.id_pubreport
				                        AND aei.cod_alvo = aud_alvos.cod_alvo), 0)
				                ) * IsNull(indiceeq.ratValor,0) As [GRP_Equivalente],
				            IsNull(EncomendasAudiencias.encRating, IsNull(
				                    (SELECT aei.audiencia
				                    FROM aud_exib AS ae WITH(NOLOCK)
				                    INNER JOIN aud_exib_id AS aei WITH(NOLOCK)
				                        ON aei.id_exib = ae.id_exib
				                    WHERE ae.id_exib = aud_rel_alinhamento_publicidade.id_pubreport
				                        AND aei.cod_alvo = aud_alvos.cod_alvo), 0)
				                ) * IsNull(indiceeqOther.ratValor,0) As [GRP_EquivalenteOther],
				            IsNull(EncomendasAudiencias.encRating, IsNull(
				                    (SELECT aei.audiencia
				                    FROM aud_exib AS ae WITH(NOLOCK)
				                    INNER JOIN aud_exib_id AS aei WITH(NOLOCK)
				                        ON aei.id_exib = ae.id_exib
				                    WHERE ae.id_exib = aud_rel_alinhamento_publicidade.id_pubreport
				                    AND aei.cod_alvo = aud_alvos.cod_alvo), 0)
				                ) As grpReal,
				            indiceeq.ratValor As indice_equi,
				            indiceeqOther.ratValor As indice_equiOther,
				            encomendasExibidas.encMaterialDuracaoEmissao As durEmissao,
				            ordemPub.ordPubClaId,
				            encomendasExibidas.bonId,
				            ordemPub.tipPubId,
				            encomendasExibidas.priId As PrioridadeId,
				            tipoPublicidade.tipEcrIdOcupacao As tipoOcupacao,
				            aud_alvos.cod_alvo,
				            Case ordemPub.ordPubFlagFixo
				                When 2
				                Then negPeriodos.negPerTipo
				                When 1
				                Then 'V'
				                Else 'D'
				            End As negPerTipo,
				            ordemPub.ordPubFlagValorBrutoVendas,
				            ordemPub.ordPubFlagValorLiquidoVendas,
				            encomendasExibidas.greComId,
				            campanhas.camGrupoId,
				            encomendasExibidas.encId
				        From
				            encomendasExibidas With(NoLock)
				            Inner Join ordemPub With(NoLock)
				                    On encomendasExibidas.ordPubCodigo = ordemPub.ordPubCodigo
				            Left Join tipoPublicidade With(NoLock)
				                    On tipoPublicidade.tipPubId = ordemPub.tipPubId
				            Left Join pacotes With(NoLock)
				                    On ordemPub.pacId = Pacotes.pacId
				            Left Join encomendasAudiencias EncomendasAudiencias With(NoLock)
				                    On EncomendasAudiencias.encId = encomendasExibidas.encId
				                    And EncomendasAudiencias.audPaiId = 1
				            Left Join campanhas With(NoLock) On campanhas.camId = ordemPub.camId
				            Left Join negPeriodos With(NoLock) On negPeriodos.negPerId = ordemPub.ordPubNegociacao
				            Left Join ratingsTabela indiceeq With(NoLock)
				                    On (IsNull(indiceeq.canCodigo, 0) = 0
				                        Or indiceeq.canCodigo = ordemPub.canCodigo)
				                    And indiceeq.ratDuracaoIntermed =
				                            CASE WHEN encomendasExibidas.encMaterialDuracaoFacturacao = 0 THEN encomendasExibidas.encMaterialDuracaoEmissao
				                                ELSE encomendasExibidas.encMaterialDuracaoFacturacao END
				                    And indiceeq.ratDuracaoBase = " & DuracaoBase & "
				                    And encomendasExibidas.encDataExibicao Between indiceeq.ratDataInicio And indiceeq.ratDataFim
				            Left Join ratingsTabela indiceeq2030 With(NoLock) On (IsNull(indiceeq2030.canCodigo, 0) = 0
				                        Or indiceeq2030.canCodigo = ordemPub.canCodigo)
				                    And indiceeq2030.ratDuracaoBase = " & DuracaoBase & "
				                    And indiceeq2030.ratDuracaoIntermed = " & DuracaoBaseOther & "
				                    And encomendasExibidas.encDataExibicao Between indiceeq2030.ratDataInicio And indiceeq2030.ratDataFim
				            Left Join ratingsTabela indiceeqOther With(NoLock)
				                    On (IsNull(indiceeqOther.canCodigo, 0) = 0
				                        Or indiceeqOther.canCodigo = ordemPub.canCodigo)
				                    And indiceeqOther.ratDuracaoIntermed =
				                            CASE WHEN encomendasExibidas.encMaterialDuracaoFacturacao = 0 THEN encomendasExibidas.encMaterialDuracaoEmissao
				                                ELSE encomendasExibidas.encMaterialDuracaoFacturacao END
				                    And indiceeqOther.ratDuracaoBase = " & DuracaoBaseOther & "
				                    And encomendasExibidas.encDataExibicao Between indiceeqOther.ratDataInicio And indiceeqOther.ratDataFim
				            Left Join ratingsTabela indiceeq2030Other With(NoLock) On (IsNull(indiceeq2030Other.canCodigo, 0) = 0
				                        Or indiceeq2030Other.canCodigo = ordemPub.canCodigo)
				                    And indiceeq2030Other.ratDuracaoBase = " & DuracaoBaseOther & "
				                    And indiceeq2030Other.ratDuracaoIntermed = " & DuracaoBaseOther & "
				                    And encomendasExibidas.encDataExibicao Between indiceeq2030Other.ratDataInicio And
				                    indiceeq2030Other.ratDataFim
				            Left Join aud_alvos With(NoLock)
				                    On aud_alvos.cod_alvo = IsNull(ordemPub.codAlvo, " & AlvoPadrao & ")
				            Left Join aud_prev_faixa With(NoLock) On aud_prev_faixa.CanCodigo = encomendasExibidas.canCodigo
				                    And DatePart(dw, encomendasExibidas.encDataExibicao) + 1 = aud_prev_faixa.DiaSemId
				                    And aud_prev_faixa.Cod_Alvo = aud_alvos.cod_alvo
				                    And encomendasExibidas.encDataExibicao >= aud_prev_faixa.dataInicio
				                    And (encomendasExibidas.encDataExibicao <= aud_prev_faixa.dataFim
				                        Or aud_prev_faixa.dataFim Is Null)
				                    And encomendasExibidas.greComHoraInicio >= aud_prev_faixa.horaInicio
				                    And encomendasExibidas.greComHoraInicio <= aud_prev_faixa.horaFim
				            Left Join aud_alinhamento_publicidade With(NoLock)
				                    On aud_alinhamento_publicidade.encId = encomendasExibidas.encId
				                    And aud_alinhamento_publicidade.spoAutId = 0
				            Left Join aud_rel_alinhamento_publicidade With(NoLock)
				                    On aud_rel_alinhamento_publicidade.id_pub =
				                    aud_alinhamento_publicidade.id_pub 
				        --  Left Join aud_exib With(NoLock) On aud_exib.id_exib = aud_rel_alinhamento_publicidade.id_pubreport
				        --  Left Join aud_exib_id With(NoLock) On aud_exib_id.id_exib = aud_exib.id_exib
				        --          And aud_exib_id.cod_alvo = aud_alvos.cod_alvo
				        Where
				            Year(encomendasExibidas.encDataExibicao) >= Year(GetDate()) - " & AnoUpdateGMedia & "
				
				    Union
				        
				        Select
				            ordemPub.ordPubCodigo,
				            ordemPub.canCodigo,
				            campanhas.camAnunciante As anuncianteId,
				            campanhas.camEntidadeFacturar As EntidadeFacturarId,
				            campanhas.camCentralCompras As CentralComprasId,
				            campanhas.camDistribuidor As AgenciaMeiosId,
				            campanhas.camAgencia As AgenciaId,
				            campanhas.camDescricao As DescricaoCampanhas,
				            ordemPub.proId,
				            Case
				                When IsNull(ordemPub.ordPubNegociacao, 0) = 0
				                Then Null
				                Else ordemPub.ordPubNegociacao
				            End As ordPubNegociacao,
				            0 As horaExib,
				            Cast(Convert(VARCHAR,ordemPub.ordPubAno) + '-' + Convert(VARCHAR,ordemPub.ordPubMes) + '-' + Convert(VARCHAR,1) As
				            DATETIME) As diaExib,
				            'O' As tipo,
				            campanhas.camVendedor As vendedor,
				            IsNull(ordemPub.ordPubValor, 0) As valorPub,
				            IsNull(ordemPub.ordPubValorTab, 0) As valorTab,
				            IsNull(ordemPub.valorBonus, 0) As valorBonus,
				            IsNull(ordemPub.ordPubTotalGRPs, 0) As GRPObjetivo,
				            Pacotes.pacId,
				            IsNull(ordemPub.ordPubValor, 0) * (IsNull(campanhas.camDescontoAgencia, 0) / 100) As valorComissaoAgencia,
				            0 As grpPrevisto,
				            0 As [GRP_Equivalente],
				            0 As [GRP_EquivalenteOther],
				            0 As grpReal,
				            0 As indice_equi,
				            0 As indice_equiOther,
				            0 As durEmissao,
				            ordemPub.ordPubClaId,
				            ordemPub.ordPubBonus As bonId,
				            ordemPub.tipPubId,
				            ordemPub.priId As PrioridadeId,
				            tipoPublicidade.tipEcrIdOcupacao As tipoOcupacao,
				            aud_alvos.cod_alvo,
				            Case ordemPub.ordPubFlagFixo
				                When 2
				                Then negPeriodos.negPerTipo
				                When 1
				                Then 'V'
				                Else 'D'
				            End As negPerTipo,
				            ordemPub.ordPubFlagValorBrutoVendas,
				            ordemPub.ordPubFlagValorLiquidoVendas,
				            Null As greComId,
				            campanhas.camGrupoId,
				            0 As encId
				        From
				            ordemPub With(NoLock)
				            Left Join campanhas With(NoLock)
				                On campanhas.camId = ordemPub.camId
				            Left Join tipoPublicidade With(NoLock)
				                On tipoPublicidade.tipPubId = ordemPub.tipPubId
				            Left Join pacotes With(NoLock)
				                On ordemPub.pacId = Pacotes.pacId
				            Left Join aud_alvos With(NoLock)
				                On aud_alvos.cod_alvo = IsNull(ordemPub.codAlvo, " & AlvoPadrao & ")
				            Left Join negPeriodos With(NoLock)
				                On negPeriodos.negPerId = ordemPub.ordPubNegociacao
				        Where
				            ordemPub.ordPubAno >= Year(GetDate()) - " & AnoUpdateGMedia & " And
				            ordemPub.ordPubCodigo Not In (
				                Select e.ordPubCodigo
				                From encomendas e With(NoLock)
				                Where e.ordPubCodigo = ordemPub.ordPubCodigo
				                Group By e.ordPubCodigo
				            Union
				                Select e.ordPubCodigo
				                From encomendasExibidas e With(NoLock)
				                Where e.ordPubCodigo = ordemPub.ordPubCodigo
				                Group By e.ordPubCodigo
				            Union
				                Select e.ordPubCodigo
				                From encomendasExcepcoes e With(NoLock)
				                Where IsNull(e.encValorPub, 0) <> 0
				                    And e.ordPubCodigo = ordemPub.ordPubCodigo
				                Group By e.ordPubCodigo)
				
				    Union
				
				        Select
				            encomendas.ordPubCodigo,
				            encomendas.canCodigo,
				            campanhas.camAnunciante As anuncianteId,
				            campanhas.camEntidadeFacturar As EntidadeFacturarId,
				            campanhas.camCentralCompras As CentralComprasId,
				            campanhas.camDistribuidor As AgenciaMeiosId,
				            campanhas.camAgencia As AgenciaId,
				            campanhas.camDescricao As DescricaoCampanhas,
				            ordemPub.proId,
				            Case
				                When IsNull(ordemPub.ordPubNegociacao, 0) = 0
				                Then Null
				                Else ordemPub.ordPubNegociacao
				            End As ordPubNegociacao,
				            encomendas.greComHoraInicio As horaExib,
				            encomendas.encDataExibicao As diaExib,
				            'X' As tipo,
				            campanhas.camVendedor As vendedor,
				            IsNull(encomendas.encValorPub, 0) As valorPub,
				            IsNull(encomendas.encValorTab, 0) As valorTab,
				            0 As valorBonus,
				            IsNull(ordemPub.ordPubTotalGRPs, 0) As GRPObjetivo,
				            Pacotes.pacId,
				            IsNull(encomendas.encValorPub, 0) * (IsNull(campanhas.camDescontoAgencia, 0) / 100) As valorComissaoAgencia,
				            IsNull(EncomendasAudiencias.encRating, IsNull((
				                SELECT MAX(apf.Rating)
				                FROM aud_prev_faixa apf
				                WHERE 1 = 1
				                    And apf.CanCodigo = encomendas.canCodigo
				                    And DatePart(dw, encomendas.encDataExibicao) + 1 = apf.DiaSemId
				                    And apf.Cod_Alvo = aud_alvos.cod_alvo
				                    And encomendas.encDataExibicao >= apf.dataInicio
				                    And (encomendas.encDataExibicao <= apf.dataFim
				                        Or apf.dataFim Is Null)
				                    And encomendas.greComHoraInicio >= apf.horaInicio
				                    And encomendas.greComHoraInicio <= apf.horaFim
				            ), 0)) As grpPrevisto,
				            0 As [GRP_Equivalente],
				            0 As [GRP_EquivalenteOther],
				            0 As grpReal,
				            indiceeq.ratValor As indice_equi,
				            indiceeqOther.ratValor As indice_equiOther,
				            encomendas.encMaterialDuracaoEmissao As durEmissao,
				            ordemPub.ordPubClaId,
				            encomendas.bonId,
				            ordemPub.tipPubId,
				            encomendas.priId As PrioridadeId,
				            tipoPublicidade.tipEcrIdOcupacao As tipoOcupacao,
				            aud_alvos.cod_alvo,
				            Case ordemPub.ordPubFlagFixo
				                When 2
				                Then negPeriodos.negPerTipo
				                When 1
				                Then 'V'
				                Else 'D'
				            End As negPerTipo,
				            ordemPub.ordPubFlagValorBrutoVendas,
				            ordemPub.ordPubFlagValorLiquidoVendas,
				            encomendas.greComId,
				            campanhas.camGrupoId,
				            encomendas.encId
				        From encomendasExcepcoes encomendas With(NoLock)
				            Inner Join ordemPub With(NoLock)
				                    On encomendas.ordPubCodigo = ordemPub.ordPubCodigo
				            Left Join tipoPublicidade With(NoLock)
				                    On tipoPublicidade.tipPubId = ordemPub.tipPubId
				            Left Join pacotes With(NoLock)
				                    On ordemPub.pacId = Pacotes.pacId
				            Left Join grelhaComercial With(NoLock)
				                    On grelhaComercial.greComId = encomendas.greComId
				            Left Join encomendasAudiencias EncomendasAudiencias With(NoLock)
				                    On EncomendasAudiencias.encId = encomendas.encId
				            Left Join campanhas With(NoLock)
				                    On campanhas.camId = ordemPub.camId
				            Left Join negPeriodos With(NoLock)
				                    On negPeriodos.negPerId = ordemPub.ordPubNegociacao
				            Left Join ratingsTabela indiceeq With(NoLock)
				                    On (IsNull(indiceeq.canCodigo, 0) = 0
				                        Or indiceeq.canCodigo = ordemPub.canCodigo)
				                    And indiceeq.ratDuracaoIntermed =
				                            CASE WHEN encomendas.encMaterialDuracaoFacturacao = 0 THEN encomendas.encMaterialDuracaoEmissao
				                                ELSE encomendas.encMaterialDuracaoFacturacao END
				                    And indiceeq.ratDuracaoBase = " & DuracaoBase & "
				                    And encomendas.encDataExibicao Between indiceeq.ratDataInicio And indiceeq.ratDataFim
				            Left Join ratingsTabela indiceeq2030 With(NoLock)
				                    On (IsNull(indiceeq2030.canCodigo, 0) = 0
				                        Or indiceeq2030.canCodigo = ordemPub.canCodigo)
				                    And indiceeq2030.ratDuracaoBase = " & DuracaoBase & "
				                    And indiceeq2030.ratDuracaoIntermed = " & DuracaoBaseOther & "
				                    And encomendas.encDataExibicao Between indiceeq2030.ratDataInicio And indiceeq2030.ratDataFim
				            Left Join ratingsTabela indiceeqOther With(NoLock)
				                    On (IsNull(indiceeqOther.canCodigo, 0) = 0
				                        Or indiceeqOther.canCodigo = ordemPub.canCodigo)
				                    And indiceeqOther.ratDuracaoIntermed =
				                            CASE WHEN encomendas.encMaterialDuracaoFacturacao = 0 THEN encomendas.encMaterialDuracaoEmissao
				                                ELSE encomendas.encMaterialDuracaoFacturacao END
				                    And indiceeqOther.ratDuracaoBase = " & DuracaoBaseOther & "
				                    And encomendas.encDataExibicao Between indiceeqOther.ratDataInicio And indiceeqOther.ratDataFim
				            Left Join ratingsTabela indiceeq2030Other With(NoLock)
				                    On (IsNull(indiceeq2030Other.canCodigo, 0) = 0
				                        Or indiceeq2030Other.canCodigo = ordemPub.canCodigo)
				                    And indiceeq2030Other.ratDuracaoBase = " & DuracaoBaseOther & "
				                    And indiceeq2030Other.ratDuracaoIntermed = " & DuracaoBaseOther & "
				                    And encomendas.encDataExibicao Between indiceeq2030Other.ratDataInicio And indiceeq2030Other.ratDataFim
				            Left Join aud_alvos With(NoLock)
				                    On aud_alvos.cod_alvo = IsNull(ordemPub.codAlvo, " & AlvoPadrao & ")
				            Left Join aud_prev_faixa With(NoLock)
				                    On aud_prev_faixa.Cod_Alvo = aud_alvos.cod_alvo
				                    And aud_prev_faixa.CanCodigo = encomendas.canCodigo
				                    And encomendas.encDataExibicao >= aud_prev_faixa.dataInicio
				                    And (encomendas.encDataExibicao <= aud_prev_faixa.dataFim
				                        Or aud_prev_faixa.dataFim Is Null)
				                    And encomendas.greComHoraInicio >= aud_prev_faixa.horaInicio
				                    And encomendas.greComHoraInicio <= aud_prev_faixa.horaFim
				                    And DatePart(dw, encomendas.encDataExibicao) + 1 = aud_prev_faixa.DiaSemId
				        Where
				            Year(encomendas.encDataExibicao) >= Year(GetDate()) - " & AnoUpdateGMedia,
				    Source = Sql.Database(ServerP, BD, [Query = SQL, CommandTimeout = #duration(6, 6, 0, 0)]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"diaExib", type date}}),
				    #"Personalizado Adicionado" = Table.AddColumn(#"Changed Type", "GRP Equivalente", each if [grpReal] = 0 then [grpPrevisto] * [indice_equi] else [grpReal] * [indice_equi]),
				    Custom1 = Table.AddColumn(#"Personalizado Adicionado", "GRP EquivalenteOther", each if [grpReal] = 0 then [grpPrevisto] * [indice_equiOther] else [grpReal] * [indice_equiOther]),
				    #"Personalizado Adicionado2" = Table.AddColumn(Custom1, "GRP Previsto Equivalente", each [grpPrevisto] * [indice_equi]),
				    Custom2 = Table.AddColumn(#"Personalizado Adicionado2", "GRP Previsto EquivalenteOther", each [grpPrevisto] * [indice_equiOther]),
				    #"Tipo Alterado2" = Table.TransformColumnTypes(Custom2,{{"GRP Equivalente", type number}, {"GRP Previsto Equivalente", type number}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Tipo Alterado2",0,null,Replacer.ReplaceValue,{"grpPrevisto", "grpReal"}),
				    #"Duplicated Column" = Table.DuplicateColumn(#"Replaced Value", "horaExib", "horaExib - Copy"),
				    #"Renamed Columns" = Table.RenameColumns(#"Duplicated Column",{{"horaExib - Copy", "MinutosExib"}}),
				    #"Divided Column" = Table.TransformColumns(#"Renamed Columns", {{"horaExib", each _ / 60, type number}}),
				    #"Arredondado por Defeito" = Table.TransformColumns(#"Divided Column",{{"horaExib", Number.RoundDown, Int64.Type}}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Arredondado por Defeito",{{"durEmissao", "Duracao Emissao"}, {"GRP EquivalenteOther", "GRP Eq 30"}, {"GRP Previsto EquivalenteOther", "GRP Previsto Eq 30"}, {"GRP Equivalente", "GRP Eq 20"}, {"GRP Previsto Equivalente", "GRP Previsto Eq 20"}, {"valorPub", "Valor Publicidade Bruto"}, {"valorTab", "Valor Tabela"}, {"valorBonus", "Valor Bonus Bruto"}, {"ordPubCodigo", "Nº ordem pub"}, {"valorComissaoAgencia", "Valor Comissao Agencia"}, {"GRPObjetivo", "GRP Objetivo"}, {"GRP_Equivalente", "GRP Eq - 20"}, {"GRP_EquivalenteOther", "GRP Eq - 30"}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Renamed Columns1",{"GRP Eq 20", "GRP Eq 30"}),
				    #"Renamed Columns2" = Table.RenameColumns(#"Removed Columns",{{"GRP Eq - 30", "GRP Eq 30"}, {"GRP Eq - 20", "GRP Eq 20"}, {"Duracao Emissao", "Spot (duração)"}})
				in
				    #"Renamed Columns2"
				```

