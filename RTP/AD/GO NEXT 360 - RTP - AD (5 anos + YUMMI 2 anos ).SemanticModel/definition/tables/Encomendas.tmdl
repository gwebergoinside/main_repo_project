	column 'Publicidade (Paga/Não Paga)' =
			
			VAR _1 =
			SWITCH(
			    TRUE()
			    ,Encomendas[Marcações] = 0 , 0
			    ,Encomendas[bonId] = 735 || Encomendas[bonId] = 748 , 0
			    ,1
			)
			VAR _TipoPub =
			SWITCH(
			    TRUE()
			    ,_1 = 1 && ( Encomendas[bonId] = BLANK() || ISBLANK(Encomendas[bonId]) ), "Publicidade Paga"
			    ,_1 = 1 && Encomendas[bonId] <> BLANK(), "Publicidade Não Paga"
			    ,"Outros (AE ou Não Emitido)"
			)
			RETURN
			_TipoPub
		lineageTag: 8cfcff07-acda-4b85-829b-667bfbe7bc16
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'GRP Projetado' = ```
			
			        SWITCH( TRUE(),
			            ISBLANK(Encomendas[grpReal]) && Encomendas[tipo] = "EE", BLANK(),
			            ISBLANK(Encomendas[grpReal]), Encomendas[grpPrevisto]
			            , BLANK())
			```
		lineageTag: 967abb99-48a0-4a2b-bb67-e24a3b5cb932
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'verificar eq Real 20' = IF( ROUNDDOWN( Encomendas[grpReal] * Encomendas[indice_equiOther], 2) = ROUNDDOWN( Encomendas[GRP Eq 30] , 2 ) && Encomendas[indice_equiOther] >  0, 1, 0)
		formatString: 0
		lineageTag: f8133c21-761e-4408-ac7e-228438334e6c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'GRP Eq Projetado 20' = ```
			
			        SWITCH( TRUE(),
			            ISBLANK(Encomendas[grpReal]) && Encomendas[tipo] = "EE", 0,
			            ISBLANK(Encomendas[grpReal]), Encomendas[GRP Previsto Eq 20]
			            , Encomendas[GRP Total 20])
			```
		lineageTag: ab950fa8-fa26-4172-b92b-86bd557eb89d
