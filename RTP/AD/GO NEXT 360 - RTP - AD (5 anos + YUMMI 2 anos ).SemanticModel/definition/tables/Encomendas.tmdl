	column 'DayPart Antigo' =
			
			SWITCH(
			        TRUE()
			        ,Encomendas[MinutosExib] >= 390  && Encomendas[MinutosExib] < 480,  "06:30 - 07:59"
			        ,Encomendas[MinutosExib] >= 480  && Encomendas[MinutosExib] < 720,  "08:00 - 11:59"
			        ,Encomendas[MinutosExib] >= 720  && Encomendas[MinutosExib] < 870,  "12:00 - 14:29"
			        ,Encomendas[MinutosExib] >= 870  && Encomendas[MinutosExib] < 1080, "14:30 - 17:59"
			        ,Encomendas[MinutosExib] >= 1080 && Encomendas[MinutosExib] < 1200, "18:00 - 19:59"
			        ,Encomendas[MinutosExib] >= 1200 && Encomendas[MinutosExib] < 1350, "20:00 - 22:29"
			        ,Encomendas[MinutosExib] >= 1350 && Encomendas[MinutosExib] < 1440, "22:30 - 23:59"
			        ,Encomendas[MinutosExib] >= 1440 && Encomendas[MinutosExib] < 1590, "24:00 - 26:29"
			        ,Encomendas[MinutosExib] >= 1590 || Encomendas[MinutosExib] < 390 , "26:30 - 06:29"
			        ,"Outro"
			    )
		isHidden
		lineageTag: c04d6ecf-4f20-44c1-b0de-fe35a2c68c7d
