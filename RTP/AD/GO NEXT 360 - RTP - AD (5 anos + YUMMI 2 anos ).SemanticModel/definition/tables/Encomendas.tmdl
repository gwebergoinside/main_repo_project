	column DayPart = ```
			
			    SWITCH(
			        TRUE()
			        , CONTAINSSTRING( RELATED( 'Codigo Break'[Codigo Break] ), "*INFO13*"), "INFO13"
			        , CONTAINSSTRING( RELATED( 'Codigo Break'[Codigo Break] ), "*INFO20*"), "INFO20"
			        ,Encomendas[MinutosExib] >= 390  && Encomendas[MinutosExib] < 480,  "06:30 - 07:59"
			        ,Encomendas[MinutosExib] >= 480  && Encomendas[MinutosExib] < 720,  "08:00 - 11:59"
			        ,Encomendas[MinutosExib] >= 720  && Encomendas[MinutosExib] < 870,  "12:00 - 14:29"
			        ,Encomendas[MinutosExib] >= 870  && Encomendas[MinutosExib] < 1140, "14:30 - 18:59"
			        ,Encomendas[MinutosExib] >= 1140 && Encomendas[MinutosExib] < 1200, "19:00 - 19:59"
			        ,Encomendas[MinutosExib] >= 1200 && Encomendas[MinutosExib] < 1260, "20:00 - 20:59"
			        ,Encomendas[MinutosExib] >= 1260 && Encomendas[MinutosExib] < 1380, "21:00 - 22:59"
			        ,Encomendas[MinutosExib] >= 1380 && Encomendas[MinutosExib] < 1590, "23:00 - 26:29"
			        ,Encomendas[MinutosExib] >= 1590 || Encomendas[MinutosExib] < 390 , "26:30 - 06:29"
			        ,"Outro"
			    )
			```
