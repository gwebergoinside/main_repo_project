	column 'Entidade Faturar C/ Encomendas' = ```
			
			VAR _1 =
			CALCULATE(
			    YEAR( MAX( Encomendas[Data Exibição] ) )
			    ,FILTER(
			        ALL( Encomendas )
			        ,Encomendas[EntidadeFacturarId] = Entidade_Faturar[IdEntidadeFaturar]
			    )
			)
			// LOOKUPVALUE( 
			//     Encomendas[UltimaEncomenda]
			//     ,Encomendas[AgenciaMeiosId]
			//     ,'Agencia Meios'[entId]
			// )
			VAR _2 =
			IF( _1 = BLANK(), 0, _1 )
			RETURN
			IF( _2 = 0, "OUTROS", Entidade_Faturar[Entidade Faturar] )
			```
