	partition FaixaHoraria-6e8c35ff-11e7-422c-ac2a-c3e2084f4038 = calculated
		mode: import
		source =
				
				VAR _1 =
				SELECTCOLUMNS(
				    Encomendas
				    ,"FH", Encomendas[Faixa_Horaria]
				    ,"Order", FORMAT( Encomendas[Faixa_Horaria], "General Number" )
				    ,"FH (text)", Encomendas[Faixa_Horaria] & ":00"
				)
				VAR _2 =
				SELECTCOLUMNS(
				    Audiencias
				    ,"FH", Audiencias[Faixa_Horaria]
				    ,"Order", FORMAT( Audiencias[Faixa_Horaria], "General Number" )
				    ,"FH (text)", Audiencias[Faixa_Horaria] & ":00"
				)
				VAR _3 =
				SELECTCOLUMNS(
				    Yumi_Valores
				    ,"FH", Yumi_Valores[Faixa_Horaria]
				    ,"Order", FORMAT( Yumi_Valores[Faixa_Horaria], "General Number" )
				    ,"FH (text)", Yumi_Valores[Faixa_Horaria] & ":00"
				)
				VAR _4 =
				SELECTCOLUMNS(
				    'Yumi_Exibição'
				    ,"FH", 'Yumi_Exibição'[Faixa_Horaria]
				    ,"Order", FORMAT( 'Yumi_Exibição'[Faixa_Horaria], "General Number" )
				    ,"FH (text)", 'Yumi_Exibição'[Faixa_Horaria] & ":00"
				)
				VAR _5 =
				SELECTCOLUMNS(
				    Ocupacao
				    ,"FH", Ocupacao[Faixa_Horaria]
				    ,"Order", FORMAT( Ocupacao[Faixa_Horaria], "General Number" )
				    ,"FH (text)", Ocupacao[Faixa_Horaria] & ":00"
				)
				
				VAR _UN =
				UNION(_1, _2, _3, _4)
				VAR Result =
				FILTER( SUMMARIZE( _UN,[FH], [Order], [FH (text)] ), [FH] <> BLANK() )
				RETURN
				Result

	annotation PBI_Id = c215e1804ee64599a7e010a356bbb4fc

