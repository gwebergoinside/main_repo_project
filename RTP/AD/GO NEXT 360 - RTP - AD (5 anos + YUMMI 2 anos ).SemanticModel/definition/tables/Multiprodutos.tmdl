	column 'Taxa Posição %'
		dataType: double
		lineageTag: a54c60b4-2e70-4b04-8558-5779f7de7821
		summarizeBy: sum
		sourceColumn: Taxa Posição %

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Multiprodutos-ab7499bb-5ae5-4cc6-8301-85b32c939cbb = m
		mode: import
		queryGroup: Encomendas
		source = ```
				let
				    SQL = "Select
				        x.encid,
				        x.ordPubCodigo,
				        x.camAnunciante,
				        x.camDistribuidor As AgenciaMeiosId,
				        x.camVendedor,
				        x.camEntidadeFacturar As EntidadeFacturarId,
				        x.camCentralCompras As CentralComprasId,
				        x.camAgencia As AgenciaId,
				        x.camDescricao As DescricaoCampanhas,
				        x.priId As PrioridadeId,
				        x.canCodigo,
				        x.greComId,
				        x.tipPubId,
				        DATEFROMPARTS(x.ordPubAno, x.ordPubMes, 1) As dia,
				        x.negPerTipo,
				        x.bonus,
				        x.encValorTabNeg,
				        valorTaxaPosicao =
				            ROUND( x.encValorTabNeg
				                *   ( 1 - COALESCE(x.encDescontoExibicao, 0) / 100.0)
				                *   ( 1 - COALESCE(x.ordPubDescontoGlobal, 0) / 100.0)
				                *   ( COALESCE(x.encTaxaPosicao, 0) / 100.0)
				                , 4 ),
				    --  valorTaxaPosicao = Round((x.encValorTabNeg * (x.encTaxaPosicao / 100)), 4),
				    --  valorTaxaPosicao =
				    --      ROUND(
				    --            ( x.encValorTabNeg
				    --          -   ( x.encValorTabNeg * (x.encDescontoExibicao / 100 ) ) 
				    --          -   ( x.encValorTabNeg * ( 1 - (x.encDescontoExibicao / 100) ) )
				    --          *   ( x.ordPubDescontoGlobal / 100 ) 
				    --             ) * ( x.encTaxaPosicao / 100 ), 4 ),
				        valorTaxaMultiproduto =
				            ROUND(
				                    ( x.encValorTabNeg
				                -   ( x.encValorTabNeg * (x.encDescontoExibicao / 100 ) ) 
				                -   ( x.encValorTabNeg * (1 - (x.encDescontoExibicao / 100) ) )
				                *   ( x.ordPubDescontoGlobal / 100 )
				                    ) * (x.ordPubSpoTaxaMultiproduto / 100) , 4),
				    --  valorTaxaMultiproduto = Round( (Round( (x.encValorTabNeg * (1 + (x.encTaxaPosicao / 100))), 4)) * (x.ordPubSpoTaxaMultiproduto / 100), 4),
				        valorDescontoExibicao =
				            ROUND( x.encValorTabNeg * ( x.encDescontoExibicao / 100 ), 4 ),
				    --    valorDescontoCampanha = Round(x.encValorTabNeg + Round((x.encValorTabNeg * (x.encTaxaPosicao / 100)), 4) +
				    --    Round((Round((x.encValorTabNeg * (1 + x.encTaxaPosicao / 100)), 4)) * (x.ordPubSpoTaxaMultiproduto / 100),
				    --    4) - Round(x.encValorTabNeg * (x.encDescontoExibicao / 100), 4), 4) * (x.camDescontoGlobal / 100),
				        valorDescontoCampanha =
				            ROUND(
				                x.encValorTabNeg *
				                ( (1 + COALESCE(x.encTaxaPosicao, 0) / 100.0 )
				                * ( 1 + COALESCE(x.ordPubSpoTaxaMultiproduto, 0 ) / 100.0)
				                - ( COALESCE(x.encDescontoExibicao, 0) / 100.0)
				                ), 4) * ( COALESCE(x.camDescontoGlobal, 0) / 100.0 ),
				    --   valorDescontoOP = Round((Round(x.encValorTabNeg + Round((x.encValorTabNeg * (x.encTaxaPosicao / 100)), 4) +
				    --   Round((Round((x.encValorTabNeg * (1 + (x.encTaxaPosicao / 100))), 4)) * (x.ordPubSpoTaxaMultiproduto / 100), 4) -
				    --   Round(x.encValorTabNeg * (x.encDescontoExibicao / 100), 4), 4) - Round(Round(x.encValorTabNeg +
				    --   Round((x.encValorTabNeg * (x.encTaxaPosicao / 100)), 4) + Round((Round((x.encValorTabNeg * (1 + x.encTaxaPosicao /
				    --   100)), 4)) * (x.ordPubSpoTaxaMultiproduto / 100), 4) - Round(x.encValorTabNeg * (x.encDescontoExibicao / 100), 4),
				    --   4) * (x.camDescontoGlobal / 100), 4)) * (x.ordPubDescontoGlobal / 100), 4),
				        valorDescontoOP = Round( ( x.encValorTabNeg * (1 - (x.encDescontoExibicao / 100) ) ) * ( x.ordPubDescontoGlobal / 100 ),4 ) ,
				        valorCustoMinimo = Case
				            When x.parValMinId <> 0
				            Then x.encValorPub + x.encValorBonus - Round(Round(x.encValorTabNeg + Round((x.encValorTabNeg *
				                (x.encTaxaPosicao / 100)), 4) + Round((Round((x.encValorTabNeg * (1 + (x.encTaxaPosicao / 100))), 4)) *
				                (x.ordPubSpoTaxaMultiproduto / 100), 4) - Round(x.encValorTabNeg * (x.encDescontoExibicao / 100), 4), 4) -
				                Round(Round(x.encValorTabNeg + Round((x.encValorTabNeg * (x.encTaxaPosicao / 100)), 4) +
				                Round((Round((x.encValorTabNeg * (1 + x.encTaxaPosicao / 100)), 4)) * (x.ordPubSpoTaxaMultiproduto / 100),
				                4) - Round(x.encValorTabNeg * (x.encDescontoExibicao / 100), 4), 4) * (x.camDescontoGlobal / 100),
				                4) - Round((Round(x.encValorTabNeg + Round((x.encValorTabNeg * (x.encTaxaPosicao / 100)), 4) +
				                Round((Round((x.encValorTabNeg * (1 + (x.encTaxaPosicao / 100))), 4)) * (x.ordPubSpoTaxaMultiproduto / 100),
				                4) - Round(x.encValorTabNeg * (x.encDescontoExibicao / 100), 4), 4) - Round(Round(x.encValorTabNeg +
				                Round((x.encValorTabNeg * (x.encTaxaPosicao / 100)), 4) + Round((Round((x.encValorTabNeg * (1 +
				                x.encTaxaPosicao / 100)), 4)) * (x.ordPubSpoTaxaMultiproduto / 100), 4) - Round(x.encValorTabNeg *
				                (x.encDescontoExibicao / 100), 4), 4) * (x.camDescontoGlobal / 100), 4)) * (x.ordPubDescontoGlobal / 100),
				                4), 2)
				            Else 0
				        End,
				        x.encValorBonus,
				        x.encValorPub,
				        x.pacId,
				        x.camGrupoId,
				        x.encTaxaPosicao AS [Taxa Posição %],
				        x.codAlvo,
				        x.MinutosExib,
				        x.ordPubNegociacao,
				        x.proId
				    From
				        ( Select
				            encomendas.encid,
				            encomendas.ordPubCodigo,
				            campanhas.camAnunciante,
				            campanhas.camDistribuidor,
				            campanhas.camVendedor,
				            campanhas.camEntidadeFacturar,
				            campanhas.camCentralCompras,
				            campanhas.camAgencia,
				            campanhas.camDescricao,
				            encomendas.priId,
				            ordemPub.ordPubAno,
				            ordemPub.ordPubMes,
				            ordemPub.canCodigo,
				            ordemPub.tipPubId,
				            IsNull(bonus.flgValorizacao, 1) As bonus,
				            encomendas.parValMinId,
				            GlobalParam.Valor,
				            Case ordemPub.ordPubFlagFixo
				                When 2
				                Then IsNull(negPeriodos.negPerTipo, '')
				                When 1
				                Then 'V'
				                Else 'D'
				            End As negPerTipo,
				            encomendas.encValorTab,
				            Round(Case Case ordemPub.ordPubFlagFixo
				                    When 2
				                    Then IsNull(negPeriodos.negPerTipo, '')
				                    When 1
				                    Then 'V'
				                    Else 'D'
				                End
				                When 'F'
				                Then encomendas.encValorTab * encomendasAudiencias.encIndice * encomendasAudiencias.encDescontoSup *
				                    encomendasAudiencias.encCusto_Indice_Rating
				                When 'G'
				                Then encomendasAudiencias.encRating * encomendasAudiencias.encIndice * encomendasAudiencias.encDescontoSup
				                    * encomendasAudiencias.encCusto_Indice_Rating * encomendas.encIndiceEq
				                When 'T'
				                Then encomendasAudiencias.encDescontoSup * encomendasAudiencias.encCusto_Indice_Rating *
				                    encomendas.encIndiceEq
				                Else encomendas.encValorTab
				            End, 2) As encValorTabNeg,
				            encomendas.encValorBonus,
				            encomendas.encValorPub,
				            IsNull( campanhas.camDescontoGlobal, 0) As camDescontoGlobal,
				            IsNull( ordemPub.ordPubDescontoGlobal, 0) As ordPubDescontoGlobal,
				            IsNull( encomendas.encTaxaPosicao, 0) As encTaxaPosicao,
				            IsNull( encomendas.encDescontoExibicao, 0) As encDescontoExibicao,
				            IsNull( ordemPubSpots.ordPubSpoTaxaMultiproduto, IsNull(spots.spoTaxaMultiproduto,
				            0)) As ordPubSpoTaxaMultiproduto,
				            IsNull( encomendas.encIndiceEq, 0) As encIndiceEq,
				            IsNull( encomendasAudiencias.encRating, 0) As encRating,
				            IsNull( encomendasAudiencias.encDescontoSup, 0) As encDescontoSup,
				            IsNull( encomendasAudiencias.encIndice, 0) As encIndice,
				            IsNull( encomendasAudiencias.encCusto_Indice_Rating, 0) As encCusto_Indice_Rating,
				            pacotes.pacId,
				            campanhas.camGrupoId,
				            ordemPub.codAlvo,
				            encomendas.greComId,
				            encomendas.greComHoraInicio As MinutosExib,
				            ordemPub.ordPubNegociacao,
				            ordemPub.proId
				        From encomendas
				            Join ordemPub
				                On ordemPub.ordPubCodigo = encomendas.ordPubCodigo
				            Join ordemPubSpots
				                On ordemPubSpots.ordPubCodigo = encomendas.ordPubCodigo
				                And ordemPubSpots.ordPubSpoNumero = encomendas.ordPubSpoNumero
				            Join campanhas
				                On campanhas.camId = ordemPub.camId
				            Join GlobalParam
				                On GlobalParam.Chave = 'FormulaCalculoPublicidade'
				            Left Join spots
				                On spots.spoId = ordemPubSpots.spoId
				            Left Join bonus
				                On bonus.bonId = encomendas.bonId
				            Left Join negPeriodos
				                On negPeriodos.negPerId = ordemPub.ordPubNegociacao
				            Left Join encomendasAudiencias
				                On encomendasAudiencias.encId = encomendas.encid
				            Left Join pacotes With(NoLock)
				                On ordemPub.pacId = pacotes.pacId
				
				    Union All
				
				        Select
				            encomendas.encId,
				            encomendas.ordPubCodigo,
				            campanhas.camAnunciante,
				            campanhas.camDistribuidor As AgenciaMeiosId,
				            campanhas.camVendedor,
				            campanhas.camEntidadeFacturar As EntidadeFacturarId,
				            campanhas.camCentralCompras As CentralComprasId,
				            campanhas.camAgencia As AgenciaId,
				            campanhas.camDescricao As DescricaoCampanhas,
				            encomendas.priId As PrioridadeId,
				            ordemPub.ordPubAno,
				            ordemPub.ordPubMes,
				            ordemPub.canCodigo,
				            ordemPub.tipPubId,
				            IsNull(bonus.flgValorizacao, 1) As bonus,
				            encomendas.parValMinId,
				            GlobalParam.Valor,
				            Case ordemPub.ordPubFlagFixo
				                When 2
				                Then IsNull(negPeriodos.negPerTipo, '')
				                When 1
				                Then 'V'
				                Else 'D'
				            End As negPerTipo,
				            encomendas.encValorTab,
				            Round(Case Case ordemPub.ordPubFlagFixo
				                    When 2
				                    Then IsNull(negPeriodos.negPerTipo, '')
				                    When 1
				                    Then 'V'
				                    Else 'D'
				                End
				                When 'F'
				                Then encomendas.encValorTab * encomendasAudiencias.encIndice * encomendasAudiencias.encDescontoSup *
				                    encomendasAudiencias.encCusto_Indice_Rating
				                When 'G'
				                Then encomendasAudiencias.encRating * encomendasAudiencias.encIndice * encomendasAudiencias.encDescontoSup
				                    * encomendasAudiencias.encCusto_Indice_Rating * encomendas.encIndiceEq
				                When 'T'
				                Then encomendasAudiencias.encDescontoSup * encomendasAudiencias.encCusto_Indice_Rating *
				                    encomendas.encIndiceEq
				                Else encomendas.encValorTab
				            End, 2) As encValorTabNeg,
				            encomendas.encValorBonus,
				            encomendas.encValorPub,
				            IsNull(campanhas.camDescontoGlobal, 0) As camDescontoGlobal,
				            IsNull(ordemPub.ordPubDescontoGlobal, 0) As ordPubDescontoGlobal,
				            IsNull(encomendas.encTaxaPosicao, 0) As encTaxaPosicao,
				            IsNull(encomendas.encDescontoExibicao, 0) As encDescontoExibicao,
				            IsNull(ordemPubSpots.ordPubSpoTaxaMultiproduto, IsNull(spots.spoTaxaMultiproduto,
				            0)) As ordPubSpoTaxaMultiproduto,
				            IsNull(encomendas.encIndiceEq, 0) As encIndiceEq,
				            IsNull(encomendasAudiencias.encRating, 0) As encRating,
				            IsNull(encomendasAudiencias.encDescontoSup, 0) As encDescontoSup,
				            IsNull(encomendasAudiencias.encIndice, 0) As encIndice,
				            IsNull(encomendasAudiencias.encCusto_Indice_Rating, 0) As encCusto_Indice_Rating,
				            pacotes.pacId,
				            campanhas.camGrupoId,
				            ordemPub.codAlvo,
				            encomendas.greComId,
				            encomendas.greComHoraInicio As MinutosExib,
				            ordemPub.ordPubNegociacao,
				            ordemPub.proId
				        From
				            encomendasExibidas encomendas
				            Join ordemPub
				                On ordemPub.ordPubCodigo = encomendas.ordPubCodigo
				            Join ordemPubSpots
				                On ordemPubSpots.ordPubCodigo = encomendas.ordPubCodigo
				                And ordemPubSpots.ordPubSpoNumero = encomendas.ordPubSpoNumero
				            Join campanhas
				                On campanhas.camId = ordemPub.camId
				            Join GlobalParam
				                On GlobalParam.Chave = 'FormulaCalculoPublicidade'
				            Left Join spots
				                On spots.spoId = ordemPubSpots.spoId
				            Left Join bonus
				                On bonus.bonId = encomendas.bonId
				            Left Join negPeriodos
				                On negPeriodos.negPerId = ordemPub.ordPubNegociacao
				            Left Join encomendasAudiencias
				                On encomendasAudiencias.encId = encomendas.encId
				            Left Join pacotes With(NoLock)
				                On ordemPub.pacId = pacotes.pacId) x
				        Where
				            x.ordPubAno >= Year(GetDate()) - " & AnoUpdateGMedia,
				    Source = Sql.Database(ServerP, BD, [Query = SQL])
				in
				    Source
				```

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

