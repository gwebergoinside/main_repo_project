	partition Negociacao-cf9c104c-5096-4892-b80d-87b387236f37 = m
		mode: import
		queryGroup: Negociações
		source = ```
				let
				    SQL = "Select
				         negPeriodos.canCodigo As Cod_Canal,
				         negPeriodos.negPerId,
				         negPeriodos.negPerDescricao As [Nome Negociacao],
				         negPeriodos.negPerDataInicio As DataInicio,
				         negPeriodos.negPerDataFim As DataFim,
				         negPeriodos.negPerTipo As Tipo,
				         negPeriodos.negPerTipValor,
				         negPeriodos.codAlvo As Cod_Alvo,
				         negPeriodos.audPaiId,
				         negPeriodos.negPerIndEq As [IndEquiv.],
				         negPeriodos.negPerResponsavel As Responsavel,
				         negPeriodos.negPerObservacoes As Observacoes,
				         negociacao.negId,
				         perfil_cc.anuId As AnuncianteId,
				         SUM( negociacao.negValor ) As NegociacaoValor
				     From negPeriodos 
						 Join negociacao
				            On negociacao.negPerId = negPeriodos.negPerId
						 Left Join perfil_cc
				            On perfil_cc.perId = negPeriodos.perId 
				     Group By
				         negPeriodos.canCodigo,
				         negPeriodos.negPerId,
				         negPeriodos.negPerDescricao,
				         negPeriodos.negPerDataInicio,
				         negPeriodos.negPerDataFim,
				         negPeriodos.negPerTipo,
				         negPeriodos.negPerTipValor,
				         negPeriodos.codAlvo,
				         negPeriodos.audPaiId,
				         negPeriodos.negPerIndEq,
				         negPeriodos.negPerResponsavel,
				         negPeriodos.negPerObservacoes,
				         negociacao.negId,
				         perfil_cc.anuId",
				    Source = Sql.Database(ServerP, BD, [Query = SQL])
				in
				    Source
				```

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

