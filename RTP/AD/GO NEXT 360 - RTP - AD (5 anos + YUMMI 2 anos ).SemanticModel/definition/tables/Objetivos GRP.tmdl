	partition 'Objetivos GRP' = calculated
		mode: import
		source = ```
				
				    GROUPBY(
				        FILTER( Encomendas
				            , ABS( Encomendas[GRP Objetivo] + Encomendas[grpPrevisto] + Encomendas[grpReal] ) > 0 )
				        , 'Nº Ordem pub'[Nº ordem pub]
				        , Encomendas[AgenciaId]
				        , Encomendas[AgenciaMeiosId]
				        , Encomendas[anuncianteId]
				        , Encomendas[camGrupoId]
				        , Encomendas[CentralComprasId]
				        , Encomendas[EntidadeFacturarId]
				        , Encomendas[ordPubClaId]
				        , Encomendas[pacId]
				        , Encomendas[tipPubId]
				        , Encomendas[proId]
				        , Encomendas[Canal]
				        , Encomendas[canCodigo]
				        , Encomendas[cod_alvo]
				        , Encomendas[DescricaoCampanhas]
				        , Encomendas[negPerTipo]
				        , Encomendas[vendedor]
				        , "DayPart (id)", SUMX( CURRENTGROUP(), BLANK())
				        , "diaExib", MINX( CURRENTGROUP(), Encomendas[diaExib] )
				        , "GRP Objetivo", MAXX( CURRENTGROUP(), Encomendas[GRP Objetivo] )
				    )
				```

	annotation PBI_Id = cc7950b31ced4b81a92befc77c192227

