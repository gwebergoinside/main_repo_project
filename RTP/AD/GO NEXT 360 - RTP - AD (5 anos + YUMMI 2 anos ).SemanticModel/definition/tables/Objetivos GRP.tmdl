table 'Objetivos GRP'
	lineageTag: 49d451d8-5888-4a6d-aa1a-008b2eb90947

	measure 'GRP Eq Alcance' =
			
			// Soma do Previsto e Real
			VAR _calculo =
			     [GRP Eq Total] - SUM ('Objetivos GRP'[GRP Eq Objetivo])
			RETURN
			    IF ( ISBLANK ( SUM ( 'Objetivos GRP'[GRP Eq Objetivo] ) ), BLANK (), _calculo )
		formatString: 0.00
		lineageTag: 6293b554-de7b-4cd0-9aa7-18d37631ddf9

	column 'GRP Eq Objetivo'
		lineageTag: 0157aae3-17f8-406c-bf61-4e96b3985407
