	partition Objetivos-d443ff34-4878-41a1-9612-6b4afea6d1f3 = m
		mode: import
		queryGroup: Encomendas
		source =
				let
				    SQL = "SELECT
				            utiId,
				            tipPubId,
				            canCodigo,
				            negObjTipo,
				            negObjValor AS [Objetivo Liquido],
				            negObjValorBruto AS [Objetivo Bruto],
				            negObjMes,
				            negObjAno,
				            perId,
				            negObjId,
				            anuId
				        FROM NegociacaoObjectivos
				        WHERE negObjAno >= YEAR( GETDATE() ) - " & AnoUpdateGMedia,
				    Source = Sql.Database(ServerP, BD, [Query = SQL])
				in
				    Source

