	partition 'Outros Custos-cf797c06-6a23-4f30-a3c5-e6bc09848300' = m
		mode: import
		queryGroup: Encomendas
		source =
				let
				    SQL = " Select
				            op.ordPubCodigo,
				            op.ordPubDetFactValor As valor,
				            DATEFROMPARTS(ordemPub.ordPubAno, ordemPub.ordPubMes, 1) As dia,
				            ordemPub.canCodigo,
				            ordemPub.tipPubId,
				            campanhas.camAnunciante,
				            campanhas.camVendedor,
				            campanhas.camEntidadeFacturar As EntidadeFacturarId,
				            campanhas.camCentralCompras As CentralComprasId,
				            campanhas.camDistribuidor As AgenciaMeiosId,
				            campanhas.camAgencia As AgenciaId,
				            campanhas.camDescricao As DescricaoCampanhas,
				            negPeriodos.negPerTipo,
				            ordemPub.priId As PrioridadeId,
				            ordemPub.pacId,
				            campanhas.camGrupoId,
				            IsNull(ordemPub.codAlvo, " & AlvoPadrao & ") As codAlvo,
				            ordemPub.ordPubNegociacao,
				            ordemPub.proId
				        From
				            ordemPubDetalheFact op
				        Left Join ordemPub
				            On op.ordPubCodigo = ordemPub.ordPubCodigo
				        Left Join campanhas
				            On ordemPub.camId = campanhas.camId
				        Left Join negPeriodos
				            On ordemPub.ordPubNegociacao = negPeriodos.negPerId
				        Where
				            ordemPub.ordPubAno >= Year(GetDate()) - " & AnoUpdateGMedia,
				    Source = Sql.Database(ServerP, BD, [Query = SQL])
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

