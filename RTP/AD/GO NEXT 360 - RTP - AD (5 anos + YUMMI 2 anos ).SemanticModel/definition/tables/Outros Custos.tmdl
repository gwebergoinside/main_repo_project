	column TipoEncomenda = ```
			
			    // LOOKUPVALUE( Encomendas[tipo], Encomendas[Nº ordem pub], 'Outros Custos'[ordPubCodigo] )
			    CALCULATE( 
			        MAX( Encomendas[tipo] )
			        ,FILTER( 
			            ALL( Encomendas ), Encomendas[Nº ordem pub] = 'Outros Custos'[ordPubCodigo]
			        )
			        , Encomendas[tipo] <> "X"
			    )
			```
		isHidden
		lineageTag: 33071244-dc25-4946-aaa3-9e19318e7eab
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column TaxaPosição =
			
			LOOKUPVALUE( Multiprodutos[Taxa Posição %], Multiprodutos[ordPubCodigo], 'Outros Custos'[ordPubCodigo] )
		isHidden
		lineageTag: a61dd045-6f21-4c2d-a16f-c6b7e5c6b39e
		summarizeBy: none

		changedProperty = IsHidden

