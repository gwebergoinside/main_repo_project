	partition Pacotes-6c3219a3-65c0-4dab-8bc5-2b37a544fbff = m
		mode: import
		queryGroup: Encomendas
		source =
				let
				    SQL = "SELECT
				            pacId,
				            pacDescricao AS Pacote,
				            pacDescricaoBreve AS PacoteBreve,
				        --  pacflgLivre AS pacFlgValidaReserva,
				            CASE
				                WHEN pacflgLivre = 0 THEN 'Package'
				                WHEN pacflgLivre = 1 THEN 'Livre'
				                ELSE NULL END AS [Tipo Pacote]
				        FROM pacotes",
				    Source = Sql.Database(ServerP, BD, [Query = SQL])
				in
				    Source

