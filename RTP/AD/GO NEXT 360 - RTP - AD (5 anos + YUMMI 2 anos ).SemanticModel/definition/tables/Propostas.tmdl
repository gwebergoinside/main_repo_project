	partition Propostas-9bd57433-3bd1-4bc6-9644-a8f47405380b = m
		mode: import
		queryGroup: Encomendas
		source =
				let
				    SQL = "SELECT
				        p.proValorPub As ValorPubProposta,
				        p.proDataInicio,
				        p.produtoDesc AS StatusProduto,
				        p.proNumero,
				        p.vendedorId,
				        ae.estadoDesc AS Status,
				        an.accNegDataInicio,
				        an.accNegValorPlano As accNegValorPlano,
				        an.canCodigo,
				        p.proDataCria,
				        p.propostaId,
				        an.accNegId,
				        p.proANId,
				        an.tipPubId
				    FROM Propostas p
				        LEFT JOIN accaoEstados ae
				            ON ae.estadoId = p.proEstado
				        LEFT JOIN accaoNegociacao an
				            ON p.propostaId = an.propostaId
				        FULL JOIN entidades e
				            ON e.entId = p.proANId
				        LEFT JOIN Vendedores v
				            ON v.UtiId = p.vendedorId
				    WHERE
				        YEAR(an.accNegDataInicio) >= YEAR( GETDATE() ) - " & AnoUpdateGMedia,
				    Source = Sql.Database(ServerP, BD, [Query = SQL])
				in
				    Source

	changedProperty = IsHidden

