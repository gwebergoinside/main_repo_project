	column 'Tipo Publicidade (agrupamento)'
		dataType: string
		lineageTag: 31030907-aee0-450d-9141-c207f694ee66
		summarizeBy: none
		sourceColumn: Tipo Publicidade (agrupamento)

		annotation SummarizationSetBy = Automatic

	partition TipoPublicidade-912ea09b-6d9b-4579-946b-39723dcee53c = m
		mode: import
		queryGroup: Encomendas
		source =
				let
				    SQL = "SELECT
				            tipPubId,
				            tipPubDescricao AS [Tipo Publicidade],
				            CASE
				                WHEN tipPubDescricao LIKE '%ESPECIAL%' THEN 'INSTITUCIONAL'
				                WHEN tipPubDescricao LIKE '%NORMAL%' THEN 'NORMAL'
				                WHEN tipPubDescricao LIKE '%PATROCINIOS%' THEN 'PATROCINIOS'
				                WHEN tipPubDescricao LIKE '%CARTOES PUB%' THEN 'CARTÕES DE PATROCÍNIO'
				                WHEN tipPubDescricao LIKE '%RTP SPONSOR/COL.PRODUTO%' THEN 'SOFTSPONSORING'
				                WHEN tipPubDescricao LIKE '%BLOCO DE TELEVENDA (TELEVENDA FORA EMISSÃO)%' THEN 'TELEVENDAS'
				                WHEN tipPubDescricao LIKE '%PROMO SPONSORIZADAS%' THEN 'SOFTSPONSORING'
				                WHEN tipPubDescricao LIKE '%ECRÃ FRACCIONADO/SPLIT-SCREEN%' THEN 'NORMAL'
				                WHEN tipPubDescricao LIKE '%TELEPROMOÇÃO%' THEN 'SOFTSPONSORING'
				                WHEN tipPubDescricao LIKE '%TELEVENDAS%' THEN 'NORMAL'
				                WHEN tipPubDescricao LIKE '%Morphing%' THEN 'SOFTSPONSORING'
				                ELSE tipPubDescricao END AS [Tipo Publicidade (agrupamento)]
				            FROM TipoPublicidade",
				    Source = Sql.Database(ServerP, BD, [Query = SQL])
				    // Custom1 = Table.AddColumn(Source, "TipoPublicidade", each
				    //     if [tipPubDescricao] = "ESPECIAL       " then "INSTITUCIONAL" else
				    //     if [tipPubDescricao] = "NORMAL         " then "NORMAL" else
				    //     if [tipPubDescricao] = "PATROCINIOS    " then "PATROCINIOS" else
				    //     if [tipPubDescricao] = "CARTOES PUB    " then "CARTÕES DE PATROCÍNIO" else
				    //     if [tipPubDescricao] = "RTP SPONSOR/COL.PRODUTO" then "SOFTSPONSORING" else
				    //     if [tipPubDescricao] = "BLOCO DE TELEVENDA (TELEVENDA FORA EMISSÃO)" then "TELEVENDAS" else
				    //     if [tipPubDescricao] = "PROMO SPONSORIZADAS" then "SOFTSPONSORING" else
				    //     if [tipPubDescricao] = "ECRÃ FRACCIONADO/SPLIT-SCREEN" then "NORMAL" else
				    //     if [tipPubDescricao] = "TELEPROMOÇÃO" then "SOFTSPONSORING" else
				    //     if [tipPubDescricao] = "TELEVENDAS" then "NORMAL" else
				    //     if [tipPubDescricao] = "Morphing Promocao" then "SOFTSPONSORING" else
				    //     if [tipPubDescricao] = "Morphing" then "SOFTSPONSORING" else
				    //     if [tipPubDescricao] = "Morphing Especial" then "SOFTSPONSORING" else
				    //     [tipPubDescricao], type text),
				    // #"Renamed Columns" = Table.RenameColumns(Custom1,{{"tipPubDescricao", "Tipo Publicidade"}, {"TipoPublicidade", "Tipo Publicidade (agrupamento)"}})
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

