	column 'Tipo de Receita' = ```
			
			SWITCH(
			    TRUE()
			    , 'TipoPublicidade'[Tipo Publicidade] = "APOIO À PRODUÇÃO DIGITAL",	"Produção"
			    , 'TipoPublicidade'[Tipo Publicidade] = "APOIO A PRODUÇÃO RADIO",	"Produção" 
			    , 'TipoPublicidade'[Tipo Publicidade] = "APOIO À PRODUÇAO TV",	"Produção"
			    , 'TipoPublicidade'[Tipo Publicidade] = "BLOCO DE TELEVENDA (TELEVENDA FORA EMISSÃO)",	"Media TV"
