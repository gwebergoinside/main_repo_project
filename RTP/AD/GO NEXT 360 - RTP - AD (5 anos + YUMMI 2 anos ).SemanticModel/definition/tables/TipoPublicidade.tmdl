	column 'Tipo Publicidade C/ Encomendas' =
			
			VAR _1 =
			CALCULATE(
			    YEAR( MAX( Encomendas[Data Exibição] ) )
			    ,FILTER(
			        ALL( Encomendas )
			        ,Encomendas[tipPubId] = TipoPublicidade[tipPubId]
			    )
			)
			VAR _2 =
			IF( _1 = BLANK(), 0, _1 )
			RETURN
			IF( _2 = 0, "OUTROS", TipoPublicidade[Tipo Publicidade] )
		isHidden
		lineageTag: fab1d7b2-466d-4abb-9ec4-64e41cb52a1a
