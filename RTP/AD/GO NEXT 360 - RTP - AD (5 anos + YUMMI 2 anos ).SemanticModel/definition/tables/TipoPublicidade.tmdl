			    , 'TipoPublicidade'[Tipo Publicidade] = "PROMO SPONSORIZADAS",	"Media TV"
			    , 'TipoPublicidade'[Tipo Publicidade] = "RTP SPONSOR/COL.PRODUTO",	"Media TV"
			    , 'TipoPublicidade'[Tipo Publicidade] = "TELEPROMOÇÃO",	"Media TV"	
			    , 'TipoPublicidade'[Tipo Publicidade] = "TELEVENDAS",	"Media TV"
			)
			```
