	partition 'Variacao Receita-773407c8-ae72-4c49-acc6-3422b189151d' = m
		mode: import
		queryGroup: Encomendas
		source =
				let
				    SQL = "SELECT
				          CAST(data_carregamento - 1 AS DATE) AS DataCarregamento
				        , data_carregamento AS data_job
				        , valorMensalId
				        , clienteId
				        , distribuidorId
				        , anuncianteId
				        , centralcomprasId
				        , agenciaId
				        , prodId
				        , tipProId
				        , pacId
				        , executivoId
				        , grupoId
				        , mes AS Mes
				        , ano AS Ano
				        , mesFacturacao
				        , anoFacturacao
				        , edicao
				        , tipoPubId
				        , canCodigo
				        , valorFact
				        , sumValorPub AS ValorPub
				        , sumValorTab AS ValorTab
				        , sumValorBonus AS ValorBonus
				        , ordPubCodigo
				        , negperid
				        , formato
				    FROM ValorMensalHistorico",
				    Source = Sql.Database(ServerP, BD, [Query = SQL])
				in
				    Source

	changedProperty = IsHidden

