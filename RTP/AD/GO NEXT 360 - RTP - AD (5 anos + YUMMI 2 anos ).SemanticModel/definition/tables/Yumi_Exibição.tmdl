	column Flag_Exclusivo = CALCULATE(DISTINCTCOUNT('Yumi_Exibição'[Grupo Canais]),ALLEXCEPT('Yumi_Exibição','Yumi_Exibição'[ADVERTISER_KEY],'Yumi_Exibição'[Year],'Yumi_Exibição'[Month]),'Yumi_Exibição'[Grupo Canais]<>blank(),'Yumi_Exibição'[Yumi_InvestimentoTabela]>0)
