	partition Yumi_Exibição-beedf99d-465d-4c58-9d14-486feffc7527 = m
		mode: import
		queryGroup: Share
		source =
				let
				    SQL = " SELECT
				              DATE
				            , YEAR(DATE) AS YEAR
				            , MONTH(DATE) AS MONTH
				            , START_HOUR -- AS `Yumi_Hora de Inicio`
				        --  , END_HOUR -- AS `Yumi_Hora de Fim`
				            , BREAK_CODE
				            , SPOT_KEY
				            , ADVERTISER_KEY
				            , BRAND_KEY
				            , SUB_BRAND_KEY
				            , SECTOR_KEY
				            , MEDIA_KEY
				            , CHANNEL_KEY
				            , PROGRAM_KEY
				            , TYPOLOGY_KEY
				            , SUB_TYPOLOGY_KEY
				            , TYPE_KEY
				            , LOCATION_KEY
				            , NO
				            , TO
				            , DURATION -- AS `Yumi_DuraçãoSpot`
				            , INVESTMENT -- AS `Yumi_InvestimentoTabela`
				        --  , DATE_KEY
				            , TIME_SPOT
				        --  , INVESTMENT_EQUI -- AS `Yumi_InvestimentoTabelaEq`
				        FROM pub.fact_exhibition
				        WHERE YEAR(DATE) >= YEAR(CURRENT_DATE()) - " & AnoUpdateYummi,
				    Source = fx_dbricks(SQL),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"START_HOUR", "Yumi_Hora de Inicio"}, /* {"END_HOUR", "Yumi_Hora de Fim"}, {"INVESTMENT_EQUI", "Yumi_InvestimentoTabelaEq"}, */ {"INVESTMENT", "Yumi_InvestimentoTabela"}, {"DURATION", "Yumi_DuraçãoSpot"}})
				in
				    #"Renamed Columns"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

