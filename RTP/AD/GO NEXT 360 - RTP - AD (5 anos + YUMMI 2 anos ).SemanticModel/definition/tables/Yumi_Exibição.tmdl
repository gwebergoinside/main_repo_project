	column Horario_Minutos = ```
			
			VAR Hours = 'Yumi_Exibição'[Hora]*60 
			VAR Minutes = FORMAT( MID( 'Yumi_Exibição'[Yumi_Hora de Inicio],4,2), "General Number") 
			VAR Seconds = FORMAT( RIGHT('Yumi_Exibição'[Yumi_Hora de Inicio],2), "General Number")/60 
			
			RETURN
			Hours+ Minutes + Seconds
			```
		isHidden
		formatString: 0
		lineageTag: 68ddc980-fc62-419d-93e2-e6f255f6f8b1
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Periodo_Ordem =
			
			SWITCH(
			    TRUE()
			    ,'Yumi_Exibição'[DayPart] = "Manhã 1",  1
			    ,'Yumi_Exibição'[DayPart] = "Manhã 2",2
			    ,'Yumi_Exibição'[DayPart] = "Almoço",3
			    ,'Yumi_Exibição'[DayPart] = "Tarde",4
			    ,'Yumi_Exibição'[DayPart] = "Acesso Prime",5
			    ,'Yumi_Exibição'[DayPart] = "Prime Time 1",6
			    ,'Yumi_Exibição'[DayPart] = "Prime Time 2",7
			    ,'Yumi_Exibição'[DayPart] = "Late Night",8
			    ,'Yumi_Exibição'[DayPart] = "Madrugada",9
			    ,'Yumi_Exibição'[DayPart] = "Outro",10
			)
		isHidden
		formatString: 0
