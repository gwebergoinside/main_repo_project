	column IdAnuncianteAD = ```
			
			VAR _1 = 
			CALCULATE (
			    FIRSTNONBLANK ( 'Ligacao Inv-Map'[IdAnunciante], 1 ),
			    FILTER ( ALL ( 'Ligacao Inv-Map' ), 'Ligacao Inv-Map'[Anunciante] = 'Yumi_Exibição'[Anunciante] )
			)
			RETURN
			IF.EAGER( _1 = BLANK(), 'Yumi_Exibição'[ADVERTISER_KEY] + 99999999999999999, _1 )
			```
		isHidden
		formatString: 0
		lineageTag: 7c321683-6453-49d0-8e09-69e86ad02027
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Anunciante = LOOKUPVALUE( Yumi_Anunciante[Yumi_Anunciante],Yumi_Anunciante[Yumi_Anunciante_Key], 'Yumi_Exibição'[ADVERTISER_KEY] )
		isHidden
		lineageTag: 80e12ae2-4b11-44d8-83f5-37067f6bb017
