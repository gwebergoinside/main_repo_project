	column CountCanais = CALCULATE( DISTINCTCOUNT( 'Yumi_Exibição'[CHANNEL_KEY] ), ALLEXCEPT( 'Yumi_Exibição', 'Yumi_Exibição'[Year], 'Yumi_Exibição'[Month]  , 'Yumi_Exibição'[ADVERTISER_KEY] ) )
		isHidden
