	column Investimento_apoio = ```
			
			VAR selected = 'Yumi_Exibição'[Grupo Canais]
			VAR soma = 'Yumi_Exibição'[Yumi_InvestimentoTabela]
			VAR Result = 
			SWITCH (
			    --selected,
			    TRUE(),
			    [Grupo Canais] = "TVI", soma - (soma * descontotvi ),
				[Grupo Canais] = "RTP", soma - (soma * descontortp ),
				[Grupo Canais] = "CMTV", soma - (soma * descontocmtv ),
				[Grupo Canais] = "SIC", soma - (soma * descontosic ),
			    [Grupo Canais] = "Cartoon Network", soma - (soma * descontocartoonnetwork ),
			    soma
			)
			RETURN
			Result
			```
		isHidden
		lineageTag: 8af39b2a-c5fe-43d7-80f7-8804a8f3ea65
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

