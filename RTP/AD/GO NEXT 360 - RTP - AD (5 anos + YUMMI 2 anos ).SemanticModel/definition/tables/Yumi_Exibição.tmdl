table Yumi_Exibição
	lineageTag: f4f3dcac-f04e-4699-9697-803d703823c8

	measure Investimento =
			
			SUM ( [Investimento_apoio] )
		formatString: #,0
		isHidden
		lineageTag: 33e6472f-6a85-476a-b2e9-a8c0da56d131

		changedProperty = IsHidden

	measure 'Investimento LY %' =
			
			VAR _LY =
			    CALCULATE ( [Investimento], SAMEPERIODLASTYEAR ( Calendario[Data] ) )
			RETURN
			    DIVIDE ( [Investimento] - _LY, _LY )
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		lineageTag: 70903eb5-3d88-476c-a847-1ce91aa33b31

		changedProperty = IsHidden

	measure Ultimo_Carregamento =
			
			"Último Carregamento: "
			    & CALCULATE (
			        FORMAT ( MAX ( 'Yumi_Exibição'[DATE] ), "dd/mm/yyyy", "pt-PT" ),
			        ALL ( 'Yumi_Exibição' )
			    )
		isHidden
		lineageTag: 4c92acd8-8d58-4294-92f3-45105640f379

		changedProperty = IsHidden

