	column 'DayPart Antigo' = ```
			
			    SWITCH(
			        TRUE()
			        ,Yumi_Valores[Time Column] >= 390  && Yumi_Valores[Time Column] < 480,  "06:30 - 07:59"
			        ,Yumi_Valores[Time Column] >= 480  && Yumi_Valores[Time Column] < 720,  "08:00 - 11:59"
			        ,Yumi_Valores[Time Column] >= 720  && Yumi_Valores[Time Column] < 870,  "12:00 - 14:29"
			        ,Yumi_Valores[Time Column] >= 870  && Yumi_Valores[Time Column] < 1080, "14:30 - 17:59"
			        ,Yumi_Valores[Time Column] >= 1080 && Yumi_Valores[Time Column] < 1200, "18:00 - 19:59"
			        ,Yumi_Valores[Time Column] >= 1200 && Yumi_Valores[Time Column] < 1350, "20:00 - 22:29"
			        ,Yumi_Valores[Time Column] >= 1350 && Yumi_Valores[Time Column] < 1440, "22:30 - 23:59"
			        ,Yumi_Valores[Time Column] >= 1440 && Yumi_Valores[Time Column] < 1590, "24:00 - 26:29"
			        ,Yumi_Valores[Time Column] >= 1590 || Yumi_Valores[Time Column] < 390 , "26:30 - 06:29"
			        ,"Outro"
			    )
			```
		isHidden
