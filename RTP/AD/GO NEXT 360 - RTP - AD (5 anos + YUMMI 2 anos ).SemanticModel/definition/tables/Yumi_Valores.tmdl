	column 'Time Column' =
			
			VAR _1 = LEFT(Yumi_Valores[START_HOUR], 2)
			VAR _2 = MID(Yumi_Valores[START_HOUR], 4, 2)
			VAR _3 = RIGHT(Yumi_Valores[START_HOUR], 2)
			RETURN
			VALUE(_1) * 60 +
			VALUE(_2) +
			VALUE(_3) / 60
		isHidden
		lineageTag: 50309d29-bced-43bb-bac1-092a02d62fc1
		summarizeBy: sum

