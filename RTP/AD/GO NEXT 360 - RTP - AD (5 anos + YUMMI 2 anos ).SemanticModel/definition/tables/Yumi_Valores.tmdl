	partition Yumi_Valores-b1685d79-6376-4ac9-85c1-ab01e1971a61 = m
		mode: import
		queryGroup: Share
		source =
				let
				    SQL = " SELECT
				              DATE
				            , START_HOUR
				            , END_HOUR
				            , BREAK_CODE
				            , SPOT_KEY
				            , ADVERTISER_KEY
				            , BRAND_KEY
				            , SUB_BRAND_KEY
				            , SECTOR_KEY
				            , MEDIA_KEY
				            , CHANNEL_KEY
				            , PROGRAM_KEY
				            , TARGET_KEY
				            , TYPOLOGY_KEY
				            , SUB_TYPOLOGY_KEY
				            , TYPE_KEY
				            , LOCATION_KEY
				            , SHARE
				            , NO
				            , TO
				        FROM pub.fact_audience
				        WHERE YEAR(DATE) >= YEAR(CURRENT_DATE()) - " & AnoUpdateYummi,
				    Source = fx_dbricks(SQL),
				    #"Renamed Columns" = Table.RenameColumns(Source, {{"SHARE", "Yumi_GRP Eq.20"}})
				in
				    #"Renamed Columns"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

