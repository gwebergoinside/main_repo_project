	measure 'Var Objetivo Anunciante YTD' = ```
			
			VAR __ReceitaLYTotal =
			    CALCULATE ( [Receita LY YTD], ALLSELECTED ( Calendario ) )
			VAR __Objetivo =
			    CALCULATE (
			        MAXX ( Negociacao, Negociacao[NegociacaoValor] ),
			        ALL ( Calendario )
			    )
			VAR __ReceitaLY = [Receita LY YTD]
			VAR Result =
			    ( DIVIDE ( __ReceitaLY * 100, __ReceitaLYTotal ) )
			        * DIVIDE ( __Objetivo, 100 )
			VAR __Obj =
			    CALCULATE (
			        Result,
			        FILTER (
			            ALL ( Calendario ),
			            'Calendario'[Ano] = MAX ( Calendario[Ano] )
			                && 'Calendario'[Mês (número)] <= MAX ( Calendario[Mês (número)] )
			        )
			    )
			VAR __Rec = [Receita YTD]
			RETURN
			    --IF( __Obj = __Rec ; 0 ; 
			    --IF( __Obj > __Rec ; 1 ; 2 ) )
			    DIVIDE ( __Rec, __Obj )
			```
		formatString: 0.00%;-0.00%;0.00%
		isHidden
