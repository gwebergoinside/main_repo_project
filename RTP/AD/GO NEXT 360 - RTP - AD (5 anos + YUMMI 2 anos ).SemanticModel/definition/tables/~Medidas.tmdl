	measure 'CPR Eq (Receita S/ Taxas)' =
			
			// CALCULATE(
			//     SUM( 'd_Neg_Característica'[carValor] )
			//     ,USERELATIONSHIP( Encomendas[ordPubNegociacao], 'd_Neg_Característica'[negPerId] )
			// )
			VAR _1 =
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( Duracao[Parametro] ) = 1, CALCULATE ( SUM ( Encomendas[GRP Total 20] ) ),
			        SELECTEDVALUE ( Duracao[Parametro] ) = 2, CALCULATE ( SUM ( Encomendas[GRP Total 30] ) )
			    )
			RETURN
			    DIVIDE ( [Receita (S/ Taxas)], _1 )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: Negociação
		lineageTag: be39280d-24d5-450d-a2d5-82a469829730

	measure 'Receita (S/ Taxas)' =
			
			VAR _1 =
			    CALCULATE (
			        SUM ( Encomendas[Valor Publicidade Bruto] ),
			        OrdemPubClassificacao[ordPubClaDescricao] <> "Pré-Facturação"
			    )
			RETURN
			    IF ( _1 = 0, BLANK (), _1 ) - [Valor Outros Custos] - [Valor Custo Minimo] - [Valor Taxa Multiproduto] - [Valor Taxa Posição]
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
