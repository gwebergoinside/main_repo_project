table ~Medidas
	lineageTag: 990b436c-ad8f-404f-b743-871182f2fd81

	measure Receita =
			
			SWITCH (
			    [Selected SalesParameter], -- MIN ( 'Valor'[ID] )
			    1,
			        CALCULATE (
			            SUM ( Encomendas[Valor Publicidade Bruto] ),
			            OrdemPubClassificacao[ordPubClaDescricao] <> "Pré-Facturação"
			        )
			            - CALCULATE ( [Desconto das Taxas], TipoNeg[negPerTipo] <> "V" ),
			    3,
			        [Valor Faturado Total] -- CALCULATE( SUM('Faturação'[valorFaturado]) - sum(Encomendas[valorComissaoAgencia] ) - [ValorRappel_Atual] )
			)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: Receita
		lineageTag: f9393cd9-2227-4a62-9a4d-f64a3591c69d

		changedProperty = FormatString

	measure 'Valor Tabela' =
			
			SUM ( Encomendas[Valor Tabela] )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: Tabela
		lineageTag: a65f3cfc-a000-4e75-b875-b09ed56ff80c

	measure Objetivo =
			
			SWITCH (
			    [Selected SalesParameter],
			    1, SUM ( Objetivos[Objetivo Bruto] ),
			    3, SUM ( Objetivos[Objetivo Bruto] ),
			    -- FICA O BRUTO ENQUANTO O FATURADO NÃO FOR LIQUIDO SUM(Objetivos[negObjValor]),
			    BLANK ()
			)
		formatString: #,0.0\ "€";-#,0.0\ "€";#,0.0\ "€"
		displayFolder: Objetivo
		lineageTag: 07c37b61-3bfd-4499-9048-b0ea389354c3

	measure 'Objetivo YTD' =
			
			CALCULATE (
			    [Objetivo],
			    FILTER (
			        ALL ( Calendario[Data] ),
			        Calendario[Data] <= MAX ( Calendario[Data] )
			            && YEAR ( Calendario[Data] ) = YEAR ( MAX ( Calendario[Data] ) )
			    )
			)
		formatString: #,0.0\ "€";-#,0.0\ "€";#,0.0\ "€"
		displayFolder: Objetivo
		lineageTag: fa6d1dca-96f7-4ab7-8146-3fd0507c6af9

	measure 'Receita LY' =
			
			SWITCH (
