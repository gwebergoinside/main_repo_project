	measure 'Gauge End Faturado YTD' =
			
			VAR SourceMeasure = [Val Faturado YTD Atual Month] //Actual value
			VAR TargetMeasure = [Objetivo YTD Atual Month] --[Objetivo liq YTD Atual Month] //Target value (end of the yellow zone)
			VAR RedZoneMeasure = [Objetivo YTD Atual Month] * 0.5 --[Objetivo liq YTD Atual Month]*0.5 //Minimum target value (end of the red zone)
			VAR MaxValue =
			    SWITCH (
			        TRUE (),
			        SourceMeasure > TargetMeasure, SourceMeasure * 1.2,
			        TargetMeasure * 1.2
			    ) //Defines max value of the scale
			RETURN
			    MaxValue
		isHidden
		displayFolder: Gauge
		lineageTag: 97ede111-0eb1-4212-8cf0-e13dcca83e5e

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

