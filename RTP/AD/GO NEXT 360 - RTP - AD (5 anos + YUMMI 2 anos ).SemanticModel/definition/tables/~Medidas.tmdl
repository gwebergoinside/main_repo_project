	measure 'Desconto das Taxas' =
			
			VAR _str =
			    IF (
			        ISFILTERED ( 'Tipo_Taxas'[Taxas] ),
			        CONCATENATEX ( 'Tipo_Taxas', [Taxas], "" )
			    )
			VAR sum_2 = [Valor Outros Custos]
			VAR sum_1 = [Valor Custo Minimo]
			VAR sum_3 = [Valor Taxa Multiproduto]
			VAR sum_4 = [Valor Taxa Posição]
			VAR _a =
			    SWITCH (
			        SELECTEDVALUE ( Tipo_Taxas[Taxas] ),
			        "Excluir Custo Mínimo", sum_1,
			        "Excluir Outros Custo", sum_2,
			        "Excluir Tx Multiproduto", sum_3,
			        "Excluir Tx Posição", sum_4
			    )
			VAR _b =
			    SWITCH (
			        TRUE (),
			        CONTAINSSTRING ( _str, "Excluir Outros Custo" )
			            && CONTAINSSTRING ( _str, "Excluir Custo Mínimo" )
			            && CONTAINSSTRING ( _str, "Excluir Tx Multiproduto" ),
			            sum_2 + sum_1 + sum_3,
			        CONTAINSSTRING ( _str, "Excluir Outros Custo" )
			            && CONTAINSSTRING ( _str, "Excluir Custo Mínimo" )
			            && CONTAINSSTRING ( _str, "Excluir Tx Posição" ),
			            sum_2 + sum_1 + sum_4,
			        CONTAINSSTRING ( _str, "Excluir Outros Custo" )
			            && CONTAINSSTRING ( _str, "Excluir Tx Multiproduto" )
			            && CONTAINSSTRING ( _str, "Excluir Tx Posição" ),
			            sum_2 + sum_3 + sum_4,
			        CONTAINSSTRING ( _str, "Excluir Custo Mínimo" )
			            && CONTAINSSTRING ( _str, "Excluir Tx Multiproduto" )
			            && CONTAINSSTRING ( _str, "Excluir Tx Posição" ),
			            sum_1 + sum_3 + sum_4,
			        CONTAINSSTRING ( _str, "Excluir Outros Custo" )
			            && CONTAINSSTRING ( _str, "Excluir Custo Mínimo" ), sum_2 + sum_1,
			        CONTAINSSTRING ( _str, "Excluir Custo Mínimo" )
			            && CONTAINSSTRING ( _str, "Excluir Tx Multiproduto" ), sum_1 + sum_3,
			        CONTAINSSTRING ( _str, "Excluir Custo Mínimo" )
			            && CONTAINSSTRING ( _str, "Excluir Tx Posição" ), sum_1 + sum_4,
			        CONTAINSSTRING ( _str, "Excluir Outros Custo" )
			            && CONTAINSSTRING ( _str, "Excluir Tx Multiproduto" ), sum_2 + sum_3,
			        CONTAINSSTRING ( _str, "Excluir Outros Custo" )
			            && CONTAINSSTRING ( _str, "Excluir Tx Posição" ), sum_2 + sum_4,
			        CONTAINSSTRING ( _str, "Excluir Tx Multiproduto" )
			            && CONTAINSSTRING ( _str, "Excluir Tx Posição" ), sum_3 + sum_4,
			        _a
			    )
			RETURN
			    //  LEN ( _str )
			    IF (
			        LEN ( _str ) = 81,
			        sum_1 + sum_2 + sum_3 + sum_4,
			        SWITCH (
			            TRUE (),
			            HASONEVALUE ( Tipo_Taxas[Taxas] ), _a,
			            NOT ( HASONEVALUE ( Tipo_Taxas[Taxas] ) ), _b
			        )
			    )
			// VAR _a =
			//     SELECTCOLUMNS ( 'Tipo_Taxas', "Name", [id] )
			// RETURN
			//     SUMX (
			//         VALUES( Tipo_Taxas[id] ),
			//         SWITCH (
			//             [id]
			//             ,1, [Valor Outros Custos]
			//             ,2, [Valor Custo Minimo]
			//             ,3, [Valor Taxa Multiproduto]
			//             ,4, [Valor Taxa Posição]
			//             --,5, BLANK()
			//             --,BLANK()
			//         )
			//     )
		isHidden
		displayFolder: Outros
		lineageTag: 11ee0d97-9485-49be-8697-abe00405b957

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

