			VAR _mindate =
			    STARTOFMONTH ( 'Variacao Receita'[DataCarregamento] )
			VAR _lastday =
			    ROUND (
			        CALCULATE (
			            SUM ( 'Variacao Receita'[ValorBonus] ),
			            FILTER ( ALL ( Calendario[Data] ), Calendario[Data] = _maxdate ),
			            REMOVEFILTERS ( 'Variacao Receita'[DataCarregamento] )
