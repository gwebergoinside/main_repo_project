	measure 'Anunciantes Concorrencia Share GRP' =
			
			VAR slicerVals_ = { 1, 5, 6, 7, 13, 14 }
			VAR customerList_ =
			    EXCEPT (
			        VALUES ( Yumi_Valores[ADVERTISER_KEY] ),
			        CALCULATETABLE (
			            VALUES ( Yumi_Valores[ADVERTISER_KEY] ),
			            Yumi_Valores[CHANNEL_KEY] IN slicerVals_
			        )
			    )
			RETURN
			    VAR _1 =
			        CALCULATE ( [Share GRP], ALLSELECTED ( Yumi_Canal ) )
			    VAR _2 = [Share GRP]
			    VAR _3 =
			        DIVIDE ( _2, _1 )
			    RETURN
			        IF.EAGER (
			            [Parâmetro % Ocupação] >= _3,
			            BLANK (),
			            CALCULATE ( [Share GRP Exclusivos], customerList_ )
			        )
		isHidden
		displayFolder: Outros
		lineageTag: 004d9800-cd60-450b-88bb-cf437bd22498

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

