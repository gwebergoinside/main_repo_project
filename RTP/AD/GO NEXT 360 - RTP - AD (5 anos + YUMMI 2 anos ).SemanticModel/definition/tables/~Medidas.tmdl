	measure 'Clientes Perdidos' =
			
			VAR _1 =
			    CALCULATE (
			        [Receita LY YTD Atual Month],
			        ALLSELECTED ( Central[Central de Compras] ),
			        ALLSELECTED ( Executivos[Executivo] ),
			        ALLSELECTED ( Canais[Canal] ),
			        ALLSELECTED ( 'TipoPublicidade'[Tipo Publicidade] )
			    )
			VAR _2 =
			    CALCULATE (
			        [Receita YTD Atual Month],
			        ALLSELECTED ( Central[Central de Compras] ),
			        ALLSELECTED ( Executivos[Executivo] ),
			        ALLSELECTED ( Canais[Canal] ),
			        ALLSELECTED ( 'TipoPublicidade'[Tipo Publicidade] )
			    )
			RETURN
			    IF.EAGER (
			        (
			            NOT (
			                ISBLANK ( _1 )
			                    && _1 = 0
			            )
			                && (
			                    ISBLANK ( _2 )
			                        || _2 = 0
			                )
			        )
			            || (
			                ISBLANK ( _1 )
			                    && (
			                        _2 = 0
			                            && NOT ( ISBLANK ( _2 ) )
			                    )
			            )
			            || (
			                _1 = 0
			                    && (
			                        _2 = 0
			                            && NOT ( ISBLANK ( _2 ) )
			                    )
			            )
			            || (
			                (
			                    _1 = 0
			                        || ISBLANK ( _1 )
			                )
			                    && _2 < 0
			            )
			            || (
			                _1 > 0
			                    && (
			                        _2 <= 0
			                            || ISBLANK ( _2 )
			                    )
			            )
			            || (
			                _1 < 0
			                    && (
			                        _2 <> 0
			                            || NOT ( ISBLANK ( _2 ) )
			                    )
			            )
			            || (
			                _1 < 0
			                    && (
			                        _2 <= 0
			                            || ISBLANK ( _2 )
			                    )
			            ),
			        [Valor Receita YTD (AY-LY Actual Month)],
			        BLANK ()
			    )
			--bruto
		isHidden
		displayFolder: Ganhos e Perdidos
		lineageTag: 0e37ac50-de80-48eb-b6b5-37f618c5ebe5

