			    SELECTEDVALUE ( TipoRappelComissao[Tipo] ) = "Comissão Agência LY",
			        CALCULATE (
			            SUM ( Encomendas[Valor Comissao Agencia] ),
			            SAMEPERIODLASTYEAR ( Calendario[Data] )
			        )
			)
