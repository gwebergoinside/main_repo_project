	measure 'Anunciantes Concorrencia Investimento_Apoio' =
			
			VAR slicerVals_ = { 1, 5, 6, 7, 13, 14 }
			VAR customerList_ =
			    EXCEPT (
			        VALUES ( 'Yumi_Exibição'[ADVERTISER_KEY] ),
			        CALCULATETABLE (
			            VALUES ( 'Yumi_Exibição'[ADVERTISER_KEY] ),
			            'Yumi_Exibição'[CHANNEL_KEY] IN slicerVals_
			        )
			    )
			VAR _1 =
			    CALCULATE ( [Share GRP], ALLSELECTED ( Yumi_Canal ) )
			VAR _2 = [Share GRP]
			VAR _3 =
			    DIVIDE ( _2, _1 )
			RETURN
