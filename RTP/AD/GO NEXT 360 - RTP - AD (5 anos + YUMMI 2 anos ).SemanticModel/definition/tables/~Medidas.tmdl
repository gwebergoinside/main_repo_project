	measure 'Receita % (AY-LY - Gráfico)' =
			
			--if ([Receita LY]=0; if([Receita]=0;BLANK();1) ; (DIVIDE([Receita];[Receita LY])-1))
			IF (
			    [Receita] = 0
			        && [Receita LY] = 0,
			    BLANK (),
			    IF ( [Receita LY] = 0, 1, DIVIDE ( [Receita], [Receita LY] ) - 1 --)
			        )
			)
		formatString: 0.00%;-0.00%;0.00%
		isHidden
		displayFolder: Receita
