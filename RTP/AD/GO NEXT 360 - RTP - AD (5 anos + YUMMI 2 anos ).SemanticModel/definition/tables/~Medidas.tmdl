	measure 'Gauge End Actual' =
			
			VAR SourceMeasure = [Receita Gauge] //Actual value
			VAR TargetMeasure = [Objetivo Gauge] //Target value (end of the yellow zone)
			VAR RedZoneMeasure = [Objetivo Gauge] * 0.5 //Minimum target value (end of the red zone)
			VAR MaxValue =
			    SWITCH (
			        TRUE (),
			        SourceMeasure > TargetMeasure, SourceMeasure * 1.2,
			        TargetMeasure * 1.2
			    ) //Defines max value of the scale
