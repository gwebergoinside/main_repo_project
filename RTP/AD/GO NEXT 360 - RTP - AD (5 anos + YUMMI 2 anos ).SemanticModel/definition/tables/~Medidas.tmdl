	measure 'Receita Var €_Comparativo' = ```
			
			VAR _val1 =
			    ROUND ( SUM ( 'Variacao Receita'[ValorPub] ), 0 ) //Valor da data inicial
			//VAR _val2 = CALCULATE( ROUND(CALCULATE( SUM( 'Variacao Receita'[sumValorPub] ), PREVIOUSDAY( 'Variacao Receita'[data_carregamento] ) ),0))
			//var _result = _val1-_val2
			VAR _3 =
			    CALCULATE (
			        ROUND (
			            CALCULATE (
			                SUM ( 'Variacao Receita'[ValorPub] ),
			                ALL ( Calendario[Data] ),
			                USERELATIONSHIP ( Calendario[Data], 'Calendario comparativo'[Date] )
			            ),
			            0
			        )
			    ) * [Normalization Factor] //Valor da data comparativa 
			VAR _result2 = _val1 - _3
			VAR _c =
			    SELECTEDVALUE ( 'calendario comparativo'[date] )
			VAR _i =
			    SELECTEDVALUE ( 'Calendario'[Data] )
			RETURN
			    IF ( _result2 = 0, BLANK (), IF.EAGER ( _c > _i, _3 - _val1, _val1 - _3 ) )
			// Previous Sales :=
			// CALCULATE (
			//     [Sales Amount],
			//     ALL ( 'Date' ),
			//     USERELATIONSHIP ( 'Date'[Date], 'Previous Date'[Date] )
			//
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		isHidden
		displayFolder: Variação Receita
		lineageTag: ba8e4f72-13c2-4298-937a-2eb9e25fb905

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

