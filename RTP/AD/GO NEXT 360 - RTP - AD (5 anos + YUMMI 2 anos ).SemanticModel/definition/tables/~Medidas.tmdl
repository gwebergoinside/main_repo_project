			        || ISFILTERED ( Calendario[Mês (nome completo)] ),
			    CALCULATE (
			        [Receita Liquida],
			        FILTER (
			            Calendario,
			            Calendario[Mês (número)] = MAX ( Calendario[Mês (número)] )
			                && Calendario[Ano] = MAX ( Calendario[Ano] )
			        )
			    ),
			    CALCULATE (
			        [Receita Liquida],
			        FILTER (
			            Calendario,
			            Calendario[Mês (número)] = MONTH ( NOW () )
			                && YEAR ( Calendario[Data] ) = MAX ( Calendario[Ano] )
			        )
			    )
			)
