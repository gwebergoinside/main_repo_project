	measure 'Receita Var YTD %_Comparativo' = ```
			
			VAR CurrDate =
			    MAX ( 'Variacao Receita'[DataCarregamento] )
			VAR _maxdate =
			    EOMONTH ( CurrDate, -1 )
			VAR _mindate =
			    STARTOFMONTH ( 'Variacao Receita'[DataCarregamento] )
			VAR _lastday =
			    ROUND (
			        CALCULATE (
			            SUM ( 'Variacao Receita'[ValorPub] ),
			            FILTER ( ALL ( Calendario[Data] ), Calendario[Data] = _maxdate ),
			            REMOVEFILTERS ( 'Variacao Receita'[DataCarregamento] )
			        ),
			        0
			    )
			VAR _val1 =
			    ROUND ( CALCULATE ( SUM ( 'Variacao Receita'[ValorPub] ) ), 0 )
			VAR _3 =
			    CALCULATE (
			        ROUND (
			            CALCULATE (
			                SUM ( 'Variacao Receita'[ValorPub] ),
			                ALL ( Calendario[Data] ),
			                USERELATIONSHIP ( Calendario[Data], 'Calendario comparativo'[Date] )
			            ),
			            0
			        )
			    ) * [Normalization Factor] //Valor da data comparativa 
			RETURN
			    DIVIDE ( _val1 - _lastday, _lastday )
			--_val1
			// Receita Var €_Comparativo = 
			// VAR _val1 = ROUND(SUM( 'Variacao Receita'[sumValorPub] ),0) //Valor da data inicial
			// //VAR _val2 = CALCULATE( ROUND(CALCULATE( SUM( 'Variacao Receita'[sumValorPub] ), PREVIOUSDAY( 'Variacao Receita'[data_carregamento] ) ),0))
			// //var _result = _val1-_val2
