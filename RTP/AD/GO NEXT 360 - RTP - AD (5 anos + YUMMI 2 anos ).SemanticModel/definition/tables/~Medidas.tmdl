	measure 'Taxa Ocupação Simulador Banda' = ```
			
			// VAR _1 = IF( divide([Ocupação Normal],[Grelha Max Normal]) = 0, BLANK(), divide([Ocupação Normal],[Grelha Max Normal]) )
			// RETURN
			// AVERAGEX( 
			//     // VALUES( Ocupacao[FaixaHoraria] )
			//     SUMMARIZE(Ocupacao, Calendario[Dia mês (número)], Canais[Canal], Ocupacao[BandaHoraria])
			//     ,IF( 'Simulador Exclusivos'[Parâmetro Valor] <= CALCULATE( _1 ) , CALCULATE( _1 ) , BLANK() )
			// )
			//IF([Filtro Simulador % Ocup Banda] = 1, [Taxa Ocupação], BLANK())
			VAR _num =
			    SUMX (
			        SUMMARIZE (
			            Ocupacao,
			            Calendario[Dia mês (número)],
			            Canais[Canal],
			            Ocupacao[BandaHoraria]
			        ),
			        IF (
			            [Filtro Simulador % Ocup Banda] = 1
			                && [Filtro Simulador Dur Ocup Banda] = 1,
			            [Ocupação Normal],
			            BLANK ()
			        )
			    )
			VAR _dem =
			    SUMX (
			        SUMMARIZE (
			            Ocupacao,
			            Calendario[Dia mês (número)],
			            Canais[Canal],
			            Ocupacao[BandaHoraria]
			        ),
			        IF ( [Filtro Simulador % Ocup Banda] = 1, [Grelha Max Normal], BLANK () )
			    )
			RETURN
			    DIVIDE ( _num, _dem )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ocupação
		lineageTag: 762538df-191e-4bc0-941b-fcf7e8da6193

	measure 'Ocupação (HH:MM:SS - Simulador Banda)' = ```
			
			// VAR Duration = --SUM(Ocupacao[OcupacaoNormal] )
			// SUMX( 
			//     // VALUES( Ocupacao[FaixaHoraria] )
			//     SUMMARIZE(Ocupacao, Calendario[Dia mês (número)], Canais[Canal], Ocupacao[BandaHoraria])
			//         ,IF( 'Simulador Exclusivos'[Parâmetro Valor] <= [Taxa Ocupação] , CALCULATE( SUM(Ocupacao[OcupacaoNormal] ) ) , BLANK() )
			// )
			VAR Duration =
			    SUMX (
			        SUMMARIZE (
			            Ocupacao,
			            Calendario[Dia mês (número)],
			            Canais[Canal],
			            Ocupacao[BandaHoraria]
			        ),
			        IF (
			            [Filtro Simulador % Ocup Banda] = 1
			                && [Filtro Simulador Dur Ocup Banda] = 1,
			            CALCULATE ( SUM ( Ocupacao[OcupacaoNormal] ) ),
			            BLANK ()
			        )
			    )
			VAR Hours =
			    INT ( Duration / 3600 )
			VAR Minutes =
			    INT ( MOD ( Duration - ( Hours * 3600 ), 3600 ) / 60 )
			VAR Seconds =
			    ROUNDUP ( MOD ( MOD ( Duration - ( Hours * 3600 ), 3600 ), 60 ), 0 )
			VAR H =
			    IF ( LEN ( Hours ) = 1, CONCATENATE ( "0", Hours ), CONCATENATE ( "", Hours ) )
			VAR M =
			    IF (
			        LEN ( Minutes ) = 1,
			        CONCATENATE ( "0", Minutes ),
			        CONCATENATE ( "", Minutes )
			    )
			VAR S =
			    IF (
			        LEN ( Seconds ) = 1,
			        CONCATENATE ( "0", Seconds ),
			        CONCATENATE ( "", Seconds )
			    )
			RETURN
			    IF (
			        Duration = BLANK (),
			        BLANK (),
			        CONCATENATE (
			            H,
			            CONCATENATE ( ":", CONCATENATE ( M, CONCATENATE ( ":", S ) ) )
			        )
			    )
			// IF([Filtro Simulador % Ocup Banda] = 1, [Ocupação Hora], BLANK())
			```
		displayFolder: Ocupação
		lineageTag: 06be7304-f148-4f6d-bb01-82e400550c97

