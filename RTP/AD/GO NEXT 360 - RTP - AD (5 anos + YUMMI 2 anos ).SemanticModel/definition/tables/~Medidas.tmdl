	measure 'val faturado Gauge' =
			
			IF (
			    ISFILTERED ( Calendario[Mês (nome)] ) || ISFILTERED ( Calendario[Mês (número)] )
			        || ISFILTERED ( Calendario[Mês (nome completo)] ),
			    CALCULATE (
			        [Valor Faturado Total],
			        FILTER (
			            Calendario,
			            Calendario[Mês (número)] = MAX ( Calendario[Mês (número)] )
			                && Calendario[Ano] = MAX ( Calendario[Ano] )
			        )
			    ),
			    CALCULATE (
			        [Valor Faturado Total],
			        FILTER (
			            Calendario,
			            Calendario[Mês (número)] = MONTH ( NOW () )
			                && YEAR ( Calendario[Data] ) = MAX ( Calendario[Ano] )
			        )
			    )
			)
			-- YEAR(NOW() ))) )
		isHidden
		displayFolder: Gauge
