	measure 'Taxa Ocupação Simulador Faixa' = ```
			
			// VAR _1 = IF( divide([Ocupação Normal],[Grelha Max Normal]) = 0, BLANK(), divide([Ocupação Normal],[Grelha Max Normal]) )
			// RETURN
			// AVERAGEX( 
			//     // VALUES( Ocupacao[FaixaHoraria] )
			//     SUMMARIZE(Ocupacao, Calendario[Dia mês (número)], Canais[Canal], Ocupacao[FaixaHoraria])
