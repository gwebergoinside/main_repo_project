	measure 'Previsão Receita Grelha Atual' =
			
			VAR __Tempo =
			    CALCULATE (
			        MAX ( Ocupacao[CanalMaxNormal] ),
			        USERELATIONSHIP ( Ocupacao[ChavePrev], 'Audiencias'[Chave] )
			    )
			VAR __Val =
			    ROUND ( AVERAGE ( 'Audiencias'[Valor] ), 2 )
			VAR __CMGRP =
			    CALCULATE (
			        [CPR Eq],
			        USERELATIONSHIP ( Encomendas[ChavePrev], 'Audiencias'[Chave] )
			    ) -- Para calcular a Média por dia
			VAR __dias =
			    CALCULATE (
			        COUNT ( Calendario[Dia Semana (nome)] ),
			        FILTER ( Calendario, Calendario[Mês (número)] = MONTH ( NOW () ) )
			    ) -- GRP Equiv.
			VAR __indice = DuracaoBase
			RETURN
			    ( ( ( __Tempo / __indice ) * __Val ) * __CMGRP )
		isHidden
		displayFolder: Previsão Audiència
		lineageTag: 88bf5d7a-d887-4c17-8b39-36b5db4c392b

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previsão Receita Grelha Seguinte' =
			
			VAR __Tempo =
			    CALCULATE (
			        MAX ( Ocupacao[CanalMaxNormal] ),
			        USERELATIONSHIP ( Ocupacao[ChavePrev], 'Audiencias'[Chave] )
			    )
			VAR __Val =
			    ROUND ( AVERAGE ( 'Audiencias'[Valor] ), 2 )
			VAR __CMGRP =
			    CALCULATE (
			        [CPR Eq],
			        USERELATIONSHIP ( Encomendas[ChavePrev], 'Audiencias'[Chave] )
			    ) -- Para calcular a Média por dia
			VAR __dias =
			    CALCULATE (
			        COUNT ( Calendario[Dia Semana (nome)] ),
			        FILTER ( Calendario, Calendario[Mês (número)] = MONTH ( NOW () ) + 1 )
			    ) -- GRP Equiv.
			VAR __indice = DuracaoBase
			RETURN
			    ( ( ( __Tempo / __indice ) * __Val ) * __CMGRP )
		isHidden
		displayFolder: Previsão Audiència
		lineageTag: 46762dfe-1307-45af-a4d6-28dbec0cba8c

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previsão Receita Mes' =
			
			VAR __prevFDS =
			    CALCULATE (
			        SUMX ( VALUES ( Audiencias[Faixa_Horaria] ), [Previsão Receita Grelha Atual] ),
			        ALLSELECTED ( Calendario ),
			        Calendario[Periodo da Semana] = "Fim de Semana"
			    )
			VAR __prevDS =
			    CALCULATE (
			        SUMX ( VALUES ( Audiencias[Faixa_Horaria] ), [Previsão Receita Grelha Atual] ),
			        ALLSELECTED ( Calendario ),
			        Calendario[Periodo da Semana] = "Dia de Semana"
			    )
			VAR __prevT =
			    CALCULATE (
			        SUMX ( VALUES ( Audiencias[Faixa_Horaria] ), [Previsão Receita Grelha Atual] ),
			        ALLSELECTED ( Calendario )
			    ) --
			VAR __dias =
			    COUNT ( Calendario[Periodo da Semana] )
			RETURN
			    IF (
			        SELECTEDVALUE ( Calendario[Periodo da Semana] ) = "Dia de Semana",
			        __prevDS,
			        IF (
			            SELECTEDVALUE ( Calendario[Periodo da Semana] ) = "Fim de Semana",
			            __prevFDS,
			            __prevT
			        )
			    ) * __dias
		formatString: #,0
		isHidden
		displayFolder: Previsão Audiència
		lineageTag: 085e2372-4eb1-4092-93af-ff59174d38de

		changedProperty = IsHidden

