	measure 'Qtd_Clientes Perdidos' =
			
			VAR _1 =
			    CALCULATE (
			        [Receita LY YTD Atual Month],
			        ALLSELECTED ( Central[Central de Compras] ),
			        ALLSELECTED ( Executivos[Executivo] ),
			        ALLSELECTED ( Canais[Canal] ),
			        ALLSELECTED ( 'TipoPublicidade'[Tipo Publicidade] )
			    )
			VAR _2 =
			    CALCULATE (
			        [Receita YTD Atual Month],
			        ALLSELECTED ( Central[Central de Compras] ),
			        ALLSELECTED ( Executivos[Executivo] ),
			        ALLSELECTED ( Canais[Canal] ),
			        ALLSELECTED ( 'TipoPublicidade'[Tipo Publicidade] )
			    )
			VAR _3 =
			    CALCULATE (
			        [Val Faturado LY YTD Atual Month],
			        ALLSELECTED ( Central[Central de Compras] ),
			        ALLSELECTED ( Executivos[Executivo] ),
			        ALLSELECTED ( Canais[Canal] ),
			        ALLSELECTED ( 'TipoPublicidade'[Tipo Publicidade] )
			    )
			VAR _4 =
			    CALCULATE (
			        [Val Faturado YTD Atual Month],
			        ALLSELECTED ( Central[Central de Compras] ),
			        ALLSELECTED ( Executivos[Executivo] ),
			        ALLSELECTED ( Canais[Canal] ),
			        ALLSELECTED ( 'TipoPublicidade'[Tipo Publicidade] )
			    )
			RETURN
			    SWITCH (
			        [Selected SalesParameter],
			        1,
			            IF.EAGER (
			                (
			                    NOT (
			                        ISBLANK ( _1 )
			                            && _1 = 0
			                    )
			                        && (
			                            ISBLANK ( _2 )
			                                || _2 = 0
			                        )
			                )
			                    || (
			                        ISBLANK ( _1 )
			                            && (
			                                _2 = 0
			                                    && NOT ( ISBLANK ( _2 ) )
			                            )
			                    )
			                    || (
			                        _1 = 0
			                            && (
			                                _2 = 0
			                                    && NOT ( ISBLANK ( _2 ) )
			                            )
			                    )
			                    || (
			                        (
			                            _1 = 0
			                                || ISBLANK ( _1 )
			                        )
			                            && _2 < 0
			                    )
			                    || (
			                        _1 > 0
			                            && (
			                                _2 <= 0
			                                    || ISBLANK ( _2 )
			                            )
			                    )
			                    || (
			                        _1 < 0
			                            && (
			                                _2 <> 0
			                                    || NOT ( ISBLANK ( _2 ) )
			                            )
			                    )
			                    || (
			                        _1 < 0
			                            && (
			                                _2 <= 0
			                                    || ISBLANK ( _2 )
			                            )
			                    ),
			                DISTINCTCOUNT ( Anunciante[Anunciante] ),
			                BLANK ()
			            ),
			        -- bruto
			        3,
			            IF.EAGER (
			                (
			                    NOT (
			                        ISBLANK ( _3 )
			                            && _3 = 0
			                    )
			                        && (
			                            ISBLANK ( _4 )
			                                || _4 = 0
			                        )
			                )
			                    || (
			                        ISBLANK ( _3 )
			                            && (
			                                _4 = 0
			                                    && NOT ( ISBLANK ( _4 ) )
			                            )
			                    )
			                    || (
			                        _3 = 0
			                            && (
			                                _4 = 0
			                                    && NOT ( ISBLANK ( _4 ) )
			                            )
			                    )
			                    || (
			                        (
			                            _3 = 0
			                                || ISBLANK ( _3 )
			                        )
			                            && _4 < 0
			                    )
			                    || (
			                        _3 > 0
			                            && (
			                                _4 <= 0
			                                    || ISBLANK ( _4 )
			                            )
			                    )
			                    || (
			                        _3 < 0
			                            && (
			                                _4 <> 0
			                                    || NOT ( ISBLANK ( _4 ) )
			                            )
			                    )
			                    || (
			                        _3 < 0
			                            && (
			                                _4 <= 0
			                                    || ISBLANK ( _4 )
			                            )
			                    ),
			                DISTINCTCOUNT ( Anunciante[Anunciante] ),
			                BLANK ()
			            ) -- fatu
			    )
		formatString: 0
		isHidden
		displayFolder: Ganhos e Perdidos
