	measure 'Bonus Var %_Comparativo' =
			
			VAR _val1 =
			    ROUND ( SUM ( 'Variacao Receita'[ValorBonus] ), 0 ) //Valor da data inicial
			VAR _val2 =
			    ROUND (
			        CALCULATE (
			            SUM ( 'Variacao Receita'[ValorBonus] ),
			            PREVIOUSDAY ( 'Variacao Receita'[DataCarregamento] )
			        ),
			        0
			    )
			VAR _3 =
			    CALCULATE (
			        ROUND (
			            CALCULATE (
			                SUM ( 'Variacao Receita'[ValorPub] ),
			                ALL ( Calendario[Data] ),
			                USERELATIONSHIP ( Calendario[Data], 'Calendario comparativo'[Date] )
			            ),
			            0
			        )
			    ) * [Normalization Factor] //Valor da data comparativa
			RETURN
			    DIVIDE ( [Bonus var €_Comparativo], _3, 1 )
		isHidden
		displayFolder: Variação Receita
		lineageTag: d96fc9fd-8aec-4583-a85c-73e3a2d47a27

		changedProperty = FormatString

		changedProperty = IsHidden

