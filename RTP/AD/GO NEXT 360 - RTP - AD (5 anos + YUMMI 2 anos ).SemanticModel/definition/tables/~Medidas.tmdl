	measure 'Receita % YTD (AY-LY Atual Month)' =
			
			SWITCH (
			    [Selected SalesParameter],
			    1,
			        IF.EAGER (
			            [Receita LY YTD Atual Month] = 0,
			            IF.EAGER ( [Receita YTD Atual Month] = 0, BLANK (), 1 ),
			            ( DIVIDE ( [Receita YTD Atual Month], [Receita LY YTD Atual Month] ) - 1 )
			        ),
			    3,
			        IF.EAGER (
			            [Val Faturado YTD Atual Month] = 0,
			            IF.EAGER ( [Val Faturado YTD Atual Month] = 0, BLANK (), 1 ),
			            (
			                DIVIDE ( [Val Faturado YTD Atual Month], [Val faturado LY YTD Atual Month] ) - 1
			            )
			        )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Receita
		lineageTag: 5a19f43e-603f-4350-b836-89463a15f347

		changedProperty = FormatString

	measure 'Objetivo % (Receita-Objetivo)' =
			
