	measure 'Valor Receita YTD (AY-LY Actual Month)' =
			
			[Receita YTD Atual Month] - [Receita LY YTD Atual Month]
		displayFolder: Receita
		lineageTag: 65fdd5dc-0439-4635-b329-d681216d071f

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valor Receita YTD % (AY-LY Actual Month)' =
			
			IF (
			    ISFILTERED ( 'Calendario'[Data] ),
			    ERROR ( "Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column." ),
			    VAR __PREV_YEAR = [Valor Receita YTD LY (Actual Month)]
			    RETURN
			        DIVIDE (
			            [Valor Receita YTD (Actual Month)] - __PREV_YEAR,
			            ABS ( __PREV_YEAR ),
			            1
			        )
			)
			// --)
			// IF(
			// 	ISFILTERED('Calendario'[Date]),
			// 	ERROR("Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column."),
			// 	VAR __PREV_YEAR = [Val Receita YTD LY Atual Month]
			// 	RETURN
			// 		DIVIDE([Val Receita YTD Atual Month] - __PREV_YEAR, ABS(__PREV_YEAR),1)
			// )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Receita
		lineageTag: 0e63cf55-f45a-4118-ab5b-4a65ed03e194

		changedProperty = FormatString

	measure valor_tipoCliente_% =
			
			SWITCH (
			    [Selected Type],
			    1,
			        DIVIDE (
			            SUMX (
			                SUMMARIZE ( Executivos, Executivos[UtiId], "sum", [Clientes Recorrentes_] ),
			                [Sum]
			            ),
			            [Valor Receita YTD (AY-LY Actual Month)]
			        ),
			    2,
			        DIVIDE (
			            SUMX (
			                SUMMARIZE ( Executivos, Executivos[UtiId], "sum", [Clientes Novos] ),
			                [Sum]
			            ),
			            [Valor Receita YTD (AY-LY Actual Month)]
			        ),
			    3,
			        DIVIDE (
			            SUMX (
			                SUMMARIZE ( Executivos, Executivos[UtiId], "sum", [Clientes Perdidos] ),
			                [Sum]
			            ),
			            [Valor Receita YTD (AY-LY Actual Month)]
			        ),
			    -- perdidos
			    4,
			        DIVIDE (
			            SUMX (
			                SUMMARIZE ( Executivos, Executivos[UtiId], "sum", [Clientes Queda] ),
			                [Sum]
			            ),
			            [Valor Receita YTD (AY-LY Actual Month)]
			        ),
			    -- queda
			    5,
			        DIVIDE (
			            SUMX (
			                SUMMARIZE ( Executivos, Executivos[UtiId], "sum", [Clientes Crescimento] ),
			                [Sum]
			            ),
			            [Valor Receita YTD (AY-LY Actual Month)]
			        )
			)
		isHidden
		displayFolder: Ganhos e Perdidos
		lineageTag: 2b13c942-0b28-43b1-8bea-5c3b8c31d7cd

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valor Receita YTD LY (Actual Month)' =
			
			IF.EAGER (
			    ISFILTERED ( 'Calendario'[Mês (nome)] ),
			    [Receita LY],
			    CALCULATE (
			        [Receita LY],
			        FILTER (
			            ALL ( 'Calendario'[Data] ),
			            MONTH ( 'Calendario'[Data] ) <= MONTH ( NOW () )
			                && YEAR ( 'Calendario'[Data] ) = YEAR ( MAX ( 'Calendario'[Data] ) )
			        )
			    )
			)
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Receita
		lineageTag: 7545e0d1-135c-4ac4-97b6-9edd257a0eaf

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

