			            Calendario[Dia mês (número)],
			            Canais[Canal],
			            Ocupacao[FaixaHoraria]
			        ),
			        IF (
			            [Filtro Simulador % Ocup Faixa] = 1
			                && [Filtro Simulador Dur Ocup Faixa] = 1,
			            [Ocupação Normal],
			            BLANK ()
			        )
			    )
			VAR _dem =
			    SUMX (
			        SUMMARIZE (
			            Ocupacao,
			            Calendario[Dia mês (número)],
			            Canais[Canal],
			            Ocupacao[FaixaHoraria]
			        ),
			        IF (
			            [Filtro Simulador % Ocup Faixa] = 1
			                && [Filtro Simulador Dur Ocup Faixa] = 1,
			            [Grelha Max Normal],
			            BLANK ()
			        )
			    )
			RETURN
			    DIVIDE ( _num, _dem )
