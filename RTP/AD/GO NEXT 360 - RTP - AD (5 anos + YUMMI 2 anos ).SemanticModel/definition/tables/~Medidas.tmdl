	measure SumLost =
			
			--CALCULATE([Receita LY Ytdd];FILTER(Anunciante;[Receita LY Ytdd]>0 && (ISBLANK([Receita])||[Receita]=0)))
			CALCULATE (
			    [Receita LY YTD Atual Month],
			    FILTER (
			        Anunciante,
			        [Receita LY YTD Atual Month] > 0
			            && (
			                ISBLANK ( [Receita] )
			                    || [Receita] = 0
			            )
			    )
			)
		formatString: #,0.00
		isHidden
		displayFolder: Outros
		lineageTag: 101020cc-eb1f-4388-98d6-06104a82b782

		changedProperty = IsHidden

	measure percentVarLost =
			
			VAR __1nivel =
			    DIVIDE ( CALCULATE ( [SumLost] ), [Receita LY YTD Atual Month] ) --CALCULATE ( [SumLost] ; ALLSELECTED(GMediaBI_Encomendas[Central]) ))
			VAR __2nivel =
			    DIVIDE (
			        CALCULATE ( [SumLost] ),
			        CALCULATE ( [SumLost], ALLSELECTED ( Anunciante[Anunciante] ) )
			    ) --Var __3nivel = CALCULATE ( [SumLost] ) / CALCULATE ( [SumLost] ; ALLSELECTED(Vendedores[UtiNome]) )
			--Var __level2 = if(__3nivel=1 ; __2nivel;__3nivel)
			RETURN
			    IF ( __2nivel = 1, __1nivel, __2nivel )
		formatString: 0.00%;-0.00%;0.00%
		isHidden
		displayFolder: Outros
		lineageTag: abead50c-1500-40ab-a8b4-a52e54485bdb

		changedProperty = IsHidden

