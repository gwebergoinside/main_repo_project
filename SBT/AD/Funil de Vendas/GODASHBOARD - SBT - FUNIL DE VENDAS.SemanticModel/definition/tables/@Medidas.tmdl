	measure 'Valor Negociado' = ```
			
			CALCULATE( 
			    SUM( 'Lead'[Opt Valor Negociado] )
			    ,'Lead'[Opt] <> BLANK()
			    ,FILTER( ALL( RLS[domainname] ), RLS[domainname] = [RLS] )
			    ,USERELATIONSHIP( RLS[RLS], 'Lead'[ownerid] )
			)
			```
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Valor
		lineageTag: a1639afd-7feb-4d64-8a14-28891098e8fd

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure RLS = ```
			
			// DEFAULT
			    IF.EAGER( 
			        USERPRINCIPALNAME() in VALUES(DashboardUserPermission[Email])
			        ,"crmadmin@gruposilviosantos.onmicrosoft.com"
			        ,USERPRINCIPALNAME()
			    )
			// GMediaAD
			    // "crmadmin@gruposilviosantos.onmicrosoft.com"
			// Kotait    
			    // "mkotait@sbt.com.br"
			// GMediaAD
			    // "cbf29051-a44f-473c-867e-2ca74d377b88"
			// alessandra nogueira gama
			    // "1e5eab-a46b-44b4-87f9-d27c0ad43db7"  
			// Juliana
			    // "bfd86487-a7fd-45f2-b8da-a0451b4a9e89"
			// OLD
			    // IF.EAGER( SELECTEDVALUE( RLSFILTER[PortalsAzureID] ) = BLANK() || SELECTEDVALUE( RLSFILTER[positionid] ) = BLANK(), "nao-tem-permissoes", SELECTEDVALUE( RLSFILTER[PortalsAzureID] ) )
			```
		displayFolder: Outros
		lineageTag: 47f3ecca-e93d-4036-90f8-84d129b272ee

