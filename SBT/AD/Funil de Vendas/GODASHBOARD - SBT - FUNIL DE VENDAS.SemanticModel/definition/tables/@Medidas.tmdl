	measure 'Tipo de Cliente' = ```
			
			VAR _1 =
			CALCULATE(
			    DISTINCTCOUNT( 'Lead'[go_leadid]),
			    FILTER(
			        'Lead',
			        --'Lead'[EstadoOPT] = "Ganho" && 
			        'Lead'[ClienteCodigo] <> "SEM CODIGO"  &&
			        YEAR( 'Lead'[createdon] ) >= SELECTEDVALUE( Calendario[Ano] ) - 2 &&
			        CALCULATE( COUNTROWS( 'Lead' ), ALLEXCEPT( 'Lead', 'Lead'[ClienteCodigo] ) ) <= 1
			    )
			)
			RETURN
			IF( _1 = BLANK() , "Existente", IF( _1 = 1, "Novo", BLANK() ) )
			
			--IF( _1 = BLANK(), "Existente", "Novo" )
