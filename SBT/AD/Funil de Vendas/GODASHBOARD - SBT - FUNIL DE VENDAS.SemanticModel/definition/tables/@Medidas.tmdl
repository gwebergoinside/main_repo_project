	measure Titulo =
			
			SWITCH (
			    [Selected TituloParameter],
			    1, SELECTEDVALUE(Titulos[Parameter]),
			    2, SELECTEDVALUE(Titulos[Parameter]),
			    3, SELECTEDVALUE(Titulos[Parameter]),
			    4, SELECTEDVALUE(Titulos[Parameter]),
			    5, SELECTEDVALUE(Titulos[Parameter]),
			    6, SELECTEDVALUE(Titulos[Parameter]),
			    7, SELECTEDVALUE(Titulos[Parameter]),
			    8, SELECTEDVALUE(Titulos[Parameter]),
			    9, SELECTEDVALUE(Titulos[Parameter]),
			    10, SELECTEDVALUE(Titulos[Parameter]),
			    11, SELECTEDVALUE(Titulos[Parameter]),
			    12, SELECTEDVALUE(Titulos[Parameter]),
			    13, SELECTEDVALUE(Titulos[Parameter]),
			    14, SELECTEDVALUE(Titulos[Parameter]),
			    15, SELECTEDVALUE(Titulos[Parameter]),
			    16, SELECTEDVALUE(Titulos[Parameter]),
			    17, SELECTEDVALUE(Titulos[Parameter]),
			    18, SELECTEDVALUE(Titulos[Parameter]),
			    19, SELECTEDVALUE(Titulos[Parameter]),
			    20, SELECTEDVALUE(Titulos[Parameter]),
