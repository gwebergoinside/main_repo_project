	measure 'Visual control Propostas Lead' =
			
			IF (
			    DISTINCTCOUNT ( Propostas[Estado] ) = 1,
			    SWITCH (
			        SELECTEDVALUE ( Propostas[Estado] ),
			        "Ganhas",       IF ( [QTD Lead com Proposta Ganhas] <> BLANK(), 1, -1 ),
			        "Com",       IF ( [QTD Lead com Proposta] <> BLANK(), 1, -1 ),
			        "Sem",     IF ( [QTD Lead sem Proposta] <> BLANK(), 1, -1 )
			    ),
			    1
			)
		displayFolder: Visual Control
		lineageTag: 303ee50f-dc5c-41c4-a3aa-dc311595d89b

	measure Status_Proposta =
			
			SWITCH(
			    TRUE()
			    ,SELECTEDVALUE('Propostas'[Estado]) = "Ganhas", [QTD Lead com Proposta Ganhas]+0
			    ,SELECTEDVALUE('Propostas'[Estado]) = "Com", [QTD Lead com Proposta]+0
			    ,SELECTEDVALUE('Propostas'[Estado]) = "Sem", [QTD Lead sem Proposta]+0
			)
		formatString: #,0
		lineageTag: 0333bd6b-2024-491a-aca7-d3b4f21154b7

