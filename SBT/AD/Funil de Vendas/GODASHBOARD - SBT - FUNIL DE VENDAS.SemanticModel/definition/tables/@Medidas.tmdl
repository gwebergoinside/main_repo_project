	measure 'Status_Agregado Switch' = ```
			
			SWITCH(
			    TRUE()
			    -- Em andamento (Lead)
			    ,SELECTEDVALUE('Status_Agregado'[Status_name]) = "Em andamento (Lead)"
			        , CALCULATE(
			            [QTD Lead]
			            ,StatusLeads[StatusLead] = "Em andamento"
			        )
			    -- Qualificado (Lead)
			    ,SELECTEDVALUE(Status_Agregado[Status_name]) = "Qualificado (Lead)"
			        ,CALCULATE(
			            [QTD Lead]
			            ,StatusLeads[StatusLead] = "Qualificado"
			        )
			    -- Desqualificado (Lead)
			    ,SELECTEDVALUE('Status_Agregado'[Status_name]) = "Desqualificado (Lead)"
			        ,CALCULATE(
			            [QTD Lead]
			            ,StatusLeads[StatusLead] = "Desqualificado"
			        )
			    -- Em andamento (Opt)
			    ,SELECTEDVALUE('Status_Agregado'[Status_name]) = "Em andamento (Opt)"
			        ,CALCULATE(
			            [QTD Opt]
			            ,'Lead'[Opt Estado] = "Em andamento"
			        )
			    -- Perdido (Opt)
			    ,SELECTEDVALUE('Status_Agregado'[Status_name]) = "Perdido (Opt)"
			        ,CALCULATE(
			            [QTD Opt]
			            ,'Lead'[Opt Estado] = "Perdida"
			        )
			    -- Ganho (Opt)
			    ,SELECTEDVALUE('Status_Agregado'[Status_name]) = "Ganha (Opt)" 
			        ,CALCULATE(
			            [QTD Opt]
			            ,'Lead'[Opt Estado] = "Ganho"
			            ,USERELATIONSHIP( Calendario[Date], 'Lead'[Opt Data Integracao] )
			        )
			    ,BLANK()
			)
			```
		formatString: 0
		lineageTag: 7e304eea-9a63-4481-9cf8-bb4aef63da6a

