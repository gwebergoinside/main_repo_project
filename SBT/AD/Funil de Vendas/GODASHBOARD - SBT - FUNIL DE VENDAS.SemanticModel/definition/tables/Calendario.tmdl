table Calendario
	lineageTag: d90cf1d6-cb29-4e92-8b7e-eaf345df1f02
	dataCategory: Time

	column Date
		isKey
		formatString: Short Date
		lineageTag: bbe61ded-219a-4e90-81b8-24914d27eaf7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		changedProperty = DataType

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Ano = year(Calendario[Date])
		formatString: 0
		lineageTag: 8980030e-83a8-452f-9ba3-0e475de1a1f9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Mes =
			SWITCH(
			    MONTH(Calendario[Date])
			    ,1,"Jan",2,"Fev",3,"Mar",4,"Abr"
			    ,5,"Mai",6,"Jun",7,"Jul",8,"Ago"
			    ,9,"Set",10,"Out",11,"Nov",12,"Dez")
		lineageTag: 27a9990f-8228-4e30-91c2-a7ce7c201c00
		summarizeBy: none
		sortByColumn: 'Mes No'

		annotation SummarizationSetBy = Automatic

	column 'Mes No' = MONTH(Calendario[Date])
		formatString: 0
		lineageTag: 125ee996-9315-4dd9-bb33-66a1202fa170
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Tipo de Ano' = IF('Calendario'[Ano] = YEAR(NOW()) , "Corrente", IF('Calendario'[Ano] = YEAR(NOW())-1 ,"Anterior","Passado"))
		lineageTag: e6f3ab31-2b86-413e-8d60-215cc53a17f4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column AnoMes = VALUE( Calendario[Ano]&FORMAT(Calendario[Mes No], "00") )
		lineageTag: d0701d7b-d234-4e98-8833-ebc331a17208
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Calendario-790a6d8f-aa7e-4546-b392-05187bbad58b = calculated
		mode: import
		source =
				CALENDAR(DATE(year(now())-5, 1, 1), DATE(year(now()), 12, 31) )
				/*Calendario = CALENDAR(FORMAT(DATE(year(now())-5, 1, 1), "DD/MM/YYYY"), Format(DATE(year(now())+1, 12, 31) , "DD-MM-YYYY"))*/

	annotation PBI_Id = ba4dc2e401a54584b2a974eebaaeec9b

