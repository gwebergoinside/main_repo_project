table Executivos
	lineageTag: bd850d38-b0d8-4a71-8c77-2e126b38e032

	column Executivo
		dataType: string
		lineageTag: 3ac7bdb1-b811-4514-80ec-cbde2cb55d7c
		summarizeBy: none
		sourceColumn: Executivo

		annotation SummarizationSetBy = Automatic

	column systemuserid
		dataType: string
		lineageTag: 8003ba54-8afb-4688-80dc-0fed0a8fb05c
		summarizeBy: none
		sourceColumn: systemuserid

		annotation SummarizationSetBy = Automatic

	column Gerente
		dataType: string
		lineageTag: 4a6ab4d5-b9a0-44a4-8821-3b4656d4c2a4
		summarizeBy: none
		sourceColumn: Gerente

		annotation SummarizationSetBy = Automatic

	partition Executivos-e03d45ff-da48-43d6-b695-83215befd5bf = m
		mode: import
		queryGroup: CORE
		source =
				let
				    SQL = "SELECT
				            SU.systemuserid,
				            SU.fullname AS Executivo,
				            CASE
				                WHEN GER.fullname IS NOT NULL THEN GER.fullname
				                WHEN EXISTS (SELECT 1 FROM systemuser F WHERE F.parentsystemuserid = SU.systemuserid) THEN SU.fullname
				            END AS Gerente
				        FROM systemuser SU
				        LEFT JOIN systemuser GER
				            ON GER.systemuserid = SU.parentsystemuserid",
				    Source = Sql.Database(OrgDynamics, BD_Dynamics, [Query = SQL])
				in
				    Source

	annotation PBI_ResultType = Table
