table LinhaDoTempo
	lineageTag: 30ddf3ba-5cab-44aa-99ea-d80d2844e719

	column go_leadid
		dataType: string
		lineageTag: 25f0196f-efc4-47a2-811e-520d04f6840b
		summarizeBy: none
		sourceColumn: go_leadid

		annotation SummarizationSetBy = Automatic

	column 'Linha do Tempo'
		dataType: string
		lineageTag: 53760a5d-1f2c-49a2-b4d2-bfbcde520842
		summarizeBy: none
		sourceColumn: Linha do Tempo

		annotation SummarizationSetBy = Automatic

	partition LinhaDoTempo = m
		mode: import
		queryGroup: Dynamics
		source =
				let
				    SQL = "SELECT
				            L.go_leadid,
				            MAX(CASE
				                    WHEN COALESCE(A.subject, A.description, A.activitytypecodename) IS NOT NULL THEN 'Atividade'
				                    ELSE 'nac'
				                END) AS has
				        FROM activitypointer A
				        INNER JOIN go_lead L
				            ON L.go_leadid = A.regardingobjectid
				        WHERE YEAR(L.createdon) >= YEAR(GETDATE()) - 3
				        GROUP BY L.go_leadid
				        UNION ALL
				        SELECT
				            L.go_leadid,
				            'Anotação' AS has
				        FROM go_lead L
				        INNER JOIN annotation AN
				            ON AN.objectid = L.go_leadid
				        WHERE YEAR(L.createdon) >= YEAR(GETDATE()) - 3
				            AND AN.createdon IS NOT NULL
				        GROUP BY L.go_leadid",
				    Source = Sql.Database(OrgDynamics, BD_Dynamics, [Query = SQL]),
				    #"Linha do Tempo por Lead" = Table.Group(Source, {"go_leadid"}, {{"Linha do Tempo", each Text.Combine([has], "/"), type text}})
				in
				    #"Linha do Tempo por Lead"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
