	partition Programas_Lead-4317b62e-3e03-41e0-b4db-890898d6c2be = m
		mode: import
		queryGroup: CORE
		source =
				let
				    SQL = "SELECT DISTINCT
				            LP.go_leadid,
				            P.go_st_name AS programname
				        FROM go_go_lead_go_program LP
				        LEFT JOIN go_program P
				            ON P.go_programid = LP.go_programid",
