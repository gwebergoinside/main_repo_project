expression Anotacoes =
		let
		       Accounts = Sql.Database(OrgDynamics, BD_Dynamics, [Query="#(tab)select #(lf)#(tab)l.go_leadid#(lf)#(tab)--,an.subject#(lf)#(tab),MAX(CASE WHEN an.createdon IS NOT NULL THEN 'Anotação' ELSE 'nan' END) AS has#(lf)from #(lf)#(tab)go_lead l#(lf)left join go_opportunity o ON l.go_leadid = o.go_lk_originatingleadid#(lf)left join annotation an ON l.go_leadid = an.objectid#(lf)where#(lf)#(tab)yeaR(l.createdon) >= year(getdate())-3#(lf)#(tab)and an.createdon is not null#(tab)#(lf)#(tab)#(tab)#(lf)   #(lf)    GROUP BY#(lf)        l.go_leadid"])
		in
		    Accounts
	lineageTag: 5766761d-5d91-45ee-9442-899a12ae6c84
	queryGroup: Dynamics

