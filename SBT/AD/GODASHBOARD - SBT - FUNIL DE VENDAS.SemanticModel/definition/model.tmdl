model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Config

	annotation PBI_QueryGroupOrder = 0

queryGroup RLS

	annotation PBI_QueryGroupOrder = 1

queryGroup CORE

	annotation PBI_QueryGroupOrder = 3

queryGroup Dynamics

	annotation PBI_QueryGroupOrder = 4

annotation PBI_QueryOrder = ["Org","OrgDynamics","CRMOrgUrl","BD","BD_Dynamics","Link","LinkLead","GrupoCliente","@Medidas","Posi","RLS","RLSFILTER","Titulos","Lead","Neg","Termometro","Status_Agregado","Estados","Executivos","BDExternal","DashboardUserPermission","#CDSTEntitySource","Briefings","GetCDST_EntityTable","UsersMain","Programas_Opt_Lead","Programas_Lead","Propostas","EmpresaFaturamento","Atualização","LinhaDoTempo"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table GrupoCliente
ref table @Medidas
ref table Calendario
ref table RLS
ref table RLSFILTER
ref table Titulos
ref table Lead
ref table Neg
ref table Estados
ref table Executivos
ref table DashboardUserPermission
ref table Briefings
ref table StatusLeads
ref table Status_Agregado
ref table Programas_Lead
ref table Termometro
ref table Propostas
ref table TipoMidia
ref table TipoOferta
ref table Programas_Opt_Lead
ref table EmpresaFaturamento
ref table Atualização
ref table LinhaDoTempo

ref role RLS

ref cultureInfo en-US

