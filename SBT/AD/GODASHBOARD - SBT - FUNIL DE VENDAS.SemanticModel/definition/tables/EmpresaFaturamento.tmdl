table EmpresaFaturamento
	lineageTag: 3cdf6159-ed0f-4656-81f0-a8ca2f0016d9

	column EmpFat
		dataType: string
		lineageTag: ace538d5-e02a-472f-80bf-1472d3b00c1f
		summarizeBy: none
		sourceColumn: EmpFat

		annotation SummarizationSetBy = Automatic

	column EmpFatId
		dataType: string
		lineageTag: de07422f-e9fd-421d-aa8c-6527a621e860
		summarizeBy: none
		sourceColumn: EmpFatId

		annotation SummarizationSetBy = Automatic

	partition EmpresaFaturamento-aa4c57ea-4518-49df-9764-3d9ee4094ca5 = m
		mode: import
		queryGroup: Dynamics
		source =
				let
				    SQL = "SELECT
				            EV.name      AS EmpFat,
				            EV.accountid AS EmpFatId
				        FROM account EV
				        WHERE EXISTS (
				            SELECT 1
				            FROM go_opportunity OPT
				            WHERE OPT.go_lk_empresafaturamentoid = EV.accountid
				        )",
				    Source = Sql.Database(OrgDynamics, BD_Dynamics, [Query = SQL])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação
