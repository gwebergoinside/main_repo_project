table GrupoCliente
	lineageTag: 6c028b10-824d-410a-9da4-eb021482177a

	column Cliente
		dataType: string
		lineageTag: 0d1fe6d2-b55f-485c-8904-1b84772a7637
		summarizeBy: none
		sourceColumn: Cliente

		annotation SummarizationSetBy = Automatic

	column ClienteCodigo
		dataType: string
		lineageTag: 0c79ccf3-9311-4eed-b76a-f6afc988647f
		summarizeBy: none
		sourceColumn: ClienteCodigo

		annotation SummarizationSetBy = Automatic

	column Cliente_Cod = ```
			GrupoCliente[Cliente] & " (" &  GrupoCliente[ClienteCodigo] & ")"
			```
		lineageTag: 1a00d938-b0e5-4648-bf87-92e950f9ab6f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition GrupoCliente-de94ef5f-6947-47b8-9312-4dba17083391 = m
		mode: import
		queryGroup: CORE
		source =
				let
				    SQL = "SELECT
				            CL.Name                  AS Cliente,
				            UPPER(CL.ExternalCode)   AS ClienteCodigo
				        FROM Entity CL
				        INNER JOIN Entity G
				            ON CL.ExternalCode = G.ExternalCode
				            AND CL.ParentID IS NULL
				        INNER JOIN EntityEntityType EET
				            ON EET.EntityID = G.ID
				            AND EET.EntityTypeID = 1
				        UNION
				        SELECT
				            CL.Name                  AS Cliente,
				            UPPER(CL.ExternalCode)   AS ClienteCodigo
				        FROM Entity CL
				        INNER JOIN Entity G
				            ON CL.ParentID = G.ID
				        INNER JOIN EntityEntityType EET
				            ON EET.EntityID = G.ID
				            AND EET.EntityTypeID = 1",
				    Source = Sql.Database(Org, BD, [Query = SQL]),
				    #"Um cliente por código" = Table.Distinct(Source, {"ClienteCodigo"})
				in
				    #"Um cliente por código"

	annotation PBI_ResultType = Table
