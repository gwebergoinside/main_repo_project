		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column 'Briefing Lead' =

			CONCATENATEX(FILTER(ALL(Briefings), Briefings[go_lk_leadorigem] = 'Lead'[go_leadid]), Briefings[go_name],", ")
		lineageTag: b85081e1-a34c-4178-8e01-846035f0ff29
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Motivo Lead Desqualificada' = IF.EAGER('Lead'[Status] = "Desqualificado", 'Lead'[statuscodename], BLANK())
		lineageTag: 04becb26-990f-43ec-969f-76b14a8e1629
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Cliente =

			VAR _1 =
			LOOKUPVALUE(
			    GrupoCliente[Cliente_Cod]
			    ,GrupoCliente[ClienteCodigo]
			    ,'Lead'[ClienteCodigo]
			)
			RETURN
			IF( _1 = BLANK(), 'Lead'[go_st_companyname], _1 )
		lineageTag: 0ab65c9d-f77a-4a8b-a1a4-70d920bc4a5f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Programa =

			CONCATENATEX(FILTER(ALL(Programas_Lead), Programas_Lead[go_leadid] = 'Lead'[go_leadid]), Programas_Lead[programname],", ")
		lineageTag: f42f9772-89c8-44c3-91c7-2b3f45803789
