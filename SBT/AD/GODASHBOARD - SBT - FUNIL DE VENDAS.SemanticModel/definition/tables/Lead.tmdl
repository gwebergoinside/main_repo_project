	partition Lead-40084854-2c86-4993-bcfd-f1c3872ccecf = m
		mode: import
		queryGroup: Dynamics
		source =
				let
				    SQL = "SELECT
				            GL.go_leadid,
				            GL.statuscodename,
				            GL.go_name,
				            GL.go_st_companyname,
				            GL.ownerid,
				            CAST(DATEADD(hour, -3, GL.createdon) AS date) AS createdon,
				            GL.modifiedon                       AS [Data Modificação],
				            SU.fullname                         AS Executivo,
				            GL.go_lk_empresaprincipalidname     AS [Empresa Principal],
				            GL.go_pl_funcaoname                 AS [Função],
				            GL.go_pl_tiponegociacaoname         AS [Tipo Negociação],
				            GL.go_pl_offertypename              AS [Tipo Oferta],
				            ISNULL(A.accountnumber, 'SEM CODIGO_' + ISNULL(GL.go_st_companyname, '')) AS ClienteCodigo
				        FROM go_lead GL
				        LEFT JOIN systemuser SU
				            ON SU.systemuserid = GL.ownerid
				        LEFT JOIN account A
				            ON A.accountid = GL.go_lk_parentaccountid",
				    Source = Sql.Database(OrgDynamics, BD_Dynamics, [Query = SQL]),
				    #"URL do Lead" = Table.AddColumn(Source, "URL", each LinkLead & [go_leadid], type text)
				in
				    #"URL do Lead"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
