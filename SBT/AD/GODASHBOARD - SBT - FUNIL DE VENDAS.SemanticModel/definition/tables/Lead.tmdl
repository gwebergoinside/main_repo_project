	column idStatus =

			SWITCH(
			    TRUE()
			        ,'Lead'[Status] = "Integrado", 4
			        ,'Lead'[Status] = "Em andamento", 1
			        ,'Lead'[Status] = "Perdido", 3
			        ,'Lead'[Status] = "Qualificado", 2
			        ,'Lead'[Status] = "Relacionamento", 5
			        ,'Lead'[Status] = "Outros", 6
			        ,'Lead'[Status] = "Desqualificado", 10
			        ,'Lead'[Status] = "Em aprovação", 8
			        ,'Lead'[Status] = "Aprovado", 9
			        ,'Lead'[Status] = "Rejeitado", 11
			        ,'Lead'[Status] = "Em inserção", 12
			        ,'Lead'[Status] = "Disponível", 13
			        ,7
			)
		formatString: 0
		lineageTag: 0e248a8d-0f19-4ee9-87be-1440aa8c179c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

