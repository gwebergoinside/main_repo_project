	column Opt =
			
			LOOKUPVALUE(
			    Neg[go_st_codnegociacao]
			    ,Neg[go_lk_originatingleadid]
			    ,'Lead'[go_leadid]
			)
		lineageTag: ec986c09-ddcb-4a9e-9719-3b7dfe32918c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Status = ```
			
			--IF( 'Lead'[CodSCTV] <> BLANK(), "Integrado", 'Lead'[statuscodename] )
			SWITCH(
			    TRUE()
			    ,'Lead'[Opt CodSCTV]  <> BLANK(), "Qualificado"
			    ,'Lead'[statuscodename] = "Em aprovação","Em aprovação"
			    ,'Lead'[statuscodename] = "Aprovado", "Aprovado"
			    ,'Lead'[statuscodename] = "Rejeitado", "Rejeitado"
			    ,'Lead'[statuscodename] = "Crédito não aprovado", "Desqualificado" 
			    ,'Lead'[statuscodename] = "Optou por outra emissora", "Desqualificado" 
			    ,'Lead'[statuscodename] = "Prazo diferenciado não aprovado pelo financeiro SBT", "Desqualificado" 
			    ,'Lead'[statuscodename] = "Alegou que a grade do SBT não é atrativa", "Desqualificado" 
			    ,'Lead'[statuscodename] = "De/Para", "Desqualificado"
			    ,'Lead'[statuscodename] = "Não É Possível Contatar", "Desqualificado"
			    ,'Lead'[statuscodename] = "Não é Possível contatar, sem retorno do cliente", "Desqualificado"
			    ,'Lead'[statuscodename] = "Postergou investimentos", "Desqualificado"
			    ,'Lead'[statuscodename] = "Lead aberto indevidamente - Erro operacional", "Desqualificado"
			    ,'Lead'[statuscodename] = "Alega que o SBT não atende o perfil necessário", "Desqualificado"
			    ,'Lead'[statuscodename] = "Corte de verba no Cliente", "Desqualificado"
			    ,'Lead'[statuscodename] = "Desistiu de anunciar em TV", "Desqualificado"
			    ,'Lead'[statuscodename] = "Não É Possível Contatar", "Desqualificado"
			    ,'Lead'[statuscodename] = "Não Está Mais Interessado", "Desqualificado"
			    ,'Lead'[statuscodename] = "Cancelado", "Desqualificado"
			    ,'Lead'[statuscodename] = "Cancelamento da Campanha", "Desqualificado"
			    ,'Lead'[statuscodename] = "Concorrência", "Desqualificado"
			    ,'Lead'[statuscodename] = "Conflito de Segmento", "Desqualificado"
			    ,'Lead'[statuscodename] = "Disponibilidade de Espaço", "Desqualificado"
			    ,'Lead'[statuscodename] = "Sem Disponibilidade de Espaço", "Desqualificado"
			    ,'Lead'[statuscodename] = "Perda da Negociação", "Desqualificado"
			    ,'Lead'[statuscodename] = "Outros", "Desqualificado"
			    ,'Lead'[statuscodename] = "Perdido", "Desqualificado"
			    ,'Lead'[statuscodename] = "Em inserção", "Em inserção"
			    ,'Lead'[statuscodename] = "Novo", "Novo"
			    ,'Lead'[statuscodename] = "Desqualificado", "Desqualificado"
			    ,'Lead'[statuscodename] = "Qualificado", "Qualificado"
			    ,'Lead'[statuscodename] = "Relacionamento", "Relacionamento"
			    ,'Lead'[statuscodename] = "Integrado", "Integrado"
			    ,'Lead'[statuscodename] = "Disponível", "Disponível"
			    ,'Lead'[statuscodename] = "Em andamento", "Em andamento"
			    ,"Desqualificado"
			)
			```
		lineageTag: bc95516a-f9b9-43cc-9a7c-0732eaffac83
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

