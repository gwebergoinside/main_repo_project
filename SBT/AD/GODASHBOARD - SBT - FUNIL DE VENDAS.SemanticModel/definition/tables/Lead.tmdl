	partition Lead-40084854-2c86-4993-bcfd-f1c3872ccecf = m
		mode: import
		queryGroup: Dynamics
		source =
				let
				       Accounts = Sql.Database(OrgDynamics, BD_Dynamics, [Query="select #(lf)   GL.[go_leadid]#(lf)   ,GL.[statecode]#(lf)   ,GL.[statecodename]#(lf)   ,GL.[statuscode]#(lf)   ,GL.[statuscodename]#(lf)   ,GL.[go_st_subject]#(lf)   ,GL.[go_name]#(lf)   ,GL.createdon#(lf)   ,GL.modifiedon as [Data Modificação]#(lf)   ,GL.ownerid#(lf)   ,su.go_st_codigoexterno as cod_executivo#(lf)   ,su.fullname as Executivo#(lf)   ,GL.go_lk_empresaprincipalidname as [Empresa Principal]#(lf)   ,GL.go_pl_funcaoname as [Função]#(lf)   ,GL.go_pl_tiponegociacaoname as [Tipo Negociação]#(lf)   ,GL.go_pl_offertypename as [Tipo Oferta]#(lf)   ,GL.go_lk_parentaccountidname as [Conta Primária]#(lf)   --,GL.[go_st_program] as Programa#(lf)   ,a.accountnumber as ClienteCodigo#(lf)  -- ,bri.go_briefingid as [Briefing]#(lf)   ,GL.go_st_companyname#(lf)FROM #(lf)   [dbo].[go_lead] GL#(lf)   left join systemuser su on GL.ownerid = su.systemuserid#(lf)   left join Account a on GL.go_lk_parentaccountid = a.accountid#(lf)   --left join go_briefing bri on GL.[go_leadid] = bri.go_lk_leadorigem#(lf)"]),
				    #"Changed Type2" = Table.TransformColumnTypes(Accounts,{{"createdon", type datetimezone}}),
				    #"Adjusted Time Zone35" = Table.AddColumn(#"Changed Type2", "createdon_adjusted", each DateTimeZone.SwitchZone([createdon], -3)),
				    #"Extracted Text Before Delimiter" = Table.TransformColumns(#"Adjusted Time Zone35", {{"createdon_adjusted", each Text.BeforeDelimiter(Text.From(_, "pt-PT"), " "), type text}}),
				    #"Changed Type3" = Table.TransformColumnTypes(#"Extracted Text Before Delimiter",{{"createdon_adjusted", type datetime}}),
				    #"Removed Previous Column35" = Table.RemoveColumns(#"Changed Type3", {"createdon"}),
				    #"Renamed Adjusted Column35" = Table.RenameColumns(#"Removed Previous Column35", {{"createdon_adjusted", "createdon"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Adjusted Column35",{{"createdon", type date}}),
				    Custom1 = Table.AddColumn(#"Changed Type", "URL", each LinkLead & [go_leadid]),
				    #"Renamed Columns" = Table.RenameColumns(Custom1,{{"cod_executivo", "cod_executivo1"}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Renamed Columns",null,"SEM CODIGO",Replacer.ReplaceValue,{"cod_executivo1"}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Replaced Value",{{"ClienteCodigo", "ClienteCodigo1"}}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Renamed Columns1",null,"SEM CODIGO",Replacer.ReplaceValue,{"ClienteCodigo1"}),
				    #"Inserted Merged Column" = Table.AddColumn(#"Replaced Value1", "cod_executivo", each if [cod_executivo1] = "SEM CODIGO" then Text.Combine({[cod_executivo1], "_", [go_st_companyname]})
				else [cod_executivo1]),
				    #"Added Custom" = Table.AddColumn(#"Inserted Merged Column", "ClienteCodigo", each if [ClienteCodigo1] = "SEM CODIGO" then Text.Combine({[ClienteCodigo1], "_", [go_st_companyname]})
				else [ClienteCodigo1]),
				    #"Removed Columns" = Table.RemoveColumns(#"Added Custom",{"cod_executivo1", "ClienteCodigo1"})
				in
				    #"Removed Columns"

