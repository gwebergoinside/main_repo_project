		source =
				let
				    Opportunities = Sql.Database(OrgDynamics, BD_Dynamics, [Query="  SELECT#(lf)OPT.createdon#(lf), OPT.go_name#(lf), OPT.go_lk_originatingleadid#(lf)--, OPT.go_dc_descontoprogramas#(lf)--, OPT.go_dc_maiordescontodado as go_fp_maiordescontodado#(lf), OPT.go_dt_competenciainicial#(lf), OPT.go_dt_dataintegracao#(lf), OPT.go_dt_estimatedclosedate as estimatedclosedate#(lf), OPT.go_int_versao #(lf), OPT.go_lk_clienteid as ParentAccountId#(lf), OPT.go_lk_empresafaturamentoid#(lf), OPT.go_lk_empresavendaid#(lf), OPT.go_lk_executivovendasid#(lf)--, OPT.go_lk_tipomidiaid#(lf)--, OPT.go_mn_valormidiaapoio#(lf), OPT.go_mn_valornegociado#(lf)--, OPT.go_name as [Name]#(lf), OPT.go_opportunityid as OpportunityId#(lf)--, OPT.go_pl_tabelamidiaprincipal#(lf)--, OPT.go_pl_tabelamidiaprincipalname as Tabela #(lf)--, OPT.go_pl_tiporegistroname#(lf), OPT.go_st_codnegociacao#(lf), OPT.go_st_codnegociacaosctv#(lf), OPT.modifiedon#(lf), OPT.ownerid#(lf), OPT.statecode#(lf), OPT.statecodename as Status#(lf), OPT.statuscode#(lf), OPT.statuscodename#(lf)--, OPT.go_dc_comissaoagencia#(lf), su.fullname as NomeExecutivo#(lf), su.go_st_codigoexterno#(lf)--, empFat.name as EmpresaFaturamento#(lf)-- , empVend.name as EmpresaVenda#(lf)--, conta.name as ContaName#(lf), Conta.accountid#(lf), Conta.accountnumber#(lf), OPT.go_lk_clienteidname as Cliente#(lf), Conta.go_pl_funcao #(lf), Conta.go_pl_funcaoname as ContaFuncao#(lf), Midia.go_name as TipoMidia#(lf), Midia.go_st_codigo as TipoMidiaCod#(lf), Conta.go_lk_originatingleadID as DeuOrigemConta#(lf), OPT.go_pl_winchancethermometer as Thermometer_cod#(lf), OPT.go_pl_winchancethermometername as Thermometer#(lf)FROM#(lf)Go_Opportunity OPT#(lf)left join systemuser su on OPT.go_lk_executivovendasid = su.systemuserid#(lf)--left join Account empFat on OPT.go_lk_empresafaturamentoid = empFat.accountid#(lf)--left join Account empVend on OPT.go_lk_go_lk_empresavendaid = empVend.accountid#(lf)left join Account Conta on OPT.go_lk_clienteid = Conta.accountid#(lf)left join go_tipomidia Midia on OPT.go_lk_tipomidiaid = Midia.go_tipomidiaid#(lf)where#(lf)#(tab)OPT.statuscodename != 'Versionada' and OPT.statuscodename != 'Versionamento Cancelado' and OPT.statuscodename <> 'Versionamento Reprovado'#(lf)#(tab)and not exists (Select 1 from Go_Opportunity x Where x.go_st_codnegociacao = opt.go_st_codnegociacao and statuscodename ='Integrada no SCTV (Fechada)' and x.go_int_versao < opt.go_int_versao)"]),
