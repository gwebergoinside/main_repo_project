		annotation SummarizationSetBy = Automatic

	column Estado =
			
			SWITCH( TRUE()
			    , Neg[statuscodename] in {"Perdida"}  , "Perdida"
			  --, Neg[statuscode] in {100000006,100000007,100000008,100000009,100000005,100000004}  , "Em Aprovação"--Proposta
			    --, Neg[statuscode] in {100000015}  , "Em Transição"--Proposta
			    --, Neg[statuscode] in {100000000}  , "Versionada"
			    , Neg[statuscodename] in {"Erro Durante a Integração (Aprovada)", "Integrada no SCTV (Fechada)"}  , "Ganho"
			    , Neg[statuscodename] in {"Em Inserção","Briefing","Proposta","Negociação","Ficha de Negociação","Em Andamento","Em Aprovação - Validadores","Em Aprovação - Controle","Em Aprovação - Gerência","Em Aprovação - Diretoria","Em Aprovação - Diretoria de Operações Comerciais","Em Transição","Negociação Reprovada", "Inserção"}  , "Em andamento" --Proposta
			    , "Em andamento"
			)
		lineageTag: b53c0570-2b41-41db-b903-8e00f56ee5c2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

