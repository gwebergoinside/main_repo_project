	column Clientes =
			
			VAR _1 =
			LOOKUPVALUE(
			        GrupoCliente[Cliente_Cod]
			        ,GrupoCliente[ClienteCodigo]
			        ,Neg[accountnumber]
			    )
			RETURN
			IF.EAGER( isblank(_1), Neg[Cliente], _1
			)
		lineageTag: 34c69f71-be95-4a58-a88b-b4a48d3ccf5b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

