		annotation SummarizationSetBy = Automatic

	column 'Briefing Opt' =
			
			CONCATENATEX(FILTER(ALL(Briefings), Briefings[go_lk_oportunidadedeorigemid] = Neg[OpportunityId]), Briefings[go_name],", ")
