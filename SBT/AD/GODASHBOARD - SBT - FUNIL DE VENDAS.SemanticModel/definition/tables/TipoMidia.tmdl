		sourceColumn: [TipoMidia]

		annotation SummarizationSetBy = Automatic

	partition TipoMidia-6d773f84-4b90-4bac-8676-d522efd22875 = calculated
		mode: import
		source =
				
				VAR _1 =
				    SELECTCOLUMNS(
				        Neg
				        ,"TipoMidia_Cod", Neg[TipoMidiaCod]
				        ,"TipoMidia", Neg[TipoMidia]
				    )
				VAR _11 =
				    SELECTCOLUMNS(
				        'Lead'
				        ,"TipoMidia_Cod", 'Lead'[Tipo Midia]
				        ,"TipoMidia", LOOKUPVALUE( Neg[TipoMidia], Neg[go_lk_originatingleadid], 'Lead'[go_leadid] )
				    )
				VAR _12 =
				    UNION( _1, _11 )
				VAR _2 =
				    FILTER( SUMMARIZE( _12, [TipoMidia_Cod], [TipoMidia] ), [TipoMidia_Cod] <> BLANK() )
				RETURN
				_2

	annotation PBI_Id = f7049c89aefd42c0bade1d7fe06b938e

