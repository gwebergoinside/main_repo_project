		column is_SBTNEWS
			dataType: string
			lineageTag: 44bc01ad-59cf-4fa0-8849-b037fe93120a
			summarizeBy: none
			sourceColumn: is_SBTNEWS

			annotation SummarizationSetBy = Automatic

		column chaveT
			dataType: string
			lineageTag: f1356fc5-68fb-4d58-bda5-7158269e4d9c
			summarizeBy: none
			sourceColumn: chaveT

			annotation SummarizationSetBy = Automatic

		partition R0002-5b2f1cdd-8bce-4385-9d08-626abdf75db3 = m
			mode: import
			queryGroup: CORE
			source = ```
					let
					    // Sanitização de aspas simples para evitar quebra de SQL via parâmetros
					    arrSBTNEWS_safe   = Text.Replace(array_SBTNEWS, "'", "''"),
					    arrNegoc_safe     = Text.Replace(array_desconsiderar_Negociacoes, "'", "''"),

					    // Constrói cláusulas IN inline (mais rápido e portável que STRING_SPLIT)
					    arrSBTNEWS_IN = "(" & Text.Combine(
					                        List.Transform(
					                            Text.Split(arrSBTNEWS_safe, ","),
					                            each "'" & Text.Upper(Text.Trim(_)) & "'"
					                        ), ","
					                    ) & ")",

					    arrNegoc_IN   = "(" & Text.Combine(
					                        List.Transform(
					                            Text.Split(arrNegoc_safe, ","),
					                            each Text.Trim(_)
					                        ), ","
					                    ) & ")",

					    // Limites de partição (incremental refresh)
					    dtRangeStart = DateTime.ToText(RangeStart, "yyyy-MM-dd"),
					    dtRangeEnd   = DateTime.ToText(RangeEnd,   "yyyy-MM-dd"),

					    SQL =
					        "
					        ;WITH VI AS
					        (
					            SELECT DISTINCT
					                r2.Cod_Empresa,
					                r2.Competencia,
					                r2.Numero_Negociacao,
					                Cod_Contato_Importada = 'VEIMPR'
					            FROM " & BDExternal & ".SCTV.R0002 AS r2 WITH (NOLOCK)
					            INNER JOIN " & BD & ".dbo.Company AS eFat WITH (NOLOCK)
					                ON eFat.ExternalCode = r2.Cod_Empresa_Faturamento
					                AND eFat.Affiliation = 'FILIADO'
					            INNER JOIN " & BD & ".dbo.Company AS eEmp WITH (NOLOCK)
					                ON eEmp.ExternalCode = r2.Cod_Empresa
					                AND eEmp.Affiliation <> 'FILIADO'
					            WHERE r2.Cod_Nucleo NOT IN ('n10', 'novon', 'vale')
					              AND r2.Indica_Mes_Anterior = 0
					              AND r2.Cod_Empresa_Faturamento <> '054'
					        ),
					        RowLevel AS
					        (
					            SELECT
					                r.Cod_Empresa,
					                r.Cod_Tipo_Comercial,
					                UPPER(r.Sequencia_Mr) AS Sequencia_Mr,
					                UPPER(LTRIM(RTRIM(r.Cod_Empresa_Faturamento))) AS [CodEmp Faturamento],
					                UPPER(LTRIM(RTRIM(r.Cod_Agencia))) AS Cod_Agencia,
					                UPPER(LTRIM(RTRIM(r.Cod_Cliente))) AS Cod_Cliente,
					                UPPER(LTRIM(RTRIM(r.Cod_Contato))) AS Cod_Contato,
					                UPPER(LTRIM(RTRIM(r.Cod_Nucleo))) AS Cod_Nucleo,
					                r.Competencia,
					                DATEFROMPARTS(CONVERT(INT, LEFT(r.Competencia, 4)), CONVERT(INT, RIGHT(r.Competencia, 2)), 1) AS Data,
					                r.Numero_Negociacao,
					                LTRIM(RTRIM(r.SaleTypeExternalCode)) AS SaleTypeExternalCode,
					                CASE WHEN UPPER(LTRIM(RTRIM(r.Cod_Nucleo))) = 'INTERAT' THEN 'SITE'
					                     ELSE LTRIM(RTRIM(r.MediaTypeExternalCode))
					                END AS MediaTypeExternalCode,
					                r.Vlr_Gerencial_BAV,
					                r.Vlr_Repasse_Varejo,
					                r.Vlr_Bruto AS Vlr_Exibido,
					                ch.ExternalCode + ' - ' + ch.Name AS ChannelDisplay,
					                cp.Affiliation,
					                r.MotivoAjusteManual
					            FROM " & BDExternal & ".SCTV.R0002_Detalhe AS r WITH (NOLOCK)
					            LEFT JOIN " & BD & ".dbo.Company AS cp    WITH (NOLOCK) ON cp.ExternalCode    = r.Cod_Empresa
					            LEFT JOIN " & BD & ".dbo.Company AS cpfat WITH (NOLOCK) ON cpfat.ExternalCode = r.Cod_Empresa_Faturamento
					            LEFT JOIN " & BD & ".dbo.Channel AS ch    WITH (NOLOCK) ON ch.ExternalCode    = r.Cod_Veiculo
					            WHERE NOT (ISNULL(cp.Affiliation, '') = 'AFILIADO' AND ISNULL(cpfat.Affiliation, '') = 'AFILIADO')
					              AND r.Competencia >= ((YEAR(GETDATE()) - " & YearUpdateData & ") * 100 + 1)
					        ),
					        Enriched AS
					        (
					            SELECT
					                E.*,
					                Cod_Executivo = COALESCE(E.MotivoAjusteManual, VI.Cod_Contato_Importada, E.Cod_Contato),
					                TipoGoverno   = ISNULL(A.go_pl_classificacaogoverno_display, 'Setor Privado'),
					                chaveT =
					                    E.Cod_Cliente +
					                    E.Cod_Agencia +
					                    E.Cod_Empresa +
					                    E.Cod_Contato +
					                    UPPER(E.SaleTypeExternalCode) +
					                    UPPER(E.MediaTypeExternalCode) +
					                    CAST(YEAR(E.Data)  AS VARCHAR(4)) +
					                    CAST(MONTH(E.Data) AS VARCHAR(2))
					            FROM RowLevel AS E
					            LEFT JOIN VI
					                ON VI.Cod_Empresa       = E.Cod_Empresa
					               AND VI.Competencia       = E.Competencia
					               AND VI.Numero_Negociacao = E.Numero_Negociacao
					            LEFT JOIN " & BD & ".dbo.Account AS A WITH (NOLOCK)
					                ON A.accountnumber = E.Cod_Cliente
					            WHERE E.Data >= '" & dtRangeStart & "'
					              AND E.Data <  '" & dtRangeEnd   & "'
					        ),
					        ChaveTExcecoes AS
					        (
					            -- chaveTs marcadas como exceção SBTNEWS (ticket Intercom 96052764)
					            SELECT DISTINCT chaveT
					            FROM Enriched
					            WHERE Numero_Negociacao IN " & arrNegoc_IN & "
					              AND Data IN ('2026-01-01','2026-02-01','2026-03-01')
					        )
					        SELECT
					            E.Cod_Empresa,
					            E.Cod_Tipo_Comercial,
					            E.Sequencia_Mr,
					            E.[CodEmp Faturamento],
					            E.Cod_Agencia,
					            E.Cod_Cliente,
					            E.Cod_Nucleo,
					            E.Competencia,
					            E.Data,
					            E.Numero_Negociacao,
					            E.SaleTypeExternalCode,
					            E.MediaTypeExternalCode,
					            E.ChannelDisplay,
					            E.Affiliation,
					            E.Cod_Executivo,
					            E.chaveT,
					            [Tipo Governo] = E.TipoGoverno,
					            Tipo = CASE WHEN E.TipoGoverno = 'Setor Privado' THEN 'Setor Privado' ELSE 'Governo' END,
					            [CLIENTES DIRETOS] = CASE WHEN E.Cod_Cliente = E.Cod_Agencia
					                                      THEN 'CLIENTES DIRETOS'
					                                      ELSE 'COM AGÊNCIA'
					                                 END,
					            [Venda Importada]  = CASE
					                                    WHEN LEFT(E.[CodEmp Faturamento], 3) = '054' AND E.Affiliation = 'AFILIADO'
					                                         THEN 'VENDA IMPORTADA NACIONAL'
					                                    WHEN E.Cod_Executivo = 'VEIMPR'
					                                         THEN 'VENDA IMPORTADA REGIONAL'
					                                 END,
					            is_SBTNEWS = CASE
					                            WHEN UPPER(E.Cod_Nucleo) IN " & arrSBTNEWS_IN & " THEN 'Sim'
					                            WHEN EXISTS (SELECT 1 FROM ChaveTExcecoes c WHERE c.chaveT = E.chaveT) THEN 'Sim'
					                            ELSE 'Não'
					                         END,
					            codIntegrador = UPPER(E.Cod_Cliente + E.Cod_Agencia),
					            ChaveForecast =
					                E.Cod_Cliente + '-' +
					                E.Cod_Agencia + '-' +
					                E.MediaTypeExternalCode + '-' +
					                E.SaleTypeExternalCode + '-' +
					                CONVERT(VARCHAR(50), CAST(E.Numero_Negociacao AS BIGINT)) + '-' +
					                CAST(YEAR(E.Data)  AS VARCHAR(4)) + '-' +
					                CAST(MONTH(E.Data) AS VARCHAR(2)),
					            Vlr_Gerencial_BAV  = SUM(E.Vlr_Gerencial_BAV),
					            Vlr_Repasse_Varejo = SUM(E.Vlr_Repasse_Varejo),
					            Vlr_Exibido        = SUM(E.Vlr_Exibido)
					        FROM Enriched AS E
					        GROUP BY
					            E.Cod_Empresa, E.Cod_Tipo_Comercial, E.Sequencia_Mr, E.[CodEmp Faturamento],
					            E.Cod_Agencia, E.Cod_Cliente, E.Cod_Nucleo, E.Competencia, E.Data, E.Numero_Negociacao,
					            E.SaleTypeExternalCode, E.MediaTypeExternalCode, E.ChannelDisplay, E.Affiliation,
					            E.Cod_Executivo, E.TipoGoverno, E.chaveT
					        ",
					    Source = Sql.Database(Org, BD, [Query = SQL])
					in
					    Source
					```

		changedProperty = IsHidden

		annotation PBI_ResultType = Exception

		annotation PBI_NavigationStepName = Navegação
