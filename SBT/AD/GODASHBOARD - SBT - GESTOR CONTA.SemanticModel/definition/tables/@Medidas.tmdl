	measure 'Val Carteira YTD LY Closed Month' = ```
			
			// IF.EAGER( 
			//     ISFILTERED('Calendario'[Mes])
			//         ,[Val Liquido Carteira Final LY Atual DePara]
			//         ,CALCULATE( [Val Liquido Carteira Final LY Atual DePara]
			//             ,FILTER( ALL('Calendario'[Date])
			//                 ,MONTH('Calendario'[Date])<=MONTH(NOW())-1 && YEAR('Calendario'[Date])=YEAR( MAX('Calendario'[Date]) 
			//                 )
			//             )
			//         ) 
			// )
			IF.EAGER (
			    ISFILTERED ( 'Calendario'[Mes] ),
			    [Val Liquido Carteira Final ly Atual DePara],
			    IF.EAGER (
			        SELECTEDVALUE ( 'Calendario'[ano] ) < YEAR ( NOW () ),
			        CALCULATE (
			            [Val Liquido Carteira Final ly Atual DePara],
			            FILTER (
			                ALL ( 'Calendario' ),
			                YEAR ( 'Calendario'[Date] ) = MAX ( Calendario[Ano] )
			            )
			        ),
			        CALCULATE (
			            [Val Liquido Carteira Final ly Atual DePara],
			            FILTER (
			                ALL ( 'Calendario'[Date] ),
			                MONTH ( 'Calendario'[Date] ) <= MONTH ( NOW () ) - 1
			                    && YEAR ( 'Calendario'[Date] ) = YEAR ( MAX ( 'Calendario'[Date] ) )
			            )
			        )
			    )
			)
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
