	measure 'QTD Oportunidades Previous' =
			
			VAR DateCount =
			    COUNTROWS ( Calendario )
			VAR PeriodType =
			    SWITCH (
			        TRUE (),
			        // Complete year selected
			        AND (
			            HASONEVALUE ( 'Calendario'[Ano] ),
			            DateCount = COUNTROWS ( PARALLELPERIOD ( 'Calendario'[Date], 0, YEAR ) )
			        ), "year",
			        // Complete month selected
			        AND (
			            HASONEVALUE ( 'Calendario'[Mes No] ),
			            DateCount = COUNTROWS ( PARALLELPERIOD ( 'Calendario'[Date], 0, MONTH ) )
			        ), "month",
			        //
			        "day"
			    )
			RETURN
			    SWITCH (
			        PeriodType,
			        "year", CALCULATE ( [QTD Oportunidades], PREVIOUSYEAR ( 'Calendario'[Date] ) ),
			        "month", CALCULATE ( [QTD Oportunidades], PREVIOUSMONTH ( 'Calendario'[Date] ) ),
			        "day",
			            CALCULATE (
			                [QTD Oportunidades],
			                DATESBETWEEN (
			                    Calendario[Date],
			                    [Start of the Previous Period],
			                    [End of the Previous Period]
			                )
			            )
			    )
		formatString: 0
		displayFolder: Oportunidades
		lineageTag: 9071daff-bf40-4beb-8733-4b9bee568406

