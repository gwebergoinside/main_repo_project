	measure 'Clientes Novos' =
			
			VAR _1 =
			    CALCULATE (
			        [Val Carteira YTD LY Closed Month],
			        ALLSELECTED ( 'Emp_Venda'[Empresa Venda] ),
			        ALLSELECTED ( 'Emp_Venda'[ExternalCode] ),
			        ALLSELECTED ( 'Executivos'[Executivo] ),
			        ALLSELECTED ( TipoMidia[ExternalCode] ),
			        ALLSELECTED ( TipoVenda[ExternalCode] ),
			        ALLSELECTED ( GrupoCliente[Cliente_Cod] ),
			        ALLSELECTED ( Users[Gerente] )
			    )
			VAR _2 =
			    CALCULATE (
			        [Val Carteira YTD Closed Month],
			        ALLSELECTED ( 'Emp_Venda'[Empresa Venda] ),
			        ALLSELECTED ( 'Emp_Venda'[ExternalCode] ),
			        ALLSELECTED ( 'Executivos'[Executivo] ),
			        ALLSELECTED ( TipoMidia[ExternalCode] ),
			        ALLSELECTED ( TipoVenda[ExternalCode] ),
			        ALLSELECTED ( GrupoCliente[Cliente_Cod] ),
			        ALLSELECTED ( Users[Gerente] )
			    )
			VAR _3 =
			    IF.EAGER (
			        _2 > 0 && ( _1 = BLANK () || _1 <= 0 ),
			        [Valor dif Carteira Ganhos e Perdidos YTD]
			    ) --Novos
			RETURN
			    _3
		displayFolder: Ganho e Perdido Anunciante
		lineageTag: c131a93e-55b4-4bbe-bff5-890fdf3d62fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Clientes Recorrentes_' =
			
			VAR _1 =
			    CALCULATE (
			        [Val Carteira YTD LY Closed Month],
			        ALLSELECTED ( 'Emp_Venda'[Empresa Venda] ),
			        ALLSELECTED ( 'Emp_Venda'[ExternalCode] ),
			        ALLSELECTED ( 'Executivos'[Executivo] ),
			        ALLSELECTED ( TipoMidia[ExternalCode] ),
			        ALLSELECTED ( TipoVenda[ExternalCode] ),
			        ALLSELECTED ( GrupoCliente[Cliente_Cod] ),
			        ALLSELECTED ( Users[Gerente] )
			    )
			VAR _2 =
			    CALCULATE (
			        [Val Carteira YTD Closed Month],
			        ALLSELECTED ( 'Emp_Venda'[Empresa Venda] ),
			        ALLSELECTED ( 'Emp_Venda'[ExternalCode] ),
			        ALLSELECTED ( 'Executivos'[Executivo] ),
			        ALLSELECTED ( TipoMidia[ExternalCode] ),
			        ALLSELECTED ( TipoVenda[ExternalCode] ),
			        ALLSELECTED ( GrupoCliente[Cliente_Cod] ),
			        ALLSELECTED ( Users[Gerente] )
			    )
			VAR _3 =
			    IF.EAGER (
			        _2 > 0 && ( _1 = BLANK () || _1 <= 0 ),
			        "Novos",
			        [Valor dif Carteira Ganhos e Perdidos YTD]
			    ) --Novos
			VAR _4 =
			    IF.EAGER ( _1 > 0 && _2 > 0, [Valor dif Carteira Ganhos e Perdidos YTD] ) -- Recorrentes
			VAR _5 =
			    IF.EAGER (
			        (
			            _1 > 0 && _2 <= 0 || _2 = BLANK ()
			        )
			            || (
			                ( _1 <= 0 || _1 = BLANK () ) && ( _2 <= 0 || _2 = BLANK () )
			            ),
			        [Valor dif Carteira Ganhos e Perdidos YTD]
			    ) --Perdidos
			VAR _6 =
			    IF.EAGER ( _2 > 0 && ( _1 > _2 ), [Valor dif Carteira Ganhos e Perdidos YTD] ) --"Queda"
			VAR _7 =
			    IF.EAGER (
			        _2 > 0 && ( _2 > _1 ) && ( _1 <> BLANK () || _1 <> 0 ),
			        [Valor dif Carteira Ganhos e Perdidos YTD]
			    ) --, "Crescimento"
			RETURN
			    _4
		displayFolder: Ganho e Perdido Anunciante
		lineageTag: 17068bfa-ef23-48bf-af65-8503036cfa1d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Clientes Perdidos' =
			
			VAR _1 =
			    CALCULATE (
			        [Val Carteira YTD LY Closed Month],
			        ALLSELECTED ( 'Emp_Venda'[Empresa Venda] ),
			        ALLSELECTED ( 'Emp_Venda'[ExternalCode] ),
			        ALLSELECTED ( 'Executivos'[Executivo] ),
			        ALLSELECTED ( TipoMidia[ExternalCode] ),
			        ALLSELECTED ( TipoVenda[ExternalCode] ),
			        ALLSELECTED ( GrupoCliente[Cliente_Cod] ),
