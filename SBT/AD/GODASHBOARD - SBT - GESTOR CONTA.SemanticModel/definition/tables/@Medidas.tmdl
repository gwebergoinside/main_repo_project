	measure 'QTD Pendentes' =
			
			VAR _Act =
			    CALCULATE (
			        DISTINCTCOUNT ( Activity[activityid] ),
			        Activity[activitytypecode] <> "appointment",
			        REMOVEFILTERS ( Calendario[Date] ),
			        TREATAS ( VALUES ( Calendario[Date] ), Neg[createdon] )
			    )
			VAR _SOL =
			    CALCULATE (
			        DISTINCTCOUNT ( Solicitacao[go_solicitaodeaprovacaoid] ),
			        REMOVEFILTERS ( Calendario[Date] ),
			        TREATAS ( VALUES ( Calendario[Date] ), Neg[createdon] )
			    )
			RETURN
			    _Act + _SOL
		formatString: #,0
		displayFolder: Pendentes
		lineageTag: 62928967-3bf0-4940-b197-9901a4edaab0

