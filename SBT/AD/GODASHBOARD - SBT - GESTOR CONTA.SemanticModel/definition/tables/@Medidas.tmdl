	measure valor_tipoCliente =
			
			SWITCH (
			    [Selected Type],
			    1,
			        SUMX (
			            SUMMARIZE ( GrupoCliente, GrupoCliente[Cliente], "sum", [Clientes Recorrentes] ),
			            [Sum]
			        ),
			    2,
			        SUMX (
			            SUMMARIZE ( GrupoCliente, GrupoCliente[Cliente], "sum", [Novos Clientes] ),
			            [Sum]
			        )
			)
		lineageTag: cb29c97e-fe72-4cd2-8e4b-257114cb811d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Clientes Recorrentes' =
			
			VAR _1 =
			    CALCULATE (
			        [Valor],
			        FILTER (
			            ALL ( Calendario[Ano] ),
			            Calendario[Ano] <= MAX ( Calendario[Ano] ) - 1
			        )
			    )
			VAR _2 =
			    CALCULATE (
			        [Valor],
			        FILTER ( ALL ( Calendario[Ano] ), Calendario[Ano] = MAX ( Calendario[Ano] ) )
			    )
			VAR _4 =
			    IF ( _1 > 0 && _2 > 0, [valor], BLANK () )
			RETURN
			    _4
		formatString: #,0
		displayFolder: Anunciante
		lineageTag: bfb565c9-dbee-476c-82e9-545577d99462

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Novos Clientes' =
			
			VAR _1 =
			    CALCULATE (
			        [Valor],
			        FILTER (
			            ALL ( Calendario[Ano] ),
			            Calendario[Ano] <= MAX ( Calendario[Ano] ) - 1
			        )
			    ) //2020 para trás
			VAR _2 =
			    CALCULATE (
			        [Valor],
			        FILTER ( ALL ( Calendario[Ano] ), Calendario[Ano] = MAX ( Calendario[Ano] ) )
			    ) //2021 MAX(Calendario[Date])=2022
			VAR _3 =
			    IF ( ( _1 = BLANK () || _1 = 0 ) && _2 > 0, [Valor], BLANK () ) //novos
			RETURN
			    _3
		formatString: #,0
		displayFolder: Anunciante
		lineageTag: fd4b9b9d-2ac9-42f4-b951-98f82fbca4e6

		changedProperty = FormatString

