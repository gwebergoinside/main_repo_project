		source =
				// let
				//     Source = Sql.Database(Org, BD, [Query="Select#(lf)    [User].Name Executivo,#(lf)    [User].ExternalCode ExecutivoCodigo#(lf)From#(lf)    [User]"]),
				//     #"Filtered Rows" = Table.SelectRows(Source, each ([ExecutivoCodigo] <> null))
				// in
