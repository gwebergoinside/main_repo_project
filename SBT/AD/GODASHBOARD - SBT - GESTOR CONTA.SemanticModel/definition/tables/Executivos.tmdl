				let
				    SQL = "SELECT
				            [User].Name AS Executivo,
				            [User].ExternalCode AS ExecutivoCodigo
				        FROM [User]
				        WHERE 1 = 1
				            AND [User].ExternalCode IS NOT NULL",
				    Source = Sql.Database(Org, BD, [Query = SQL]),
				    Verificar = let
				        Agrupar = Table.Group(Source, {"ExecutivoCodigo"}, {"Contagem", each Table.RowCount(_), Int64.Type})
				        in Table.SelectRows(Agrupar, each [Contagem] > 1)[ExecutivoCodigo],
				    #"Registros Duplicados" = Table.SelectRows(Source, each List.Contains(Verificar, [ExecutivoCodigo])),
				    #"Filtrar Sem Duplicidade" = Table.SelectRows(Source, each not ([ExecutivoCodigo] = "BVENA" and [Executivo] = "Bruna Kethelyn Candida Venancio"))
				in
				    #"Filtrar Sem Duplicidade"

