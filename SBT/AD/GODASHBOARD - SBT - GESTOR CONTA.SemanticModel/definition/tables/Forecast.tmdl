	column codIntegrador
		dataType: string
		lineageTag: 8be4607d-4d4a-4d10-a3cb-2ee14b786121
		summarizeBy: none
		sourceColumn: codIntegrador

		annotation SummarizationSetBy = Automatic

	partition Forecast-3377f633-fee9-48ef-943f-c971e94ba467 = m
		mode: import
		queryGroup: Carteira
		source =
				let
				    SQL = "SELECT
				            ForecastPeriod.Date,
				            Entity.ExternalCode,
				            Forecast.Amount As ForecastAmount,
				            Forecast.ExpectedAmount As ForecastExpAmount,
				            (Forecast.Amount + Forecast.ExpectedAmount) * 1000 As Forecast,
				            [User].ExternalCode As ExternalCodeExecutivo,
				            Company.ExternalCode As ExternalCodeCompany,
				            Entity1.ExternalCode As ExternalCodeAgency,
				            UPPER(ForecastMediaType.ExternalCode) As MediaType,
				            UPPER(ForecastSaleType.ExternalCode) As SaleType,
				            UPPER(Entity.ExternalCode + Entity1.ExternalCode) AS codIntegrador
				        FROM Forecast
				        JOIN ForecastPeriod
				            On Forecast.PeriodID = ForecastPeriod.ID
				        JOIN Entity
				            On Forecast.EntityClientID = Entity.ID
				        JOIN [User]
				            On Forecast.UserID = [User].ID
				        JOIN Company
				            On Forecast.CompanyID = Company.ID
				        JOIN Entity Entity1
				            On Forecast.EntityAgencyID = Entity1.ID
				        JOIN ForecastMediaType
				            On Forecast.MediaTypeID = ForecastMediaType.ID
				        JOIN ForecastSaleType
				            On Forecast.SaleTypeID = ForecastSaleType.ID
				        WHERE
				            ABS(Forecast.Amount + Forecast.ExpectedAmount) > 0",
				    Source = Sql.Database(Org, BD, [Query = SQL]),
				    #"Merged Account" = Fn_TipoGoverno(Source, "ExternalCode")
				in
				    #"Merged Account"

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

