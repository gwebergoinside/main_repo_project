	column Chave = [ExternalCode]&"-"& [ExternalCodeAgency]&"-"& [MediaType]&"-"& [SaleType]&"-"& [Numero_Negociacao]&"-"& Year([Date])&"-"& MONTH([Date])
		isHidden
