	column Valor_BAV =
			
			// LOOKUPVALUE(
			//     R0002[Vlr_Gerencial_BAV]
			//     ,R0002[ChaveForecast]
			//     ,Forecast_OPT[Chave]
			// )
			
			CALCULATE(
			    SUM( R0002[Vlr_Gerencial_BAV] )
			    ,FILTER(
			        ALL(R0002)
			        , Forecast_OPT[Chave] = R0002[ChaveForecast]
			    )
			)
		isHidden
		lineageTag: 5ad4b709-68c9-4375-a58f-70f576497481
