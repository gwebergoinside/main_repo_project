	partition GrupoAgencia-9ed82b92-d56c-481e-9c8b-39c29ea39b08 = m
		mode: import
		queryGroup: CORE
		source = ```
				let
				    SQL = "WITH
				        GrupoPorExternalCode AS (
				            SELECT
				                cl.Name AS Agencia,
				                g.Name AS GrupoAgencia,
				                cl.ExternalCode AS AgenciaCodigo,
				                g.ExternalCode AS GrupoAgenciaCodigo
				            FROM
				                Entity cl
				                INNER JOIN Entity g
				                    ON cl.ExternalCode = g.ExternalCode
				                    AND cl.ParentID IS NULL
				                INNER JOIN EntityEntityType
				                    ON g.ID = EntityEntityType.EntityID
				            WHERE
				                EntityEntityType.EntityTypeID = 2
				        ),
				
				        GrupoPorParentId AS (
				            SELECT
				                cl.Name AS Agencia,
				                g.Name AS GrupoAgencia,
				                cl.ExternalCode AS AgenciaCodigo,
				                g.ExternalCode AS GrupoAgenciaCodigo
				            FROM
				                Entity cl
				                INNER JOIN Entity g
				                    ON cl.ParentID = g.ID
				                INNER JOIN EntityEntityType
				                    ON g.ID = EntityEntityType.EntityID
				            WHERE
				                EntityEntityType.EntityTypeID = 2
				        ),
				
				        Union1 AS (
				            SELECT
				                Agencia,
				                GrupoAgencia,
				                AgenciaCodigo,
				                GrupoAgenciaCodigo
				            FROM
				                GrupoPorExternalCode
				
				        UNION
				
				            SELECT
				                Agencia,
				                GrupoAgencia,
				                AgenciaCodigo,
				                GrupoAgenciaCodigo
				            FROM
				                GrupoPorParentId
				        )
				        
				    SELECT
				        D.Agencia,
				        D.GrupoAgencia,
				        D.AgenciaCodigo,
				        D.GrupoAgenciaCodigo,
				        D.Grupo_Agencia
				        FROM (
				            SELECT
				                TRIM(Union1.Agencia) AS Agencia,
				                TRIM(Union1.GrupoAgencia) AS GrupoAgencia,
				                UPPER(TRIM(Union1.AgenciaCodigo)) AS AgenciaCodigo,
				                TRIM(Union1.GrupoAgenciaCodigo) AS GrupoAgenciaCodigo,
				                TRIM(Union1.GrupoAgencia) + ' (' + TRIM(Union1.GrupoAgenciaCodigo) + ')' AS Grupo_Agencia,
				                -- AgenciaCodigo é o lado 1 de várias relações: uma linha por código, com desempate determinístico
				                ROW_NUMBER() OVER (
				                    PARTITION BY UPPER(TRIM(Union1.AgenciaCodigo))
				                    ORDER BY Union1.GrupoAgenciaCodigo, Union1.Agencia
				                ) AS rn
				            FROM Union1
				        ) AS D
				        WHERE D.rn = 1",
				    Source = Sql.Database(Org, BD, [Query = SQL])
				in
				    Source
				```

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navegação

