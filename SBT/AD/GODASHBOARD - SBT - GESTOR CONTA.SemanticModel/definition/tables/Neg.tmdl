	column 'Data de Integração_Final'
		dataType: dateTime
		formatString: Long Date
		lineageTag: d73879a1-9a70-499e-9d75-fb2411c9aad5
		summarizeBy: none
		sourceColumn: Data de Integração_Final

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Mes Integração' =
			
			SWITCH(
			    MONTH(Neg[Data de Integração_Final])
			    ,1,"Jan",2,"Fev",3,"Mar",4,"Abr"
			    ,5,"Mai",6,"Jun",7,"Jul",8,"Ago"
			    ,9,"Set",10,"Out",11,"Nov",12,"Dez"
			)
		lineageTag: 1bf37e35-7c35-4506-a8b2-50bfee9bc3d4
		summarizeBy: none
		sortByColumn: 'Mes Nº Integração'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Ano Integração' = YEAR( Neg[Data de Integração_Final] )
		formatString: 0
		lineageTag: 7be7311b-603a-4a41-8bb0-e52b40d763b2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Mes Nº Integração' = MONTH( Neg[Data de Integração_Final] )
		formatString: 0
		lineageTag: a3eb07c7-3ba5-4d3b-8057-01b03ffd16bc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ValorLiquido =
			
			// LOOKUPVALUE(
			//     R0002[Vlr_Gerencial_BAV]
			//     ,R0002[ChaveForecast]
			//     ,Forecast_OPT[Chave]
			// )
			VAR _1 =
			CALCULATE(
			    SUM( R0002[Vlr_Gerencial_BAV] )
			    ,FILTER(
			        ALL(R0002)
			        , Neg[Numero_Negociacao] = R0002[Numero_Negociacao]
			    )
			)
			VAR _2 =
			CALCULATE(
			    SUM( R0002[Vlr_Repasse_Varejo] )
			    ,FILTER(
			        ALL(R0002)
			        , Neg[Numero_Negociacao] = R0002[Numero_Negociacao]
			    )
			)
			RETURN
			IF( Neg[Numero_Negociacao] = BLANK(), BLANK(),
			_1+_2 )
		lineageTag: bcdd4720-7e58-410e-8196-8b9f00f805f6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

