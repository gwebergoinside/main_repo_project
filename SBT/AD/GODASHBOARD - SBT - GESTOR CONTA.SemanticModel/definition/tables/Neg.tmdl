	column Estado =
			
			SWITCH( TRUE()
			    , Neg[statuscode] in {100000010,1,2,100000001,100000002,100000003}  , "Em Aberto"
			    , Neg[statuscode] in {5,100000011,100000012,100000013,100000014}  , "Perdida"
			    , Neg[statuscode] in {100000006,100000007,100000008,100000004}  , "Em Aprovação"
			    , Neg[statuscode] in {3}  , "Ganho"
			    , BLANK()
			)
		lineageTag: a3093d49-f5e0-49d4-931c-e8290385bb60
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

