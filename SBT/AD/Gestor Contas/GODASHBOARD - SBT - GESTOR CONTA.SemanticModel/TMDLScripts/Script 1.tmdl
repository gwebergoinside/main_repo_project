		column MêsCorrente =
				
				IF (
				    AND ( [Date]>=DATE ( YEAR ( NOW () ), MONTH ( NOW () ), 1 ) ,[Date]<DATE ( YEAR ( NOW () ), MONTH ( NOW () )+1, 1) ),
				    "Mês Corrente",
				    IF (
				        AND ( [Date]>=DATE ( YEAR ( NOW () ), MONTH ( NOW () )-12, 1 ),[Date]<[Today] ),
				        "Meses Transactos",
				        IF ( [Today] = 0, "" )
				    )
				)
			isHidden
			lineageTag: d46989d1-e10b-41a6-a460-f012c21501b3
			summarizeBy: none

			changedProperty = IsHidden

			annotation SummarizationSetBy = Automatic

		column Today = IF([Date] = TODAY(), 1, 0)
			isHidden
