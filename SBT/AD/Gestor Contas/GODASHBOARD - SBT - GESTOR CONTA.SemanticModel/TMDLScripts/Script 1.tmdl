		measure 'Valor dif Carteira Ganhos e Perdidos YTD' =
				
				IF (
				    ISFILTERED ( 'Calendario'[Date] ),
				    ERROR ( "Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column." ),
				    VAR __PREV_YEAR = [Val Carteira YTD LY Closed Month]
				    RETURN
				        [Val Carteira YTD Closed Month] - __PREV_YEAR
				)
			formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
			displayFolder: Ganho e Perdido Anunciante
			lineageTag: 3687f0c5-8e6a-4b78-b1b7-fcc4a6f219c4

			changedProperty = FormatString

			annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

		measure 'Valor var Carteira Ganhos e Perdidos YTD' =
				
				--SWITCH (
				--    [Selected SalesParameter],
				--    1, [% Var Exibido],
				--    2, [% Var Liquido Final],
				--    BLANK ()
				--)
				IF (
				    ISFILTERED ( 'Calendario'[Date] ),
				    ERROR ( "Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column." ),
				    VAR __PREV_YEAR = [Val Carteira YTD LY Closed Month]
				    RETURN
				        DIVIDE ( [Val Carteira YTD Closed Month] - __PREV_YEAR, ABS ( __PREV_YEAR ), 1 )
				)
			formatString: 0.00%;-0.00%;0.00%
			displayFolder: Ganho e Perdido Anunciante
