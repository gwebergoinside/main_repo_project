					//     #"Trimmed Text" = Table.TransformColumns(#"Changed Type",{{"Cod_Agencia", Text.Trim, type text}, {"Cod_Cliente", Text.Trim, type text}, {"Cod_Contato", Text.Trim, type text}, {"MediaTypeExternalCode", Text.Trim, type text}, {"SaleTypeExternalCode", Text.Trim, type text}}),
					//     #"Uppercased Text" = Table.TransformColumns(#"Trimmed Text",{{"Cod_Agencia", Text.Upper, type text}, {"Cod_Cliente", Text.Upper, type text}, {"Cod_Contato", Text.Upper, type text}, {"Cod_Nucleo", Text.Upper, type text}}),
					//     #"Merged Queries3" = Table.NestedJoin(#"Uppercased Text", {"Cod_Empresa", "Competencia", "Numero_Negociacao"}, VendaImportada, {"Cod_Empresa", "Competencia", "Numero_Negociacao"}, "VendaImportada", JoinKind.LeftOuter),
					//     #"Expanded VendaImportada" = Table.ExpandTableColumn(#"Merged Queries3", "VendaImportada", {"Cod_Contato_Importada"}, {"Cod_Contato.1"}),
					//     #"Added Custom" = Table.AddColumn(#"Expanded VendaImportada", "Cod_ContatoFinal", each if [MotivoAjusteManual] = null then [Cod_Contato.1] else [Cod_Contato]),
					//     Custom6 = Table.AddColumn(#"Added Custom" , "Cod_Contato.2", each if [Cod_ContatoFinal] <> null then [Cod_ContatoFinal] else [Cod_Contato]),
					//     #"Removed Columns" = Table.RemoveColumns(Custom6,{"Cod_Contato", "Cod_Contato.1", "Cod_ContatoFinal", "Numero_Mr"}),
					//     #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{"Cod_Contato.2", "Cod_Contato"}),
					//     #"Merged Queries2" = Table.NestedJoin(#"Renamed Columns", {"Cod_Cliente"}, Account, {"accountnumber"}, "Account", JoinKind.LeftOuter),
					//     #"Expanded Account" = Table.ExpandTableColumn(#"Merged Queries2", "Account", {"go_pl_classificacaogoverno_display"}, {"Tipo Governo"}),
					//     #"Replaced Value" = Table.ReplaceValue(#"Expanded Account",null,"Setor Privado",Replacer.ReplaceValue,{"Tipo Governo"}),
					//     #"Renamed Columns1" = Table.RenameColumns(#"Replaced Value",{"Cod_Contato", "Cod_Executivo"})
					// in
					//     #"Renamed Columns1"
					
					let
					    SQL = "
					        WITH VI AS
					            (
					                SELECT DISTINCT
					                    r2.Cod_Empresa,
					                    r2.Competencia,
					                    r2.Numero_Negociacao,
					                    Cod_Contato_Importada = 'VEIMPR'
					                FROM " & BDExternal & ".SCTV.R0002 AS r2
					                JOIN " & BD & ".dbo.Company AS eFat
					                    ON eFat.ExternalCode = r2.Cod_Empresa_Faturamento
					                    AND eFat.Affiliation = 'FILIADO'
					                JOIN " & BD & ".dbo.Company AS eEmp
					                    ON eEmp.ExternalCode = r2.Cod_Empresa
					                    AND eEmp.Affiliation <> 'FILIADO'
					                WHERE 1 = 1
					                    AND r2.Cod_Nucleo NOT IN ('n10', 'novon', 'vale')
					                    AND r2.Indica_Mes_Anterior = 0
					                    AND r2.Cod_Empresa_Faturamento <> '054'
					            )
					
					        SELECT
					            E.Cod_Empresa,
					            E.Cod_Tipo_Comercial,
					            E.Sequencia_Mr,
					            E.[CodEmp Faturamento],
					            E.Cod_Agencia,
					            E.Cod_Cliente,
					            E.Cod_Nucleo,
					            E.Competencia,
					            E.Data,
					            E.Numero_Negociacao,
					            E.SaleTypeExternalCode,
					            E.MediaTypeExternalCode,
					            E.ChannelDisplay,
					            E.Affiliation,
					            E.chaveT,
					            Cod_Executivo = COALESCE(E.MotivoAjusteManual, VI.Cod_Contato_Importada, E.Cod_Contato),
					            UPPER(E.Cod_Cliente + E.Cod_Agencia) AS codIntegrador,
					            SUM(E.Vlr_Gerencial_BAV)  AS Vlr_Gerencial_BAV,
					            SUM(E.Vlr_Repasse_Varejo) AS Vlr_Repasse_Varejo,
					            SUM(E.Vlr_Exibido) AS Vlr_Exibido
					        FROM
					
					            (
					                SELECT
					                    r.Cod_Empresa,
					                    r.Cod_Tipo_Comercial,
					                    x.Sequencia_Mr,
					                    x.CodEmpFaturamento AS [CodEmp Faturamento],
					                    x.Cod_Agencia,
					                    x.Cod_Cliente,
					                    x.Cod_Contato,
					                    x.Cod_Nucleo,
					                    r.Competencia,
					                    x.Data,
					                    r.Numero_Negociacao,
					                    x.SaleTypeExternalCode,
					                    CASE WHEN X.Cod_Nucleo = 'INTERAT' THEN 'SITE' ELSE X.MediaTypeExternalCode END AS MediaTypeExternalCode, -- Condicional solicitada ticket 73910310 - Ajuste Nucelo Interatividade                    
					                    r.Vlr_Gerencial_BAV,
					                    r.Vlr_Repasse_Varejo,
					                    r.Vlr_Bruto AS Vlr_Exibido,
					                    (ch.ExternalCode + ' - ' + ch.Name) AS ChannelDisplay,
					                    cp.Affiliation,
					                    r.MotivoAjusteManual,
					                    chaveT =
					                        x.Cod_Cliente +
					                        x.Cod_Agencia +
					                        r.Cod_Empresa +
					                        x.Cod_Contato +
					                        UPPER(x.SaleTypeExternalCode) + 
					                        UPPER(CASE WHEN X.Cod_Nucleo = 'INTERAT' THEN 'SITE' ELSE X.MediaTypeExternalCode END) + 
					                        CAST(YEAR(x.Data) AS VARCHAR(4)) +
					                        CAST(MONTH(x.Data) AS VARCHAR(2))
					                FROM " & BDExternal & ".SCTV.R0002_Detalhe AS r WITH (NOLOCK)
					                LEFT JOIN " & BD & ".dbo.Company AS cp WITH (NOLOCK)
					                    ON cp.ExternalCode = r.Cod_Empresa
					                LEFT JOIN " & BD & ".dbo.Company AS cpfat WITH (NOLOCK)
					                    ON cpfat.ExternalCode = r.Cod_Empresa_Faturamento
					                LEFT JOIN " & BD & ".dbo.Channel AS ch WITH (NOLOCK)
					                    ON ch.ExternalCode = r.Cod_Veiculo
					                CROSS APPLY (
					                        VALUES (
					                            DATEFROMPARTS(CONVERT(INT, LEFT(r.Competencia, 4)), CONVERT(INT, RIGHT(r.Competencia, 2)), 1),
					                            UPPER(r.Sequencia_Mr),
					                            UPPER(LTRIM(RTRIM(r.Cod_Empresa_Faturamento))),
					                            UPPER(LTRIM(RTRIM(r.Cod_Agencia))),
					                            UPPER(LTRIM(RTRIM(r.Cod_Cliente))),
					                            UPPER(LTRIM(RTRIM(r.Cod_Contato))),
					                            UPPER(LTRIM(RTRIM(r.Cod_Nucleo))),
					                            LTRIM(RTRIM(r.SaleTypeExternalCode)),
					                            LTRIM(RTRIM(r.MediaTypeExternalCode))
					                        )
					                    ) x
					                    (
					                        Data,
					                        Sequencia_Mr,
					                        CodEmpFaturamento,
					                        Cod_Agencia,
					                        Cod_Cliente,
					                        Cod_Contato,
					                        Cod_Nucleo,
					                        SaleTypeExternalCode,
					                        MediaTypeExternalCode
					                    )
					                    WHERE 1 = 1
					                        AND NOT (ISNULL(cp.Affiliation, '') = 'AFILIADO'
					                        AND ISNULL(cpfat.Affiliation, '') = 'AFILIADO')
					                ) AS E
					        LEFT JOIN VI
					            ON VI.Cod_Empresa = E.Cod_Empresa
					            AND VI.Competencia = E.Competencia
					            AND VI.Numero_Negociacao = E.Numero_Negociacao
					        WHERE 1 = 1
					            AND YEAR(E.Data) >= YEAR(GETDATE()) - " & YearUpdateData & "
					            AND E.Data >= '" & DateTime.ToText( RangeStart, "yyyy-MM-dd") & "'
					            AND E.Data < '" & DateTime.ToText( RangeEnd , "yyyy-MM-dd") & "'
					        GROUP BY
					            E.Cod_Empresa,
					            E.Cod_Tipo_Comercial,
					            E.Sequencia_Mr,
					            E.[CodEmp Faturamento],
					            E.Cod_Agencia,
					            E.Cod_Cliente,
					            E.Cod_Nucleo,
					            E.Competencia,
					            E.Data,
					            E.Numero_Negociacao,
					            E.SaleTypeExternalCode,
					            E.MediaTypeExternalCode,
					            E.ChannelDisplay,
					            E.Affiliation,
					            E.chaveT,
					            COALESCE(E.MotivoAjusteManual, VI.Cod_Contato_Importada, E.Cod_Contato)",
					    Source = Sql.Database(Org, BD, [Query = SQL]),
						// MergeVendaImportada = let
						//     Juntar = Table.NestedJoin( Source, {"Cod_Empresa", "Competencia", "Numero_Negociacao"}, VendaImportada, {"Cod_Empresa", "Competencia", "Numero_Negociacao"}, "VendaImportada", JoinKind.LeftOuter ),
						//     Expandir = Table.ExpandTableColumn( Juntar, "VendaImportada", {"Cod_Contato_Importada"}, {"Cod_Contato_Importada"} )
						//     in Table.AddColumn( Expandir, "Cod_Contato_Final", each if [MotivoAjusteManual] is null or [MotivoAjusteManual] = "" then if [Cod_Contato_Importada] is null or [Cod_Contato_Importada] = "" then [Cod_Contato_Importada] else [Cod_Contato] else [Cod_Contato], type text ),
						// Cleanup = Table.RemoveColumns(MergeVendaImportada, {"Cod_Contato_Importada"}),
						// ReplaceCodContato = Table.RenameColumns( Table.RemoveColumns(Cleanup, {"Cod_Contato"}), {{"Cod_Contato_Final", "Cod_Contato"}}),
						Exceções = {"HAVANIMPHAV227SEMCNACIONSITE20263",
					            "HAVANIMPHAV227SEMCNACIONNORMAL20261",
					            "HAVANIMPHAV227SEMCNACIONNORMAL20262",
					            "HAVANIMPHAV227SEMCNACIONNORMAL20263",
					            "HAVANIMPHAV227SEMCNACIONMAISSBT20263",
					            "9LA0IT9LA0IT605SEMCNACIONNORMAL20262",
					            "0IORC3CALY2P605SEMCNACIONNORMAL20262",
					            "FRIBOICPBCR605SEMCNACIONSITE20263",
					            "APEXSNBB605SEMCNACIONNORMAL20262",
					            "APEXSNBB605SEMCNACIONNORMAL20263",
					            "ATACAFATACAF605SEMCNACIONMERCHA20263",
					            "HIRNN0HIRNN0605SEMCNACIONMERCHA20262",
					            "HIRNN0HIRNN0605SEMCNACIONMERCHA20263",
					            "AMISP70IT0AP605SEMCNACIONNORMAL20263",
					            "9LA0IT9LA0IT605SEMCNACIONNORMAL20261",
					            "9LA0IT9LA0IT605SEMCNACIONNORMAL20263",
					            "TIMSA1DAANAD605SEMCNACIONNORMAL20261",
					            "TIMSA1DAANAD605SEMCNACIONNORMAL20262",
					            "TIMSA1DAANAD605SEMCNACIONNORMAL20263",
					            "U0PN0CTPLAN605SEMCNACIONNORMAL20261",
					            "U0PN0CTPLAN605SEMCNACIONNORMAL20262",
					            "FRIBOICPBCR605SEMCNACIONMAISSBT20262",
					            "FRIBOICPBCR605SEMCNACIONMAISSBT20263",
					            "FRIBOICPBCR605SEMCNACIONSITE20262",
					            "TIMSA1DAANAD605SEMCNACIONSITE20261",
					            "TIMSA1DAANAD605SEMCNACIONSITE20262",
					            "TIMSA1DAANAD605SEMCNACIONSITE20263",
					            "ATACAFATACAF605SEMCNACIONNORMAL20263",
					            "HIRNN0HIRNN0605SEMCNACIONNORMAL20262",
					            "HIRNN0HIRNN0605SEMCNACIONNORMAL20263"},
					    // Exceções = let // Condicional solicitada ticket Intercom 96052764 [Melhoria SBT] - Criação de Dashboard "Venda Líquida Carteira Atual" – SBT News (Fase 2 | Chamado 85579164)     
						// 	#"Códigos Núcleo" = {434522,433991,433968,433687,433688,433685,433675,433456,436008,436379,437426,435038,435037,435638
					    //         ,437707}, // 4659 [Melhoria SBT] - Inclusão de negociação - Intercom: 98881620
						// 	Datas = List.Transform({"2026-01-01","2026-02-01","2026-03-01"}, each DateTime.From(_)),
						// 	#"Filtrar Exceções" = List.Distinct(Table.SelectRows(Source, each List.Contains(#"Códigos Núcleo", [Numero_Negociacao]) and List.Contains(Datas, [Data] ))[chaveT])
						// in #"Filtrar Exceções",
						SBTNEWS = Table.AddColumn(Source, "is_SBTNEWS", each try
									if List.Contains(Text.Split(array_SBTNEWS, ","), [Cod_Nucleo], Comparer.OrdinalIgnoreCase) then "Sim" // Condicional solicitada ticket 72675899 - Ajuste de exibição dos dados do SBT News nos dashboards - 72675899
					        // else    if List.Contains({"MAISSBT", "SITE"}, [Cod_Nucleo], Comparer.OrdinalIgnoreCase) and DateTime.Date( [Data] ) >= #date(2026, 4, 1) then "Sim"
							else    if List.Contains(Exceções, [chaveT], Comparer.OrdinalIgnoreCase) then "Sim" // Condicional solicitada ticket Intercom 96052764 [Melhoria SBT] - Criação de Dashboard "Venda Líquida Carteira Atual" – SBT News (Fase 2 | Chamado 85579164)        
							else    "Não" otherwise "Não", type text),
					    #"Ajuste Nucleo SBTNEWS" = Table.ReplaceValue(SBTNEWS, each [Cod_Nucleo],
					            each if Text.Trim(Text.Clean([Cod_Nucleo])) = "MAISSBT" and [is_SBTNEWS] = "Sim" then "SBTNMAI"
					            else if Text.Trim(Text.Clean([Cod_Nucleo])) = "SITE" and [is_SBTNEWS] = "Sim" then "SBTNDIG"
					            else Text.Trim(Text.Clean([Cod_Nucleo])),
					        Replacer.ReplaceText,{"Cod_Nucleo"}), 
						MergeAccount = let
							Juntar = Table.NestedJoin(#"Ajuste Nucleo SBTNEWS", {"Cod_Cliente"}, Account, {"accountnumber"}, "Account", JoinKind.LeftOuter ),
							Expandir = Table.ExpandTableColumn( Juntar, "Account", {"go_pl_classificacaogoverno_display"}, {"Tipo Governo"})
							in Table.ReplaceValue( Expandir, null, "Setor Privado", Replacer.ReplaceValue, {"Tipo Governo"})
					in
						MergeAccount
					```

