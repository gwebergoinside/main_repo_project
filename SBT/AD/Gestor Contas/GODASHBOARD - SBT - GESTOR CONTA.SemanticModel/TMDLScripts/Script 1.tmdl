ao,#(lf)    R.SaleTypeExternalCode,#(lf)    R.MediaTypeExternalCode,#(lf)    ch.ExternalCode + ' - ' + ch.Name,#(lf)    cp.Affiliation,#(lf)    R.MotivoAjusteManual"]),
