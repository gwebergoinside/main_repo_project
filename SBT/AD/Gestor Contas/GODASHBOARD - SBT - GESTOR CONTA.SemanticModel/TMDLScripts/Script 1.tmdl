		partition Forecast_OPT-ddc06653-9c03-41de-bc0d-a4ea71c2298f = m
			mode: import
			queryGroup: Carteira
			source = ```
					let
					    SQL = "Select
					            fp.Date,
					            e.ExternalCode,
					            f.Amount As ForecastAmount,
					            f.ExpectedAmount As Forecast,
					            f.RealizedAmount, 
					            e1.ExternalCode As ExternalCodeAgency,
					            UPPER(fmt.ExternalCode) As MediaType,
					            UPPER(fst.ExternalCode) As SaleType,
					            CAST(DO.ExternalCode AS INT) AS Numero_Negociacao,
					            Negotiation.OpportunityID,
					            Negotiation.ID,
					            f.IsActive,
					            f.LockedExpectedAmount,
					            UPPER(e.ExternalCode + e1.ExternalCode) AS codIntegrador
					        From NegotiationForecast f
					        Join ForecastPeriod fp
					            On f.PeriodID = fp.ID
					        Join Entity e
					            On f.EntityClientID = e.ID
					        Join Entity e1
					            On f.EntityAgencyID = e1.ID
					        Join ForecastMediaType fmt
					            On f.MediaTypeID = fmt.ID
					        Join ForecastSaleType fst
					            On f.SaleTypeID = fst.ID
					        Join Negotiation
					            On f.NegotiationID = Negotiation.ID
					        Join DynamicsOpportunity DO
					            On DO.ID = Negotiation.OpportunityID
					        Where
					            f.IsActive = 1",
					    Source = Sql.Database(Org, BD, [Query = SQL])
					    // #"Uppercased Text" = Table.TransformColumns(Source,{{"MediaType", Text.Upper, type text}, {"SaleType", Text.Upper, type text}}),
					    // #"Changed Type" = Table.TransformColumnTypes(#"Uppercased Text",{{"Numero_Negociacao", Int64.Type}}),
					    // #"Renamed Columns1" = Table.RenameColumns(#"Changed Type",{{"ForecastExpAmount", "Forecast"}}),
					    // #"Changed Type1" = Table.TransformColumnTypes(#"Renamed Columns1",{{"Date", type date}}),
					    // #"Linhas Filtradas" = Table.SelectRows(#"Changed Type1", each ([IsActive] = true))
					in
					    Source
					```

		changedProperty = IsHidden

		annotation PBI_ResultType = Exception

		annotation PBI_NavigationStepName = Navegação

