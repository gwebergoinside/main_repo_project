			sourceColumn: Tipo Governo

			annotation SummarizationSetBy = Automatic

		column codIntegrador
			dataType: string
			lineageTag: 8be4607d-4d4a-4d10-a3cb-2ee14b786121
			summarizeBy: none
			sourceColumn: codIntegrador

			annotation SummarizationSetBy = Automatic

		partition Forecast-3377f633-fee9-48ef-943f-c971e94ba467 = m
			mode: import
			queryGroup: Carteira
			source =
					// let
					//     SQL = "Select#(lf)    ForecastPeriod.Date,#(lf)    Entity.ExternalCode,#(lf)    Forecast.Amount As ForecastAmount,#(lf)    Forecast.ExpectedAmount As ForecastExpAmount,#(lf)    [User].ExternalCode As ExternalCodeExecutivo,#(lf)    Company.ExternalCode As ExternalCodeCompany,#(lf)    Entity1.ExternalCode As ExternalCodeAgency,#(lf)    ForecastMediaType.ExternalCode As MediaType,#(lf)    ForecastSaleType.ExternalCode As SaleType#(lf)From#(lf)    Forecast Inner Join#(lf)    ForecastPeriod On Forecast.PeriodID = ForecastPeriod.ID Inner Join#(lf)    Entity On Forecast.EntityClientID = Entity.ID Inner Join#(lf)    [User] On Forecast.UserID = [User].ID Inner Join#(lf)    Company On Forecast.CompanyID = Company.ID Inner Join#(lf)    Entity Entity1 On Forecast.EntityAgencyID = Entity1.ID Inner Join#(lf)    ForecastMediaType On Forecast.MediaTypeID = ForecastMediaType.ID Inner Join#(lf)    ForecastSaleType On Forecast.SaleTypeID = ForecastSaleType.ID",
					//     Source = Sql.Database(Org, BD, [Query = SQL]),
					//     #"Uppercased Text" = Table.TransformColumns(Source,{{"MediaType", Text.Upper, type text}, {"SaleType", Text.Upper, type text}}),
					//     #"Added Custom" = Table.AddColumn(#"Uppercased Text", "Forecast", each [ForecastAmount]+[ForecastExpAmount]),
					//     #"Multiplied Column" = Table.TransformColumns(#"Added Custom", {{"Forecast", each _ * 1000, type number}}),
					//     #"Filtered Rows" = Table.SelectRows(#"Multiplied Column", each ([Forecast] <> 0)),
					//     #"Merged Queries" = Table.NestedJoin(#"Filtered Rows", {"ExternalCode"}, Account, {"accountnumber"}, "Account", JoinKind.LeftOuter),
					//     #"Expanded Account" = Table.ExpandTableColumn(#"Merged Queries", "Account", {"go_pl_classificacaogoverno_display"}, {"Tipo Governo"}),
					//     #"Replaced Value" = Table.ReplaceValue(#"Expanded Account",null,"Setor Privado",Replacer.ReplaceValue,{"Tipo Governo"})
					// in
					//     #"Replaced Value"
					
					let
					    SQL = "SELECT
					            ForecastPeriod.Date,
					            Entity.ExternalCode,
					            Forecast.Amount As ForecastAmount,
					            Forecast.ExpectedAmount As ForecastExpAmount,
					            (Forecast.Amount + Forecast.ExpectedAmount) * 1000 As Forecast,
					            [User].ExternalCode As ExternalCodeExecutivo,
					            Company.ExternalCode As ExternalCodeCompany,
					            Entity1.ExternalCode As ExternalCodeAgency,
					            UPPER(ForecastMediaType.ExternalCode) As MediaType,
					            UPPER(ForecastSaleType.ExternalCode) As SaleType,
					            UPPER(Entity.ExternalCode + Entity1.ExternalCode) AS codIntegrador
					        FROM Forecast
					        JOIN ForecastPeriod
					            On Forecast.PeriodID = ForecastPeriod.ID
					        JOIN Entity
					            On Forecast.EntityClientID = Entity.ID
					        JOIN [User]
					            On Forecast.UserID = [User].ID
					        JOIN Company
					            On Forecast.CompanyID = Company.ID
					        JOIN Entity Entity1
					            On Forecast.EntityAgencyID = Entity1.ID
					        JOIN ForecastMediaType
					            On Forecast.MediaTypeID = ForecastMediaType.ID
					        JOIN ForecastSaleType
					            On Forecast.SaleTypeID = ForecastSaleType.ID
					        WHERE
					            ABS(Forecast.Amount + Forecast.ExpectedAmount) > 0",
					    Source = Sql.Database(Org, BD, [Query = SQL]),
					    #"Merged Account" =  let
					        Juntar = Table.NestedJoin(Source, {"ExternalCode"}, Account, {"accountnumber"}, "Account", JoinKind.LeftOuter),
					        Expandir = Table.ExpandTableColumn(Juntar, "Account", {"go_pl_classificacaogoverno_display"}, {"Tipo Governo"})
					        in Table.ReplaceValue(Expandir, null, "Setor Privado",Replacer.ReplaceValue,{"Tipo Governo"})
					in
					    #"Merged Account"

		annotation PBI_ResultType = Table

		annotation PBI_NavigationStepName = Navigation

