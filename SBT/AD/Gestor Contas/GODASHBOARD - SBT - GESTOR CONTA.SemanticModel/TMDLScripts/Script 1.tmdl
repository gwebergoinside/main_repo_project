		measure 'Val Carteira YTD Atual Month' =
				
				IF.EAGER (
				    ISFILTERED ( 'Calendario'[Mes] ),
				    [Val Liquido Carteira Final Atual DePara],
				    CALCULATE (
				        [Val Liquido Carteira Final Atual DePara],
				        FILTER (
				            ALL ( 'Calendario'[Date] ),
				            MONTH ( 'Calendario'[Date] ) <= MONTH ( NOW () )
				                && YEAR ( 'Calendario'[Date] ) = YEAR ( MAX ( 'Calendario'[Date] ) )
				        )
				    )
				)
