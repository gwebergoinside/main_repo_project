		measure '% Ganho Liquido' =
				
				VAR __1nivel =
				    DIVIDE ( CALCULATE ( [SumEarned Liquido] ), [Val Liquido YTD Atual Month] )
				VAR __2nivel =
				    DIVIDE (
				        CALCULATE ( [SumEarned Liquido] ),
				        CALCULATE ( [SumEarned Liquido], ALLSELECTED ( GrupoCliente[Grupo_Cliente] ) )
				    )
				RETURN
				    IF.EAGER ( __2nivel = 1, __1nivel, __2nivel )
			displayFolder: Val Bruto e Liquido
			lineageTag: 48f544af-09e8-49b2-a275-9f78b7aab015

