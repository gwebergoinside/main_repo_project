		partition TipoComercial-38a4717e-ce91-466e-bc5d-ca6c544fb7e8 = m
			mode: import
			queryGroup: CORE
			source =
					// let
					//     Source = Sql.Database(Org, BDExternal, [Query="SELECT#(lf)TC.Cod_Tipo_Comercial#(lf),TC.Descricao#(lf)FROM#(lf)SCTV.Tipo_Comercial TC"]),
					//     #"Trimmed Text" = Table.TransformColumns(Source,{{"Descricao", Text.Trim, type text}}),
					//     #"Inserted Merged Column" = Table.AddColumn(#"Trimmed Text", "Merged", each Text.Combine({[Cod_Tipo_Comercial], " (", [Descricao], ")"}), type text),
					//     #"Renamed Columns" = Table.RenameColumns(#"Inserted Merged Column",{{"Merged", "Tipo Comercial"}})
					// in
					//     #"Renamed Columns"
					
					let
					    SQL = "SELECT
					              LTRIM( RTRIM( TC.Cod_Tipo_Comercial )) AS Cod_Tipo_Comercial
					            , LTRIM( RTRIM( TC.Descricao )) AS Descricao
					            , LTRIM( RTRIM( TC.Cod_Tipo_Comercial )) + ' (' + LTRIM( RTRIM( TC.Descricao )) + ')' AS [Tipo Comercial]
					        FROM SCTV.Tipo_Comercial TC",
					    Source = Sql.Database(Org, BDExternal, [Query = SQL])
					in
					    Source

		annotation PBI_ResultType = Exception

		annotation PBI_NavigationStepName = Navegação

