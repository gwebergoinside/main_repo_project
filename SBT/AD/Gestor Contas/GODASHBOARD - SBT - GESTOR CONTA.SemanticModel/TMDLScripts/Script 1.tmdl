		measure 'Value by day of Month' =
				
				SUMX (
				    SUMMARIZE (
				        FILTER (
				            CROSSJOIN ( 'Neg', 'Calendario_OPT' ),
				            'Calendario_OPT'[Date] >= 'Neg'[go_dt_competenciainicial]
				                && 'Calendario_OPT'[Date] <= 'Neg'[estimatedclosedate]
				        ),
				        'Neg'[go_st_codnegociacao],
				        'Calendario_OPT'[Date],
				        Neg[go_mn_valornegociado],
				        Neg[go_dt_competenciainicial],
				        Neg[estimatedclosedate]
				    ),
				    DIVIDE (
				        Neg[go_mn_valornegociado],
				        DATEDIFF ( Neg[go_dt_competenciainicial], Neg[estimatedclosedate], DAY ) + 1
				    )
				)
			lineageTag: 129fc04e-9584-41d7-9b7d-93cfb1b4d5cc

			annotation PBI_FormatHint = {"isGeneralNumber":true}

