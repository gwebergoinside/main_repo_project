		measure 'QTD Oportunidades %' =
				
				VAR _val =
				    DIVIDE (
				        [QTD Oportunidades] - [QTD Oportunidades Previous],
				        [QTD Oportunidades Previous],
				        1
				    )
				RETURN
				    IF (
				        _val = 0,
				        UNICHAR ( 128993 ) & " " & FORMAT ( _val, "# %" ),
				        IF (
				            _val > 0,
				            UNICHAR ( 128994 ) & " " & FORMAT ( _val, "# %" ),
				            UNICHAR ( 128992 ) & " " & FORMAT ( _val, "# %" )
				        )
				    )
			displayFolder: Oportunidades
			lineageTag: 7099751d-8bfa-40b7-af03-05deda4ebe18

		measure 'QTD Oportunidades Previous' =
				
				VAR DateCount =
				    COUNTROWS ( Calendario )
				VAR PeriodType =
				    SWITCH (
				        TRUE (),
				        // Complete year selected
				        AND (
				            HASONEVALUE ( 'Calendario'[Ano] ),
				            DateCount = COUNTROWS ( PARALLELPERIOD ( 'Calendario'[Date], 0, YEAR ) )
				        ), "year",
				        // Complete month selected
				        AND (
				            HASONEVALUE ( 'Calendario'[Mes No] ),
				            DateCount = COUNTROWS ( PARALLELPERIOD ( 'Calendario'[Date], 0, MONTH ) )
				        ), "month",
				        //
				        "day"
				    )
				RETURN
				    SWITCH (
				        PeriodType,
				        "year", CALCULATE ( [QTD Oportunidades], PREVIOUSYEAR ( 'Calendario'[Date] ) ),
				        "month", CALCULATE ( [QTD Oportunidades], PREVIOUSMONTH ( 'Calendario'[Date] ) ),
				        "day",
				            CALCULATE (
				                [QTD Oportunidades],
				                DATESBETWEEN (
				                    Calendario[Date],
				                    [Start of the Previous Period],
				                    [End of the Previous Period]
				                )
				            )
				    )
			formatString: 0
			displayFolder: Oportunidades
			lineageTag: 9071daff-bf40-4beb-8733-4b9bee568406

		measure 'Start of the Previous Period' =
				
				[End of the Previous Period] - [Days in this Period]
			displayFolder: Oportunidades
			lineageTag: 652b1f14-ab6b-4a71-9a00-17ef839f2bea

