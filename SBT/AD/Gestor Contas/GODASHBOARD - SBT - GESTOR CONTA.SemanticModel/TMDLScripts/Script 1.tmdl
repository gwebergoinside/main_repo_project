	expression VendaImportada =
			let
			    Source = Sql.Database(Org, BD, [Query="Select#(lf)    R2.Cod_Empresa,#(lf)    --R2.Cod_Agencia,#(lf)    --R2.Cod_Cliente,#(lf)    R2.Competencia,#(lf)    R2.Cod_Contato,#(lf)    --R2.Cod_Empresa_Faturamento,#(lf)    R2.Numero_Negociacao#(lf)From#(lf)    "&BDExternal&".SCTV.R0002 R2#(lf)Where#(lf)    R2.Competencia >= 201601 And#(lf)    R2.Cod_Nucleo Not In ('n10', 'novon', 'vale') And#(lf)    R2.Indica_Mes_Anterior = 0 And#(lf)    R2.Cod_Empresa_Faturamento <> '054' And#(lf)    Exists(Select#(lf)         0#(lf)     From#(lf)         Company E#(lf)     Where#(lf)         E.ExternalCode = R2.Cod_Empresa_Faturamento And#(lf)         E.Affiliation = 'FILIADO') And#(lf)    Exists(Select#(lf)         0#(lf)     From#(lf)         Company E#(lf)     Where#(lf)         E.ExternalCode = R2.Cod_Empresa And#(lf)         E.Affiliation <> 'FILIADO')#(lf)Group By#(lf)    R2.Cod_Empresa,#(lf)    R2.Competencia,#(lf)    R2.Cod_Contato,#(lf)    R2.Numero_Negociacao"]),
			    #"Added Custom" = Table.AddColumn(Source, "Cod_Contato_Importada", each "VEIMPR")
			in
			    #"Added Custom"
		lineageTag: f251825f-ea21-4f98-a3d8-d7206e2f753c
		queryGroup: CORE

