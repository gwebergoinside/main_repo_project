	expression GetCDST_EntityTable =
			let
			    Source = (#"schema name" as text) =>
			        let
			            Source = #"#CDSTEntitySource",
			            Entities = Source{[Group="entities"]}[Data],
			            DataTable = Entities{[SchemaName=#"schema name"]}[Data]
			        in
			            DataTable
			in
			    Source
