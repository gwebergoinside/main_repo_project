	table @Medidas
		lineageTag: f208a06d-6edf-426b-b2be-c7b5f9a95eb7

		measure 'Val Exibido' =
				
				--CALCULATE( SUM( Contrato[Vlr_Exibido] ), FILTER( R0002, NOT ISBLANK(R0002[Competencia]) ) )
				CALCULATE (
				    SUM ( R0002[Vlr_Exibido] )
				)
			formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
			displayFolder: Val Exibido
			lineageTag: 93345e5a-3d27-4461-b22f-31254b4350af

			annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

		measure 'Val Exibido LY' =
				
				CALCULATE ( [Val Exibido], SAMEPERIODLASTYEAR ( Calendario[Date] ) )
			formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
			displayFolder: Val Exibido
			lineageTag: 799a3a97-5f05-4730-aebd-f66d8f383da0

			annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

		measure 'Val Exibido LY YTD Atual Month' =
				
				IF.EAGER (
				    ISFILTERED ( Calendario[Mes] ),
				    CALCULATE ( [Val Exibido LY Final], DATESYTD ( Calendario[Date] ) ),
				    CALCULATE (
				        [Val Exibido LY Final],
				        FILTER (
				            ALL ( Calendario[Date] ),
				            MONTH ( Calendario[Date] ) <= MONTH ( NOW () )
				                && YEAR ( Calendario[Date] ) = YEAR ( MAX ( Calendario[Date] ) )
				        )
				    )
				)
			formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
			displayFolder: Val Exibido
			lineageTag: f4da8e64-d917-402f-a435-f344f237be1f

			annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

		measure 'Val Exibido YTD Atual Month' =
				
				IF.EAGER (
				    ISFILTERED ( Calendario[Mes] ),
				    CALCULATE ( [Val Exibido Final], DATESYTD ( Calendario[Date] ) ),
				    CALCULATE (
				        [Val Exibido Final],
				        FILTER (
				            ALL ( Calendario[Date] ),
				            MONTH ( Calendario[Date] ) <= MONTH ( NOW () )
				                && YEAR ( Calendario[Date] ) = YEAR ( MAX ( Calendario[Date] ) )
				        )
				    )
				)
			formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
			displayFolder: Val Exibido
			lineageTag: 227ac482-3ca3-4f4f-bca0-0a4dee2167f3

			annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

		measure 'Val Exibido YTD' =
				
				CALCULATE ( TOTALYTD ( [Val Exibido Final], Calendario[Date] ) )
			formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
			displayFolder: Val Exibido
			lineageTag: 5ed89b91-8e58-45d6-9a44-7f7c2bab8322

			annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

		measure Valor =
				
				SWITCH (
				    [Selected SalesParameter],
				    1, [Val Exibido Final],
				    2, [Val Liquido Final],
				    BLANK ()
				)
			formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
			displayFolder: Val Bruto e Liquido
			lineageTag: 250f2fae-0909-4ac5-b466-128c18eafac2

			annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

		measure 'Val Liquido' =
				
				CALCULATE (
				    SUM ( R0002[Vlr_Gerencial_BAV] ) + SUM ( R0002[Vlr_Repasse_Varejo] )
				)
			displayFolder: Val Bruto e Liquido
			lineageTag: 6a032fdd-ee3d-4d9c-a200-3b5965eea0bc

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 'Val Liquido LY' =
				
				CALCULATE ( [Val Liquido], SAMEPERIODLASTYEAR ( Calendario[Date] ) )
			displayFolder: Val Bruto e Liquido
			lineageTag: 7ac37ff5-9ae5-45d0-a331-79d49165ab60

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 'Valor LY' =
				
				SWITCH (
				    [Selected SalesParameter],
				    1, [Val Exibido LY Final],
				    2, [Val Liquido LY Final],
				    BLANK ()
				)
			formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
			displayFolder: Val Bruto e Liquido
			lineageTag: 55c786d6-e478-410e-ac7f-10705d3f20d3

			annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

		measure 'Valor YTD' =
				
				SWITCH (
				    [Selected SalesParameter],
				    1, [Val Exibido YTD],
				    2, [Val Liquido YTD],
				    BLANK ()
				)
			formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
			displayFolder: Val Bruto e Liquido
			lineageTag: 73b2de79-0985-471a-b4ce-b7a619fd35d0

			annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

		measure 'Val Liquido LY YTD Atual Month' =
				
				IF.EAGER (
				    ISFILTERED ( Calendario[Mes] ),
				    CALCULATE ( [Val Liquido LY Final], DATESYTD ( Calendario[Date] ) ),
				    CALCULATE (
				        [Val Liquido LY Final],
				        FILTER (
				            ALL ( Calendario[Date] ),
				            MONTH ( Calendario[Date] ) <= MONTH ( NOW () )
				                && YEAR ( Calendario[Date] ) = YEAR ( MAX ( Calendario[Date] ) )
				        )
				    )
				)
			displayFolder: Val Bruto e Liquido
			lineageTag: 0a7774c6-3e4b-441b-b7e4-81ff03b717ac

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 'Val Liquido YTD Atual Month' =
				
				IF.EAGER (
				    ISFILTERED ( Calendario[Mes] ),
				    CALCULATE ( [Val Liquido Final], DATESYTD ( Calendario[Date] ) ),
				    CALCULATE (
				        [Val Liquido Final],
				        FILTER (
				            ALL ( Calendario[Date] ),
				            MONTH ( Calendario[Date] ) <= MONTH ( NOW () )
				                && YEAR ( Calendario[Date] ) = YEAR ( MAX ( Calendario[Date] ) )
				        )
				    )
				)
			displayFolder: Val Bruto e Liquido
			lineageTag: 66b7ded9-8431-4c68-8703-0638fa7817f0

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 'SumLost Liquido' =
				
				CALCULATE (
				    [Val Liquido LY YTD Atual Month],
				    FILTER (
				        GrupoCliente,
				        [Val Liquido LY YTD Atual Month] > 0
				            && (
				                ISBLANK ( [Val Liquido YTD Atual Month] ) || [Val Liquido YTD Atual Month] = 0
				            )
				    )
				)
			displayFolder: Val Bruto e Liquido
