		measure 'Titulo_Ganhos Perdidos' =
				
				VAR _1 =
				    CONCATENATEX (
				        SUMMARIZE ( 'Calendario', 'Calendario'[Mes] ),
				        'Calendario'[Mes],
				        ", "
				    )
				VAR _12 =
				    MIN ( 'Calendario'[Mes No] )
				VAR _11 =
				    MAX ( 'Calendario'[Mes No] )
				RETURN
				    IF.EAGER (
				        ISFILTERED ( 'Calendario'[Mes] ),
				        "CLASSIFICAÇÃO POR ANUNCIANTE (" & _1 & ")",
				        CALCULATE ( [Titulo], Titulos[ID] = 10 ) & " ("
				            & SWITCH (
				                _12,
				                1, "Jan",
				                2, "Fev",
				                3, "Mar",
				                4, "Abr",
				                5, "Mai",
				                6, "Jun",
				                7, "Jul",
				                8, "Ago",
				                9, "Set",
				                10, "Out",
				                11, "Nov",
				                12, "Dez"
				            ) & " - "
				            & SWITCH (
				                _11,
				                1, "Jan",
				                2, "Fev",
				                3, "Mar",
				                4, "Abr",
				                5, "Mai",
				                6, "Jun",
				                7, "Jul",
				                8, "Ago",
				                9, "Set",
				                10, "Out",
				                11, "Nov",
				                12, "Dez"
				            ) & ")"
				    )
			displayFolder: Ganho e Perdido Anunciante
			lineageTag: 80a53947-e0b1-485f-9da9-be205b1161a3

