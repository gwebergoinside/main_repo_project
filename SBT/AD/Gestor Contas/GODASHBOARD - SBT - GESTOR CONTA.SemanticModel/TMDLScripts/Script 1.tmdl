		column ValorLiquido =
				
				// LOOKUPVALUE(
				//     R0002[Vlr_Gerencial_BAV]
				//     ,R0002[ChaveForecast]
				//     ,Forecast_OPT[Chave]
				// )
				VAR _1 =
				CALCULATE(
				    SUM( R0002[Vlr_Gerencial_BAV] )
				    ,FILTER(
				        ALL(R0002)
				        , Neg[Numero_Negociacao] = R0002[Numero_Negociacao]
				    )
				)
				VAR _2 =
				CALCULATE(
				    SUM( R0002[Vlr_Repasse_Varejo] )
				    ,FILTER(
				        ALL(R0002)
				        , Neg[Numero_Negociacao] = R0002[Numero_Negociacao]
				    )
				)
				RETURN
				IF( Neg[Numero_Negociacao] = BLANK(), BLANK(),
				_1+_2 )
			lineageTag: bcdd4720-7e58-410e-8196-8b9f00f805f6
			summarizeBy: sum

			annotation SummarizationSetBy = Automatic

