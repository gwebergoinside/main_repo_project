		measure valor_tipoCliente_graphs =
				
				VAR _1 =
				    SUMMARIZE ( GrupoCliente, GrupoCliente[Grupo_Cliente] )
				RETURN
				    IF (
				        [Selected Type] = 1,
				        SUMX ( _1, [Clientes Recorrentes_] ),
				        IF (
				            [Selected Type] = 2,
				            SUMX ( _1, [Clientes Novos] ),
				            IF (
				                [Selected Type] = 3,
				                SUMX ( _1, [Clientes Perdidos] * -1 ),
				                IF (
				                    [Selected Type] = 4,
				                    SUMX ( _1, [Clientes Queda] * -1 ),
				                    --Format( métrica, "$#,##0;($#,##0)" )
				                    IF (
				                        [Selected Type] = 5,
				                        SUMX ( _1, [Clientes Crescimento] )
				                    )
				                )
				            )
				        )
				    )
