		column Valor_BAV =
				
				// LOOKUPVALUE(
				//     R0002[Vlr_Gerencial_BAV]
				//     ,R0002[ChaveForecast]
				//     ,Forecast_OPT[Chave]
				// )
				
				CALCULATE(
				    SUM( R0002[Vlr_Gerencial_BAV] )
