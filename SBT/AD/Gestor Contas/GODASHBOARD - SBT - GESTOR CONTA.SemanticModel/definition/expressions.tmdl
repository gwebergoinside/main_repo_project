/// Acrescenta a coluna "Tipo Governo" a partir da Account; sem correspondência = Setor Privado.
expression Fn_TipoGoverno =
		// Substitui o bloco que estava repetido em R0002, LY, Forecast, ForecastSnapshot e Metas.
		let
		    Fn = (tabela as table, colunaCliente as text) as table =>
		        let
		            Juntar = Table.NestedJoin(tabela, {colunaCliente}, Account, {"accountnumber"}, "Account", JoinKind.LeftOuter),
		            Expandir = Table.ExpandTableColumn(Juntar, "Account", {"go_pl_classificacaogoverno_display"}, {"Tipo Governo"}),
		            Preencher = Table.ReplaceValue(Expandir, null, "Setor Privado", Replacer.ReplaceValue, {"Tipo Governo"})
		        in
		            Preencher
		in
		    Fn
	lineageTag: 5b9e2c30-7f41-42a8-b6d3-0c58e9a1f772
	queryGroup: Config

	annotation PBI_ResultType = Function

