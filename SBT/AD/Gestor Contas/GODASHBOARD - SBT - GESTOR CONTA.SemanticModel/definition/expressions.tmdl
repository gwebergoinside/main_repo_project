expression OPTSDatas =
		// Unifica OPTSCreated, OPTSModified e OPTSIntegrated: uma única leitura de go_opportunity
		// e um único agrupamento por negociação, em vez de três.
		let
		    Opportunities = #"GetCDST_EntityTable"("go_opportunity"),
		    #"Colunas Selecionadas" = Table.SelectColumns(Opportunities,{"go_st_codnegociacao", "createdon", "modifiedon", "go_dt_dataintegracao"}),
		    #"Tipo Data Integração" = Table.TransformColumnTypes(#"Colunas Selecionadas",{{"go_dt_dataintegracao", type date}}),
		    #"Agrupado por Negociação" = Table.Group(#"Tipo Data Integração", {"go_st_codnegociacao"}, {
		        {"First_Createdon", each List.Min([createdon]), type nullable datetimezone},
		        {"Data Aprovação", each List.Min([modifiedon]), type nullable datetimezone},
		        {"Data de Integração_Final", each List.Min(List.RemoveNulls([go_dt_dataintegracao])), type nullable date}
		    })
		in
		    #"Agrupado por Negociação"
	lineageTag: 1daf280a-efcc-4a46-94ce-52f15e6f9629
	queryGroup: Dynamics

	annotation PBI_ResultType = Table

