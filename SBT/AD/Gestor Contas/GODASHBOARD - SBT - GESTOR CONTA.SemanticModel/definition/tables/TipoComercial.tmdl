	partition TipoComercial-38a4717e-ce91-466e-bc5d-ca6c544fb7e8 = m
		mode: import
		queryGroup: CORE
		source =
				let
				    SQL = "SELECT
				              LTRIM( RTRIM( TC.Cod_Tipo_Comercial )) AS Cod_Tipo_Comercial
				            , LTRIM( RTRIM( TC.Descricao )) AS Descricao
				            , LTRIM( RTRIM( TC.Cod_Tipo_Comercial )) + ' (' + LTRIM( RTRIM( TC.Descricao )) + ')' AS [Tipo Comercial]
				        FROM SCTV.Tipo_Comercial TC",
				    Source = Sql.Database(Org, BDExternal, [Query = SQL])
				in
				    Source

	annotation PBI_ResultType = Exception

