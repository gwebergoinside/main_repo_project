	partition UsersNacionais = m
		mode: import
		queryGroup: RLS
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [go_st_codigoexterno = _t, systemuserid = _t, parentsystemuserid = _t, fullname = _t, domainname = _t]),
				    Mesclar = let
				        FiltrarGestores = Table.SelectRows(Fonte, each [parentsystemuserid] is null or [parentsystemuserid] = ""),
				        FiltrarExecutivos = Table.SelectRows(Fonte, each not ([parentsystemuserid] is null or [parentsystemuserid] = "")),
				        MesclarTabelas = Table.NestedJoin(FiltrarExecutivos, {"parentsystemuserid"}, FiltrarGestores, {"systemuserid"}, "nameGestores", JoinKind.LeftOuter)
