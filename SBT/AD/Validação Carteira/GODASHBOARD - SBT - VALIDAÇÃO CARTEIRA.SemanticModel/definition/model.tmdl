model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-PT
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Config

	annotation PBI_QueryGroupOrder = 0

queryGroup Carteira

	annotation PBI_QueryGroupOrder = 3

queryGroup CORE

	annotation PBI_QueryGroupOrder = 3

annotation PBI_QueryOrder = ["Carteira","PosicaoCarteira","R0002","Org","BD","BDExternal","@CRMOrgUrl","Link","YearUpdateVeiculacao","GrupoCliente","GrupoAgencia","@Medidas","Valor","VendaImportada","TipoMidia","TipoVenda","LY","Titulos","Emp_Venda","Executivos","NextID","YearDateUpdate"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["CalcGroup","DevMode"]

ref table R0002
ref table GrupoCliente
ref table GrupoAgencia
ref table @Medidas
ref table Calendario
ref table Carteira
ref table PosicaoCarteira
ref table Valor
ref table TipoMidia
ref table TipoVenda
ref table LY
ref table Titulos
ref table Emp_Venda
ref table Executivos
ref table Emp_Faturamento
ref table ValoresFinal
ref table NextID
ref table 'Verificar Diferenças'

ref role RLS

ref cultureInfo en-US

