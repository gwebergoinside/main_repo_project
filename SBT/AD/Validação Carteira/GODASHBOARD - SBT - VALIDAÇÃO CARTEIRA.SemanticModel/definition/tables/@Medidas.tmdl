	measure Dif =
			
			VAR _1 =
			SWITCH(
			    TRUE()
			    ,ISINSCOPE( Executivos[Executivo] ), BLANK()
			    ,ISINSCOPE( ValoresFinal[Negociacao] ), BLANK()
			    ,ISINSCOPE( Emp_Venda[ExternalCode] ), BLANK()
			    ,ISINSCOPE( Executivos[ExecutivoCodigo] ), BLANK()
			    ,ISINSCOPE( GrupoAgencia[AgenciaCodigo] ), BLANK()
			    ,ISINSCOPE( GrupoCliente[ClienteCodigo] ), [ValorDiferenca]
			    ,BLANK()
			)
			RETURN
			var _a=CALCULATE([ValorDiferenca],ALLEXCEPT(ValoresFinal,ValoresFinal[Cod_Cliente], ValoresFinal[Ano], ValoresFinal[Mes] ))
			var _b=[ValorDiferenca]
			return IF( NOT ISBLANK( _a ) ,_b, BLANK() )
		lineageTag: 0b887773-3c24-49ea-bb42-84cd00a2210f

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Dif1 = ```
			
			var _a=CALCULATE([ValorDiferenca],ALLEXCEPT(Calendario,Calendario[Date]))
			var _b=[ValorDiferenca]
			return 
