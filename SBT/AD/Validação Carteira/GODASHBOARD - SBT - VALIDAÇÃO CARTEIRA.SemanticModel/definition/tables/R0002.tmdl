	partition R0002-5b2f1cdd-8bce-4385-9d08-626abdf75db3 = m
		mode: import
		queryGroup: CORE
		source = ```
				let
				    SQL = "Select
				            R.Cod_Empresa,
				            R.Cod_Tipo_Comercial,
				            R.Numero_Mr,
				            R.Sequencia_Mr,
				            R.Cod_Empresa_Faturamento As [CodEmp Faturamento],
				            R.Cod_Agencia,
				            R.Cod_Cliente,
				            R.Cod_Contato,
				            R.Cod_Nucleo,
				            R.Competencia,
				            Cast(Convert(VARCHAR,Left(R.Competencia, 4)) + '-' + Convert(VARCHAR,Right(R.Competencia, 2)) + '-' +
				            Convert(VARCHAR,1) As DATETIME) As Data,
				            R.Numero_Negociacao,
				            Sum(R.Vlr_Gerencial_BAV) As Vlr_Gerencial_BAV,
				            R.SaleTypeExternalCode,
				            R.MediaTypeExternalCode,
				            Sum(R.Vlr_Repasse_Varejo) As Vlr_Repasse_Varejo,
				            Sum(R.Vlr_Bruto) As Vlr_Exibido,
				            ch.ExternalCode + ' - ' + ch.Name As ChannelDisplay,
				            cp.Affiliation,
				            R.MotivoAjusteManual
				        From
				            GONEXTADExternal.SCTV.R0002_Detalhe R With(NoLock) 
				    --	Left Join GONEXTADExternal.SCTV.Contrato c With(NoLock) On c.Cod_Empresa = R.Cod_Empresa
				    --            And c.Numero_Mr = R.Numero_Mr
				    --            And c.Sequencia_Mr = R.Sequencia_Mr 
				        Left Join Company cp With(NoLock) On cp.ExternalCode = R.Cod_Empresa
				        Left Join Company cpfat With(NoLock) On cpfat.ExternalCode = R.Cod_Empresa_Faturamento
				        Left Join Channel ch With(NoLock) On ch.ExternalCode = R.Cod_Veiculo
				        Where
				            Left(R.Competencia,4) >= year(getdate()) - " & YearDateUpdate & "
				            And Not (cp.Affiliation = 'AFILIADO' And cpfat.Affiliation = 'AFILIADO')
				        Group By
				            R.Cod_Empresa,
				            R.Cod_Tipo_Comercial,
				            R.Numero_Mr,
				            R.Sequencia_Mr,
				            R.Cod_Empresa_Faturamento,
				            R.Cod_Agencia,
				            R.Cod_Cliente,
				            R.Cod_Contato,
				            R.Cod_Nucleo,
				            R.Competencia,
				            Cast(Convert(VARCHAR,Left(R.Competencia, 4)) + '-' + Convert(VARCHAR,Right(R.Competencia, 2)) + '-' +
				            Convert(VARCHAR,1) As DATETIME),
				            R.Numero_Negociacao,
				            R.SaleTypeExternalCode,
				            R.MediaTypeExternalCode,
				            ch.ExternalCode + ' - ' + ch.Name,
				            cp.Affiliation,
				            R.MotivoAjusteManual",
				    Source = Sql.Database(Org, BD, [Query = SQL]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Numero_Mr", type text}, {"Sequencia_Mr", type text}}),
				    #"Trimmed Text" = Table.TransformColumns(#"Changed Type",{{"Cod_Agencia", Text.Trim, type text}, {"Cod_Cliente", Text.Trim, type text}, {"Cod_Contato", Text.Trim, type text}, {"MediaTypeExternalCode", Text.Trim, type text}, {"SaleTypeExternalCode", Text.Trim, type text}}),
				    #"Uppercased Text" = Table.TransformColumns(#"Trimmed Text",{{"Cod_Agencia", Text.Upper, type text}, {"Cod_Cliente", Text.Upper, type text}, {"Cod_Contato", Text.Upper, type text}, {"Cod_Nucleo", Text.Upper, type text}}),
				    #"Merged Queries3" = Table.NestedJoin(#"Uppercased Text", {"Cod_Empresa", "Competencia", "Numero_Negociacao"}, VendaImportada, {"Cod_Empresa", "Competencia", "Numero_Negociacao"}, "VendaImportada", JoinKind.LeftOuter),
				    #"Expanded VendaImportada" = Table.ExpandTableColumn(#"Merged Queries3", "VendaImportada", {"Cod_Contato_Importada"}, {"Cod_Contato.1"}),
				    #"Added Custom" = Table.AddColumn(#"Expanded VendaImportada", "Cod_ContatoFinal", each if [MotivoAjusteManual] = null then [Cod_Contato.1] else [Cod_Contato]),
				    Custom6 = Table.AddColumn(#"Added Custom" , "Cod_Contato.2", each if [Cod_ContatoFinal] <> null then [Cod_ContatoFinal] else [Cod_Contato]),
				    #"Removed Columns" = Table.RemoveColumns(Custom6,{"Cod_Contato", "Cod_Contato.1", "Cod_ContatoFinal", "Numero_Mr"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{"Cod_Contato.2", "Cod_Contato"}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Renamed Columns",{"Cod_Contato", "Cod_Executivo"})
				in
				    #"Renamed Columns1"
				```

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

