	column 'Venda Importada' =
			
			SWITCH( TRUE(),
			    LEFT(R0002[CodEmp Faturamento],3) = "054" && R0002[Affiliation] = "AFILIADO", "VENDA IMPORTADA NACIONAL",
			    R0002[Cod_Executivo] = "VEIMPR", "VENDA IMPORTADA REGIONAL"
			)
		isHidden
		lineageTag: 08610258-833a-4694-a266-e9b59e0bba3e
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

