	partition ValoresFinal-6ae0aa66-207b-4a32-bbc0-83bc98756551 = calculated
		mode: import
		source = ```
				
				VAR _1 = 
				    SELECTCOLUMNS(
				        LY
				        ,"Cod_Cliente",LY[Cod_Cliente]
				        ,"Cod_Agencia",LY[Cod_Agencia]
				        ,"Cod_Executivo",LY[Cod_Executivo]
				        ,"Cod_Emp",LY[Cod_Emp]
				        ,"Valor", LY[Amount]
				        ,"Data", LY[Data]
				        ,"Ano", YEAR( LY[Data] )
				        ,"Mes", MONTH( LY[Data] )
				        ,"Tipo", "Carteira"
				        ,"Negociacao", BLANK()
				    )
				VAR _2 = 
				    SELECTCOLUMNS(
				        R0002
				        ,"Cod_Cliente",R0002[Cod_Cliente]
				        ,"Cod_Agencia",R0002[Cod_Agencia]
				        ,"Cod_Executivo",R0002[Cod_Executivo]
				        ,"Cod_Emp",R0002[Cod_Empresa]
				        ,"Valor", R0002[Vlr_Gerencial_BAV]+R0002[Vlr_Repasse_Varejo]
				        ,"Data", R0002[Data]
				        ,"Ano", YEAR( R0002[Data] )
				        ,"Mes", MONTH( R0002[Data] )
				        ,"Tipo", "SCTV"
				        ,"Negociacao", R0002[Numero_Negociacao]
				    )
				RETURN
				UNION(_1,_2)
				```

	annotation PBI_Id = 90ec8e58ed4447fc98cfc55b1bd2ce98

