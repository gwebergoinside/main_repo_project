			defaultHierarchy: LocalDateTable_40e49aed-7a2a-4133-acba-279ead422257.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column Mes = SWITCH(MONTH(Calendario[Date]),1,"Jan",2,"Fev",3,"Mar",4,"Abr",5,"Mai",6,"Jun",7,"Jul",8,"Ago",9,"Set",10,"Out",11,"Nov",12,"Dez")
		lineageTag: 6269b710-28c7-47be-a5a7-17c9c6eb43e8
		summarizeBy: none
		sortByColumn: Mês

