table Calendario
	lineageTag: 83ed920b-0ca0-4831-bd71-d5727931210e

	measure 'Filter Next Months' =
			
			VAR currentSelectedMonth =
			    MONTH( NOW() )
			VAR currentSelectedYear =
			    YEAR( NOW() )
			VAR NextMonthSelected =
			    IF ( currentSelectedMonth = 12, 1, currentSelectedMonth )
			VAR nextYearSelected =
			    IF ( currentSelectedMonth = 12, currentSelectedYear , currentSelectedYear )
			RETURN
			    IF (
			        YEAR ( MAX ( Calendario[Date] ) ) = nextYearSelected
			            && MONTH ( MAX ( Calendario[Date] ) ) >= NextMonthSelected,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 4f74e75f-f237-4cdc-8e06-ff9e13c1ba3f

	column Date
		formatString: General Date
		lineageTag: 166ffa98-e5ec-429a-9b22-1251cf9681da
