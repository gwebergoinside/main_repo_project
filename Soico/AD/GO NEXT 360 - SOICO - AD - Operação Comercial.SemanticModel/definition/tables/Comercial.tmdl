	column LogAcao =
			SWITCH( TRUE(),
			// Comercial[encLogAccao] = "A" , "Alteração",
			// Comercial[encLogAccao] = "RR" , "Encomenda Recuperada",
			// Comercial[encLogAccao] = "X" , "Excepção",
			// Comercial[encLogAccao] = "I" , "Inserção",
			// Comercial[encLogAccao] = "EE" , "Passar a exibidas",
			// Comercial[encLogAccao] = "R" , "Remover encomenda",
			// Comercial[encLogAccao] = "RX" , "Remover excepção",
			// Comercial[encLogAccao] = "RE" , "Remover exibida",
			// Comercial[encLogAccao])
			Comercial[__minDateInsercao] = "A" , "Alteração",
			Comercial[__minDateInsercao] = "RR" , "Encomenda Recuperada",
			Comercial[__minDateInsercao] = "X" , "Excepção",
			Comercial[__minDateInsercao] = "I" , "Inserção",
			Comercial[__minDateInsercao] = "EE" , "Passar a exibidas",
			Comercial[__minDateInsercao] = "R" , "Remover encomenda",
			Comercial[__minDateInsercao] = "RX" , "Remover excepção",
			Comercial[__minDateInsercao] = "RE" , "Remover exibida",
			Comercial[encLogAccao])
		lineageTag: abf7530c-2d45-481b-b81b-c588c1392309
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

