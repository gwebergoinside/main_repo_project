	column __campsDate =
			
			Var __date = CALCULATE ( MIN ( 'OPLog'[Data] ), USERELATIONSHIP( Comercial[ordPubCodigo], OPLog[ordPubCodigo] ), ALLEXCEPT ( Comercial, Comercial[ordPubCodigo]) , 'OPLog'[Accao] = "I" )
			Return
			DATE(YEAR(__date),MONTH(__date),DAY(__date))
		formatString: dd/mm/yyyy
		lineageTag: c5de58a7-01fe-4f8a-9d85-29bd338b4c43
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

