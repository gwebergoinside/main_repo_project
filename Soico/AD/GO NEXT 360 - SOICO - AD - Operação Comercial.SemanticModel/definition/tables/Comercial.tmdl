table Comercial
	lineageTag: 5b0250a5-d743-4885-8106-f0dbf89709ff

	measure Inserções = ```
			
			CALCULATE( 
			    COUNT( Comercial[ordPubCodigo])
			    , Comercial[__minDateInsercao] = "I"
			) 
			--,Comercial[encLogAccao] = "I" )
			```
		formatString: #,0
		lineageTag: 753ef6a3-4798-4f2e-9db4-369f102fd421

	measure 'Falta Espaço' = CALCULATE( COUNT( Comercial[ordPubCodigo]), Comercial[encLogAccao] = "X", SEARCH("espaço",Comercial[encExcDescricaoErro],1,0) )
		formatString: #,0
		lineageTag: 1dff06eb-ec1f-4de6-8432-c7c33b0504d3

	measure Alterações = CALCULATE( COUNT( Comercial[ordPubCodigo]), Comercial[LogAcao] = "Alteração" )
		formatString: #,0
		lineageTag: 0324308b-4144-4a23-97e4-7d760629654d

	measure Remoções = CALCULATE( COUNT( Comercial[ordPubCodigo]), Comercial[LogAcao] = "Remover encomenda" )
		formatString: #,0
		lineageTag: 6fa02910-0a51-486c-a4b0-294d9424602c

	measure 'Remoções Falta Esp.' = CALCULATE( COUNT( Comercial[ordPubCodigo]), Comercial[RemocaoUtilizador] = 1 )
		formatString: #,0
		lineageTag: 2cdbb67b-1515-4ebd-ad8c-2ed6143db6f6

	measure 'OrdPub Atual' =
			
			CALCULATE( count( Comercial[ordPubCodigo] ) , YEAR(Comercial[encLogData]) =  YEAR(NOW()) )
		formatString: #,0
		lineageTag: fbe41768-2038-4a92-94fa-d78c4ac864c9

	measure 'OrdPub LY' =
			
			CALCULATE( count( Comercial[ordPubCodigo] ) , SAMEPERIODLASTYEAR(Calendario[Date]) )
		formatString: #,0
		lineageTag: cd69a2ce-ca14-451b-acd8-b03d442a7fe4

	measure Manual = CALCULATE( DISTINCTCOUNT( Comercial[ordPubCodigo] ) , ISBLANK(Comercial[Tipo]) , USERELATIONSHIP( Calendario[Date] , Comercial[DataOrdPub] ) )
		formatString: #,0
		lineageTag: fe8797e3-667f-4052-b57d-6dbfbc159656

	measure Contratos = CALCULATE( DISTINCTCOUNT( Comercial[ordPubCodigo] ) , Comercial[Tipo] = "C" , USERELATIONSHIP( Calendario[Date] , Comercial[DataOrdPub] ))
		formatString: #,0
		lineageTag: 1dcf5031-3f16-4e4b-a79f-eb51de7aac9b

	measure Eletrónica = CALCULATE( DISTINCTCOUNT( Comercial[ordPubCodigo] ) , Comercial[Tipo] <> "C" && NOT(ISBLANK(Comercial[Tipo])) , USERELATIONSHIP( Calendario[Date] , Comercial[DataOrdPub] ) )
		formatString: #,0
		lineageTag: 0c4db1ed-b0f0-4958-b7fc-972ea2145b00

	measure 'Novas Campanhas' =
			
			CALCULATE( DISTINCTCOUNT( Comercial[ordPubCodigo] ) , USERELATIONSHIP( Calendario[Date] , Comercial[__campsDate] ) )
		formatString: 0
		lineageTag: 66807767-c9b1-4cbc-a3db-180847e6bfbc

	measure 'Novas CampanhasGraph LY' =
			
			CALCULATE( DISTINCTCOUNT( Comercial[ordPubCodigo] ) , USERELATIONSHIP( Calendario[Date] , Comercial[__campsDate] ) , SAMEPERIODLASTYEAR(Calendario[Date]) )
			--CALCULATE( DISTINCTCOUNT( Comercial[ordPubCodigo] ) , USERELATIONSHIP( Calendario[Date] , Comercial[__campsDate] ), YEAR(Comercial[__campsDate]) =  YEAR(NOW())-1)
		formatString: 0
		lineageTag: 14229372-2e9e-49e3-ab7e-4aac5d19aa5e

	measure 'Avg Inserção Inicio' = ```
			
			CALCULATE(
			    DIVIDE([Inserções],
			        DISTINCTCOUNT(Comercial[ordPubCodigo])
			    ),
			            FILTER(Comercial, Comercial[encLogDataHora] = [__minDate] ) , 
			                    ALLEXCEPT(Comercial,Comercial[ordPubCodigo])
			        , 
			            Comercial[LogAcao] = "Inserção")
			```
		formatString: 0
		lineageTag: e35249a0-efff-4f93-8bf4-5bee1f165743

	measure 'Avg Alterações' =
			
			
			Var __count1 = sumx(summarize(Comercial, Comercial[encLogDataHora], "_dist", count(Comercial[ordPubCodigo])),[_dist])
			--Var __count2 =
			Return
			DIVIDE(__count1,DISTINCTCOUNT(Comercial[ordPubCodigo]))
		formatString: 0
		lineageTag: 1db2634e-6fbf-4f42-9da3-9ace80cdb6f6

	measure 'OPs Log' =
			
			--Var __sum = SUMX(SUMMARIZE(Comercial, Comercial[ordPubCodigo], "Count", MAX(Comercial[Count])),[Count])
			Var __sum = SUMX(SUMMARIZE(OPLog, OPLog[ordPubCodigo], OPLog[Accao], OPLog[ordPubData], "Count", CALCULATE(DISTINCTCOUNT(OPLog[ordPubCodigo]), OPLog[Accao] = "M" )),[Count])
			Return
			DIVIDE(__sum,CALCULATE( DISTINCTCOUNT(Comercial[ordPubCodigo]),USERELATIONSHIP(Comercial[ordPubCodigo],OPLog[ordPubCodigo])))
		formatString: #,0
		lineageTag: afd092af-233f-4164-bb7f-362d81c349fd

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Avg Inserção Após Inicio' = ```
			
			CALCULATE(
			    DIVIDE([Inserções],
			        DISTINCTCOUNT(Comercial[ordPubCodigo])
			    ),
			            FILTER(Comercial, Comercial[encLogDataHora] > [__minDate] ) , 
			                    ALLEXCEPT(Comercial,Comercial[ordPubCodigo])
			        , 
			            Comercial[LogAcao] = "Inserção")
			```
		formatString: #,0
		lineageTag: 6bc0dc5c-46a2-4e7d-aa54-2839ecd23441

		annotation PBI_FormatHint = {"isDecimal":true}

