		source =
				let
				    Source = Sql.Database(Server, BD, [Query="With#(lf)    web As (#(lf)     Select#(lf)         ordPubWeb.ordPubCodigo,#(lf)         ordPubWeb.flgOrigem As Tipo#(lf)     From#(lf)         ordPubWeb#(lf)     Where#(lf)         ordPubWeb.ordPubCodigo Is Not Null And#(lf)         ordPubWeb.estado <> 'R'#(lf)     Group By#(lf)         ordPubWeb.ordPubCodigo,#(lf)         ordPubWeb.flgOrigem#(lf)     Union All#(lf)     Select#(lf)         OrdemPublicidadeElectronica.OrdemPublicidadeGMediaAdId As ordPubCodigo,#(lf)         OrdemPublicidadeElectronica.TipoMarcacao As Tipo#(lf)     From#(lf)         OrdemPublicidadeElectronica#(lf)     Where#(lf)         OrdemPublicidadeElectronica.OrdemPublicidadeGMediaAdId Is Not Null#(lf)    )#(lf)Select#(lf)    encomendasLog.enclogid,#(lf)    ordemPub.ordPubCodigo,#(lf)    campanhas.camId,#(lf)    campanhas.camDescricao,#(lf)    Convert(VARCHAR(10),campanhas.camDataRegisto,103) + ' ' + Convert(VARCHAR(8),campanhas.camDataRegisto,14) As#(lf)    camDataRegisto,#(lf)    encomendasLog.encLogAccao,#(lf)    ordemPub.ordPubAno,#(lf)    encomendasLog.encLogLocal,#(lf)    ordemPub.ordPubMes,#(lf)    Convert(VARCHAR(10),encomendasLog.encLogData,103) + ' ' + Convert(VARCHAR(8),encomendasLog.encLogData,14) As#(lf)    encLogData,#(lf)    entidades.entNome As Anunciante,#(lf)    entidades1.entNome As Distribuidor,#(lf)    Utilizadores1.UtiNome As Vendedor,#(lf)    Utilizadores2.UtiNome As Responsavel,#(lf)    Utilizadores.UtiNome As Assistente,#(lf)    encomendasLog.encDataExibicao,#(lf)    ordemPub.ordPubData,#(lf)    Canais.canDescricao As Canal,#(lf)    web.Tipo,#(lf)    encomendasLog.encId,#(lf)    encomendasLog.encExcDescricaoErro,#(lf)    Case#(lf)        When (Select#(lf)                 Count(*)#(lf)             From#(lf)                 encomendasLog x#(lf)             Where#(lf)                 x.encNui = encomendasLog.encNui And#(lf)                 x.encLogData > encomendasLog.encLogData And#(lf)                 encomendasLog.encLogAccao = 'RX') = 0 And encomendasLog.encLogAccao = 'RX'#(lf)        Then 1#(lf)        Else 0#(lf)    End RemocaoUtilizador,#(lf)    Utilizadores2.UtiId As IdResponsavel,#(lf)    Utilizadores1.UtiId As IdVendedor,#(lf)    entidades1.entId As IdDistribuidor,#(lf)    entidades.entId As IdAnunciante,#(lf)    Utilizadores.UtiId As IdAssistente,#(lf)    Canais.canCodigo#(lf)From#(lf)    encomendasLog Right Join#(lf)    ordemPub On ordemPub.ordPubCodigo = encomendasLog.ordPubCodigo Inner Join#(lf)    campanhas On campanhas.camId = ordemPub.camId Left Join#(lf)    entidades On campanhas.camAnunciante = entidades.entId Left Join#(lf)    entidades entidades1 On entidades1.entId = campanhas.camDistribuidor Left Join#(lf)    Utilizadores Utilizadores1 On campanhas.camVendedor = Utilizadores1.UtiId Left Join#(lf)    Utilizadores On Utilizadores.UtiId = encomendasLog.encLogUtiId Left Join#(lf)    Utilizadores Utilizadores2 On campanhas.camResponsavel = Utilizadores2.UtiId Left Join#(lf)    Canais On Canais.canCodigo = encomendasLog.canCodigo Left Join#(lf)    web On web.ordPubCodigo = ordemPub.ordPubCodigo#(lf)Where#(lf)    Year(ordemPub.ordPubData) >= Year(GetDate()) - 1", CommandTimeout=#duration(6, 6, 0, 0)]),
