	column CodCanal =
			
			-- Varia de Cliente (Sujeito a alteração)
			SWITCH( TRUE(),
			[Canal]="AÇORES",1,
			[Canal]="RTP 1",2,
			[Canal]="RTP 2",3,
			[Canal]="MADEIRA",4,
			[Canal]="RTP AFRICA",5,
			[Canal]="RTPI",6,
			[Canal]="RTP 3",7,
			[Canal]="SPONSORING",8,
			[Canal]="RTP Memoria",9,
			[Canal]="RTP MOBILE",10,
			[Canal]="RTPI América",12,
			[Canal]="INTERNET",11,
			[Canal]="RTPI Asia",13,
			[Canal]="RTP Musica",14,
			[Canal]="RTP HD JOLIMPICOS",15,
			[Canal]="RTP Memoria TDT",16,
			[Canal]="RTP 3 TDT",17,
			[Canal]="RTP PLAY",18
			)
		formatString: 0
		lineageTag: 9b141445-0d62-49af-8f01-623689d17ff5
