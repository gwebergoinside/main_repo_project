table Audiencias
	lineageTag: ab4e73bc-93a0-4090-9239-077065995c63

	measure 'Previsão Receita Grelha Atual' =
			
			Var __Tempo = CALCULATE( MAX(Ocupacao[CanalMaxNormal]) , USERELATIONSHIP( Ocupacao[ChavePrev], 'Audiencias'[Chave] ) )
			Var __Val = ROUND(AVERAGE('Audiencias'[Valor]),2)
			Var __CMGRP = CALCULATE( [CM GRP Equivalente] , USERELATIONSHIP( Encomendas[ChavePrev], 'Audiencias'[Chave] ) )
			-- Para calcular a Média por dia
			Var __dias = CALCULATE( COUNT( Calendario[Dia Semana] ) , FILTER(Calendario, Calendario[Mês] = MONTH(NOW())) )
			-- GRP Equiv.
			Var __indice = 20
			Return
			( ( ( __Tempo / __indice) * __Val) * __CMGRP )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: e1871527-50ae-46b0-9ed7-1ebd881d1326

	measure 'Receita AtualPrevisão' =
			
			If ( SELECTEDVALUE(Calendario[Mês]) ,
			CALCULATE( [Receita Média] , ALL(Alvos)),
			
			CALCULATE( [Receita Média] , ALL(Alvos), FILTER( Calendario , Calendario[Mês] = MONTH(NOW()))))
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 786022a3-e2e8-4036-b17d-bdd65ca240ec

	measure 'Receita Média' = CALCULATE(DIVIDE(SUM(Encomendas[valorPub]),COUNT(Calendario[Dia])) , OrdemPubClassificacao[ordPubClaDescricao] <> "Pré-Facturação" , USERELATIONSHIP(Encomendas[ChavePrev],'Audiencias'[Chave]) )
		lineageTag: f408470a-895d-4d7a-bcbb-0e9bf364e7c0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previsão Receita Grelha Seguinte' =
			
			Var __Tempo = CALCULATE( MAX(Ocupacao[CanalMaxNormal]) , USERELATIONSHIP( Ocupacao[ChavePrev], 'Audiencias'[Chave] ) )
			Var __Val = ROUND(AVERAGE('Audiencias'[Valor]),2)
			Var __CMGRP = CALCULATE( [CM GRP Equivalente] , USERELATIONSHIP( Encomendas[ChavePrev], 'Audiencias'[Chave] ) )
			-- Para calcular a Média por dia
			Var __dias = CALCULATE( COUNT( Calendario[Dia Semana] ) , FILTER(Calendario, Calendario[Mês] = MONTH(NOW())+1) )
			-- GRP Equiv.
			Var __indice = 20
			Return
			( ( ( __Tempo / __indice) * __Val) * __CMGRP )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: d667baab-07af-4542-82b3-b03e5aee674e

	measure 'Receita Previsão Seguinte' =
			
			CALCULATE( [Receita Média] , ALL(Alvos), FILTER( Calendario , Calendario[Mês] = MONTH(NOW())+1))
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: c19e7765-0c89-4f14-a238-0d79e9c18269

	measure 'Média All' = CALCULATE( AVERAGE( 'Audiencias'[Valor] ), CROSSFILTER(Canais[canCodigo],Audiencias[CodCanal],None) )
		lineageTag: 637bf024-cec1-44a7-97e9-afdfb2fc2516

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previsão Receita Mes' =
			
			Var __prevFDS = CALCULATE( SUMX( VALUES(Audiencias[Faixa (groups)]), [Previsão Receita Grelha Atual]) , ALLSELECTED(Calendario) , Calendario[Periodo da Semana] = "Fim de Semana")
			Var __prevDS = CALCULATE( SUMX( VALUES(Audiencias[Faixa (groups)]), [Previsão Receita Grelha Atual]) , ALLSELECTED(Calendario) , Calendario[Periodo da Semana] = "Dia de Semana")
			Var __prevT = CALCULATE( SUMX( VALUES(Audiencias[Faixa (groups)]), [Previsão Receita Grelha Atual]) , ALLSELECTED(Calendario) )
			--
			Var __dias = COUNT( Calendario[Periodo da Semana] )
			
			Return
			IF( SELECTEDVALUE(Calendario[Periodo da Semana]) = "Dia de Semana" , __prevDS ,
			IF( SELECTEDVALUE(Calendario[Periodo da Semana]) = "Fim de Semana" , __prevFDS , __prevT ) )
			*__dias
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 7f34b601-434e-446e-a0c5-f3914cb9b64e

	measure 'Receita S Alvos' = CALCULATE( [Receita] , ALL( Alvos ), USERELATIONSHIP( Encomendas[ChavePrev], 'Audiencias'[Chave] ), USERELATIONSHIP( Ocupacao[ChavePrev], 'Audiencias'[Chave] ) )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 75721445-b515-4a58-83d4-fe9322a5df30

	measure 'CM GRP Equiv.' = CALCULATE( [CM GRP Equivalente] , USERELATIONSHIP( Encomendas[ChavePrev], 'Audiencias'[Chave] ) )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: ad9d9ac1-3ca5-4c00-a595-20e9b8763818

	measure 'Previsão %' = DIVIDE([Receita S Alvos]-[Previsão Receita Mes],[Previsão Receita Mes])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a74589b6-eafb-4b27-be0f-9694f8b11358

