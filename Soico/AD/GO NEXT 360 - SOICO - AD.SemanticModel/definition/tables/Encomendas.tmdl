table Encomendas
	lineageTag: 487f0557-de7d-46f9-9c81-8186b7bd6a9d

	measure 'GRP vs GRPPrevisto' = ```
			
			Var __GRP = SUM(Encomendas[GRP Equivalente])
			Var __GRPPre = SUM(Encomendas[GRP Previsto Equivalente])
			--Var __blank = SUM( GMediaBI_Encomendas[GRP Equivalente]) <> BLANK() && SUM(GMediaBI_Encomendas[GRP Previsto Equivalente]) <> BLANK()
			RETURN
			IF( __GRP = __GRPPre , 0 , 
			IF( __GRP > __GRPPre , 1 , 2 ) )
			```
		formatString: 0
		lineageTag: 4e639534-a7cf-4a64-8201-67d7227748d3

	measure 'Custo GRP vs GRPPrevisto LY' = ```
			
			Var __GRP = [CM GRP Equivalente]
			Var __GRPLY = CALCULATE( [CM GRP Equivalente], SAMEPERIODLASTYEAR( Calendario[Date] ))
			--Var __blank = SUM( GMediaBI_Encomendas[GRP Equivalente]) <> BLANK() && SUM(GMediaBI_Encomendas[GRP Previsto Equivalente]) <> BLANK()
			RETURN
			IF( __GRP = __GRPLY , 0 , 
			IF( __GRP > __GRPLY , 1 , 2 ) )
			```
		formatString: 0
		lineageTag: 1af71e56-5c8a-42fe-bb63-2811b3ad14b9

	measure 'Qtd.Marcações' = calculate( COUNTROWS(Encomendas), filter(Encomendas, Encomendas[ordPubNegociacao]))
