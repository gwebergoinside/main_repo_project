	column DayPart =
			
			SWITCH(
			    TRUE()
			    ,Encomendas[MinutosExib] >= 390  && Encomendas[MinutosExib] < 480,  "Manhã 1"
			    ,Encomendas[MinutosExib] >= 480  && Encomendas[MinutosExib] < 720,  "Manhã 2"
			    ,Encomendas[MinutosExib] >= 720  && Encomendas[MinutosExib] < 870,  "Almoço"
			    ,Encomendas[MinutosExib] >= 870  && Encomendas[MinutosExib] < 1080, "Tarde"
			    ,Encomendas[MinutosExib] >= 1080 && Encomendas[MinutosExib] < 1200, "Acesso Prime"
			    ,Encomendas[MinutosExib] >= 1200 && Encomendas[MinutosExib] < 1350, "Prime Time 1"
			    ,Encomendas[MinutosExib] >= 1350 && Encomendas[MinutosExib] < 1440, "Prime Time 2"
			    ,Encomendas[MinutosExib] >= 1440 && Encomendas[MinutosExib] < 1590, "Late Night"
			    ,Encomendas[MinutosExib] >= 1590 || Encomendas[MinutosExib] < 390 , "Madrugada"
			    ,"Outro"
			)
		dataType: string
		lineageTag: 5d2c52cd-b4d8-4fb3-9bfd-5d59ad4eeff0
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

