table 'GRP Simulador'
	lineageTag: 1d7fe140-ae4d-4d4a-8991-a720de404fd0

	measure 'GRP Simulador Value' =
			--SELECTEDVALUE('GRP Simulador'[GRP Simulador])
			
			Var __start = SELECTEDVALUE('GRP Simulador'[GRP Simulador]) * 1.5
			Var __end = SELECTEDVALUE('GRP Simulador'[GRP Simulador]) / 1.5
			Var __result = SUM(Encomendas[GRP Equivalente])
			RETURN
			CALCULATE( [CM GRP Equivalente]) --; FILTER( GMediaBI_Encomendas ; (__result < __start) && (__result > __end) ) ))
		lineageTag: 376fe903-46c6-4032-8f1c-600e37af8784

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'GRP Selected' = SELECTEDVALUE( 'GRP Simulador'[GRP Simulador] )
		formatString: 0
		lineageTag: 20e95fb3-4270-4443-9cf9-0a5b596c8217

