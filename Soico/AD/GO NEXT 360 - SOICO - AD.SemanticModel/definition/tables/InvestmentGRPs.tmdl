		annotation SummarizationSetBy = Automatic

	column 'Grupo Canais' =
			
			SWITCH(
			    TRUE()
			    ,InvestmentGRPs[IdChannel] = 15, "TVI"
			    ,RELATED(GrupoCanais[Agrupador])
			)
		lineageTag: 3ecbbf0d-99c9-453e-9929-b65822eae827
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Chave = RELATED(Channels[Canal])&InvestmentGRPs[Data]&InvestmentGRPs[HoraInicio]
		lineageTag: 6830a4bd-5b4d-43f2-8a14-6121cba3aa80
		summarizeBy: none

