	column Periodo =
			
			SWITCH(
			    TRUE()
			    , [Horario_Minutos] >= 390  && [Horario_Minutos] < 480,  "Manhã 1"
			    ,[Horario_Minutos] >= 480  && [Horario_Minutos] < 720,  "Manhã 2"
			    ,[Horario_Minutos] >= 720  && [Horario_Minutos] < 870,  "Almoço"
			    ,[Horario_Minutos] >= 870  && [Horario_Minutos] < 1080, "Tarde"
			    ,[Horario_Minutos] >= 1080 && [Horario_Minutos] < 1200, "Acesso Prime"
			    ,[Horario_Minutos] >= 1200 && [Horario_Minutos] < 1350, "Prime Time 1"
			    ,[Horario_Minutos] >= 1350 && [Horario_Minutos] < 1440, "Prime Time 2"
			    ,[Horario_Minutos] >= 1440 && [Horario_Minutos] < 1590, "Late Night"
			    ,[Horario_Minutos] >= 1590 || [Horario_Minutos] < 390 , "Madrugada"
			    ,"Outro"
			)
			//         if([Horario_Minutos]>=0 && [Hora]<8,"Manhã 1",
			//         if([Hora]>=8 && [Hora]<12,"Manhã 2",
			//         if([Hora]>=12 && [Hora]<=14,"Almoço", --14:29
			//         if([Hora]>=14 && [Hora]<18,"Tarde",--14:30
			//         if([Hora]>18 && [Hora]<20,"Acesso Prime",
			//         if([Hora]>=20 && [Hora]<23,"Prime time 1",--22:29
			//         if([Hora]>=24 && [Hora]<=26,"Prime time 2", --22:30 26:29
			//         if([Hora]>24 && [Hora]<=26,"Late Night", --26:30
			//         if([Hora]>26 && [Hora]<=6,"Madrugada" --
			// )))))))))
		lineageTag: 45f3d48b-8825-43cf-b57d-32d4b2b87d55
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Hora = LEFT(InvestmentGRPs[HoraInicio],2)
		dataType: int64
		formatString: 0
		lineageTag: 48dbf898-dbaf-47b7-93cf-2c7c9d17432b
