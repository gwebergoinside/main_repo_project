table InvestmentGRPs
	lineageTag: f4f3dcac-f04e-4699-9697-803d703823c8

	measure Investimento =
			
			SUM([Investimento_apoio])/DISTINCTCOUNT(InvestmentGRPs[IdTarget])
			--SUM([InvestimentoTemp])/DISTINCTCOUNT(InvestmentGRPs[IdTarget])
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 33e6472f-6a85-476a-b2e9-a8c0da56d131

	measure Count_grupo_Canal =
			
			--CALCULATE(DISTINCTCOUNT(InvestmentGRPs[Grupo Canais]),ALLEXCEPT(InvestmentGRPs,InvestmentGRPs[IdAdvertiser],InvestmentGRPs[Ano],InvestmentGRPs[Mês]),InvestmentGRPs[Grupo Canais]<>blank(),InvestmentGRPs[InvestimentoTemp]>0)
			
			CALCULATE(DISTINCTCOUNT(InvestmentGRPs[Grupo Canais]),ALLEXCEPT(InvestmentGRPs,Advertisers[Anunciante],Calendario[Ano],Calendario[Mes]),filter(InvestmentGRPs,InvestmentGRPs[InvestimentoTemp]>0))
			--CALCULATE([SumInvestimento],ALLEXCEPT(InvestmentGRPs,Advertisers[Anunciante],Calendario[Ano],Calendario[Mes]))
		formatString: 0
		lineageTag: 7e2b7d0b-6547-4225-bfb6-9be9f67e3274

	measure 'Investimento LY %' =
			
			VAR _LY = CALCULATE( [Investimento], SAMEPERIODLASTYEAR( Calendario[Date] ) )
			RETURN
			DIVIDE( [Investimento]-_LY, _LY )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 70903eb5-3d88-476c-a847-1ce91aa33b31

	measure Ultimo_Carregamento = "Último Carregamento: "& CALCULATE( Format(Max(InvestmentGRPs[Data]), "dd/mm/yyyy", "pt-PT"), ALL( InvestmentGRPs ) )
		lineageTag: 4c92acd8-8d58-4294-92f3-45105640f379

