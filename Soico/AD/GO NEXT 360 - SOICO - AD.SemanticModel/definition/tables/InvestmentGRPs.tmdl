	column IdAnuncianteAD =
			
			VAR _1 = --iferror(LOOKUPVALUE( 'Ligacao Inv-Map'[IdAnunciante],'Ligacao Inv-Map'[Anunciante], InvestmentGRPs[Anunciante] ),InvestmentGRPs[IdAdvertiser] + 99999999999999999)
			CALCULATE (
			    FIRSTNONBLANK ( 'Ligacao Inv-Map'[IdAnunciante], 1 ),
			    FILTER ( ALL ( 'Ligacao Inv-Map' ), 'Ligacao Inv-Map'[Anunciante] = InvestmentGRPs[Anunciante] )
			)
			RETURN
			IF.EAGER( _1 = BLANK(), InvestmentGRPs[IdAdvertiser] + 99999999999999999, _1 )
		formatString: 0
		lineageTag: 7c321683-6453-49d0-8e09-69e86ad02027
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Anunciante = LOOKUPVALUE( Advertisers[Anunciante],Advertisers[Id], InvestmentGRPs[IdAdvertiser] )
		lineageTag: 80e12ae2-4b11-44d8-83f5-37067f6bb017
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Horario_Minutos = ```
			
			VAR Hours = 'InvestmentGRPs'[Hora]*60 --INT ( Duration / 3600)
			VAR Minutes = FORMAT( MID( InvestmentGRPs[HoraInicio],4,2), "General Number")  -- INT ( MOD( Duration - ( Hours * 3600 ),3600 ) / 60)
			VAR Seconds = FORMAT( RIGHT(InvestmentGRPs[HoraInicio],2), "General Number")/60  --'InvestmentGRPs'[Segundos] /60 --    ROUNDUP(MOD ( MOD( Duration - ( Hours * 3600 ),3600 ), 60 ),0) 
			
			RETURN
			Hours+ Minutes + Seconds
			```
		lineageTag: 68ddc980-fc62-419d-93e2-e6f255f6f8b1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Periodo_Ordem =
			
			SWITCH(
			    TRUE()
			    ,InvestmentGRPs[Periodo] = "Manhã 1",  1
			    ,InvestmentGRPs[Periodo] = "Manhã 2",2
			    ,InvestmentGRPs[Periodo] = "Almoço",3
			    ,InvestmentGRPs[Periodo] = "Tarde",4
			    ,InvestmentGRPs[Periodo] = "Acesso Prime",5
			    ,InvestmentGRPs[Periodo] = "Prime Time 1",6
			    ,InvestmentGRPs[Periodo] = "Prime Time 2",7
			    ,InvestmentGRPs[Periodo] = "Late Night",8
			    ,InvestmentGRPs[Periodo] = "Madrugada",9
			    ,InvestmentGRPs[Periodo] = "Outro",10
			)
		formatString: 0
		lineageTag: 4b230e20-a624-4868-a916-478611f6b762
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Flag_Exclusivo = CALCULATE(DISTINCTCOUNT(InvestmentGRPs[Grupo Canais]),ALLEXCEPT(InvestmentGRPs,InvestmentGRPs[IdAdvertiser],InvestmentGRPs[Ano],InvestmentGRPs[Mês]),InvestmentGRPs[Grupo Canais]<>blank(),InvestmentGRPs[InvestimentoTemp]>0)
		formatString: 0
		lineageTag: c8c0412b-0691-459c-ae1e-bfb1aaf7a46a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column CountCanais = CALCULATE( DISTINCTCOUNT( InvestmentGRPs[IdChannel] ), ALLEXCEPT( InvestmentGRPs, InvestmentGRPs[Ano], InvestmentGRPs[Mês], InvestmentGRPs[IdAdvertiser] ) )
		formatString: 0
		lineageTag: 787ca70f-ec93-495c-8841-3c616b36bd4f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Investimento_apoio = ```
			
			VAR selected = InvestmentGRPs[Grupo Canais]
			VAR soma = InvestmentGRPs[InvestimentoTemp]
			VAR Result = 
			SWITCH (
			    selected,
			    --20887, soma - (soma * [Valor Desconto %] ),
			    "TVI", soma - (soma * descontotvi ),
				"RTP", soma - (soma * descontortp ),
				"CMTV", soma - (soma * descontocmtv ),
				"SIC", soma - (soma * descontosic ),
			    "Cartoon Network", soma - (soma * descontocartoonnetwork ),
			    soma
			    --,soma - (soma * 0.94 )
			)
			RETURN
			Result
			```
		lineageTag: 8af39b2a-c5fe-43d7-80f7-8804a8f3ea65
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

