		source = ```
				--FILTER( SUMMARIZE('Ligacao Inv-Map', 'Ligacao Inv-Map'[NomeAnunciante], 'Ligacao Inv-Map'[IdAnunciante], "Anunciante", MAX('Ligacao Inv-Map'[Anunciante]) ) , [Anunciante] <> BLANK() )
				
				--SUMMARIZE('Ligacao Inv-Map', 'Ligacao Inv-Map'[NomeAnunciante], 'Ligacao Inv-Map'[IdAnunciante], "Anunciante", MAX('Ligacao Inv-Map'[Anunciante]) )
				
				VAR _Invest = 
