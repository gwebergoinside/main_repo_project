	partition NegDetalhe-cf9c104c-5096-4892-b80d-87b387236f37 = m
		mode: import
		queryGroup: Negociações
		source =
				let
				    Source = Sql.Database(ServerP, BD, [Query="Select#(lf)    negPeriodos.canCodigo As Cod_Canal,#(lf)    negPeriodos.negPerId,#(lf)    negPeriodos.negPerDescricao As Descricao,#(lf)    negPeriodos.negPerDataInicio As DataInicio,#(lf)    negPeriodos.negPerDataFim As DataFim,#(lf)    negPeriodos.negPerTipo As Tipo,#(lf)    negPeriodos.negPerTipValor,#(lf)    negPeriodos.codAlvo As Cod_Alvo,#(lf)    negPeriodos.audPaiId,#(lf)    negPeriodos.negPerIndEq As [IndEquiv.],#(lf)    negPeriodos.negPerResponsavel As Responsavel,#(lf)    negPeriodos.negPerObservacoes As Observacoes,#(lf)#(tab)  negociacao.negId#(lf)#(tab)#(lf)From negPeriodos #(lf)    join negociacao on negociacao.negPerId=negPeriodos.negPerId and negociacao.negFlgActivo=1"])
				in
				    Source

	annotation PBI_ResultType = Table

