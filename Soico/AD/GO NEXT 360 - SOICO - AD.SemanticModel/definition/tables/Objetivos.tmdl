	partition Objetivos-d443ff34-4878-41a1-9612-6b4afea6d1f3 = m
		mode: import
		queryGroup: Encomendas
		source =
				let
				    Source = Sql.Database(ServerP, BD, [Query="Select#(lf)    NegociacaoObjectivos.utiId,#(lf)    NegociacaoObjectivos.tipPubId,#(lf)    NegociacaoObjectivos.canCodigo,#(lf)    NegociacaoObjectivos.negObjTipo,#(lf)    NegociacaoObjectivos.negObjValor,#(lf)    NegociacaoObjectivos.negObjValorBruto,#(lf)    NegociacaoObjectivos.negObjMes,#(lf)    NegociacaoObjectivos.negObjAno,#(lf)    NegociacaoObjectivos.perId,#(lf)    NegociacaoObjectivos.negObjId,#(lf)    NegociacaoObjectivos.anuId#(lf)From#(lf)    NegociacaoObjectivos#(lf)Where#(lf)    NegociacaoObjectivos.negObjAno >= Year(GetDate()) - 3"])
				in
				    Source

