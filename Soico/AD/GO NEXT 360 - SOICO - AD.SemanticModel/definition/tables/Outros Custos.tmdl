				    Source = Sql.Database(ServerP, BD, [Query="Select#(lf)    op.ordPubCodigo,#(lf)    op.ordPubDetFactValor As valor,#(lf)    '01-' + RIGHT('0' + cast(ordpubmes as varchar),2) + '-' + cast(ordpubano as varchar) as dia,#(lf)    ordemPub.canCodigo,#(lf)    ordemPub.tipPubId,#(lf)    ordemPub.camId#(lf)From#(lf)    ordemPubDetalheFact op Left Join#(lf)    ordemPub On op.ordPubCodigo = ordemPub.ordPubCodigo"])
