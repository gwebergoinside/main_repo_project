	partition Propostas-9bd57433-3bd1-4bc6-9644-a8f47405380b = m
		mode: import
		queryGroup: Encomendas
		source =
				let
				    Origem = Sql.Database(ServerP, BD, [Query="Select#(lf)    p.proValorPub As proValorPub,#(lf)    p.proDataInicio,#(lf)    p.produtoDesc,#(lf)    p.proNumero,#(lf)    p.vendedorId,#(lf)    ae.estadoDesc,#(lf)    an.accNegDataInicio,#(lf)    an.accNegValorPlano As accNegValorPlano,#(lf)    an.canCodigo,#(lf)    p.proDataCria,#(lf)    p.propostaId,#(lf)    an.accNegId,#(lf)    p.proANId,#(lf)    an.tipPubId#(lf)From#(lf)    Propostas p Left Join#(lf)    accaoEstados ae On ae.estadoId = p.proEstado Left Join#(lf)    accaoNegociacao an On p.propostaId = an.propostaId Full Join#(lf)    entidades e On e.entId = p.proANId Left Join#(lf)    Vendedores v On v.UtiId = p.vendedorId#(lf)Where#(lf)    Year(an.accNegDataInicio) >= Year(GetDate()) - 1"])
				in
				    Origem

