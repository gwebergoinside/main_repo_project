	column desDias_format = ```
			
			var _seg=   If(SEARCH("2",'d_Neg_Descontos'[desDias],,0)>0, "2ª")
			var _ter=   If(SEARCH("3",'d_Neg_Descontos'[desDias],,0)>0, "3ª")
			var _qua=   If(SEARCH("4",'d_Neg_Descontos'[desDias],,0)>0, "4ª")
			var _qui=   If(SEARCH("5",'d_Neg_Descontos'[desDias],,0)>0, "5ª")
			var _sex=   If(SEARCH("6",'d_Neg_Descontos'[desDias],,0)>0, "6ª")
			var _sab =  If(SEARCH("S",'d_Neg_Descontos'[desDias],,0)>0,"Sáb")
			var _dom =  If(SEARCH("D",'d_Neg_Descontos'[desDias],,0)>0,"Dom")
			
			Return 
			 Trim (COMBINEVALUES ( " ", _seg,_ter,_qua,_qui,_sex,_sab,_dom))
			```
		lineageTag: 92091a1e-9e9e-4cde-b5aa-a9f97a9b4690
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Hora_inicio-Formatada = ```
			
			VAR Duration = 'd_Neg_Descontos'[desHoraInicio] *60
			VAR Hours =
			    INT ( Duration / 3600)
			VAR Minutes =
			    INT ( MOD( Duration - ( Hours * 3600 ),3600 ) / 60)
			VAR Seconds =
			    ROUNDUP(MOD ( MOD( Duration - ( Hours * 3600 ),3600 ), 60 ),0) 
			VAR H =
			    IF ( LEN ( Hours ) = 1, 
			        CONCATENATE ( "0", Hours ),
			        CONCATENATE ( "", Hours )
			      )
			VAR M =
			    IF (
			        LEN ( Minutes ) = 1,
			        CONCATENATE ( "0", Minutes ),
			        CONCATENATE ( "", Minutes )
			    )
			VAR S =
			    IF (
			        LEN ( Seconds ) = 1,
			        CONCATENATE ( "0", Seconds ),
			        CONCATENATE ( "", Seconds )
			    )
			RETURN
			IF( Duration = BLANK(), BLANK() ,
			    CONCATENATE (
			        H,
			        CONCATENATE ( ":", CONCATENATE ( M, CONCATENATE ( ":", S ) ) )
			    )
			)
			```
		lineageTag: 505b1dbe-c77f-4bfe-8746-05b34ac3a7dc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

