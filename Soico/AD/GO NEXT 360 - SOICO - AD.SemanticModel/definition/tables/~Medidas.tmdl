			             ,ALLSELECTED(Encomendas[Central]), ALLSELECTED(Vendedores[UtiNome]), ALLSELECTED(Canais[Canal]), ALLSELECTED(Pub[Tipo PUB]))
			    VAR _2 = CALCULATE( [Receita YTD Atual Month]
			            ,ALLSELECTED(Encomendas[Central]), ALLSELECTED(Vendedores[UtiNome]), ALLSELECTED(Canais[Canal]), ALLSELECTED(Pub[Tipo PUB]))
			    VAR _3 = CALCULATE( 
