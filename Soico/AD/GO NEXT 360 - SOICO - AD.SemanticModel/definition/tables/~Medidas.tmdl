			IF( ISFILTERED(Calendario[Mes]) , calculate([Val Faturado total] , FILTER(Calendario, Calendario[Mês] = MAX(Calendario[Mês]) && Calendario[Ano] = MAX(Calendario[Ano]) ) ) ,
