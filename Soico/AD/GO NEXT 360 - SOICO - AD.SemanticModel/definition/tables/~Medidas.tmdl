	measure RappelFaturado =
			
			SWITCH(
			    TRUE()
			    ,SELECTEDVALUE( TipoRappelComissao[Tipo] ) = "Rappel", CALCULATE( SUM(Rappel[valorRappel] ) )
			    ,SELECTEDVALUE( TipoRappelComissao[Tipo] ) = "Comissão Agência", CALCULATE( SUM( Encomendas[valorComissaoAgencia] ) )
			    ,SELECTEDVALUE( TipoRappelComissao[Tipo] ) = "Rappel LY", CALCULATE( SUM(Rappel[valorRappel] ), SAMEPERIODLASTYEAR( Calendario[Date] ) )
			    ,SELECTEDVALUE( TipoRappelComissao[Tipo] ) = "Comissão Agência LY", CALCULATE( SUM( Encomendas[valorComissaoAgencia] ), SAMEPERIODLASTYEAR( Calendario[Date] ) )
			)
		formatString: #,0.00
		lineageTag: 588fdf47-1919-4925-a3e6-c3e7d560a926

		changedProperty = FormatString

	measure RappelLiquido =
			
			SWITCH(
			    TRUE()
			    ,SELECTEDVALUE( TipoRappelComissao[Tipo] ) = "Rappel", CALCULATE( SUM(Rappel[valorRappel] ), USERELATIONSHIP( Calendario[Date], Rappel[dataExib] ) )
			    ,SELECTEDVALUE( TipoRappelComissao[Tipo] ) = "Comissão Agência", CALCULATE( SUM( Encomendas[valorComissaoAgencia] ) )
			    ,SELECTEDVALUE( TipoRappelComissao[Tipo] ) = "Rappel LY", CALCULATE( SUM(Rappel[valorRappel] ), SAMEPERIODLASTYEAR( Calendario[Date] ), USERELATIONSHIP( Calendario[Date], Rappel[dataExib] ) )
			    ,SELECTEDVALUE( TipoRappelComissao[Tipo] ) = "Comissão Agência LY", CALCULATE( SUM( Encomendas[valorComissaoAgencia] ), SAMEPERIODLASTYEAR( Calendario[Date] ) )
			)
		formatString: #,0.00
