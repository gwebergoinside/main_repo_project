	measure 'Var Objetivo Anunciante YTD' = ```
			
			
			VAR __ReceitaLYTotal = CALCULATE( [Receita LY YTD] , ALLSELECTED(Calendario) )
			VAR __Objetivo = CALCULATE( MAXX(Negociacao, Negociacao[negValor]) , ALL(Calendario) )
			VAR __ReceitaLY = [Receita LY YTD]
			VAR Result =(DIVIDE(__ReceitaLY*100,__ReceitaLYTotal))*DIVIDE(__Objetivo,100)
			Var __Obj = CALCULATE(Result,FILTER(ALL(Calendario),'Calendario'[Ano]=MAX(Calendario[Ano])&&'Calendario'[Mês]<=MAX(Calendario[Mês])))
			Var __Rec = [Receita YTD]
			
			RETURN
			--IF( __Obj = __Rec ; 0 ; 
			--IF( __Obj > __Rec ; 1 ; 2 ) )
			DIVIDE(__Rec,__Obj)
			```
