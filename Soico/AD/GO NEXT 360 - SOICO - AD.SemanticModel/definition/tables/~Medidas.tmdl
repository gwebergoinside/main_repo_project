	measure 'Titulo_Ganhos Perdidos' = ```
			
			vAR _1 = concatenatex(SUMMARIZE('Calendario','Calendario'[Mes]), 'Calendario'[Mes],", " )
			vAR _12 = MIN('Calendario'[Mês])
			VAR _11 = MONTH(now())
			--VAR _2 =  IF.EAGER(ISFILTERED('Calendario Carteira'[Mes]),  MONTH(CALEND), BLANK())
			--Var _3 = Titulos[ID]
			// IF.EAGER(
			//     ISFILTERED('Calendario Carteira'[Mes]) && Titulos[Selected TituloParameter] = 10, [Titulo] & " " & ,
			//     )
			RETURN 
			 --_1
			IF.EAGER( ISFILTERED('Calendario'[Mes])
			    ,"Ganhos e Perdidos (" & _1 & ")"
			    ,CALCULATE( [Titulo], Titulos[ID] = 10 ) & " (" & SWITCH(
			    _12
			    ,1,"Jan",2,"Fev",3,"Mar",4,"Abr"
			    ,5,"Mai",6,"Jun",7,"Jul",8,"Ago"
			    ,9,"Set",10,"Out",11,"Nov",12,"Dez") & " - " & SWITCH(
			    _11
			    ,1,"Jan",2,"Fev",3,"Mar",4,"Abr"
			    ,5,"Mai",6,"Jun",7,"Jul",8,"Ago"
			    ,9,"Set",10,"Out",11,"Nov",12,"Dez") & ")"
			) 
			```
		displayFolder: Ganhos e Perdidos
		lineageTag: 215a8f71-1ab6-4763-a55b-4a5495f32b34

