			VAR _2 = CALCULATE( [Receita YTD Atual Month]
			                   ,ALLSELECTED(Central[Central Agrupador]), ALLSELECTED(Vendedores[UtiNome]), ALLSELECTED(Canais[Canal]), ALLSELECTED('Tipo Publicidade'[tipPubDescricao]))
			
			
			RETURN
			
			    IF.EAGER(
			        ( not(ISBLANK(_1) && _1 = 0) && (ISBLANK( _2 ) || _2 = 0 )) || (ISBLANK( _1) && ( _2 = 0 && not( ISBLANK( _2)))) || (_1 = 0 && (_2 = 0 && not (ISBLANK( _2)))) || ((_1 = 0 || ISBLANK( _1)) && _2 < 0)  || (_1 > 0 && (_2 <= 0 || ISBLANK( _2))) || (_1 < 0 && ( _2 <> 0 || not(ISBLANK( _2)))) || (_1 < 0 && ( _2 <= 0 || ISBLANK( _2))), [Valor dif Carteira Ganhos e Perdidos YTD],BLANK() ) --bruto
			    
