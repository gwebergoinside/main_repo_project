	measure GPQC = ```
			
			VAR _1 = CALCULATE([Receita LY YTD Atual Month]
			                ,ALLSELECTED(Central[Central Agrupador]), ALLSELECTED(Vendedores[UtiNome]), ALLSELECTED(Canais[Canal]), ALLSELECTED('Tipo Publicidade'[tipPubDescricao]))
			
			
			VAR _2 = CALCULATE([Receita YTD Atual Month]
			            ,ALLSELECTED(Central[Central Agrupador]), ALLSELECTED(Vendedores[UtiNome]), ALLSELECTED(Canais[Canal]), ALLSELECTED('Tipo Publicidade'[tipPubDescricao]))
			
			return
				SWITCH(
					TRUE()
					 , ((not(ISBLANK(_1)) && _1 = 0) && (ISBLANK( _2 ) || _2 = 0 )) || (ISBLANK( _1) && ( _2 = 0 && not( ISBLANK( _2)))) || (_1 = 0 && (_2 = 0 && not (ISBLANK( _2)))) || ((_1 = 0 || ISBLANK( _1)) && _2 < 0)  || (_1 > 0 && (_2 <= 0 || ISBLANK( _2))) || (_1 < 0 && ( _2 <> 0 || not(ISBLANK( _2)))) || (_1 < 0 && ( _2 <= 0 || ISBLANK( _2))),  "Perdidos" 
					, _2 > 0 && ( _1 = BLANK() || _1 <= 0), "Novos"
					, _2 > 0 && ( _1 > _2), "Queda"
					, _2 > 0 && ( _2 > _1) && (_1 <> BLANK() || _1 <> 0), "Crescimento"
					, "Outros"
				)
			
			```
		displayFolder: Ganhos e Perdidos
		lineageTag: 9cd9a664-2096-49bc-8890-d9ae6395bc5d

