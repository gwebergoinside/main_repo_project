	measure Gauge = ```
			
			VAR SourceMeasure = [Receita YTD Atual Month] //Actual value
			VAR TargetMeasure = [Objetivo YTD Atual Month] //Target value (end of the yellow zone)
			VAR RedZoneMeasure = [Objetivo YTD Atual Month]/2 //Minimum target value (end of the red zone)
			VAR MaxValue = SWITCH(TRUE(),SourceMeasure>TargetMeasure,SourceMeasure*1.2,TargetMeasure*1.2) //Defines max value of the scale
			VAR RedZoneColor = "#cc3232" //Red zone color
			VAR YellowZoneColor = "#ffc90d" //Yellow zone color
			VAR MainZoneColor = "#99c140" //Green zone color
			VAR Size = 50 // SVG-image size
			VAR Radius = Size*0.4 //Defines the gauge radius
			Var Circumference = 2*PI()*Radius
			VAR RedZone = (RedZoneMeasure/MaxValue)*PI()*Radius //Red zone lenght
			VAR YellowZone = ((TargetMeasure-RedZoneMeasure)/MaxValue)*PI()*Radius //Yellow zone length
			VAR LineAngle = ROUND(SourceMeasure*180/MaxValue,0) //Actual value - arrow rotation angle
			VAR YellowZoneAngle = 180+ROUND(RedZoneMeasure*180/MaxValue,0) //Yellow circle rotation angle
			
			/*Defines the svg image */ VAR Output = "data:image/svg+xml;utf8,"
			    & "<svg xmlns='http://www.w3.org/2000/svg' x= '0px' y = '0px' width='" & Size & "' height='" & Size/2 & "'>"
			 &"<circle r='"&Radius&"' cx='" & Size/2  & "' cy='" & Size/2&"' stroke='"&MainZoneColor&"' stroke-width='"&Size*0.1&"' stroke-dasharray='"&Circumference*RedZone&","& Circumference&"' transform= 'rotate(240,"&Size/2&","&Size/2&")' fill='none'></circle>" // Green zone
			    & "<circle cx='" & Size/2 & "' cy='" & Size/2 & "' r='"   & Radius& "' stroke='"&RedZoneColor&"' fill = 'none'  stroke-width='"&Size*0.1&"' " 
			&"stroke-dasharray='"& RedZone &","& Circumference &"' transform= 'rotate(180,"& Size/2 &","& Size/2 &")' />" //Red zone
			& "<circle cx = '" & Size/2 & "' cy='" & Size/2 & "' r='"   & Radius& "' stroke='"&YellowZoneColor&"' fill = 'none'  stroke-width='"&Size*0.1&"' "
			&"stroke-dasharray='"& YellowZone &","& Circumference &"' transform= 'rotate("&YellowZoneAngle&","& Size/2 &","& Size/2 &")' />" //Yellow zone
			
			&"<line x1='"&Size/2&"' y1='"&Size/2&"' x2='"&Size*0.1&"' y2='"&Size/2&"' stroke='black' stroke-width='2' transform='rotate("&LineAngle&","&Size/2&","&Size/2&")' />"
			    & "</svg>"
			RETURN //Use HASONEVALUE expression in order to eliminate issue with totals
			    IF ( HASONEVALUE ( 'Canais'[Canal] )&&SourceMeasure<>BLANK(), Output, BLANK () )
			
			```
		displayFolder: Gauge
		lineageTag: 57e2f358-ef20-4f7b-8e31-3ca5d8f4639e
		dataCategory: ImageUrl

