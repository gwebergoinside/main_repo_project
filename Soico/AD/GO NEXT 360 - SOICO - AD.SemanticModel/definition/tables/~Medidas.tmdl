	measure 'Gauge End Faturado' =
			
			VAR SourceMeasure = [val faturado Gauge] //Actual value
			VAR TargetMeasure = [Objetivo Gauge] --[Objetivo liquido Gauge] //Target value (end of the yellow zone)
			VAR RedZoneMeasure = [Objetivo Gauge]*0.5 --[Objetivo liquido Gauge]*0.5 //Minimum target value (end of the red zone)
			VAR MaxValue = SWITCH(TRUE(),SourceMeasure>TargetMeasure,SourceMeasure*1.2,TargetMeasure*1.2) //Defines max value of the scale
			Return
			MaxValue
		displayFolder: Gauge
		lineageTag: eb59d539-d55a-4e5f-8fda-ef6abd4bb4a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gauge Red Faturado' =
			
			VAR SourceMeasure = [val faturado Gauge] //Actual value
			VAR TargetMeasure = [Objetivo Gauge] --[Objetivo liquido Gauge] //Target value (end of the yellow zone)
			VAR RedZoneMeasure = [Objetivo Gauge]*0.5 --[Objetivo liquido Gauge]*0.5 //Minimum target value (end of the red zone)
			VAR MaxValue = SWITCH(TRUE(),SourceMeasure>TargetMeasure,SourceMeasure*1.2,TargetMeasure*1.2) //Defines max value of the scale
			Return
			RedZoneMeasure
		displayFolder: Gauge
		lineageTag: 570e66eb-3f64-41d9-8045-f615b5ba04f9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gauge Green Faturado Actual' =
			
			VAR SourceMeasure = [val faturado Gauge] //Actual value
			VAR TargetMeasure = [Objetivo Gauge] --[Objetivo liquido Gauge] //Target value (end of the yellow zone)
			VAR RedZoneMeasure = [Objetivo Gauge]/2 --[Objetivo liquido Gauge]/2 //Minimum target value (end of the red zone)
			VAR MaxValue = SWITCH(TRUE(),SourceMeasure>TargetMeasure,SourceMeasure*1.2,TargetMeasure*1.2) //Defines max value of the scale
			
			Return
			
