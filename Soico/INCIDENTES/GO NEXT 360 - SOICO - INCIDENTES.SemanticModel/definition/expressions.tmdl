expression TarefasCodigo =
		let
		    Source = Sql.Database(#"@Org", BD, [Query="SELECT DISTINCT t.p.value('(Name)[1]', 'varchar(max)') [Name]#(lf)    ,t.p.value('(StringValue)[1]', 'varchar(max)') StringValue#(lf)    ,t.p.value('(IntegerValue)[1]', 'int') IntegerValue#(lf)    ,t.p.value('(Color)[1]', 'varchar(max)') Color#(lf)    ,t.p.value('(FgColor)[1]', 'varchar(max)') FgColor#(lf)    ,t.p.value('(Prefix)[1]', 'varchar(max)') Prefix#(lf)    ,t.p.value('(Image)[1]', 'varchar(max)') [Image]#(lf)    ,t.p.value('(IsBuiltIn)[1]', 'bit') IsBuiltIn#(lf)    ,t.p.value('(IsEnabled)[1]', 'bit') IsEnabled#(lf)    ,t.p.value('(CanBeDisabled)[1]', 'bit') CanBeDisabled#(lf)    ,t.p.value('(Highlighted)[1]', 'bit') Highlighted#(lf)FROM Configuracoes_Estados#(lf)CROSS APPLY Valor.nodes('/ArrayOfState/State') t(p)#(lf)WHERE Tipo = 'TaskStateMachine'"]),
		    #"Removed Columns" = Table.RemoveColumns(Source,{"IntegerValue", "Color", "FgColor", "Prefix", "Image", "IsBuiltIn", "IsEnabled", "CanBeDisabled", "Highlighted"})
		in
		    #"Removed Columns"
	lineageTag: 2b3a706b-2196-4119-a3f7-4336bae9b7be

