	measure Duracao_Interrupcao =
			
			VAR allseconds =
			    CALCULATE(SUM(f_Incidencias[Duracao_Seg]), FILTER(f_Incidencias, f_Incidencias[Interrupcao] = 1),TREATAS( VALUES( f_Meios[Id] ), d_Meios_Incid[IdMeio] ))
			VAR days =
			    INT ( allseconds / 24 / 60 / 60 )
			VAR hours =
			    MOD ( INT ( allseconds / 60 / 60 ), 24 )
			VAR minutes =
			    MOD ( INT ( allseconds / 60 ), 60 )
			VAR seconds =
			    MOD ( INT ( allseconds ), 60 )
			RETURN
			IF.EAGER( ISBLANK(allseconds), "0d 0h 0m 0s",
			days & "d "
			& hours
			& "h "
			& minutes
			& "m "
			& seconds
			& "s "
			)
