	measure Interrupcao_month = ```
			
			var _1 = CALCULATE(
			    [Interrupcao], DATESYTD(Calendario[Date]))
			
			var _2=  CALCULATE([Interrupcao]
			      ,FILTER( all(Calendario),
			         MONTH(Calendario[Date])<=MONTH(NOW()) && YEAR(Calendario[Date])=YEAR(MAX(Calendario[Date])) ) )
			
			         Return 
			   _2
			// IF.EAGER( ISFILTERED(Calendario[Date]),     
			//     CALCULATE(
			//     [Interrupcao], DATESYTD(Calendario[Date]))
			//     , CALCULATE([Interrupcao]
			//       ,FILTER( ALL(Calendario[Date]),
			//          MONTH(Calendario[Date])<=MONTH(NOW()) && YEAR(Calendario[Date])=YEAR(MAX(Calendario[Date])) ) )) 
			```
		lineageTag: 4b688d6a-c94e-4764-9018-8d65dc90eb97

		annotation PBI_FormatHint = {"isGeneralNumber":true}

