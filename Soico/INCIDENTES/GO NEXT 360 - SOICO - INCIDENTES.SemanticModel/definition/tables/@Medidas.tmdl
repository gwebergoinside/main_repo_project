	measure 'Tempo Total_Hora' = ```
			
			 
			Var __seg = CALCULATE(SUM(f_Incidencias[Duracao_Seg])) -- CALCULATE(AVERAGE(f_Incidencias[Duracao_Hora])) --, GENERATEALL(Projetos, ExecucaoMensalConta) )
			
			RETURN
			 
			IF( ISBLANK(__seg) , BLANK() ,
			
			    RIGHT ( "0" & INT ( __seg / 3600 ),2 )
			
			    & ":"
			
			    & RIGHT (
			
			    "0"
			
			    & INT ( ( __seg - INT (__seg / 3600 ) * 3600 ) / 60 ),
			
			    2
			
			))
			
			```
		lineageTag: b5d47c0a-5cf1-435b-accd-627f2f0a1625

	measure Total_seg = SUM(f_Incidencias[Duracao_Seg])
		formatString: 0
		lineageTag: 80eaa8e7-0212-4791-9597-79447a50f298

	measure dias = INT([Total_seg])
		formatString: 0
		lineageTag: 0552b03e-bcd0-4964-97f1-58f777286552

	measure 'Soma Hora (hh:mm:ss)' =
			
			VAR vHorasDecimal = [Total_seg]
			VAR vHoras = INT ( vHorasDecimal )
			VAR vMinutosDecimal = 60 * ( vHorasDecimal - vHoras)
			VAR vMinutos = INT ( vMinutosDecimal )
			VAR vSegundos = ROUND ( 60 * (vMinutosDecimal - vMinutos), 0 )
			VAR vHH = IF ( LEN ( vHoras ) = 1, "0" & vHoras, vHoras )
			VAR vMM = IF ( LEN ( vMinutos ) = 1, "0" & vMinutos, vMinutos )
			VAR vSS = IF ( LEN ( vSegundos ) = 1, "0" & vSegundos, vSegundos )
			VAR vResultado = vHH & ":" & vMM & ":" & vSS
			RETURN
			    vResultado
		formatString: 00:00:00
		lineageTag: d32d520a-846a-4832-9285-847ceb999f24

		annotation PBI_FormatHint = {"isCustom":true}

	measure Duracao_Total =
			
			Var __seg = CALCULATE(SUM(f_Incidencias[Duracao_Seg])) --, GENERATEALL(Projetos, ExecucaoMensalConta) )
			
			var _calc =
			
			(__seg / 3600 )
			
			return
			 ROUNDDOWN( _calc,0)
			 --AVERAGE(f_Incidencias[Duracao_Hora])
		lineageTag: 2b11adc7-d1b9-4ebf-8d45-1fff1da4ff31

