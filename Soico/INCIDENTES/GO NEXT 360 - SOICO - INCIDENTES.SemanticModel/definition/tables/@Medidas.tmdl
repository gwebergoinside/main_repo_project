	measure Duracao_Media =
			
			VAR allseconds =
			    CALCULATE(AVERAGE(f_Incidencias[Duracao_Seg]))
			VAR days =
			    INT ( allseconds / 24 / 60 / 60 )
			VAR hours =
			    MOD ( INT ( allseconds / 60 / 60 ), 24 )
			VAR minutes =
			    MOD ( INT ( allseconds / 60 ), 60 )
			VAR seconds =
			    MOD ( INT ( allseconds ), 60 )
			RETURN
			days & "d "
			& hours
			& "h "
			& minutes
			& "m "
			& seconds
			& "s "
		lineageTag: 9d014536-6e43-412c-b167-6d5310d55561

