	measure Interrupcao = ```
			
			Var __seg = CALCULATE(SUM(f_Incidencias[Duracao_Seg]), FILTER(f_Incidencias, f_Incidencias[Interrupcao] =1)) --, GENERATEALL(Projetos, ExecucaoMensalConta) )
			var _calc = (__seg / 60 )  --minutos
			var valor = ROUNDDOWN( _calc,0)
			 
			return
			_calc/60 --hora
			```
		formatString: 0.0
