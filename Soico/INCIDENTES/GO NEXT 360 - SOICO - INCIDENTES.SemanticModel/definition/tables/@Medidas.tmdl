	measure 'Gauge End' =
			
			VAR SourceMeasure = [Interrupcao] //Actual value [Duracao_Total]
			VAR TargetMeasure = [Duracao_Mes] //Target value (end of the yellow zone)
			VAR RedZoneMeasure = [Duracao_Mes]*0.5 //Minimum target value (end of the red zone)
			VAR MaxValue = [Duracao_Mes]--SWITCH(TRUE(),SourceMeasure>TargetMeasure,SourceMeasure*1.2,TargetMeasure*1.2) //Defines max value of the scale
			
			Return
			
			MaxValue
		lineageTag: 61e3074e-a125-4f04-b707-44584e97bc26

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gauge Red' = ```
			
			VAR SourceMeasure = [Interrupcao] // [Duracao_Mes] Actual value
			VAR TargetMeasure = [Duracao_Mes] *0.0001 //Target value (end of the yellow zone) 
			VAR RedZoneMeasure = [Duracao_Mes]*0.5 //Minimum target value (end of the red zone) = 365
			VAR MaxValue = SWITCH(TRUE(),SourceMeasure>TargetMeasure,SourceMeasure*1.2,TargetMeasure*1.2) //Defines max value of the scale
			
			Return
			
			RedZoneMeasure
			```
		lineageTag: 16f12d8a-8370-4fb5-8656-c83df45b007d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gauge Green' =
			
			VAR SourceMeasure = [Duracao_Total] //Actual value
			VAR TargetMeasure = [Duracao_Mes] *0.01 //Target value (end of the yellow zone)
			VAR RedZoneMeasure = [Duracao_Mes]*0.5 //Minimum target value (end of the red zone)
			VAR MaxValue = SWITCH(TRUE(),SourceMeasure>TargetMeasure,SourceMeasure*1.2,TargetMeasure*1.2) //Defines max value of the scale
			
			Return
			
			TargetMeasure
		formatString: 0.00
		lineageTag: 06b3a6b0-bb9c-49fa-88e3-3de7b9580703

