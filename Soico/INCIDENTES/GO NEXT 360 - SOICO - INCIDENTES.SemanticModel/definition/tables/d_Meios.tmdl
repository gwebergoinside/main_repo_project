	partition d_Meios-3845e0b9-2cd5-4376-a870-a80c66807b76 = m
		mode: import
		source =
				let
				    Origem = Sql.Database(#"@Org", BD, [Query="Select#(lf)    m.Nome,#(lf)    m.Id,#(lf)    m.activo,#(lf)    am.Nome As Meio_Nome_Areas,#(lf)    tp.Nome As Meio_Tipo,#(lf)    atm.Nome As Meio_Atividade#(lf)From#(lf)    Meios m Inner Join#(lf)    Areas_Meios am On m.IdAreaMeio = am.Id Left Join#(lf)    Tipos_Meio tp On m.IdTipoMeio = tp.Id Left Join#(lf)    Actividades_Meios atm On m.IdActividadeMeio = atm.Id"])
				in
				    Origem

	annotation PBI_ResultType = Table

