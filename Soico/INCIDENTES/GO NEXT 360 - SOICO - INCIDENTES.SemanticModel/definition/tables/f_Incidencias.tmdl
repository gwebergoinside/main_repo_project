	column Duracao_Calc =
			
			VAR allseconds =
			    DATEDIFF(f_Incidencias[DataInicioExecucao],f_Incidencias[DataFimExecucao],SECOND)
			VAR days =
			    INT ( allseconds / 24 / 60 / 60 )
			VAR hours =
			    MOD ( INT ( allseconds / 60 / 60 ), 24 )
			VAR minutes =
			    MOD ( INT ( allseconds / 60 ), 60 )
			VAR seconds =
			    MOD ( INT( allseconds ), 60 )
			RETURN
			days & "d "
			& hours
			& "h "
			& minutes
			& "m "
			& seconds
			& "s "
		lineageTag: 09ea390c-b1b8-4f85-b1bd-9e07122433a0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

