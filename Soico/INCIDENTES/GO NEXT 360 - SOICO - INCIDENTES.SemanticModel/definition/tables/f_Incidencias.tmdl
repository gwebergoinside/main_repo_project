	partition f_Incidencias-835da081-5614-418b-95f8-eb186e517b23 = m
		mode: import
		queryGroup: Fatos
		source =
				let
				    Origem = Sql.Database(#"@Org", BD, [Query="Select#(lf)    Incidencias.Id As ID_Incidencias,#(lf)    Incidencias.IdSubArea,#(lf)    Incidencias.IdArea,#(lf)    Incidencias.IdModulo,#(lf)    Incidencias.IdProjecto,#(lf)    Incidencias.Titulo,#(lf)    Incidencias.Descricao,#(lf)    Incidencias.DataInicio,#(lf)    Incidencias.DataFim,#(lf)    Incidencias.Codigo,#(lf)    Incidencias.IdIncidenciaRelacionada,#(lf)    Incidencias.Estado,#(lf)    Incidencias.DataInicioExecucao,#(lf)    Incidencias.DataFimExecucao,#(lf)    Incidencias.Duracao,#(lf)    Incidencias.DuracaoExecucao,#(lf)    Incidencias.UnidadeDuracao,#(lf)    Incidencias.UnidadeDuracaoExecucao,#(lf)    Incidencias.Interrupcao,#(lf)    Incidencias.Tipo,#(lf)    Incidencias_Tipos.Nome As Tipo_Desc,#(lf)    Incidencias.ResolucaoTecnica,#(lf)    Incidencias.Observacoes,#(lf)    Incidencias.Resolucao,#(lf)    Incidencias_SubAreas.Nome As SubArea,#(lf)    Incidencias_Locais.Nome As Local,#(lf)    Incidencias_Causas.Nome As Causas,#(lf)    Incidencias_Causas.TempoMedioResolucao,#(lf)    Incidencias_Areas.Nome As Area,#(lf)    Incidencias_Areas_Causas.Nome As Area_Causas,#(lf)    Incidencias.IdAreaCausa,#(lf)    Incidencias.IdCausa,#(lf)    Tarefas.Titulo,#(lf)    Tarefas.DataInicio,#(lf)    Tarefas.DataFim,#(lf)    Incidencias.IdClassificacao,#(lf)    Incidencias.StampUser,#(lf)    Pessoas.nome AS PessoaNome,#(lf)    Funcoes_Pessoas.Nome As FuncaoNome#(lf)From#(lf)    Incidencias Left Join#(lf)    Incidencias_Areas On Incidencias.IdArea = Incidencias_Areas.Id Left Join#(lf)    Incidencias_Areas_Causas On Incidencias.IdAreaCausa = Incidencias_Areas_Causas.Id Left Join#(lf)    Incidencias_Causas On Incidencias.IdCausa = Incidencias_Causas.Id Left Join#(lf)    Incidencias_Locais On Incidencias.IdLocal = Incidencias_Locais.Id Left Join#(lf)    Incidencias_SubAreas On Incidencias.IdSubArea = Incidencias_SubAreas.Id Left Join#(lf)    Incidencias_Tipos On Incidencias_Tipos.Id = Incidencias.Tipo Left Join#(lf)    Tarefas On Incidencias.IdTarefa = Tarefas.Id Left Join#(lf)    Pessoas On Pessoas.utilizador = Incidencias.StampUser Left Join#(lf)    Funcoes_Pessoas On Pessoas.IdFuncaoPessoa = Funcoes_Pessoas.Id"]),
				    #"Duplicated Column" = Table.DuplicateColumn(Origem, "DataInicioExecucao", "DataInicioExecucao - Copy"),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Duplicated Column",{{"DataInicioExecucao - Copy", type date}}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Changed Type1",{{"DataInicioExecucao - Copy", "DataInicioExecucao_Calc"}}),
				    #"Colunas Reordenadas" = Table.ReorderColumns(#"Renamed Columns1",{"ID_Incidencias", "IdSubArea", "IdArea", "IdModulo", "IdProjecto", "Titulo", "Descricao", "DataInicio", "DataInicioExecucao_Calc", "DataFim", "Codigo", "Estado", "DataInicioExecucao", "DataFimExecucao", "Duracao", "DuracaoExecucao", "UnidadeDuracao", "UnidadeDuracaoExecucao", "Interrupcao", "Tipo", "ResolucaoTecnica", "Observacoes", "Resolucao", "SubArea", "Local", "Causas", "TempoMedioResolucao", "Area", "Area_Causas", "IdAreaCausa", "IdCausa"}),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Colunas Reordenadas",{{"Estado", type text}}),
				    #"Coluna Intercalada Inserida-Link" = Table.AddColumn(#"Tipo Alterado1", "Link", each Text.Combine({URL,Text.From([ID_Incidencias], "pt-PT")}), type text),
				    #"Added Custom-Link_Incid_Relacionada" = Table.AddColumn(#"Coluna Intercalada Inserida-Link", "Link_Incid_Relacionada", each Text.Combine({URL,Text.From([IdIncidenciaRelacionada], "pt-PT")})),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom-Link_Incid_Relacionada",{{"Link_Incid_Relacionada", type text}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"Tipo", "Tipo_Cod"}, {"Tipo_Desc", "Tipo"}}),
				    #"Inserted Merged Column" = Table.AddColumn(#"Renamed Columns", "Evento_Producao", each Text.Combine({[Titulo2], " (", Text.From([DataInicio2], "pt-PT"), " - ", Text.From([DataFim2], "pt-PT"), ")"}), type text),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Inserted Merged Column",{{"Interrupcao", Int64.Type}})
				in
