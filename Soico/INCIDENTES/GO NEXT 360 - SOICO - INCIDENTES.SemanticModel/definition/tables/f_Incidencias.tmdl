	column Areas_meios =
			
			
			CONCATENATEX (
			
			CALCULATETABLE (
			
			VALUES ( d_Meios_Incid[Meio_Nome_Areas] )
			
			--,CROSSFILTER ( d_Meios_Incid[IdMeio], f_Meios[Id], BOTH )
			
			),
			
			[Meio_Nome_Areas],
			
			", "
			
			)
		lineageTag: cd4c6731-6ab9-4290-8646-db78f0c0eb78
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Unidade_Pessoas =
			
			
			CONCATENATEX (
			
			CALCULATETABLE (
			
			VALUES ( d_Pessoas_Incid[Pessoa_Unidade] )--,
			
			--CROSSFILTER ( d_Pessoas_Incid[IdPessoa], f_Pessoas[Id], BOTH )
			
			),
			
			[Pessoa_Unidade],
			
			", "
			
			)
		lineageTag: 052380f6-c373-4f5d-802a-8655c0a6a3a1
