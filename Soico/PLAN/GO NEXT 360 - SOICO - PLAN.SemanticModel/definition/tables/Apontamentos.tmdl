ssoa IS NOT NULL#(lf)                                                                                 AND PH.IdPessoa = P.Id#(lf)                                                                                 AND CAST(PH.DataInicioGrupo AS DATE) <= CAST(H.HoraInicio1 AS DATE)#(lf)                                                                                 AND (#(lf)                                                                                                 PH.DataFimGrupo IS NULL#(lf)                                                                                                 OR CAST(PH.DataFimGrupo AS DATE) >= CAST(H.HoraInicio1 AS DATE)#(lf)                                                                                                 )#(lf)                                                                 ORDER BY PH.DataInicioGrupo#(lf)                                                                 ), P.IdGrupoPessoa) IdGrupoPessoa#(lf)                                  ,P.NumFuncionario#(lf)       FROM #H H#(lf)       JOIN Pessoas P  WITH (NOLOCK)  ON H.IdPessoa = P.Id#(lf)       LEFT JOIN Centros_Custo CC  WITH (NOLOCK)  ON P.CodCentroCusto = CC.Codigo#(lf)       WHERE 1 = 1#(lf)                                  AND YEAR(H.[Data]) >= YEAR(GETDATE()) - 3#(lf)                                  AND NOT EXISTS (#(lf)                                                         SELECT 1#(lf)                                                         FROM #TarefasPessoasHorarios TPHC#(lf)                                                         WHERE TPHC.IdHorario = H.Id#(lf)                                                         )#(lf)) Lista#(lf)#(lf)Drop table #TarefasPessoasHorarios#(lf)DROP TABLE #TP#(lf)DROP TABLE #H"]),
