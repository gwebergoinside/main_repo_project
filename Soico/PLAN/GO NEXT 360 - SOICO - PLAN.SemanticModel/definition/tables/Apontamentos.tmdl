	column 'Ativ vs Exec - Fim(M)' = ```
			
			IF.EAGER( Apontamentos[HoraFim] = BLANK()
			    ,ABS( 
			        DATEDIFF( 
					    Apontamentos[ExecucaoHoraFim]
					    ,Apontamentos[ExecucaoHoraInicio]
			        , MINUTE
			        )
			    )
			,IF.EAGER( Apontamentos[ExecucaoHoraFim] = BLANK()
			    ,ABS( 
			        DATEDIFF(
					    Apontamentos[HoraFim]
					    ,Apontamentos[HoraIni]
			        , MINUTE
			        )
			    )
			    ,ABS(
			        DATEDIFF( 
