                                 AND PH.IdGrupoPessoa IS NOT NULL#(lf)                                                                                 AND PH.IdPessoa = tp.IdPessoa#(lf)                                                                                 AND CAST(PH.DataInicioGrupo AS DATE) <= CAST(tp.HoraInicio AS DATE)#(lf)                                                                                 AND (#(lf)                                                                                                 PH.DataFimGrupo IS NULL#(lf)                                                                                                 OR CAST(PH.DataFimGrupo AS DATE) >= CAST(tp.HoraInicio AS DATE)#(lf)                                                                                                 )#(lf)                                                                 ORDER BY PH.DataInicioGrupo#(lf)                                                                 ), P.IdGrupoPessoa) IdGrupoPessoa#(lf)                                  ,P.NumFuncionario#(lf)       FROM #TarefasPessoasHorarios TPH#(lf)       JOIN #TP TP  ON TPH.IdTarefaPessoa = TP.IdTarefaPessoa#(lf)       JOIN Tarefas T  WITH (NOLOCK) ON TP.IdTarefa = T.Id#(lf)       JOIN Pessoas P  WITH (NOLOCK) ON TP.IdPessoa = P.Id#(lf)       JOIN Projectos Proj  WITH (NOLOCK) ON T.IdProjecto = Proj.Id#(lf)       LEFT JOIN Centros_Custo CC  WITH (NOLOCK) ON TP.CodCentroCusto = CC.Codigo#(lf)       LEFT JOIN Pessoas_Valorizacoes_Mensais PVM  WITH (NOLOCK) ON PVM.Ano = YEAR(TP.DataImputacao)#(lf)                                  AND PVM.Mes = MONTH(TP.DataImputacao)#(lf)                                  AND PVM.IdPessoa = TP.IdPessoa#(lf)       LEFT JOIN #H H ON TPH.IdHorario = H.Id#(lf)       UNION ALL#(lf)       SELECT NULL TempoImputado#(lf)                                  ,NULL DataImputacao#(lf)                                  ,NULL AnoImput#(lf)                                  ,NULL MesImput#(lf)      