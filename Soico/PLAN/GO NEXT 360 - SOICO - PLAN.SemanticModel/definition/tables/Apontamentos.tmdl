	column 'Planeado | Hora Fim' = ```
			
			IF( 
			    Apontamentos[HoraFiimPlan3] > Apontamentos[HoraFiimPlan2], Apontamentos[HoraFiimPlan3]
			    ,IF( 
			        Apontamentos[HoraFiimPlan2] > Apontamentos[HoraFiimPlan], Apontamentos[HoraFiimPlan2]
