	column Days =
			
			VAR _TY = FORMAT(Calendario[Date],"dd-mm-yy") & " ("& Calendario[Dia Semana Abre] &")"
			VAR _LY = FORMAT(DATE(YEAR(Calendario[Date]),MONTH(Calendario[Date])-1,DAY(Calendario[Date])),"dd-mm-yy")& " ("& Calendario[Dia Semana DateLastMonth Abre] &")" /*FORMAT(DATE(YEAR(Calendario[Date]),MONTH(Calendario[Date])-1,DAY(Calendario[Date])) + IF(MOD(MONTH(Calendario[Date]),3) = 0, 2,1),"dd-mm-yy") & " ("& Calendario[Dia Semana DateLastMonth Abre] &")"*/
			RETURN
			_TY &"-"& _LY
		lineageTag: 05d818a7-89b3-42cf-bd8a-75238f9e2d1a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

