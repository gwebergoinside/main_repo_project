	partition Capacidade-8646f4ba-6a4f-463e-8955-a5c8f2293479 = m
		mode: import
		queryGroup: Meios
		source =
				let
				    Origem = Sql.Database(Org, BD, [Query="Select#(lf)    mhm.Data,#(lf)    mhm.IdMeio,#(lf)    mhm.Capacidade,#(lf)    mhm.Inatividade#(lf)From#(lf)    Meios_Horas_Mensais As mhm#(lf)Where#(lf)    year(mhm.Data) >= Year(GetDate()) - 3 and Year(mhm.Data) <= Year(GetDate())"])
				in
				    Origem

