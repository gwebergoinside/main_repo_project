	partition Episodios-a99c94cd-5c33-4ab8-ac4b-15795bdffb72 = m
		mode: import
		queryGroup: Projetos
		source = ```
				let
				    Origem = Sql.Database(Org, BD, [Query="Select#(lf)    Projectos.Id,#(lf)    Projectos.titulo,#(lf)    Projectos.abreviatura,#(lf)    Programas.DataPrevistaEntrega,#(lf)    Programas.Evento,#(lf)    Programas.Duracao,#(lf)    Programas.DataEntrega,#(lf)    Programas.ReferenciaPrograma,#(lf)    Programas.SubTitulo,#(lf)    Programas.Observacoes,#(lf)    Programas.DataPrevistaEmissao,#(lf)    Programas.DataEmissao,#(lf)    Programas.Estado,#(lf)    Programas.Sinopse,#(lf)    Count(Documentos.Ficheiro) As Ficheiros,#(lf)    Programas.ID As IDPrograma#(lf)From#(lf)    Projectos Left Join#(lf)    Programas On Programas.IDProjecto = Projectos.Id Left Join#(lf)    Documentos_Entidades On Documentos_Entidades.IdEntidade = Programas.ID#(lf)            And Documentos_Entidades.TipoEntidade = 'Episode' Left Join#(lf)    Documentos On Documentos.Id = Documentos_Entidades.IdDocumento#(lf)Group By#(lf)    Projectos.Id,#(lf)    Projectos.titulo,#(lf)    Projectos.abreviatura,#(lf)    Programas.DataPrevistaEntrega,#(lf)    Programas.Evento,#(lf)    Programas.Duracao,#(lf)    Programas.DataEntrega,#(lf)    Programas.ReferenciaPrograma,#(lf)    Programas.SubTitulo,#(lf)    Programas.Observacoes,#(lf)    Programas.DataPrevistaEmissao,#(lf)    Programas.DataEmissao,#(lf)    Programas.Estado,#(lf)    Programas.Sinopse,#(lf)    Programas.ID"]),
				    #"Added Custom" = Table.AddColumn(Origem, "Documento", each Documentos 
				& "?Id=" & Number.ToText([IDPrograma]) 
				& "&IdEpisodio=" & Number.ToText([IDPrograma]) 
				& "&IdProjecto=" & Number.ToText([Id]))
				in
				    #"Added Custom"
				```

	annotation PBI_QueryRelationships = {"columnCount":16,"keyColumnNames":[],"queryRelationships":[],"columnIdentities":["Section1/Episodios/Origem.{Id,0}","Section1/Episodios/Origem.{titulo,1}","Section1/Episodios/Origem.{abreviatura,2}","Section1/Episodios/Origem.{DataPrevistaEntrega,3}","Section1/Episodios/Origem.{Evento,4}","Section1/Episodios/Origem.{Duracao,5}","Section1/Episodios/Origem.{DataEntrega,6}","Section1/Episodios/Origem.{ReferenciaPrograma,7}","Section1/Episodios/Origem.{SubTitulo,8}","Section1/Episodios/Origem.{Observacoes,9}","Section1/Episodios/Origem.{DataPrevistaEmissao,10}","Section1/Episodios/Origem.{DataEmissao,11}","Section1/Episodios/Origem.{Estado,12}","Section1/Episodios/Origem.{Sinopse,13}","Section1/Episodios/Origem.{Ficheiro,14}","Section1/Episodios/Added Custom.{Documento,15}"],"ColumnCount":16,"KeyColumnNames":[],"ColumnIdentities":["Section1/Episodios/Origem.{Id,0}","Section1/Episodios/Origem.{titulo,1}","Section1/Episodios/Origem.{abreviatura,2}","Section1/Episodios/Origem.{DataPrevistaEntrega,3}","Section1/Episodios/Origem.{Evento,4}","Section1/Episodios/Origem.{Duracao,5}","Section1/Episodios/Origem.{DataEntrega,6}","Section1/Episodios/Origem.{ReferenciaPrograma,7}","Section1/Episodios/Origem.{SubTitulo,8}","Section1/Episodios/Origem.{Observacoes,9}","Section1/Episodios/Origem.{DataPrevistaEmissao,10}","Section1/Episodios/Origem.{DataEmissao,11}","Section1/Episodios/Origem.{Estado,12}","Section1/Episodios/Origem.{Sinopse,13}","Section1/Episodios/Origem.{Ficheiro,14}","Section1/Episodios/Added Custom.{Documento,15}"],"RelationshipInfo":[]}

