table Episodios
	lineageTag: 0b49f951-cb3c-4893-8b48-e72a5574afe7

	measure 'Duração Produção (h)' =
			
			Var __seg = CALCULATE( SUM(Episodios[Duracao]) )*60
			RETURN
			VAR allseconds = __seg
			
			VAR days = INT ( allseconds / 24 / 60 / 60 )
			
			VAR hours =  MOD ( INT ( allseconds / 60 / 60 ), 24 )
			
			VAR minutes = MOD ( INT ( allseconds / 60 ), 60 )
			
			VAR seconds = MOD ( allseconds, 60 )
			
			RETURN
			
			IF( ISBLANK(__seg) , BLANK() ,
			days & "d "
			
			& hours
			
			& "h "
			
			& minutes
			
			& "m "
			)
		lineageTag: 56ed0a0a-10ce-4257-a03e-8c64bb4f9723

