	column 'Código Conta' =
			
			IF(
				ISERROR( VALUE( ExecucaoMensalConta[AccountCode] ) ),
				ExecucaoMensalConta[AccountCode],
				CONCATENATE( VALUE(ExecucaoMensalConta[AccountCode]), "" )
			)
		lineageTag: 0c245289-0792-4f23-bb0f-8a5ef4f8383b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column AGrupado =
			SWITCH( TRUE(),
			ExecucaoMensalConta[AccountGroup1] = "Atividades" , "Estrutural",
			ExecucaoMensalConta[AccountGroup1] = "ESTRUTURAL" , "Estrutural",
			ExecucaoMensalConta[AccountGroup1] = "CUSTO DE PRODUÇÃO" , "Total Despesas Diretas",
			ExecucaoMensalConta[AccountGroup1] = "ARTÍSTICO e EQUIPE PRODUÇÃO" , "Total Despesas Diretas",
			ExecucaoMensalConta[AccountGroup1] = "MERCHANDISING" , "Total Despesas Diretas",
			ExecucaoMensalConta[AccountGroup1] = "Total Despesas Diretas", "Total Despesas Diretas",
			ExecucaoMensalConta[AccountGroup1] = "Despesas Financeiras", "Total Financeiras",
			ExecucaoMensalConta[AccountGroup1] = "ADM DE PRODUÇÃO" , "Total Despesas Diretas",
			ExecucaoMensalConta[AccountGroup1] = BLANK() , "Sem Correspondência",
			ExecucaoMensalConta[AccountGroup1])
		lineageTag: 545a0245-66b0-441a-b2a9-ccedd86a2b85
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

