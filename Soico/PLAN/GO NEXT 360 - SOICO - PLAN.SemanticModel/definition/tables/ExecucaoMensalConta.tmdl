	partition ExecucaoMensalConta-0117d7be-01d6-46dc-8273-9603fa1c9e15 = m
		mode: import
		queryGroup: 'Execução Mensal'
		source =
				let
				    Origem = Sql.Database(Org, BD, [Query="Select#(lf)    ExecucaoMensal.ProjectReference,#(lf)    ExecucaoMensal.ProjectTitle,#(lf)    ExecucaoMensal.Year,#(lf)    ExecucaoMensal.Month,#(lf)    ExecucaoMensal.AccountCode,#(lf)    Sum(ExecucaoMensal.BudgetPurchaseValue) BudgetPurchaseValue,#(lf)    Sum(ExecucaoMensal.BudgetSellValue) BudgetSellValue,#(lf)    Cast(Convert(VARCHAR,ExecucaoMensal.Year) + '-' + Convert(VARCHAR,ExecucaoMensal.Month) + '-' + Convert(VARCHAR,1)#(lf)    As DATETIME) As DATE,#(lf)    Tipos_Projecto.Nome As [Tipo Projeto],#(lf)    Projectos.titulo,#(lf)    ExecucaoMensal.Id,#(lf)    ExecucaoMensal.estado#(lf)From#(lf)    (Select Distinct#(lf)         Year(o.DataExecucaoInicio) Year,#(lf)         Month(o.DataExecucaoInicio) Month,#(lf)         prj.Id ProjectReference,#(lf)         prj.titulo ProjectTitle,#(lf)         G.Id BudgetGroupReference,#(lf)         G.Nome BudgetGroupName,#(lf)         R.Id BudgetRubricReference,#(lf)         R.Nome BudgetRubricName,#(lf)         I.Id BudgetItemReference,#(lf)         I.Nome BudgetItemName,#(lf)         G.Ordem BudgetGroupOrder,#(lf)         I.tipo BudgetItemType,#(lf)         Replace(Str(IsNull(Contas.CodigoConta, ''), 12), Space(1), '0') AccountCode,#(lf)         IsNull(TOI.OrcamentoCompra, 0) BudgetPurchaseValue,#(lf)         IsNull(TOI.OrcamentoVenda, 0) BudgetSellValue,#(lf)         o.Id,#(lf)         o.estado#(lf)     From#(lf)         Orcamento_Items oi Inner Join#(lf)         Orcamentos o On oi.IdOrcamento = o.Id Inner Join#(lf)         Orc_Items As I On I.Id = oi.IdOrcItem Inner Join#(lf)         Orc_Rubricas As R On I.IdOrcRubrica = R.Id Inner Join#(lf)         Orc_Grupos As G On R.IdOrcGrupo = G.Id Inner Join#(lf)         Projectos prj On prj.Id = o.IdProjecto Left Outer Join#(lf)         (Select#(lf)              c.Codigo As CodigoConta,#(lf)              c.Descricao As DescricaoConta,#(lf)              p2.Id IdProjecto#(lf)          From#(lf)              Contas As c Inner Join#(lf)              Orc_Items As I On I.CodConta = c.Codigo Inner Join#(lf)              Orcamento_Items oi On oi.IdOrcItem = I.Id Inner Join#(lf)              Orcamentos o On oi.IdOrcamento = o.Id Inner Join#(lf)              Projectos p2 On p2.Id = o.IdProjecto#(lf)          Group By#(lf)              c.Codigo,#(lf)              c.Descricao,#(lf)              p2.Id) As Contas On Contas.CodigoConta = I.CodConta#(lf)                 And Contas.IdProjecto = prj.Id Left Outer Join#(lf)         (Select#(lf)              vwcip.IdOrcItem,#(lf)              vwcip.DataPedido,#(lf)              IsNull(Sum(IsNull(vwcip.Valor, 0)), 0) As ValorCED,#(lf)              p2.Id IdProjecto#(lf)          From#(lf)              vwComprasItemsProjecto vwcip Inner Join#(lf)              Projectos p2 On p2.Id = vwcip.IdProjecto#(lf)          Where#(lf)              vwcip.estado <> 4#(lf)          Group By#(lf)              vwcip.IdOrcItem,#(lf)              vwcip.DataPedido,#(lf)              p2.Id) As CED On CED.IdOrcItem = I.Id#(lf)                 And CED.IdProjecto = prj.Id#(lf)                 And CED.DataPedido >= o.DataExecucaoInicio#(lf)                 And CED.DataPedido <= o.DataExecucaoFim Left Outer Join#(lf)         (Select#(lf)              o.Id IdOrcamento,#(lf)              oi.IdOrcItem,#(lf)              Cast(IsNull(Sum(IsNull(oi.unidades, 0) * IsNull(oi.Quantidade, 0) * IsNull(oi.PrecoCompraUnidade, 0)),#(lf)              0) As NUMERIC(18,2)) As 'OrcamentoCompra',#(lf)              Cast(IsNull(Sum(IsNull(oi.unidades, 0) * IsNull(oi.Quantidade, 0) * IsNull(oi.PrecoVendaUnidade, 0) * (1 -#(lf)              Coalesce(oi.PrecoVendaDesconto / 100, 0))), 0) As NUMERIC(18,2)) As 'OrcamentoVenda',#(lf)              p2.Id IdProjecto#(lf)          From#(lf)              Orcamento_Items oi Inner Join#(lf)              Orcamentos o On oi.IdOrcamento = o.Id Inner Join#(lf)              Orc_Items As I On I.Id = oi.IdOrcItem Inner Join#(lf)              Orc_Rubricas As R On I.IdOrcRubrica = R.Id Inner Join#(lf)              Projectos p2 On p2.Id = o.IdProjecto#(lf)          Where#(lf)              o.estado In ('A', 'V', 'P', 'T', 'B', 'Q')#(lf)          Group By#(lf)              o.Id,#(lf)              oi.IdOrcItem,#(lf)              p2.Id) As TOI On TOI.IdOrcItem = oi.IdOrcItem#(lf)                 And o.Id = TOI.IdOrcamento#(lf)                 And TOI.IdProjecto = prj.Id Left Outer Join#(lf)         (Select#(lf)              vwcip.IdOrcItem,#(lf)              Sum(IsNull(vwcip.ValorComprometido, 0)) As ComprasComprometido,#(lf)              Sum(IsNull(vwcip.ValorEfectivo, 0)) As ComprasEfectivo,#(lf)              Sum(IsNull(vwcip.Valor, 0)) As ComprasValor,#(lf)              p2.Id IdProjecto#(lf)          From#(lf)              vwComprasItemsProjecto As vwcip Inner Join#(lf)              Projectos p2 On p2.Id = vwcip.IdProjecto#(lf)          Where#(lf)              vwcip.estado <> 4#(lf)          Group By#(lf)              vwcip.IdOrcItem,#(lf)              p2.Id) As TC On TC.IdOrcItem = I.Id#(lf)                 And TC.IdProjecto = prj.Id#(lf)     Where#(lf)         1 = 1 And#(lf)         o.Mensualizado = 1) ExecucaoMensal Full Join#(lf)    Projectos On Projectos.Id = ExecucaoMensal.ProjectReference Inner Join#(lf)    Tipos_Projecto On Projectos.IdTipoProjecto = Tipos_Projecto.Id#(lf)Group By#(lf)    ExecucaoMensal.ProjectReference,#(lf)    ExecucaoMensal.ProjectTitle,#(lf)    ExecucaoMensal.Year,#(lf)    ExecucaoMensal.Month,#(lf)    ExecucaoMensal.AccountCode,#(lf)    Tipos_Projecto.Nome,#(lf)    Projectos.titulo,#(lf)    ExecucaoMensal.Id,#(lf)    ExecucaoMensal.estado"]),
				    Custom1 = Table.AddColumn(Origem, "TotalCosts", each [BudgetPurchaseValue]),
				    Custom2 = Table.AddColumn(Custom1, "AccountGroup1", each null),
				    #"Changed Type" = Table.TransformColumnTypes(Custom2,{{"TotalCosts", type number}})
				in
				    #"Changed Type"

