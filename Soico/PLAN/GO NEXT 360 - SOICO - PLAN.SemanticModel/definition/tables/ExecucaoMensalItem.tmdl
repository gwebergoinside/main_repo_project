 c.Descricao As DescricaoConta,#(lf)              p2.Id IdProjecto#(lf)          From#(lf)              Contas As c Inner Join#(lf)              Orc_Items As I On I.CodConta = c.Codigo Inner Join#(lf)              Orcamento_Items oi On oi.IdOrcItem = I.Id Inner Join#(lf)              Orcamentos o On oi.IdOrcamento = o.Id Inner Join#(lf)              Projectos p2 On p2.Id = o.IdProjecto#(lf)          Group By#(lf)              c.Codigo,#(lf)              c.Descricao,#(lf)              p2.Id) As Contas On Contas.CodigoConta = prjcmp.CodConta#(lf)                 And Contas.IdProjecto = prjcmp.IdProjecto #(lf)#(tab)#(tab)Left Outer Join#(lf)         (Select#(lf)              o.Id IdOrcamento,#(lf)              oi.IdOrcItem,#(lf)              oi.TipoUnidade,#(lf)              IsNull(oi.unidades, 0) Unidades,#(lf)              IsNull(oi.Quantidade, 0) Quantidade,#(lf)              IsNull(oi.PrecoCompraUnidade, 0) PrecoCompraUnidade,#(lf)              IsNull(oi.PrecoVendaUnidade, 0) PrecoVendaUnidade,#(lf)              Cast(IsNull(Sum(IsNull(oi.unidades, 0) * IsNull(oi.Quantidade, 0) * IsNull(oi.PrecoCompraUnidade, 0)),#(lf)              0) As NUMERIC(18,2)) As 'OrcamentoCompra',#(lf)              Cast(IsNull(Sum(IsNull(oi.unidades, 0) * IsNull(oi.Quantidade, 0) * IsNull(oi.PrecoVendaUnidade, 0) * (1 -#(lf)              Coalesce(oi.PrecoVendaDesconto / 100, 0))), 0) As NUMERIC(18,2)) As 'OrcamentoVenda',#(lf)              p2.Id IdProjecto#(lf)          From#(lf)              Orcamento_Items oi Inner Join#(lf)              Orcamentos o On oi.IdOrcamento = o.Id Inner Join#(lf)              Orc_Items As I On I.Id = oi.IdOrcItem Inner Join#(lf)              Orc_Rubricas As R On I.IdOrcRubrica = R.Id Inner Join#(lf)              Projectos p2 On p2.Id = o.IdProjecto#(lf)          Where#(lf)              o.estado In ('A', 'V', 'P', 'T', 'B', 'Q')#(lf)          Group By#(lf)              o.Id,#(lf)              oi.IdOrcItem,#(lf)              oi.TipoUnidade,#(lf)              IsN