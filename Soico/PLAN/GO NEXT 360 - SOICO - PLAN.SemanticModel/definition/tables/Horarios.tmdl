	column Capacidade_Planeamento =
			
			IF.EAGER( Horarios[TrabalhoEfectivo] = TRUE(), Horarios[Diff_1_Min]+Horarios[Diff_2_Min]+Horarios[Diff_3_Min] - Horarios[MinutosPausaNaoIdentificada], BLANK() )
		formatString: 0
		lineageTag: 36e12ae5-8e38-45e0-968e-f9c056e167e0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column TrabalhoEfectivo = LOOKUPVALUE( HorariosRefs[TrabalhoEfectivo], HorariosRefs[IdHorariosRefs], Horarios[IdHorariosRefs] )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 000482eb-19fc-44e0-9fd6-ccb512260fb4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Horarios-1f311d38-9962-4bf9-a50d-b2b6a9e7decc = m
		mode: import
		queryGroup: Pessoas
		source =
				let
				    Source = Sql.Database(Org, BD, [Query="Select#(lf)    h.HoraInicio1,#(lf)    h.HoraFim1,#(lf)    h.HoraInicio2,#(lf)    h.HoraFim2,#(lf)    h.HoraInicio3,#(lf)    h.HoraFim3,#(lf)    h.IdPessoa As IdPessoaHorarios,#(lf)    Centros_Custo.Id,#(lf)    h.Data,#(lf)    Pessoas.HorasDia,#(lf)    Pessoas_Horas_Mensais.Capacidade,#(lf)    Horarios_Refs.Descricao,#(lf)    Horarios_Refs.Id As IdHorariosRefs,#(lf)    Horarios_Refs.TrabalhoEfectivo,#(lf)    DateDiff(minute, aus.DataInicio, aus.DataFim) / 60.0 As Ausencia,#(lf)    Horarios_Refs.Codigo,#(lf)    h.MinutosPausaNaoIdentificada,#(lf)    Abonos_Calculados.quantidade#(lf)From#(lf)    Horarios h Inner Join#(lf)    Pessoas_Valorizacoes_Mensais pvm On pvm.Ano = Year(h.Data)#(lf)            And pvm.Mes = Month(h.Data)#(lf)            And pvm.IdPessoa = h.IdPessoa Inner Join#(lf)    Centros_Custo On Centros_Custo.Id = pvm.IdCentroCusto Inner Join#(lf)    Pessoas On h.IdPessoa = Pessoas.Id Left Join#(lf)    Pessoas_Horas_Mensais On h.Data = Pessoas_Horas_Mensais.Data#(lf)            And h.IdPessoa = Pessoas_Horas_Mensais.IdPessoa Inner Join#(lf)    Horarios_Refs On h.IdHorarioRef = Horarios_Refs.Id Left Join#(lf)    Ausencias aus On aus.IdHorario = h.Id Left Join#(lf)    Abonos_Calculados On Abonos_Calculados.IdHorario = h.Id#(lf)Where#(lf)    pvm.Ano >= Year(GetDate()) - 3"]),
				    #"Added Custom" = Table.AddColumn(Source, "CodDesc", each [Codigo] &" ("&[Descricao] &")"),
				    #"Removed Columns" = Table.RemoveColumns(#"Added Custom",{"TrabalhoEfectivo"})
				in
				    #"Removed Columns"

