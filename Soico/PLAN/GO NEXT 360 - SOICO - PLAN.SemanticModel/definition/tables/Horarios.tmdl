	column 'Planeado | Hora Fim' =
			IF( Horarios[HoraFim3] > Horarios[HoraFim2] , Horarios[HoraFim3],
			                      IF( Horarios[HoraFim2] > Horarios[HoraFim1], Horarios[HoraFim2], Horarios[HoraFim1] ) )
