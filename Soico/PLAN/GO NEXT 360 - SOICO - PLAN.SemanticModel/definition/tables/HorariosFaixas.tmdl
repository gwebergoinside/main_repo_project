	partition HorariosFaixas-f8a4f01f-b55c-4e08-a2a3-d8da4399e6b8 = m
		mode: import
		queryGroup: Pessoas
		source =
				let
				    Source = Sql.Database(Org, BD, [Query="Select#(lf)    Horarios.IdHorarioRef,#(lf)    Horarios.Data,#(lf)    IsNull(Horarios.HoraInicio1, IsNull(Horarios.HoraInicio2, Horarios.HoraInicio3)) HoraInicio,#(lf)    IsNull(Horarios.HoraFim3, IsNull(Horarios.HoraFim2, Horarios.HoraFim1)) HoraFim,#(lf)    Right('0' + Cast(vwFaixasHorarias.Hora % 24 As VARCHAR(2)), 2) + ':00' Faixa,#(lf)    DateAdd(hour, vwFaixasHorarias.Hora % 24, DateAdd(day, vwFaixasHorarias.Hora / 24, Horarios.Data)) InicioFaixa,#(lf)    DateAdd(second, -1, DateAdd(hour, 1, DateAdd(hour, vwFaixasHorarias.Hora % 24, DateAdd(day, vwFaixasHorarias.Hora /#(lf)    24, Horarios.Data)))) FimFaixa,#(lf)    Horarios.IdPessoa,#(lf)    Horarios.IdMeio,#(lf)    Pessoas_Valorizacoes_Mensais.IdCentroCusto,#(lf)    Horarios_Refs.TrabalhoEfectivo#(lf)From#(lf)    Horarios Left Join#(lf)    Pessoas_Valorizacoes_Mensais On Horarios.IdPessoa = Pessoas_Valorizacoes_Mensais.IdPessoa#(lf)            And Year(Horarios.Data) = Pessoas_Valorizacoes_Mensais.Ano#(lf)            And Month(Horarios.Data) = Pessoas_Valorizacoes_Mensais.Mes Join#(lf)    vwFaixasHorarias On vwFaixasHorarias.Hora Between DatePart(hour, IsNull(Horarios.HoraInicio1,#(lf)            IsNull(Horarios.HoraInicio2, Horarios.HoraInicio3))) And Ceiling(DateDiff(minute, Horarios.Data,#(lf)            IsNull(Horarios.HoraFim3, IsNull(Horarios.HoraFim2, Horarios.HoraFim1))) / 60.0) - 1 Inner Join#(lf)    Horarios_Refs On Horarios.IdHorarioRef = Horarios_Refs.Id#(lf)Where#(lf)    ((Horarios.HoraInicio1 Is Not Null And#(lf)            Horarios.HoraFim1 Is Not Null) Or#(lf)        (Horarios.HoraInicio2 Is Not Null And#(lf)            Horarios.HoraFim2 Is Not Null) Or#(lf)        (Horarios.HoraInicio3 Is Not Null And#(lf)            Horarios.HoraFim3 Is Not Null)) And#(lf)    Year(Horarios.Data) >= Year(GetDate()) - 3"])
				in
				    Source

