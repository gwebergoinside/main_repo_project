	column Período =
			
			SWITCH(
			    TRUE()
			    ,HOUR(HorariosFaixas[Horainicio])>=0 && hour(HorariosFaixas[Horainicio])<6,"Madrugada"
			    ,HOUR(HorariosFaixas[Horainicio])>=6 && hour(HorariosFaixas[Horainicio])<12,"Manhã"
			    ,HOUR(HorariosFaixas[Horainicio])>=12 && hour(HorariosFaixas[Horainicio])<18,"Tarde"
			    ,HOUR(HorariosFaixas[Horainicio])>=18 && hour(HorariosFaixas[Horainicio])<24,"Noite"
			)
		lineageTag: 7fda2ae4-1bcc-4db2-8bc5-3d232d005413
		summarizeBy: none

