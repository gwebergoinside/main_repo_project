	partition LancManuais-870323eb-c7eb-49a3-ac71-b5195aeba605 = m
		mode: import
		queryGroup: Lancamentos
		source =
				let
				    Source = Sql.Database(Org, BD, [Query="Select#(lf)    CustosInternosManuais.Id,#(lf)    CustosInternosManuais.IdCentroCustoEmissor As IdCC,#(lf)    CustosInternosManuais.IdProjeto,#(lf)    CustosInternosManuais.Data,#(lf)    CustosInternosManuais.Quantidade,#(lf)    CustosInternosManuais.Valor,#(lf)    'Manual' As Tipo#(lf)From#(lf)    CustosInternosManuais#(lf)Where#(lf)    Year(CustosInternosManuais.Data) >= Year(GetDate()) - 3"])
				in
				    Source

	annotation PBI_ResultType = Exception

