	partition Lancamentos-0c6e86a4-c54a-4a01-a5ee-902217322f5a = calculated
		mode: import
		source = ```
				
				UNION(
				    FILTER( SUMMARIZE(  
				                Tarefas_Pessoas,
				                Tarefas_Pessoas[HoraInicio],
				                Tarefas_Pessoas[IdCC],
				                Tarefas_Pessoas[IdProjeto],
				                Tarefas_Pessoas[TipoActividadeApuradaTarefas],
				                Tarefas_Pessoas[Calculo Cap Ativ],
				                "Quantidade", SUM(Tarefas_Pessoas[TempoImputado]),
				                "Valor", SUM(Tarefas_Pessoas[TempoImputado])*SUM(Tarefas_Pessoas[Tarifa]),
				                "Tipo", "Automático"
				    ), Tarefas_Pessoas[TipoActividadeApuradaTarefas] = 2 || Tarefas_Pessoas[TipoActividadeApuradaTarefas] = 0 ),
				    FILTER( SUMMARIZE(  
				                Meios,
				                Meios[Date],
				                Meios[IdCC],
				                Meios[IdProjeto],
				                Meios[TipoActividadeApurada],
				                Meios[Calculo Cap Ativ],
				                "Quantidade", SUM(Meios[TempoImputado]),
				                "Valor", SUM(Meios[TempoImputado])*SUM(Meios[Tarifa]),
				                "Tipo", "Automático"
				    ), Meios[TipoActividadeApurada] = 1 || Meios[TipoActividadeApurada] = 0 ),
				    SUMMARIZE(  LancManuais,
				                LancManuais[Data],
				                LancManuais[IdCC],
				                LancManuais[IdProjeto],
				                "Atividade", BLANK(),
				                "Calculo Cap Ativ", "LancManual",
				                "Quantidade", SUM(LancManuais[Quantidade]),
				                "Valor", SUM(LancManuais[Valor]),
				                "Tipo", "Manual"
				    )
				)
				```

	annotation PBI_Id = f9d302b9d5d54d94b119b61ded1c4648

