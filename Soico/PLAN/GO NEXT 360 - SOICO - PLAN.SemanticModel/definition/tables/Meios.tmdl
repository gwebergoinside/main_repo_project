	column 'Código Conta' =
			
			IF(
				ISERROR( VALUE( Meios[Codigo] ) ),
				Meios[Codigo],
				CONCATENATE( VALUE(Meios[Codigo]), "" )
			)
		lineageTag: 6f53abc4-7a21-494c-aa01-cce16eca6810
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column NaoConsiderarParaCalculoCapacidadeAtividade
