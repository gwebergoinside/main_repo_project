	column Estados =
			SWITCH( TRUE(),
			Meios[Estado] = "A", "Disponivel",
			Meios[Estado] = "C", "Cancelado",
			Meios[Estado] = "R", "Previsão",
			Meios[Estado] = "L", "Alteração",
			Meios[Estado] = "N", "Novo",
			Meios[Estado] = "P", "Planeamento",
			Meios[Estado] = "Z", "Não Realizado",
			Meios[Estado] = "X", "Cancelado < 48horas" )
		lineageTag: 16950d3d-1991-42f0-aa5c-276b711d6242
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Ativ. Apurada (CC)' = ```
			SWITCH(
			    TRUE(), 
			    Meios[TipoActividadeApurada] = 0, "Nenhuma",
			    Meios[TipoActividadeApurada] = 1, "Meios", 
			    Meios[TipoActividadeApurada] = 2, "Pessoas", 
			    "Não Definido"
			    )
			```
		lineageTag: cea53045-6d8b-4528-959e-9624396a0368
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

