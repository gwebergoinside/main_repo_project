	column ExtraNec =
			
			CALCULATE(
			    SUM( 'NecessidadesGantt Extra'[Index] )
			    ,FILTER( ALL('NecessidadesGantt Extra'), Meios[keyAtividade] ='NecessidadesGantt Extra'[keyAtividade] )
			    ,'NecessidadesGantt Extra'[Tipo] = "Meios"
			)
		lineageTag: 7fd120b8-ff53-4dbc-bfcc-8b739f2b76c3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

