		sourceColumn: NaoConsiderarParaCalculoCapacidadeAtividade

		annotation SummarizationSetBy = Automatic

	column 'Calculo Cap Ativ' = ```
			
			SWITCH(TRUE, 
			    Meios[NaoConsiderarParaCalculoCapacidadeAtividade] = BLANK(), "Ativo",
			    Meios[NaoConsiderarParaCalculoCapacidadeAtividade] = FALSE(), "Ativo",
			    "Desativo"
			)
			```
