	partition Meios-e63535be-923e-4035-87f4-91a114bcb094 = m
		mode: import
		queryGroup: Meios
		source =
				let
				    Origem = Sql.Database(Org, BD, [Query="With#(lf)    me As (#(lf)     Select#(lf)         am.Nome As [Areas Nome],#(lf)         m.Nome,#(lf)         tm.DataImputacao,#(lf)         tm.TempoImputado As TempoImputado,#(lf)         p.titulo As [Projectos Titulo],#(lf)         m.Id,#(lf)         tm.Id As IdTarefaMeios,#(lf)         Year(tm.DataImputacao) As AnoDataImputacao,#(lf)         Month(tm.DataImputacao) As MesDataImputacao,#(lf)         m.activo,#(lf)         tm.HoraInicio,#(lf)         cc.Nome As [Nome Centro Custo],#(lf)         cc.TipoActividadeApurada,#(lf)         Year(tm.HoraInicio) As anoInicio,#(lf)         Month(tm.HoraInicio) As mesInicio,#(lf)         tm.IdMeio As IdTarefas_Meios,#(lf)         p.IdTipoProjecto,#(lf)         p.Id As IdProjeto,#(lf)         tm.IdAreaTipoTarefa,#(lf)         cc.Id As IdCC,#(lf)         t.Estado,#(lf)         cc.Codigo,#(lf)         DateFromParts(Year(tm.HoraInicio), Month(tm.HoraInicio), Day(tm.HoraInicio)) Date,#(lf)         DateFromParts(Year(tm.HoraInicio), Month(tm.HoraInicio), 1) As [Start of Month],#(lf)         mvm.NaoConsiderarParaCalculoCapacidadeAtividade,#(lf)         tm.HoraFim,#(lf)         Tipos_Meio.Nome As Nome1,#(lf)         Actividades_Meios.Nome As Nome2#(lf)     From#(lf)         Meios m Inner Join#(lf)         Tarefas_Meios tm On tm.IdMeio = m.Id Inner Join#(lf)         Areas_Meios am On m.IdAreaMeio = am.Id Inner Join#(lf)         Tarefas t On tm.IdTarefa = t.Id Inner Join#(lf)         Projectos p On t.IdProjecto = p.Id Left Join#(lf)         Centros_Custo cc On cc.Codigo = tm.CodCentroCusto Left Join#(lf)         Meios_Valorizacoes_Mensais mvm On mvm.Ano = Year(tm.DataImputacao)#(lf)                 And mvm.Mes = Month(tm.DataImputacao)#(lf)                 And mvm.IdMeio = tm.IdMeio Left Join#(lf)         Tipos_Meio On m.IdTipoMeio = Tipos_Meio.Id Left Join#(lf)         Actividades_Meios On m.IdActividadeMeio = Actividades_Meios.Id#(lf)    )#(lf)Select#(lf)    mhm.Capacidade,#(lf)    me.Id,#(lf)    me.[Areas Nome],#(lf)    me.Nome,#(lf)    me.TempoImputado As TempoImputado,#(lf)    me.[Projectos Titulo],#(lf)    me.AnoDataImputacao,#(lf)    me.MesDataImputacao,#(lf)    me.activo,#(lf)    me.HoraInicio,#(lf)    me.[Nome Centro Custo],#(lf)    me.TipoActividadeApurada,#(lf)    me.anoInicio,#(lf)    me.mesInicio,#(lf)    me.IdTarefas_Meios,#(lf)    me.DataImputacao,#(lf)    me.IdTarefaMeios,#(lf)    me.IdTipoProjecto,#(lf)    me.IdProjeto,#(lf)    me.IdAreaTipoTarefa,#(lf)    me.IdCC,#(lf)    me.Estado,#(lf)    me.Codigo,#(lf)    me.NaoConsiderarParaCalculoCapacidadeAtividade,#(lf)    me.Date,#(lf)    me.[Start of Month],#(lf)    me.HoraFim,#(lf)    me.Nome1 As Tipo,#(lf)    me.Nome2 As Atividade#(lf)From#(lf)    Meios_Horas_Mensais mhm Right Join#(lf)    me On mhm.Data = me.DataImputacao#(lf)            And mhm.IdMeio = me.Id#(lf)Where#(lf)    me.anoInicio >= Year(GetDate()) - 3#(lf)Group By#(lf)    mhm.Capacidade,#(lf)    me.Id,#(lf)    me.[Areas Nome],#(lf)    me.Nome,#(lf)    me.TempoImputado,#(lf)    me.[Projectos Titulo],#(lf)    me.AnoDataImputacao,#(lf)    me.MesDataImputacao,#(lf)    me.activo,#(lf)    me.HoraInicio,#(lf)    me.[Nome Centro Custo],#(lf)    me.TipoActividadeApurada,#(lf)    me.anoInicio,#(lf)    me.mesInicio,#(lf)    me.IdTarefas_Meios,#(lf)    me.DataImputacao,#(lf)    me.IdTarefaMeios,#(lf)    me.IdTipoProjecto,#(lf)    me.IdProjeto,#(lf)    me.IdAreaTipoTarefa,#(lf)    me.IdCC,#(lf)    me.Estado,#(lf)    me.Codigo,#(lf)    me.NaoConsiderarParaCalculoCapacidadeAtividade,#(lf)    me.Date,#(lf)    me.[Start of Month],#(lf)    me.HoraFim,#(lf)    me.Nome1,#(lf)    me.Nome2"]),
				    #"Merged Queries" = Table.NestedJoin(Origem, {"Start of Month", "IdCC"}, Tarifa, {"Mes", "IdCentroCusto"}, "Tarifa", JoinKind.LeftOuter),
				    #"Expanded Tarifa1" = Table.ExpandTableColumn(#"Merged Queries", "Tarifa", {"TarifaUnitaria"}, {"Tarifa.TarifaUnitaria"}),
