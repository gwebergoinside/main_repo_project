	partition MeiosHoras-2124a920-e175-4773-adf8-aab7a797cd38 = m
		mode: import
		queryGroup: Meios
		source =
				let
				    Origem = Sql.Database(Org, BD, [Query="Select#(lf)    mhm.Id,#(lf)    mhm.Data,#(lf)    mhm.IdMeio,#(lf)    mhm.Capacidade,#(lf)    mhm.Inatividade,#(lf)    mvm.IdCentroCusto,#(lf)    mvm.IdActividadeMeio,#(lf)    mvm.ValorHora,#(lf)    mvm.NaoConsiderarParaCalculoCapacidadeAtividade,#(lf)    Centros_Custo.TipoActividadeApurada,#(lf)    Centros_Custo.Nome As [Nome Centro Custo]#(lf)From#(lf)    Meios_Horas_Mensais As mhm Join#(lf)    Meios_Valorizacoes_Mensais mvm On mhm.IdMeio = mvm.IdMeio#(lf)            And Month(mhm.Data) = mvm.Mes#(lf)            And Year(mhm.Data) = mvm.Ano Inner Join#(lf)    Centros_Custo On mvm.IdCentroCusto = Centros_Custo.Id#(lf)Where#(lf)    mvm.Ano >= Year(GetDate()) - 3"])
				in
				    Origem

	annotation PBI_QueryRelationships = {"columnCount":11,"keyColumnNames":[],"queryRelationships":[],"columnIdentities":["Section1/MeiosHoras/Origem.{Id,0}","Section1/MeiosHoras/Origem.{Data,1}","Section1/MeiosHoras/Origem.{IdMeio,2}","Section1/MeiosHoras/Origem.{Capacidade,3}","Section1/MeiosHoras/Origem.{Inatividade,4}","Section1/MeiosHoras/Origem.{IdCentroCusto,5}","Section1/MeiosHoras/Origem.{IdActividadeMeio,6}","Section1/MeiosHoras/Origem.{ValorHora,7}","Section1/MeiosHoras/Origem.{NaoConsiderarParaCalculoCapacidadeAtividade,8}","Section1/MeiosHoras/Origem.{TipoActividadeApurada,9}","Section1/MeiosHoras/Origem.{Nome Centro Custo,10}"],"ColumnCount":11,"KeyColumnNames":[],"ColumnIdentities":["Section1/MeiosHoras/Origem.{Id,0}","Section1/MeiosHoras/Origem.{Data,1}","Section1/MeiosHoras/Origem.{IdMeio,2}","Section1/MeiosHoras/Origem.{Capacidade,3}","Section1/MeiosHoras/Origem.{Inatividade,4}","Section1/MeiosHoras/Origem.{IdCentroCusto,5}","Section1/MeiosHoras/Origem.{IdActividadeMeio,6}","Section1/MeiosHoras/Origem.{ValorHora,7}","Section1/MeiosHoras/Origem.{NaoConsiderarParaCalculoCapacidadeAtividade,8}","Section1/MeiosHoras/Origem.{TipoActividadeApurada,9}","Section1/MeiosHoras/Origem.{Nome Centro Custo,10}"],"RelationshipInfo":[]}

