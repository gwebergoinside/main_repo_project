		summarizeBy: sum
		sourceColumn: QuantidadeDias

		annotation SummarizationSetBy = Automatic

	column QTDDiasSemana =
			
			var __seg = IF( [Segunda] = "true" , 1, BLANK() )
			var __ter = IF( [Terca] = "true" , 1, BLANK() )
			var __qua = IF( [Quarta] = "true", 1, BLANK() )
			var __qui = IF( [Quinta] = "true" , 1, BLANK() )
			var __sex = IF( [Sexta] = "true" , 1, BLANK() )
			var __sab = IF( [Sabado] = "true" , 1, BLANK() )
			var __dom = IF( [Domingo] = "true", 1, BLANK() )
			
			Return
			__seg+__ter+__qua+__qui+__sex+__sab+__dom
		formatString: 0
		lineageTag: b221ae79-b875-4a29-a085-486aedc4d9f4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

