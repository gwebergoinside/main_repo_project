	column Days =
			--COMBINEVALUES(", ",[Segunda],[Terca],[Quarta],[Quinta],[Sexta],[Sabado],[Domingo])
			var __seg = IF( [Segunda] = "true" , "Seg", BLANK() )
			var __ter = IF( [Terca] = "true" , "Ter", BLANK() )
			var __qua = IF( [Quarta] = "true", "Qua", BLANK() )
			var __qui = IF( [Quinta] = "true" , "Qui", BLANK() )
			var __sex = IF( [Sexta] = "true" , "Sext", BLANK() )
			var __sab = IF( [Sabado] = "true" , "Sab", BLANK() )
			var __dom = IF( [Domingo] = "true", "Dom", BLANK() )
			
			Return
			 COMBINEVALUES ( " ", __seg,__ter,__qua,__qui,__sex,__sab,__dom)
		lineageTag: b0e2f6a1-c19b-4fc0-81b4-c4da8ca4be70
		summarizeBy: none

