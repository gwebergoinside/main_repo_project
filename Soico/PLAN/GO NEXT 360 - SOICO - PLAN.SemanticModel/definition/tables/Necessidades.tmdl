		annotation SummarizationSetBy = Automatic

	column 'Tipo Calculo' = ```
			
			SWITCH(
			    TRUE()
			    , Necessidades[TipoCalculo] = 0, "Diário" 
			    , Necessidades[TipoCalculo] = 1, "Semanal" 
			    , Necessidades[TipoCalculo] = 2, "Quinzenal"
			    , Necessidades[TipoCalculo] = 3, "Mensal"
			)
			```
		lineageTag: e79da214-7000-445a-a4a3-6dae230ea423
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column QuantidadeDias
		dataType: int64
