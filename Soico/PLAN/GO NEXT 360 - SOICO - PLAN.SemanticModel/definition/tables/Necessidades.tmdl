	partition Necessidades-774e70a0-9930-4506-85b0-8f68927013d4 = m
		mode: import
		queryGroup: Necessidades
		source =
				let
				    Origem = Sql.Database(Org, BD, [Query="Select#(lf)    tt.Id,#(lf)    tt.Nome,#(lf)    'Meios' As Tipo,#(lf)    tt.DataInicio,#(lf)    tt.DataFim,#(lf)    tt.IdSegmento,#(lf)    s.Nome As NomeEtapa,#(lf)    am.Id As IdActividade,#(lf)    am.Nome As NomeActividade,#(lf)    ttnm.Quantidade,#(lf)    Cast((Case#(lf)        When ttnm.Duracao Is Not Null#(lf)        Then ttnm.Duracao#(lf)        Else DateDiff(SECOND, ttnm.HoraInicio, ttnm.HoraFim)#(lf)    End) / 3600.0 As DECIMAL(18,2)) As DuracaoDia,#(lf)    ttnm.IdCentroCusto,#(lf)    ttnm.Id As IdNecessidade,#(lf)    'Meios' As Funcao,#(lf)    Cast(Case#(lf)        When ttnm.DiasSemana & Power(2, 0) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Segunda,#(lf)    Cast(Case#(lf)        When ttnm.DiasSemana & Power(2, 1) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Terca,#(lf)    Cast(Case#(lf)        When ttnm.DiasSemana & Power(2, 2) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Quarta,#(lf)    Cast(Case#(lf)        When ttnm.DiasSemana & Power(2, 3) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Quinta,#(lf)    Cast(Case#(lf)        When ttnm.DiasSemana & Power(2, 4) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Sexta,#(lf)    Cast(Case#(lf)        When ttnm.DiasSemana & Power(2, 5) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Sabado,#(lf)    Cast(Case#(lf)        When ttnm.DiasSemana & Power(2, 6) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Domingo,#(lf)    tt.IdProjecto,#(lf)    p.IdTipoProjecto,#(lf)    p.IdTipoPrograma,#(lf)    p.titulo As Projeto,#(lf)    tt.TipoCalculo,#(lf)    ((Select Sum(x.contrib) From (Select Case When (ttnm.DiasSemana & Power(2, wd.n)) <> 0 And DateAdd(DAY, (wd.n - DateDiff(DAY, 0, tt.DataInicio) % 7 + 7) % 7, tt.DataInicio) <= tt.DataFim Then (DateDiff(DAY, DateAdd(DAY, (wd.n - DateDiff(DAY, 0, tt.DataInicio) % 7 + 7) % 7, tt.DataInicio), tt.DataFim) / 7) + 1 Else 0 End As contrib From (Values (0),(1),(2),(3),(4),(5),(6)) As wd(n)) As x) - (Select Count(Distinct e.DataExcluida) From Templates_Necessidades_DatasExcluidas e Where e.IdTemplateNecessidades = tt.Id And e.DataExcluida Between tt.DataInicio And tt.DataFim And (ttnm.DiasSemana & Power(2, DateDiff(DAY, 0, e.DataExcluida) % 7)) <> 0)) QuantidadeDias,#(lf)    tp.Nome As TipoEvProd,#(lf)    att.Nome As TipoTarefa,#(lf)    Meios.Id As IdMeio,#(lf)    '' As IdPessoa,#(lf)#(tab)Case#(lf)        When tt.Ativo = 1#(lf)#(tab)#(tab)Then 'Ativo'#(lf)        Else 'Inativo'#(lf)    End As [Status Template],#(lf)#(tab)Case#(lf)        When ttnm.Ativo = 1#(lf)#(tab)#(tab)Then 'Ativo'#(lf)        Else 'Inativo'#(lf)    End As [Status Nec]#(lf)From#(lf)    Templates_Tarefas tt  Join#(lf)    Templates_Tarefas_Necessidades_Meios ttnm On ttnm.IdTemplate = tt.Id Join#(lf)    Projectos p  On tt.IdProjecto = p.Id Left Join#(lf)    Tipos_Tarefas tp  On tt.IdTipoEventoProducao = tp.Id Left Join#(lf)    Segmentos s  On tt.IdSegmento = s.Id Left Join#(lf)    Areas_Tipo_Tarefas att On ttnm.IdAreaTipoTarefa = att.Id Left Join#(lf)    Actividades_Meios am  On ttnm.IdActividadeMeio = am.Id Left Join#(lf)    Meios On ttnm.IdMeio = Meios.Id#(lf)#(lf)Union All#(lf)Select#(lf)    tt.Id,#(lf)    tt.Nome,#(lf)    'RH' As Tipo,#(lf)    tt.DataInicio,#(lf)    tt.DataFim,#(lf)    tt.IdSegmento,#(lf)    s.Nome As NomeEtapa,#(lf)    ap.Id As IdActividade,#(lf)    ap.Nome As NomeActividade,#(lf)    ttnp.Quantidade,#(lf)    Cast((Case#(lf)        When ttnp.Duracao Is Not Null#(lf)        Then ttnp.Duracao#(lf)        Else DateDiff(SECOND, ttnp.HoraInicio, ttnp.HoraFim)#(lf)    End) / 3600.0 As DECIMAL(18,2)) As DuracaoDia,#(lf)    ttnp.IdCentroCusto,#(lf)    ttnp.Id As IdNecessidade,#(lf)    'Pessoas' As Funcao,#(lf)    Cast(Case#(lf)        When ttnp.DiasSemana & Power(2, 0) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Segunda,#(lf)    Cast(Case#(lf)        When ttnp.DiasSemana & Power(2, 1) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Terca,#(lf)    Cast(Case#(lf)        When ttnp.DiasSemana & Power(2, 2) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Quarta,#(lf)    Cast(Case#(lf)        When ttnp.DiasSemana & Power(2, 3) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Quinta,#(lf)    Cast(Case#(lf)        When ttnp.DiasSemana & Power(2, 4) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Sexta,#(lf)    Cast(Case#(lf)        When ttnp.DiasSemana & Power(2, 5) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Sabado,#(lf)    Cast(Case#(lf)        When ttnp.DiasSemana & Power(2, 6) = 0#(lf)        Then 0#(lf)        Else 1#(lf)    End As BIT) Domingo,#(lf)    tt.IdProjecto,#(lf)    p.IdTipoProjecto,#(lf)    p.IdTipoPrograma,#(lf)    p.titulo As Projeto,#(lf)    tt.TipoCalculo,#(lf)    ((Select Sum(x.contrib) From (Select Case When (ttnp.DiasSemana & Power(2, wd.n)) <> 0 And DateAdd(DAY, (wd.n - DateDiff(DAY, 0, tt.DataInicio) % 7 + 7) % 7, tt.DataInicio) <= tt.DataFim Then (DateDiff(DAY, DateAdd(DAY, (wd.n - DateDiff(DAY, 0, tt.DataInicio) % 7 + 7) % 7, tt.DataInicio), tt.DataFim) / 7) + 1 Else 0 End As contrib From (Values (0),(1),(2),(3),(4),(5),(6)) As wd(n)) As x) - (Select Count(Distinct e.DataExcluida) From Templates_Necessidades_DatasExcluidas e Where e.IdTemplateNecessidades = tt.Id And e.DataExcluida Between tt.DataInicio And tt.DataFim And (ttnp.DiasSemana & Power(2, DateDiff(DAY, 0, e.DataExcluida) % 7)) <> 0)) QuantidadeDias,#(lf)    tp.Nome As TipoEvProd,#(lf)    'RH' As TipoTarefa,#(lf)    Pessoas.Id As IdPessoa,#(lf)    '' As idMeio,#(lf)#(tab)Case#(lf)        When tt.Ativo = 1#(lf)#(tab)#(tab)Then 'Ativo'#(lf)        Else 'Inativo'#(lf)    End As [Status Template],#(lf)#(tab)Case#(lf)        When ttnp.Ativo = 1#(lf)#(tab)#(tab)Then 'Ativo'#(lf)        Else 'Inativo'#(lf)    End As [Status Nec]#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  #(lf)From#(lf)    Templates_Tarefas tt Join#(lf)    Templates_Tarefas_Necessidades_Pessoas ttnp On ttnp.IdTemplate = tt.Id Join#(lf)    Projectos p On tt.IdProjecto = p.Id Left Join#(lf)    Tipos_Tarefas tp On tt.IdTipoEventoProducao = tp.Id Left Join#(lf)    Segmentos s On tt.IdSegmento = s.Id Left Join#(lf)    Actividades_Pessoas ap On ttnp.IdActividadePessoa = ap.Id Left Join#(lf)    Pessoas On ttnp.IdPessoa = Pessoas.Id"]),
				    Custom1 = Table.TransformColumnTypes(Origem,{{"Segunda", type text}, {"Terca", type text}, {"Quarta", type text}, {"Quinta", type text}, {"Sexta", type text}, {"Sabado", type text}, {"Domingo", type text}}),
