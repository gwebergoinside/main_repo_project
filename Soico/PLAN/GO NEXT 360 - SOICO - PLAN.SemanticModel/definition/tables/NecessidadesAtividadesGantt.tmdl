	partition NecessidadesAtividadesGantt-70362e5f-b282-416e-8dee-5f65505ae7ee = calculated
		mode: import
		source = ```
				
				    VAR _P =
				        SELECTCOLUMNS(
				            Tarefas_Pessoas,
				            "IDProjeto", Tarefas_Pessoas[IdProjeto],
				            "IDCC", Tarefas_Pessoas[IdCC],
				            "Data", Tarefas_Pessoas[HoraInicio],
				            "Tempo", SUM(Tarefas_Pessoas[TempoImputado])
				        )
				    VAR _M =
				        SELECTCOLUMNS(
				            Meios,
				            "IDProjeto", Meios[IdProjeto],
				            "IDCC", Meios[IdCC],
				            "Data", Meios[Date],
				            "Tempo", SUM(Meios[TempoImputado])
				        )   
				    VAR Result = UNION(_P,_M)
				    RETURN
				    SUMMARIZE(Result, [IDProjeto], [IDCC], [Data], "Value", IF( COUNTX(Result, [Tempo]) > 0, 1 , BLANK() ) )
				```

	annotation PBI_Id = 06b43cf13e8b47a98d588fbfad19dfb4

