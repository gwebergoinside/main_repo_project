	partition 'NecessidadesGantt Extra-9c287f7f-d527-433a-a2ab-ac33bf96e9db' = calculated
		mode: import
		source = ```
				
				VAR _1 = SELECTCOLUMNS(
				    GENERATE(
				            'Necessidades',
				            FILTER(
				                CALENDAR(MIN('Necessidades'[DataInicio]),MAX('Necessidades'[DataFim]))
				                ,[Date]>=[DataInicio] && [Date] <= IF(NOT IsBlank([DataFim]),[DataFim],MAX('Necessidades'[DataFim])
				                )
				            )
				       )
				       ,"Index", Necessidades[Index]
				       ,"Datas", [Date]
				       ,"Mes", MONTH([Date])
				       ,"WeekDay", WEEKDAY( [Date] )
				       ,"Key", Necessidades[Index]&"-"&WEEKDAY( [Date] )
				       ,"DataInicio", [DataInicio]
				       ,"DataFim", [DataFim]
				       ,"DuracaoDia", [DuracaoDia] 
				       --,"Estado", [Estado],
				       ,"IdCentroCusto",[IdCentroCusto]
				       ,"IdProjeto", [IdProjecto]
				       ,"Projeto", [Projeto]
				       ,"Tipo Calculo", [Tipo Calculo]
				       ,"NomeActividade", [NomeActividade]
				       ,"Nome", [Nome]
				       ,"NomeEtapa", [NomeEtapa]
				       ,"Quantidade", [Quantidade]
				       ,"Tipo", [Tipo]
				       ,"Funcao", [Funcao]
				       --,"IdGrupoPessoa", [IdGrupoPessoa]
				       ,"IdNecessidade", [IdNecessidade]
				       ,"IdTipoPrograma", [IdTipoPrograma]
				       ,"Id", [Id]
				       ,"Days", [Days]
				       ,"Days Nec", [Days]& " (ID: "&Necessidades[IdNecessidade]&" "& Necessidades[TipoEvProd] &""&")"
				       ,"QuantidadeDias", [QuantidadeDias]
				       ,"QTDDiasSemana", [QTDDiasSemana]
				       ,"Tipo Ev. Prod.", [TipoEvProd]
				       ,"Tarefa", [TipoTarefa]
				       ,"IdPessoa", [IdPessoa]
				       ,"IDMeio", [IdMeio]
				       ,"Rows", 1
				       ,"TipoNec", "Necessidades"
				       ,"Status Nec", [Status Nec]
				       ,"Status Template", [Status Template]
				    )
				VAR _2 = SELECTCOLUMNS( 
				            'NecessidadesGanttUnpivot', "Key", FORMAT([Key],"String"), "Valida", NecessidadesGanttUnpivot[Value] )
				Var _3 = NATURALINNERJOIN(_1,_2)
				Return
				_3
				```

	annotation PBI_Id = d570f7f3df1f4b8e84d43af4733b62de

