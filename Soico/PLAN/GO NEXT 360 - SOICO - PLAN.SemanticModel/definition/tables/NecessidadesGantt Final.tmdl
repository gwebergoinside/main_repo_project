	partition 'NecessidadesGantt Final-a36bc1b7-ecf7-44dd-8fe6-253412eb1c17' = calculated
		mode: import
		source = ```
				
				VAR _1 = SELECTCOLUMNS(
				    'NecessidadesGantt Extra'
				       ,"Index", [Index]
				       ,"Datas", [Datas]
				       ,"Mes", [Mes]
				       ,"WeekDay", [WeekDay]
				       ,"Key", [Key]
				       ,"DataInicio", [DataInicio]
				       ,"DataFim", [DataFim]
				       ,"DuracaoDia", [DuracaoDia] 
				       ,"IdCentroCusto",[IdCentroCusto]
				       ,"IdProjeto", [IdProjeto]
				       ,"Projeto", [Projeto]
				       ,"Tipo Calculo", [Tipo Calculo]
				       ,"NomeActividade", [NomeActividade]
				       ,"Nome", [Nome]
				       ,"NomeEtapa", [NomeEtapa]
				       ,"Quantidade", [Quantidade]
				       ,"Tipo", [Tipo]
				       ,"Funcao", [Funcao]
				       ,"IdNecessidade", [IdNecessidade]
				       ,"IdTipoPrograma", [IdTipoPrograma]
				       ,"Id", [Id]
				       ,"Days", [Days]
				       ,"Days Nec", [Days Nec]
				       ,"QuantidadeDias", [QuantidadeDias]
				       ,"QTDDiasSemana", [QTDDiasSemana]
				       ,"Tipo Ev. Prod.", [Tipo Ev. Prod.]
				       ,"Tarefa", [Tarefa]
				       ,"IdPessoa", [IdPessoa]
				       ,"IDMeio", [IdMeio]
				       ,"Rows", [Rows]
				       ,"TipoNec", [TipoNec]
				       ,"Valida", [Valida]
				       ,"Status Nec", [Status Nec]
				       ,"Status Template", [Status Template]
				    )
				VAR _11 = SELECTCOLUMNS(
				    FILTER( Tarefas_Pessoas, ISBLANK( Tarefas_Pessoas[ExtraNec] ) )
				       ,"Index", BLANK()
				       ,"Datas", [HoraInicio]
				       ,"Mes", MONTH([HoraInicio])
				       ,"WeekDay", WEEKDAY( [HoraInicio] )
				       ,"Key", BLANK()
				       ,"DataInicio", [HoraInicio]
				       ,"DataFim", [HoraFiimPlan]
				       ,"DuracaoDia", BLANK()
				       ,"IdCentroCusto",[IdCC]
				       ,"IdProjeto", [IdProjeto]
				       ,"Projeto", [Projeto]
				       ,"Tipo Calculo", BLANK()
				       ,"NomeActividade", BLANK()
				       ,"Nome", BLANK()
				       ,"NomeEtapa", BLANK()
				       ,"Quantidade", [TempoImputado]
				       ,"Tipo", BLANK()
				       ,"Funcao", "RH"
				       ,"IdNecessidade", BLANK()
				       ,"IdTipoPrograma", BLANK()
				       ,"Id", BLANK()
				       ,"Days", BLANK()
				       ,"Days Nec", BLANK()
				       ,"QuantidadeDias", BLANK()
				       ,"QTDDiasSemana", BLANK()
				       ,"Tipo Ev. Prod.", BLANK()
				       ,"Tarefa", BLANK()
				       ,"IdPessoa", [IdPessoa]
				       ,"IDMeio", BLANK()
				       ,"Rows", 1
				       ,"TipoNec", "Extra Necessidades"
				       ,"Valida", BLANK()
				       ,"Status Nec", "Ativo"
				       ,"Status Template", "Ativo"
				
				)
				VAR _12 = SELECTCOLUMNS(
				    FILTER( Meios, ISBLANK( Meios[ExtraNec] ) )
				       ,"Index", BLANK()
				       ,"Datas", [Date]
				       ,"Mes", MONTH([Date])
				       ,"WeekDay", WEEKDAY( [Date] )
				       ,"Key", BLANK()
				       ,"DataInicio", [HoraInicio]
				       ,"DataFim", [HoraFim]
				       ,"DuracaoDia", BLANK()
				       ,"IdCentroCusto",[IdCC]
				       ,"IdProjeto", [IdProjeto]
				       ,"Projeto", [Projectos Titulo]
				       ,"Tipo Calculo", BLANK()
				       ,"NomeActividade", BLANK()
				       ,"Nome", BLANK()
				       ,"NomeEtapa", BLANK()
				       ,"Quantidade", [TempoImputado]
				       ,"Tipo", BLANK()
				       ,"Funcao", "Meios"
				       ,"IdNecessidade", BLANK()
				       ,"IdTipoPrograma", BLANK()
				       ,"Id", BLANK()
				       ,"Days", BLANK()
				       ,"Days Nec", BLANK()
				       ,"QuantidadeDias", BLANK()
				       ,"QTDDiasSemana", BLANK()
				       ,"Tipo Ev. Prod.", BLANK()
				       ,"Tarefa", BLANK()
				       ,"IdPessoa", BLANK()
				       ,"IDMeio", [Id]
				       ,"Rows", 1
				       ,"TipoNec", "Extra Necessidades"
				       ,"Valida", BLANK()
				       ,"Status Nec", "Ativo"
				       ,"Status Template", "Ativo"
				)
				Return
				UNION(
				    _1,
				    _11,
				    _12
				)
				```

