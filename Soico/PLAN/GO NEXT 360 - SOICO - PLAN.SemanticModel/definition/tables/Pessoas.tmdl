	column IdUni =
			
			LOOKUPVALUE(
			    GrupoUnidade[IdUnidade]
			    ,GrupoUnidade[IdGrupo]
			    ,Pessoas[IdGrupo]
			)
		formatString: 0
		lineageTag: a03210ef-9b8f-40fa-a37e-9083287b147d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Pessoas-f95b4e83-18e0-45f0-8a80-9c159aed89a9 = m
		mode: import
		queryGroup: Pessoas
		source =
				let
				    Source = Sql.Database(Org, BD, [Query="Select#(lf)    Pessoas.Id,#(lf)    Pessoas.nome,#(lf)    Pessoas.activo,#(lf)    Pessoas.tipo,#(lf)    Pessoas.DataNascimento,#(lf)    Pessoas.DataAdmissao,#(lf)    Pessoas.HorasDia,#(lf)    Pessoas.sexo,#(lf)    Grupos_Pessoas.Id As IdGrupo,#(lf)    Grupos_Pessoas.Nome As Grupo,#(lf)    Unidades_Pessoas.Nome As Unidade,#(lf)    Documentos.Ficheiro,#(lf)    Actividades_Pessoas.Nome As Atividade,#(lf)    Funcoes_Pessoas.Id As IdFuncao,#(lf)    Funcoes_Pessoas.Nome As Funcao#(lf)From#(lf)    Pessoas Left Join#(lf)    Documentos_Entidades On Documentos_Entidades.IdEntidade = Pessoas.Id#(lf)            And Documentos_Entidades.TipoEntidade = 'PersonPhoto' Left Join#(lf)    Documentos On Documentos.Id = Documentos_Entidades.IdDocumento Left Join#(lf)    Grupos_Pessoas On Pessoas.IdGrupoPessoa = Grupos_Pessoas.Id Left Join#(lf)    Unidades_Pessoas On Grupos_Pessoas.IdUnidadePessoa = Unidades_Pessoas.Id Inner Join#(lf)    Actividades_Pessoas On Pessoas.IdActividadePessoa = Actividades_Pessoas.Id Inner Join#(lf)    Funcoes_Pessoas On Pessoas.IdFuncaoPessoa = Funcoes_Pessoas.Id"]),
				    #"Added Custom" = Table.AddColumn(Source, "Fotos", each Fotos&[Ficheiro]),
				    #"Added Conditional Column" = Table.AddColumn(#"Added Custom", "Foto", each if [Fotos] = null and [sexo] = "M" then "data:image/png;base64," else if [Fotos] = null and [sexo] = "F" then "data:image/png;base64," else [Fotos]),
				    #"Merged Queries" = Table.NestedJoin(#"Added Conditional Column", {"Id"}, CCPessoas, {"IdPessoa"}, "CCPessoas", JoinKind.LeftOuter),
				    #"Expanded CCPessoas" = Table.ExpandTableColumn(#"Merged Queries", "CCPessoas", {"IdCentroCusto"}, {"IdCentroCusto"})
				in
				    #"Expanded CCPessoas"

	annotation PBI_QueryRelationships = {"columnCount":11,"keyColumnNames":[],"queryRelationships":[],"columnIdentities":["Section1/Pessoas/Source.{Id,0}","Section1/Pessoas/Source.{nome,1}","Section1/Pessoas/Source.{activo,2}","Section1/Pessoas/Source.{DataNascimento,3}","Section1/Pessoas/Source.{DataAdmissao,4}","Section1/Pessoas/Source.{HorasDia,5}","Section1/Pessoas/Source.{sexo,6}","Section1/Pessoas/Source.{Grupo,7}","Section1/Pessoas/Source.{Unidade,8}","Section1/Pessoas/Source.{Ficheiro,9}","Section1/Pessoas/Added Custom.{Foto,10}"],"ColumnCount":11,"KeyColumnNames":[],"ColumnIdentities":["Section1/Pessoas/Source.{Id,0}","Section1/Pessoas/Source.{nome,1}","Section1/Pessoas/Source.{activo,2}","Section1/Pessoas/Source.{DataNascimento,3}","Section1/Pessoas/Source.{DataAdmissao,4}","Section1/Pessoas/Source.{HorasDia,5}","Section1/Pessoas/Source.{sexo,6}","Section1/Pessoas/Source.{Grupo,7}","Section1/Pessoas/Source.{Unidade,8}","Section1/Pessoas/Source.{Ficheiro,9}","Section1/Pessoas/Added Custom.{Foto,10}"],"RelationshipInfo":[]}

