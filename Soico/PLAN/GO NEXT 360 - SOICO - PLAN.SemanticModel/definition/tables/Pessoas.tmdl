	column Idade = if(Pessoas[DataNascimento]<>BLANK(), int(YEARFRAC(Pessoas[DataNascimento],TODAY(),1)),BLANK())
		formatString: 0
		lineageTag: fa042dbc-32c8-4e87-8446-8d84ccc665d4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Faixa Etária' =
			
			SWITCH(
			    TRUE()
			        ,Pessoas[Idade]>0 && Pessoas[Idade]<=20,"0-20"
			        ,Pessoas[Idade]>20 && Pessoas[Idade]<=40,"21-40"
			        ,Pessoas[Idade]>40 && Pessoas[Idade]<=60,"41-60"
			        ,Pessoas[Idade]>60,"60>"
			        ,"Não definida"
			)
		lineageTag: 36fc51cd-e492-40b6-bce4-4ff7152b24d8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Tempo Empresa' = if(Pessoas[DataAdmissao] <> BLANK(),INT ( YEARFRAC ( Pessoas[DataAdmissao], TODAY (), 1 ) ),blank())
		lineageTag: a115e43d-ab60-4fce-82cb-aede3b985593
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DataAdmissao
		dataType: dateTime
		formatString: General Date
		lineageTag: a638bcc2-d364-49f4-a914-2c223e2fda12
		summarizeBy: none
