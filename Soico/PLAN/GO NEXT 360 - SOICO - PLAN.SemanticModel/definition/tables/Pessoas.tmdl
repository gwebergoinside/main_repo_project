	column HorasPorDia =
			
			VAR _Duration = Pessoas[HorasDia]
			
			VAR __seg = _Duration * 3600
			VAR allseconds = __seg
			--VAR days = format(INT ( allseconds / 24 / 60 / 60 ),"00")
			VAR hours =  format(MOD ( INT ( allseconds / 60 / 60 ), 24 ),"00")
			VAR minutes = FORMAT( MOD ( INT ( allseconds / 60 ), 60 ),"00" )
			RETURN
			hours &":"& minutes
		lineageTag: baf77374-05f4-4e77-afa8-17f9153e4c56
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

