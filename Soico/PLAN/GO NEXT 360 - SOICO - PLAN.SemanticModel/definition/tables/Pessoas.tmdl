		annotation SummarizationSetBy = Automatic

	column 'Faixa duração na Empresa' =
			
			SWITCH(
			    TRUE()
			        ,Pessoas[Tempo Empresa] <=1, "Até 1 ano"
			        ,Pessoas[Tempo Empresa] >1 && Pessoas[Tempo Empresa] <=5, "1-5 anos"
			        ,Pessoas[Tempo Empresa] >5 && Pessoas[Tempo Empresa] <=10, "5-10 anos"
			        ,Pessoas[Tempo Empresa] >10 && Pessoas[Tempo Empresa] <=15, "10-15 anos"
			        ,Pessoas[Tempo Empresa] >15 && Pessoas[Tempo Empresa] <=20, "15-20 anos"
			        ,Pessoas[Tempo Empresa] >20 && Pessoas[Tempo Empresa] <=30, "20-30 anos"
			        ,Pessoas[Tempo Empresa] >30, "Mais que 30 anos"
			)
		lineageTag: 4d963351-00e9-4b40-953d-7750c2975051
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

