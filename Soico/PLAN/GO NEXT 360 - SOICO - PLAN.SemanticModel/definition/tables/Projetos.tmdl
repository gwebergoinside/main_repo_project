table Projetos
	lineageTag: ee88b762-8067-439e-94f0-68a6d0df7621

	measure link =
			
			var __last = MAX(Projetos[Id])
			var __link = LinkProjeto
			Return
			__link & __last
			--IF( [Actividade Pessoas (h)] > 0 , __link & __last, BLANK() )
		lineageTag: ef0376b1-be3d-4758-9dfe-39ea5be69e29
		dataCategory: WebUrl

	measure 'link RH CC' =
			
			var __last = LASTNONBLANK(Projetos[Id], SELECTEDVALUE(Projetos[Projeto]))
			var __link = LinkProjeto
			Return
			--__link & __last
			IF( [Atividade Pessoas (h)] > 0 , __link & __last, BLANK() )
		lineageTag: 24f59911-ef15-44fd-9b6f-4886321823e5
		dataCategory: WebUrl

	measure 'link Nec Meios' =
			
			var __last = MAX('NecessidadesGantt Final'[IdProjeto])
			var __link = LinkNec
			Return
			IF( [DuracaoDia Nec Meios] > 0 , __link & __last, BLANK() )
		lineageTag: a988cd57-18f3-4122-83d5-dd139318aecd
		dataCategory: WebUrl

	measure 'link Nec Pessoas' =
			
			var __last = MAX('NecessidadesGantt Final'[IdProjeto])
			var __link = LinkNec
			Return
			IF( [DuracaoDia Nec Pessoas] > 0 , __link & __last, BLANK() )
		lineageTag: 1ba9a8c8-7d5c-4dc9-bf92-4ea1f9d47d0b
		dataCategory: WebUrl

