	column Nec =
			
			// LOOKUPVALUE(
			//     'NecessidadesGantt Final'[Projeto]
			//     ,'NecessidadesGantt Final'[IdProjeto]
			//     ,Projetos[Id]
			// )
			CALCULATE(FIRSTNONBLANK('NecessidadesGantt Final'[Projeto],1),
			filter(all('NecessidadesGantt Final'),
			'Projetos'[Id] = 'NecessidadesGantt Final'[IdProjeto]))
		lineageTag: fb82d7ea-c26a-4c08-9ef2-aed3d1f0e3e1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Projetos-4afaf328-925d-4ea8-91a5-3619ba8847ad = m
		mode: import
		queryGroup: Projetos
		source =
				let
				    Origem = Sql.Database(Org, BD, [Query="With#(lf)    Tar As (#(lf)     Select#(lf)         Tarefas.IdProjecto,#(lf)         Max(Tarefas.DataInicio) As [Ultima Data]#(lf)     From#(lf)         Tarefas#(lf)     Group By#(lf)         Tarefas.IdProjecto#(lf)    ),#(lf)    Proj As (#(lf)     Select#(lf)         Projectos.Referencia,#(lf)         Projectos.titulo As titulo,#(lf)         Projectos.Id,#(lf)         Avg(Programas.Duracao) As [Duracao Média],#(lf)         Count(Programas.Evento) As Evento,#(lf)         Projectos.IdTipoProjecto,#(lf)         Projectos.DataInicio,#(lf)         Projectos.DataFim,#(lf)         Projectos.Estado,#(lf)         Tipos_Projecto.Nome As [Tipo Projeto],#(lf)         IsNull(Projectos.IdMasterProject, Projectos.Id) IDProjectoMaster,#(lf)         IsNull(ProjectosMaster.Referencia, Projectos.Referencia) ReferenciaProjectoMaster,#(lf)         Projectos.IdTipoProducao,#(lf)         Projectos.IdTipoPrograma,#(lf)         ProjectosMaster.titulo As ProjectoMaster#(lf)     From#(lf)         Projectos Left Join#(lf)         Programas On Programas.IDProjecto = Projectos.Id Left Join#(lf)         Tipos_Projecto On Projectos.IdTipoProjecto = Tipos_Projecto.Id Left Join#(lf)         Projectos ProjectosMaster On ProjectosMaster.Id = Projectos.IdMasterProject#(lf)     Group By#(lf)         Projectos.Referencia,#(lf)         Projectos.titulo,#(lf)         Projectos.Id,#(lf)         Projectos.IdTipoProjecto,#(lf)         Projectos.DataInicio,#(lf)         Projectos.DataFim,#(lf)         Projectos.Estado,#(lf)         Tipos_Projecto.Nome,#(lf)         IsNull(Projectos.IdMasterProject, Projectos.Id),#(lf)         IsNull(ProjectosMaster.Referencia, Projectos.Referencia),#(lf)         Projectos.IdTipoProducao,#(lf)         Projectos.IdTipoPrograma,#(lf)         ProjectosMaster.titulo#(lf)    )#(lf)Select#(lf)    Proj.Id,#(lf)    Proj.Referencia,#(lf)    Proj.titulo,#(lf)    Proj.[Duracao Média],#(lf)    Proj.Evento,#(lf)    Proj.IdTipoProjecto,#(lf)    Proj.DataInicio,#(lf)    Proj.DataFim,#(lf)    Proj.Estado,#(lf)    Proj.[Tipo Projeto],#(lf)    t.[Ultima Data],#(lf)    Proj.ReferenciaProjectoMaster,#(lf)    Proj.IDProjectoMaster,#(lf)    ptp.Nome As [Tipo Producao],#(lf)    tp.Nome As [Tipo Programa],#(lf)    Proj.ProjectoMaster,#(lf)    pr.ImputacaoProgramas,#(lf)    pr.Referencia As [Referencia de Projeto]#(lf)From#(lf)    Proj Left Join#(lf)    Tar t On t.IdProjecto = Proj.Id Left Join#(lf)    Projectos_Tipos_Producoes ptp On ptp.Id = Proj.IdTipoProducao Left Join#(lf)    Tipos_Programas tp On tp.Id = Proj.IdTipoPrograma Left Join#(lf)    Projectos_Referencias pr On Proj.Referencia Like pr.Referencia + '.%'#(lf)Where#(lf)    Year(Proj.DataFim) >= Year(GetDate()) - 3"]),
				    Personalizado1 = Table.RenameColumns(Origem,{"titulo", "Projeto"}),
				    #"Added Custom" = Table.AddColumn(Personalizado1, "RLS", each "*")
				in
				    #"Added Custom"

