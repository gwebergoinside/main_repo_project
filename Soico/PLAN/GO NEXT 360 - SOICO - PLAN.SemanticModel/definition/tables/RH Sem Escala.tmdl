	partition 'RH Sem Escala-0546c32a-02fc-4660-a145-0f87a0a68903' = calculated
		mode: import
		source = ```
				
				FILTER(
				ADDCOLUMNS
				            (NATURALLEFTOUTERJOIN(
				                SELECTCOLUMNS(
				                        CROSSJOIN(SUMMARIZECOLUMNS('Horarios'[IdPessoaHorarios]),'Calendario') ,
				                        "idPessoa" , 'Horarios'[IdPessoaHorarios] ,
				                        "Calendario" , DATE(YEAR('Calendario'[Date]),MONTH('Calendario'[Date]),DAY('Calendario'[Date]))
				                        )
				                ,
				                SELECTCOLUMNS(
							'Horarios'
							,"idPessoa",[IdPessoaHorarios]				
							,"Calendario", DATE(YEAR([Data]),MONTH([Data]),DAY([Data]))
				            ,"idref",[IdHorariosRefs]
				            ,"MinutosPlaneados", [Diff_1_Min]+[Diff_2_Min]+[Diff_3_Min]
				            --,"idCC", [id] // Com coluna de LookupValue
							)                    
				                    ),
				             "Result",
				             IF(
				                ISBLANK( [MinutosPlaneados] ) && ( ISBLANK([idref]) || [idref] = 1 ) ,
				                 "Sem Escala",
				                 "OK")
				                ),
				                ISBLANK( [MinutosPlaneados] ) && ( ISBLANK([idref]) || [idref] = 1 )
				)
				```

	annotation PBI_Id = f15595b7b6cf4893be9dba36819bd046

