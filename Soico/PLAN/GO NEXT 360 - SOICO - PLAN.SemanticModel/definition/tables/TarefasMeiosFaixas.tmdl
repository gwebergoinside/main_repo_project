	column 'Dia Semana' = SWITCH(WEEKDAY(TarefasMeiosFaixas[Date]),1,"Domingo",2,"Segunda-Feira",3,"Terça-Feira",4,"Quarta-Feira",5,"Quinta-Feira",6,"Sexta-Feira",7,"Sábado")
		lineageTag: c2880f28-0036-42b1-9684-9a0cf8cba8d6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Período =
			
			SWITCH(
			    TRUE()
			    ,HOUR(TarefasMeiosFaixas[Horainicio])>=0 && hour(TarefasMeiosFaixas[Horainicio])<6,"Madrugada"
			    ,HOUR(TarefasMeiosFaixas[Horainicio])>=6 && hour(TarefasMeiosFaixas[Horainicio])<12,"Manhã"
			    ,HOUR(TarefasMeiosFaixas[Horainicio])>=12 && hour(TarefasMeiosFaixas[Horainicio])<18,"Tarde"
			    ,HOUR(TarefasMeiosFaixas[Horainicio])>=18 && hour(TarefasMeiosFaixas[Horainicio])<24,"Noite"
			)
		lineageTag: 4f8ecadb-6827-4f0f-a2f8-814c821ca69f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IdTipoProjecto
		dataType: int64
