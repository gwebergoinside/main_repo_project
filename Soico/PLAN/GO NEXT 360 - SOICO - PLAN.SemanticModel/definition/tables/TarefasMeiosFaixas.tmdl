		sourceColumn: IdTipoProjecto

		annotation SummarizationSetBy = Automatic

	partition TarefasMeiosFaixas-a7b65505-3157-4a8a-9bb6-77a8b843d390 = m
		mode: import
		queryGroup: Meios
		source =
				let
				    Origem = Sql.Database(Org, BD, [Query="Select#(lf)    tm.Id,#(lf)    tm.MeioPrincipal,#(lf)    tm.HoraInicio,#(lf)    tm.HoraFim,#(lf)    Right('0' + Cast(fh.Hora % 24 As VARCHAR(2)), 2) + ':00' Faixa,#(lf)    DateAdd(hour, fh.Hora % 24, DateAdd(day, fh.Hora / 24, Cast(Cast(tm.HoraInicio As DATE) As DATETIME))) InicioFaixa,#(lf)    DateAdd(second, -1, DateAdd(hour, 1, DateAdd(hour, fh.Hora % 24, DateAdd(day, fh.Hora / 24, Cast(Cast(tm.HoraInicio#(lf)    As DATE) As DATETIME))))) FimFaixa,#(lf)    cc.Id IdCentroCusto,#(lf)    tm.CodCentroCusto,#(lf)    tm.IdTarefa,#(lf)    tm.IdMeio,#(lf)    tm.IdAreaTipoTarefa,#(lf)    tm.IdActividadeMeio,#(lf)    tm.SemPeriodoDefinido,#(lf)    IsNull(tm.MinutosPausa, 0) MinutosPausa,#(lf)    t.IdProjecto,#(lf)    Meios.Nome,#(lf)    Projectos.titulo,#(lf)    Projectos.IdTipoProjecto#(lf)From#(lf)    Tarefas_Meios tm Join#(lf)    Tarefas t On tm.IdTarefa = t.Id Left Join#(lf)    Centros_Custo cc On tm.CodCentroCusto = cc.Codigo Join#(lf)    vwFaixasHorarias fh On (tm.SemPeriodoDefinido = 0#(lf)                And fh.Hora Between DatePart(hour, tm.HoraInicio) And Ceiling(DateDiff(minute, Cast(Cast(tm.HoraInicio#(lf)                As DATE) As DATETIME), tm.HoraFim) / 60.0) - 1)#(lf)            Or (tm.SemPeriodoDefinido = 1#(lf)                And fh.Hora Between 0 And 23) Inner Join#(lf)    Meios On tm.IdMeio = Meios.Id Inner Join#(lf)    Projectos On t.IdProjecto = Projectos.Id#(lf)Where#(lf)    Year(tm.HoraInicio) >= Year(GetDate()) -3"]),
				    #"Inserted Date" = Table.AddColumn(Origem, "Date", each DateTime.Date([HoraInicio]), type date)
				in
				    #"Inserted Date"

