	partition TarefasPessoasFaixas-e8f8a793-79a6-4ba1-8484-37589c8d9ef3 = m
		mode: import
		queryGroup: Pessoas
		source =
				let
				    Origem = Sql.Database(Org, BD, [Query="Select#(lf)    tp.Id,#(lf)    tp.HoraInicio,#(lf)    tp.HoraFim,#(lf)    Right('0' + Cast(fh.Hora % 24 As VARCHAR(2)), 2) + ':00' Faixa,#(lf)    DateAdd(hour, fh.Hora % 24, DateAdd(day, fh.Hora / 24, Cast(Cast(tp.HoraInicio As DATE) As DATETIME))) InicioFaixa,#(lf)    DateAdd(second, -1, DateAdd(hour, 1, DateAdd(hour, fh.Hora % 24, DateAdd(day, fh.Hora / 24, Cast(Cast(tp.HoraInicio#(lf)    As DATE) As DATETIME))))) FimFaixa,#(lf)    cc.Id IdCentroCusto,#(lf)    tp.CodCentroCusto,#(lf)    tp.IdTarefa,#(lf)    tp.IdPessoa,#(lf)    tp.IdActividadePessoa,#(lf)    tp.SemPeriodoDefinido,#(lf)    IsNull(tp.MinutosPausa, 0) MinutosPausa,#(lf)    t.Estado TarefaEstado,#(lf)    Projectos.titulo,#(lf)    Projectos.IdTipoProjecto,#(lf)    t.Titulo As [Titulo Tarefa],#(lf)    t.DataInicio As [DataInicio Tarefa],#(lf)    t.DataFim As [DataFim Tarefa],#(lf)    Horarios.IdHorarioRef,#(lf)    Projectos.Id As IdProjeto#(lf)From#(lf)    Tarefas_Pessoas tp Join#(lf)    Tarefas t On tp.IdTarefa = t.Id Left Join#(lf)    Centros_Custo cc On tp.CodCentroCusto = cc.Codigo Join#(lf)    vwFaixasHorarias fh On (tp.SemPeriodoDefinido = 0#(lf)                And fh.Hora Between DatePart(hour, tp.HoraInicio) And Ceiling(DateDiff(minute, Cast(Cast(tp.HoraInicio#(lf)                As DATE) As DATETIME), tp.HoraFim) / 60.0) - 1)#(lf)            Or (tp.SemPeriodoDefinido = 1#(lf)                And fh.Hora Between 0 And 23) Inner Join#(lf)    Projectos On t.IdProjecto = Projectos.Id Left Join#(lf)    Horarios On Horarios.IdPessoa = tp.IdPessoa#(lf)            And Convert(varchar(10),Horarios.Data,103) = Convert(varchar(10),tp.HoraInicio,103)#(lf)Where#(lf)    Year(tp.HoraInicio) >= Year(GetDate()) - 3"]),
				    date = Table.AddColumn(Origem, "Date", each DateTime.Date([HoraInicio]), type date)
				in
				    date

	annotation PBI_QueryRelationships = {"columnCount":22,"keyColumnNames":[],"queryRelationships":[],"columnIdentities":["Section1/TarefasPessoasFaixas/Origem.{Id,0}","Section1/TarefasPessoasFaixas/Origem.{HoraInicio,1}","Section1/TarefasPessoasFaixas/Origem.{HoraFim,2}","Section1/TarefasPessoasFaixas/Origem.{Faixa,3}","Section1/TarefasPessoasFaixas/Origem.{InicioFaixa,4}","Section1/TarefasPessoasFaixas/Origem.{FimFaixa,5}","Section1/TarefasPessoasFaixas/Origem.{IdCentroCusto,6}","Section1/TarefasPessoasFaixas/Origem.{CodCentroCusto,7}","Section1/TarefasPessoasFaixas/Origem.{IdTarefa,8}","Section1/TarefasPessoasFaixas/Origem.{IdPessoa,9}","Section1/TarefasPessoasFaixas/Origem.{IdActividadePessoa,10}","Section1/TarefasPessoasFaixas/Origem.{SemPeriodoDefinido,11}","Section1/TarefasPessoasFaixas/Origem.{MinutosPausa,12}","Section1/TarefasPessoasFaixas/Origem.{TarefaEstado,13}","Section1/TarefasPessoasFaixas/Origem.{titulo,14}","Section1/TarefasPessoasFaixas/Origem.{IdTipoProjecto,15}","Section1/TarefasPessoasFaixas/Origem.{Titulo Tarefa,16}","Section1/TarefasPessoasFaixas/Origem.{DataInicio Tarefa,17}","Section1/TarefasPessoasFaixas/Origem.{DataFim Tarefa,18}","Section1/TarefasPessoasFaixas/Origem.{IdHorarioRef,19}","Section1/TarefasPessoasFaixas/Origem.{IdProjeto,20}","Section1/TarefasPessoasFaixas/date.{Date,21}"],"ColumnCount":22,"KeyColumnNames":[],"ColumnIdentities":["Section1/TarefasPessoasFaixas/Origem.{Id,0}","Section1/TarefasPessoasFaixas/Origem.{HoraInicio,1}","Section1/TarefasPessoasFaixas/Origem.{HoraFim,2}","Section1/TarefasPessoasFaixas/Origem.{Faixa,3}","Section1/TarefasPessoasFaixas/Origem.{InicioFaixa,4}","Section1/TarefasPessoasFaixas/Origem.{FimFaixa,5}","Section1/TarefasPessoasFaixas/Origem.{IdCentroCusto,6}","Section1/TarefasPessoasFaixas/Origem.{CodCentroCusto,7}","Section1/TarefasPessoasFaixas/Origem.{IdTarefa,8}","Section1/TarefasPessoasFaixas/Origem.{IdPessoa,9}","Section1/TarefasPessoasFaixas/Origem.{IdActividadePessoa,10}","Section1/TarefasPess