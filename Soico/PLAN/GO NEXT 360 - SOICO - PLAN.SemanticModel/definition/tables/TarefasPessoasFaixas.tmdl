	column Período =
			
			SWITCH(
			    TRUE()
			    ,HOUR(TarefasPessoasFaixas[Horainicio])>=0 && hour(TarefasPessoasFaixas[Horainicio])<6,"Madrugada"
			    ,HOUR(TarefasPessoasFaixas[Horainicio])>=6 && hour(TarefasPessoasFaixas[Horainicio])<12,"Manhã"
			    ,HOUR(TarefasPessoasFaixas[Horainicio])>=12 && hour(TarefasPessoasFaixas[Horainicio])<18,"Tarde"
			    ,HOUR(TarefasPessoasFaixas[Horainicio])>=18 && hour(TarefasPessoasFaixas[Horainicio])<24,"Noite"
			)
		lineageTag: dd917266-e072-4fa3-a2cb-a61ae5313b10
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

