	partition Tarefas_Pessoas-82766b52-9fab-4841-9742-8fcb2320c70f = m
		mode: import
		queryGroup: Pessoas
		source =
				let
				    Origem = Sql.Database(Org, BD, [Query="Select#(lf)    tp.TempoImputado,#(lf)    tp.IdPessoa,#(lf)    tp.Id As IdTarefas,#(lf)    Projectos.titulo,#(lf)    Convert(VARCHAR(10),tp.HoraInicio,103) As HoraInicio,#(lf)    cc.Id As IdCC,#(lf)    cc.TipoActividadeApurada As TipoActividadeApuradaTarefas,#(lf)    Pessoas.Id,#(lf)    Projectos.IdTipoProjecto,#(lf)    Horarios.IdHorarioRef,#(lf)    Projectos.Id As IdProjeto,#(lf)    tp.HoraInicio As HoraIni,#(lf)    Horarios.HoraInicio1 As HoraInicioPlan,#(lf)    Horarios.HoraInicio2 As HoraInicioPlan2,#(lf)    Horarios.HoraInicio3 As HoraInicioPlan3,#(lf)    Horarios.HoraFim1 As HoraFiimPlan,#(lf)    Horarios.HoraFim2 As HoraFiimPlan2,#(lf)    Horarios.HoraFim3 As HoraFiimPlan3,#(lf)    DateFromParts(Year(tp.HoraInicio), Month(tp.HoraInicio), 1) As [Start of Month],#(lf)    pvm.NaoConsiderarParaCalculoCapacidadeAtividade,#(lf)    IsNull((Select Top 1#(lf)         PH.IdGrupoPessoa#(lf)     From#(lf)         Pessoas_Historico PH#(lf)     Where#(lf)         PH.IdGrupoPessoa Is Not Null And#(lf)         PH.IdPessoa = tp.IdPessoa And#(lf)         Cast(PH.DataInicioGrupo As DATE) <= Cast(tp.HoraInicio As DATE) And#(lf)         (PH.DataFimGrupo Is Null Or#(lf)             Cast(PH.DataFimGrupo As DATE) >= Cast(tp.HoraInicio As DATE))#(lf)     Order By#(lf)         PH.DataInicioGrupo), Pessoas.IdGrupoPessoa) IdGrupoPessoa,#(lf)    Pessoas.NumFuncionario#(lf)From#(lf)    Tarefas_Pessoas tp Inner Join#(lf)    Tarefas On tp.IdTarefa = Tarefas.Id Inner Join#(lf)    Projectos On Tarefas.IdProjecto = Projectos.Id Left Join#(lf)    Centros_Custo cc On cc.Codigo = tp.CodCentroCusto Inner Join#(lf)    Pessoas On tp.IdPessoa = Pessoas.Id Left Join#(lf)    Horarios On Convert(VARCHAR(10),Horarios.Data,103) = Convert(VARCHAR(10),tp.HoraInicio,103)#(lf)            And Horarios.IdPessoa = tp.IdPessoa Left Join#(lf)    Pessoas_Valorizacoes_Mensais pvm On pvm.Ano = Year(tp.DataImputacao)#(lf)            And pvm.Mes = Month(tp.DataImputacao)#(lf)            And pvm.IdPessoa = tp.IdPessoa"]),
				    #"Merged Queries" = Table.NestedJoin(Origem, {"Start of Month", "IdCC"}, Tarifa, {"Mes", "IdCentroCusto"}, "Tarifa", JoinKind.LeftOuter),
				    #"Expanded Tarifa1" = Table.ExpandTableColumn(#"Merged Queries", "Tarifa", {"TarifaUnitaria"}, {"Tarifa"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Expanded Tarifa1",{{"HoraInicio", type date}})
				in
				    #"Changed Type"

