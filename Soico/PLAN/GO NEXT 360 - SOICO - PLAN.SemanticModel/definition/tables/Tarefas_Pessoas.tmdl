	column ExtraNec =
			
			CALCULATE(
			    SUM( 'NecessidadesGantt Extra'[Index] )
			    ,FILTER( ALL('NecessidadesGantt Extra'), Tarefas_Pessoas[keyAtividade] ='NecessidadesGantt Extra'[keyAtividade] )
			    ,'NecessidadesGantt Extra'[Tipo] = "RH"
			    )
		formatString: 0
		lineageTag: 63a6d7c3-306a-4407-b655-1f7ea9808e2e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

