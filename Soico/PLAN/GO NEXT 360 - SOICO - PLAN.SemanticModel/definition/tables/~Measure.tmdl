	measure 'Capacidade Prevista (h)' = CALCULATE( sum(Horarios[Capacidade])  )
		formatString: #,0
		displayFolder: Capacidade
		lineageTag: dece5690-1c76-4228-a873-189b63a5ccf1

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Capacidade Planeada (h)' = ```
			
			CALCULATE( 
			    ( sum(Horarios[Diff_1]) + SUM(Horarios[Diff_2]) + SUM(Horarios[Diff_3]) ) - (SUM(Horarios[MinutosPausaNaoIdentificada]))/60 
			    ,Horarios[TrabalhoEfectivo] = TRUE() 
			    ,FILTER( Horarios , ISBLANK(Horarios[Diff_1]) = FALSE() || ISBLANK(Horarios[Diff_2]) = FALSE() || ISBLANK(Horarios[Diff_3]) = FALSE() ) 
			)
			```
		formatString: #,0.00
		displayFolder: Capacidade
		lineageTag: 4d238b76-a3f9-4f8a-90bc-e3e71ae53844

	measure '% Taxa Ocupação Pessoas' = divide([Atividade Pessoas (h)],[Capacidade - Ferias e Aus])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: %
		lineageTag: 7c9f8a26-7938-4db2-a751-7a6b3c85d761

	measure 'Atividade Pessoas (d)' = ```
			
			Var __horas = 
			CALCULATE( 
			    SUM( 'Tarefas_Pessoas'[TempoImputado] )
			    --,TREATAS( VALUES( Tarefas_Pessoas[IdHorarioRef] ), Horarios[IdHorariosRefs] )
			)--, USERELATIONSHIP( Horarios[IdHorariosRefs] , Tarefas_Pessoas[IdHorarioRef] ) )
			Var __dias = 
			CALCULATE( 
			    MAXX(Horarios, Horarios[HorasDia] )
			    --,TREATAS( VALUES( Tarefas_Pessoas[IdHorarioRef] ), Horarios[IdHorariosRefs] ) 
			)--, USERELATIONSHIP( Horarios[IdHorariosRefs] , Tarefas_Pessoas[IdHorarioRef] ) )
			RETURN
			DIVIDE( __horas, __dias )
			```
		formatString: #,0
		displayFolder: Actividade
		lineageTag: 78d34b98-fac2-43e1-aa22-78bd26e07920

