	measure '# RH Escala Vs Ponto One' = ```
			
			VAR _PontoIni = MIN( Apontamentos[PicagemInicio] )
			VAR _EscalaIni = MIN( Apontamentos[Planeado | Hora Inicio] )
			VAR _PontoFim = MAX( Apontamentos[Picagem_Fim])
			VAR _EscalaFim = MAX( Apontamentos[Planeado | Hora Fim] )
			--
			VAR _ExecucaoIni = MIN( Apontamentos[ExecucaoHoraInicio] )
			VAR _AtividadeIni = MIN( Apontamentos[HoraIni] )
			RETURN   
			CALCULATE( DISTINCTCOUNT( Pessoas[Id] ), FILTER( Pessoas, 
			    ((_EscalaIni <> _PontoIni) && DATEDIFF( _PontoIni, _EscalaIni, MINUTE ) > Simulador[Simulador Value] ) || 
			    ((_PontoFim <> _EscalaFim) && DATEDIFF( _PontoFim, _EscalaFim, MINUTE ) > Simulador[Simulador Value] ) ||
			    ((_EscalaIni <> _PontoIni) && DATEDIFF( _EscalaIni, _PontoIni, MINUTE ) > Simulador[Simulador Value] ) || 
			    ((_PontoFim <> _EscalaFim) && DATEDIFF( _EscalaFim, _PontoFim, MINUTE ) > Simulador[Simulador Value] ) ||
			    ((ISBLANK(_EscalaIni) && NOT ISBLANK(_PontoIni) ) || ( NOT ISBLANK(_EscalaIni) && ISBLANK(_PontoIni) )) ||
			    ((ISBLANK(_EscalaFim) && NOT ISBLANK(_PontoFim) ) || ( NOT ISBLANK(_EscalaFim) && ISBLANK(_PontoFim) ))
			))
			```
		formatString: 0
		displayFolder: Controlo de RH
		lineageTag: 908d117d-c969-4656-92e5-3a79652758dd

	measure '# RH Escala Vs Atividade One' = ```
			
