	measure 'Orç. Acumulado' = ```
			
			--    CALCULATE( 
			--        [Orç. Mensal], 
			--            FILTER( 
			--                ALL( Calendario), 
			--                    MAX( Calendario[Mês]) >=Calendario[Mês]
			--            )
			--        ,VALUES( Calendario[Ano])
			--    )
			IF ( ISFILTERED(Calendario[Mês Nome]), CALCULATE([Orçamento], DATESYTD(Calendario[Date])), CALCULATE( [Orçamento], FILTER( ALL(Calendario[Date]),
			         MONTH(Calendario[Date])<=MONTH(NOW()) && YEAR(Calendario[Date])=YEAR(MAX(Calendario[Date])) ) ) )
			```
		formatString: #,0
		displayFolder: Orçamentos
		lineageTag: cfe69692-09da-4ded-adff-93d09fbf77a2

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Orç. Mensal' =
			
			VAR _1 = SUM(ExecucaoMensalConta[BudgetPurchaseValue])
			RETURN
			IF( _1 = 0, BLANK(), _1 )
		displayFolder: Orçamentos
		lineageTag: ff1376e0-0cc1-4b83-af07-b0f7a712165e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Orç. Previsto' =
			
			VAR _1 = CALCULATE (
			    [Orç. Mensal],
			FILTER(
			         ALL(Calendario[Date]),
			         YEAR(Calendario[Date])=YEAR(MAX(Calendario[Date]))&&MONTH(Calendario[Date])>=MONTH(MAX(Calendario[Date]))) )
			RETURN
			IF ( ISFILTERED(Calendario[Mês Nome]), _1, CALCULATE( [Orç. Mensal], FILTER( ALL(Calendario[Date]),
			         MONTH(Calendario[Date])>=MONTH(NOW()) && YEAR(Calendario[Date])=YEAR(MAX(Calendario[Date])) ) ) )
		displayFolder: Orçamentos
		lineageTag: edf6b3d3-c3c2-4688-b74e-1da24b817257

		annotation PBI_FormatHint = {"isGeneralNumber":true}

