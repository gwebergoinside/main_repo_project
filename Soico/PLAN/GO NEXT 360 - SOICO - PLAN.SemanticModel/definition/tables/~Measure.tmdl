			VAR _2 = SUMX( SUMMARIZE('NecessidadesGantt Final', [IdCentroCusto],"Sum", CALCULATE( DISTINCTCOUNT( 'NecessidadesGantt Final'[Datas] ), 'NecessidadesGantt Final'[Tipo] = "Meios" ) ),[Sum])
