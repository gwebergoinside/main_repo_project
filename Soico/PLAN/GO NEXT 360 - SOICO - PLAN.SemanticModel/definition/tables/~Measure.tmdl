			VAR _PontoFim = MAX( Apontamentos[Picagem_Fim] )
			VAR _ExecucaoIni = MIN( Apontamentos[ExecucaoHoraInicio] )
			VAR _ExecucaoFim = MAX( Apontamentos[ExecucaoHoraFim] )
			--
			VAR _AtividadeIni = MIN( Apontamentos[HoraIni] )
			VAR _EscalaIni = MIN( Apontamentos[Planeado | Hora Inicio] )
			RETURN   
			CALCULATE( DISTINCTCOUNT( Pessoas[Id] ), FILTER( Pessoas,
			    // ((_Picagem <> _Exec) && (DATEDIFF( _PicagemIni, _PicagemFim, MINUTE ) - DATEDIFF( _ExecIni, _ExecFim, MINUTE )) > Simulador[Simulador Value] ) ||
			    // ((_Picagem <> _Exec) && (DATEDIFF( _ExecIni, _ExecFim, MINUTE ) - DATEDIFF( _PicagemIni, _PicagemFim, MINUTE )) > Simulador[Simulador Value] ) ) )
			    ((_ExecucaoIni <> _PontoIni) && DATEDIFF( _PontoIni, _ExecucaoIni, MINUTE ) > Simulador[Simulador Value] ) || 
			    ((_PontoFim <> _ExecucaoFim) && DATEDIFF( _PontoFim, _ExecucaoFim, MINUTE ) > Simulador[Simulador Value] ) ||
			    --((_ExecucaoIni <> _PontoIni) && DATEDIFF( _ExecucaoIni, _PontoIni, MINUTE ) > Simulador[Simulador Value] ) || 
			    --((_PontoFim <> _ExecucaoFim) && DATEDIFF( _ExecucaoFim, _PontoFim, MINUTE ) > Simulador[Simulador Value] ) ||
			    ((ISBLANK(_ExecucaoIni) && NOT ISBLANK(_PontoIni) ) || ( NOT ISBLANK(_ExecucaoIni) && ISBLANK(_PontoIni) )) ||
			    ((ISBLANK(_ExecucaoFim) && NOT ISBLANK(_PontoFim) ) || ( NOT ISBLANK(_ExecucaoFim) && ISBLANK(_PontoFim) ))
			))
			```
		formatString: 0
		displayFolder: Controlo de RH
		lineageTag: a0ca7359-2dc9-4fdf-84f1-5e31e6332ba7

