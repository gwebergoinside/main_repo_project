	measure Custo = SUM(ExecucaoMensalConta[TotalCosts])
		formatString: #,0.00
		displayFolder: Custo
		lineageTag: b0dae276-3d6a-45f8-bad9-375ac13436c7

	measure 'Custo Acumulado' = ```
			
			--    CALCULATE( 
			--        SUM(ExecucaoMensalConta[TotalCosts]), 
			--            FILTER( 
			--                ALL( Calendario), 
			--                    MAX( Calendario[Mês]) >=Calendario[Mês]
			--            )
			--        ,VALUES( Calendario[Ano])
			--    )
			IF ( ISFILTERED(Calendario[Mês Nome]), CALCULATE([Custo], DATESYTD(Calendario[Date])), CALCULATE( [Custo], FILTER( ALL(Calendario[Date]),
			         MONTH(Calendario[Date])<=MONTH(NOW()) && YEAR(Calendario[Date])=YEAR(MAX(Calendario[Date])) ) ) )
			```
		displayFolder: Custo
		lineageTag: 8b14b35b-f064-4827-bcd3-b7f47c991282

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Custo Mensal' =
			
			SUM(ExecucaoMensalConta[TotalCosts])
		formatString: #,0.0
		displayFolder: Custo
		lineageTag: a2122458-ed5b-49e5-978e-a80a9ebd4288

	measure 'Custo Previsto' =
			
			CALCULATE (
			    SUM ( ExecucaoMensalConta[TotalCosts]),
			    FILTER (
			        ALL ( Calendario[Date]),
			        Calendario[Date] > MAX ( Calendario[Date] )
			    )
			)
		displayFolder: Custo
