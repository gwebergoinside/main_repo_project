	measure 'Plan vs Exec Inicio_CARD (d hh:mm)' =
			
			VAR Hour_Min = [Plan vs Exec Inicio(M)_tole] --[Plan vs Exec Inicio (M)]
			VAR __seg = Hour_Min * 60
			VAR allseconds = __seg
			VAR days = format(INT ( allseconds / 24 / 60 / 60 ),"00")
			VAR hours =  format(MOD ( INT ( allseconds / 60 / 60 ), 24 ),"00")
			VAR minutes = FORMAT( MOD ( INT ( allseconds / 60 ), 60 ),"00" )
			RETURN
			days &" d "& hours &":"& minutes
		displayFolder: Controlo de Horas
		lineageTag: 5a2e8279-27e1-41a0-86f7-3bd6fda48929

