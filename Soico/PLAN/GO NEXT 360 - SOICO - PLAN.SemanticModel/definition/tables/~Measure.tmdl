	measure 'QTD RH CalculoNecessidades' =
			
			-- Capacidade --
			VAR _1_QTD = CALCULATE( DISTINCTCOUNT( Pessoas[id] ), FILTER( Horarios , NOT ISBLANK(Horarios[Diff_1]) || NOT ISBLANK(Horarios[Diff_2]) || NOT ISBLANK(Horarios[Diff_3]) ) )
			-- Necessidades --
			VAR _2_QTD = CALCULATE( [QTD Nec Pessoas], TREATAS( VALUES( Pessoas[IdCentroCusto] ), CentroCusto[Id] ) )
			-- Escala --
			VAR _3_QTD = CALCULATE( DISTINCTCOUNT( Apontamentos[IdPessoa] ), NOT ISBLANK( Apontamentos[Planeado | Hora Inicio] ) )
			-- Atividade --
			VAR _4_QTD = CALCULATE( DISTINCTCOUNT( Apontamentos[IdPessoa] ), NOT ISBLANK( Apontamentos[HoraIni] ) )
			-- Execução --
			VAR _5_QTD = CALCULATE( DISTINCTCOUNT( Apontamentos[IdPessoa] ), NOT ISBLANK( Apontamentos[ExecucaoHoraInicio] ) )
			RETURN
			SWITCH(
			    TRUE()
			-- Capacidade
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Capacidade", _1_QTD
			-- Necessidades
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Necessidades", _2_QTD
			-- Escala
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Escala", _3_QTD
			-- Atividade
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Atividade", _4_QTD
			-- Execução
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Execução", _5_QTD
			-- else
			    ,BLANK()
			)
		formatString: #,0
		displayFolder: Necessidades
		lineageTag: e5b33a68-19ff-4ca7-a913-4661891e554c

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Horas RH CalculoNecessidades' =
			
			-- Capacidade --
			VAR _Duration_Cap = AVERAGEX( VALUES(Horarios[IdPessoaHorarios]), CALCULATE( SUM(Horarios[Capacidade_Planeamento] ) ) )
			
			VAR __seg_Cap = _Duration_Cap * 60
			VAR allseconds_Cap = __seg_Cap
			VAR days_Cap = FORMAT(INT ( allseconds_Cap / 24 / 60 / 60 ),"00")
			VAR hours_Cap =  FORMAT(MOD ( INT ( allseconds_Cap / 60 / 60 ), 24 ),"00")
			VAR minutes_Cap = FORMAT( MOD ( INT ( allseconds_Cap / 60 ), 60 ),"00" )
			-- Necessidades --
			--VAR _2_1_Horas = AVERAGEX( VALUES('NecessidadesGantt Final'[IdPessoa]), CALCULATE( [Necessidades Pessoas_week_Planeamento] ) )
			VAR _2_1_Horas = AVERAGEX( 'NecessidadesGantt Final', CALCULATE( [DuracaoDia Nec Pessoas], TREATAS( VALUES( Pessoas[IdCentroCusto] ), CentroCusto[Id] ) ))
			VAR _2_HORAS = _2_1_Horas * 60 --[Necessidades Pessoas_week_Planeamento] * 60
			VAR _Duration_Nec = _2_HORAS
			VAR __seg_Nec = _Duration_Nec * 60
			VAR allseconds_Nec = __seg_Nec
			VAR days_Nec = FORMAT(INT ( allseconds_Nec / 24 / 60 / 60 ),"00")
			VAR hours_Nec =  FORMAT(MOD ( INT ( allseconds_Nec / 60 / 60 ), 24 ),"00")
			VAR minutes_Nec = FORMAT( MOD ( INT ( allseconds_Nec / 60 ), 60 ),"00" )
			-- Escala --
			VAR _Duration_esc = AVERAGEX( VALUES(Apontamentos[IdPessoa]), CALCULATE( SUM(Apontamentos[Escala (m)] ) ) )
			Var __seg_esc = _Duration_esc * 60
			VAR allseconds_esc = __seg_esc
			VAR days_esc = FORMAT(INT ( allseconds_esc / 24 / 60 / 60 ),"00")
			VAR hours_esc =  FORMAT(MOD ( INT ( allseconds_esc / 60 / 60 ), 24 ),"00")
			VAR minutes_esc = FORMAT( MOD ( INT ( allseconds_esc / 60 ), 60 ),"00" )
			-- Atividade --
			VAR _Duration_ativ = AVERAGEX( VALUES(Apontamentos[IdPessoa]), CALCULATE( SUM(Apontamentos[Atividade (m)] ) ) )
			Var __seg_ativ = _Duration_ativ * 60
			VAR allseconds_ativ = __seg_ativ
			VAR days_ativ = FORMAT(INT ( allseconds_ativ / 24 / 60 / 60 ),"00")
			VAR hours_ativ =  FORMAT(MOD ( INT ( allseconds_ativ / 60 / 60 ), 24 ),"00")
			VAR minutes_ativ = FORMAT( MOD ( INT ( allseconds_ativ / 60 ), 60 ),"00" )
			-- Execução --
			VAR _Duration_exec = AVERAGEX( VALUES(Apontamentos[IdPessoa]), CALCULATE( SUM(Apontamentos[Execucao (m)] ) ) )
			Var __seg_exec = _Duration_exec * 60
			VAR allseconds_exec = __seg_exec
			VAR days_exec = FORMAT(INT ( allseconds_exec / 24 / 60 / 60 ),"00")
			VAR hours_exec =  FORMAT(MOD ( INT ( allseconds_exec / 60 / 60 ), 24 ),"00")
			VAR minutes_exec = FORMAT( MOD ( INT ( allseconds_exec / 60 ), 60 ),"00" )
			RETURN
			SWITCH(
			    TRUE()
			-- Capacidade
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Capacidade", --_1_HORAS
			        IF.EAGER(_Duration_Cap >= 1440, days_Cap &" d "& hours_Cap &":"& minutes_Cap, IF( _Duration_Cap = BLANK(), BLANK(), hours_Cap &":"& minutes_Cap) )
			-- Necessidades
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Necessidades", --_2_HORAS
			        IF.EAGER(_Duration_Nec >= 1440, days_Nec &" d "& hours_Nec &":"& minutes_Nec, IF( _Duration_Nec = BLANK(), BLANK(), hours_Nec &":"& minutes_Nec) )
			-- Escala
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Escala",
			        IF.EAGER(_Duration_esc >= 1440, days_esc &" d "& hours_esc &":"& minutes_esc, IF( _Duration_esc = BLANK(), BLANK(), hours_esc &":"& minutes_esc) )
			-- Atividade
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Atividade",
			        IF.EAGER(_Duration_ativ >= 1440, days_ativ &" d "& hours_ativ &":"& minutes_ativ, IF( _Duration_ativ = BLANK(), BLANK(), hours_ativ &":"& minutes_ativ) )
			-- Execução
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Execução",
			        IF.EAGER(_Duration_exec >= 1440, days_exec &" d "& hours_exec &":"& minutes_exec, IF( _Duration_exec = BLANK(), BLANK(), hours_exec &":"& minutes_exec) )
			-- else
			    ,BLANK()
			)
		displayFolder: Necessidades
		lineageTag: 00fae04a-6ff4-4a14-83ce-855328f7cff8

	measure 'Necessidades Pessoas_week_Planeamento' =
			
			VAR _1 =
			SUMMARIZE('NecessidadesGantt Final', 'NecessidadesGantt Final'[WeekDay],'NecessidadesGantt Final'[IdCentroCusto], 'NecessidadesGantt Final'[NomeEtapa], [IdNecessidade] )
			RETURN
			AVERAGEX( _1, CALCULATE( [Dias Nec Pessoas_week] * [Total Nec Pessoas] ) )
