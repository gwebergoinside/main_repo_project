	measure 'Atividade Planeada Pessoas h' =
			
			VAR _MIN = MIN( Horarios[HoraInicio1] )
			VAR _MAX = MAX( Horarios[Planeado | Hora Fim] )
			VAR Duration = DATEDIFF( _MIN , _MAX , SECOND )
			VAR Hours =
			    INT ( Duration / 3600)
			VAR Minutes =
			    INT ( MOD( Duration - ( Hours * 3600 ),3600 ) / 60)
			RETURN
			abs(Hours)
		formatString: 0
		displayFolder: Pessoas
		lineageTag: 049aedae-1be5-4148-ab67-8c37005eb9cc

	measure 'Atividade Planeada Pessoas (h) Balanço' =
			
			VAR _MIN = MIN( Horarios[HoraInicio1] )
			VAR _MAX = MAX( Horarios[Planeado | Hora Fim] )
			VAR Duration = DATEDIFF( _MIN , _MAX , SECOND )
			VAR Hours =
			    INT ( Duration / 3600)
			VAR Minutes =
			    INT ( MOD( Duration - ( Hours * 3600 ),3600 ) / 60)
			RETURN
			[Atividade Pessoas (h)]-Hours
		displayFolder: Pessoas
		lineageTag: 1fbcfa17-7bb5-4716-b6c9-f5aaf913ebd1

