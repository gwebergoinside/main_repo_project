	measure 'Atividade Necessidades Pessoas_Apoio' = ```
			
			SWITCH(
			    TRUE()
			    // ,SELECTEDVALUE( 'NecessidadesGantt Final'[TipoNec] ) = "Extra Necessidades", 
			        // CALCULATE( 
			        //     SUM('NecessidadesGantt Final'[Quantidade] )
			        //     ,CROSSFILTER( Projetos[id], 'NecessidadesGantt Final'[IdProjeto], Both )
