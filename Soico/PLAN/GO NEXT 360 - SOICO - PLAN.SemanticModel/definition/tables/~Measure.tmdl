	measure 'Escala (h)' = ```
			
			VAR _MIN = MIN( Apontamentos[Planeado | Hora Inicio] )
			VAR _MAX = MAX( Apontamentos[Planeado | Hora Fim] )
			VAR _Duration = DATEDIFF( _MIN , _MAX , MINUTE )
			// VAR Duration = DATEDIFF( _MIN , _MAX , SECOND )
			// VAR Hours =
			//     INT ( Duration / 3600)
			// VAR Minutes =
			//     INT ( MOD( Duration - ( Hours * 3600 ),3600 ) / 60)
			// VAR H =
			//     IF ( LEN ( Hours ) = 1, 
			//         CONCATENATE ( "0", Hours ),
			//         CONCATENATE ( "", Hours )
			//       )
			// VAR M =
			//     IF (
			//         LEN ( Minutes ) = 1,
			//         CONCATENATE ( "0", Minutes ),
			//         CONCATENATE ( "", Minutes )
			//     )
			// RETURN
			// IF( Duration = BLANK(), BLANK() ,
			//     CONCATENATE (
			//         H,
			//         CONCATENATE ( ":", M )
			//     )
			// )
			VAR __seg = _Duration * 60
			VAR allseconds = __seg
			VAR days = format(INT ( allseconds / 24 / 60 / 60 ),"00")
			VAR hours =  format(MOD ( INT ( allseconds / 60 / 60 ), 24 ),"00")
			VAR minutes = FORMAT( MOD ( INT ( allseconds / 60 ), 60 ),"00" )
			RETURN
			IF.EAGER(_Duration >= 1440, days &" d "& hours &":"& minutes, IF( _Duration = BLANK(), BLANK(), hours &":"& minutes) )
			```
