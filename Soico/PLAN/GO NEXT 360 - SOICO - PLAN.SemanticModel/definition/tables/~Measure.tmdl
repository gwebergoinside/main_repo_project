	measure 'Diff_Plan vs Ativ - Fim(M)' = ```
			
			SUMX(
			    SUMMARIZE(
			        Apontamentos,
			        Apontamentos[Date]
			        ,"soma"
			        ,CALCULATE(
			            IF.EAGER(
			                MAX( Apontamentos[Planeado | Hora Fim])  = BLANK()
			                ,ABS( 
			                    DATEDIFF( 
			                        MAX(Apontamentos[HoraFim])
			                        ,MIN( Apontamentos[HoraIni])
			                    , MINUTE
			                    )
			                )
			                ,IF.EAGER( MAX(Apontamentos[HoraFim]) = BLANK()
			                    ,ABS( 
			                        DATEDIFF( 
			                            MAX( Apontamentos[Planeado | Hora Fim]) 
			                            ,MIN( Apontamentos[Planeado | Hora Inicio])
			                        , MINUTE
			                        )
			                    )
			                    ,ABS(
			                        DATEDIFF( 
			                            MAX( Apontamentos[Planeado | Hora Fim]) 
			                            ,MAX(Apontamentos[HoraFim]) 
			                        , MINUTE 
			                        )
			                    )
			                )
			            )
			        )
			    )
			    ,[soma] 
			) / DISTINCTCOUNT( Apontamentos[Date] )
			```
		formatString: 0
		displayFolder: Controlo de Horas
		lineageTag: 6a89a3c6-1c2e-4579-ab44-76b461566945

	measure Dias = ```
			
			VAR CurrentHour = MAX( 'FichaPessoa_Horas'[Value] )
			VAR CurrentDay = MAX( 'FichaPessoa_Dias'[Value] )
			VAR CurrentMonth = MAX( 'FichaPessoa_Meses'[Value] )
			-- Escala --
			VAR _1_DaysEscala = ABS( DATEDIFF( MAX( Apontamentos[Planeado | Hora Fim] ), MIN( Apontamentos[Planeado | Hora Inicio] ), DAY ) )
			VAR _1_DaysFromStartDate =  DAY(MIN( Apontamentos[Planeado | Hora Inicio] ) )
			VAR _1_DaysFromEndDate = DAY(MAX( Apontamentos[Planeado | Hora FIM] ) )
			VAR _1_HoursFromStartDate =  HOUR(MIN( Apontamentos[Planeado | Hora Inicio] ) )
			VAR _1_HoursFromEndDate = HOUR(MAX( Apontamentos[Planeado | Hora FIM] ) )
			VAR _1_MonthsFromStartDate =  MONTH(MIN( Apontamentos[Planeado | Hora Inicio] ) )
			VAR _1_MonthsFromEndDate = MONTH(MAX( Apontamentos[Planeado | Hora FIM] ) )
			-- Atividade --
			VAR _2_DaysAtividade = ABS( DATEDIFF( MAX( Apontamentos[HoraFim] ), MIN( Apontamentos[HoraIni] ), DAY ) )
			VAR _2_DaysFromStartDate =  DAY(MIN( Apontamentos[HoraIni] ) )
			VAR _2_DaysFromEndDate = DAY(MAX( Apontamentos[HoraFIM] ) )
			VAR _2_HoursFromStartDate =  HOUR(MIN( Apontamentos[HoraIni] ) )
			VAR _2_HoursFromEndDate = HOUR(MAX( Apontamentos[HoraFIM] ) )
			VAR _2_MonthsFromStartDate =  MONTH(MIN( Apontamentos[HoraIni] ) )
			VAR _2_MonthsFromEndDate = MONTH(MAX( Apontamentos[HoraFIM] ) )
			-- Ponto --
			VAR _3_DaysPonto = ABS( DATEDIFF( MAX( Apontamentos[Picagem_Fim] ), MIN( Apontamentos[PicagemInicio] ), DAY ) )
			VAR _3_DaysFromStartDate = DAY(MIN( Apontamentos[PicagemInicio] ) )
			VAR _3_DaysFromEndDate = DAY(MAX( Apontamentos[Picagem_Fim] ) )
			VAR _3_HoursFromStartDate = HOUR(MIN( Apontamentos[PicagemInicio] ) )
			VAR _3_HoursFromEndDate = HOUR(MAX( Apontamentos[Picagem_Fim] ) )
			VAR _3_MonthsFromStartDate = MONTH(MIN( Apontamentos[PicagemInicio] ) )
			VAR _3_MonthsFromEndDate = MONTH(MAX( Apontamentos[Picagem_Fim] ) )
			-- Execução --
			VAR _4_DaysExecucao = ABS( DATEDIFF( MAX( Apontamentos[ExecucaoHoraFim] ), MIN( Apontamentos[ExecucaoHoraInicio] ), DAY ) )
			VAR _4_DaysFromStartDate = DAY(MIN( Apontamentos[ExecucaoHoraInicio] ) )
			VAR _4_DaysFromEndDate = DAY(MAX( Apontamentos[ExecucaoHoraFim] ) )
			VAR _4_HoursFromStartDate = HOUR(MIN( Apontamentos[ExecucaoHoraInicio] ) )
			VAR _4_HoursFromEndDate = HOUR(MAX( Apontamentos[ExecucaoHoraFim] ) )
			VAR _4_MonthsFromStartDate = MONTH(MIN( Apontamentos[ExecucaoHoraInicio] ) )
			VAR _4_MonthsFromEndDate = MONTH(MAX( Apontamentos[ExecucaoHoraFim] ) )
			RETURN
			SWITCH(
			    TRUE()
			-- Escala
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Escala" && _1_DaysEscala = 1,
			        IF.EAGER(
			            ( CurrentMonth = _1_MonthsFromStartDate && CurrentDay = _1_DaysFromStartDate && CurrentHour >= _1_HoursFromStartDate && CurrentHour <= 23 ) ||
			            ( CurrentMonth = _1_MonthsFromEndDate && CurrentDay = _1_DaysFromEndDate && CurrentHour >= 0 && CurrentHour <= _1_HoursFromEndDate ) 
			            ,1
			            ,BLANK()
			        )
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Escala" && _1_DaysEscala = 0 && CurrentMonth = _1_MonthsFromStartDate,
			        IF.EAGER(
			            ( CurrentDay >= _1_DaysFromStartDate && CurrentDay <= _1_DaysFromEndDate )
			            && ( CurrentHour >= _1_HoursFromStartDate && CurrentHour <= _1_HoursFromEndDate )
			            ,1
			            ,BLANK()
			        )
			-- Atividade
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Atividade" && _2_DaysAtividade = 1,
			        IF.EAGER(
			            ( CurrentMonth = _2_MonthsFromStartDate && CurrentDay = _2_DaysFromStartDate && CurrentHour >= _2_HoursFromStartDate && CurrentHour <= 23 ) ||
			            ( CurrentMonth = _2_MonthsFromEndDate && CurrentDay = _2_DaysFromEndDate && CurrentHour >= 0 && CurrentHour <= _2_HoursFromEndDate ) 
			            ,2
			            ,BLANK()
			        )
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Atividade" && _2_DaysAtividade = 0 && CurrentMonth = _2_MonthsFromStartDate,
			        IF.EAGER(
			            ( CurrentDay >= _2_DaysFromStartDate && CurrentDay <= _2_DaysFromEndDate )
			            && ( CurrentHour >= _2_HoursFromStartDate && CurrentHour <= _2_HoursFromEndDate ) 
			            ,2
			            ,BLANK()
			        )
			-- Ponto
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Ponto" && _3_DaysPonto = 1,
			        IF.EAGER(
			            ( CurrentMonth = _3_MonthsFromStartDate && CurrentDay = _3_DaysFromStartDate && CurrentHour >= _3_HoursFromStartDate && CurrentHour <= 23) ||
			            ( CurrentMonth = _3_MonthsFromEndDate && CurrentDay = _3_DaysFromEndDate && CurrentHour >= 0 && CurrentHour <= _3_HoursFromEndDate ) 
			            ,3
			            ,BLANK()
			        )
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Ponto" && _3_DaysPonto = 0 && CurrentMonth = _3_MonthsFromStartDate,
			        IF.EAGER(
			            ( CurrentDay >= _3_DaysFromStartDate && CurrentDay <= _3_DaysFromEndDate )
			            && ( CurrentHour >= _3_HoursFromStartDate && CurrentHour <= _3_HoursFromEndDate )
			            ,3
			            ,BLANK()
			        )
			-- Execução
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Execução" && _4_DaysExecucao = 1,
			        IF.EAGER(
			            ( CurrentMonth = _4_MonthsFromStartDate && CurrentDay = _4_DaysFromStartDate && CurrentHour >= _4_HoursFromStartDate && CurrentHour <= 23 ) ||
			            ( CurrentMonth = _4_MonthsFromEndDate && CurrentDay = _4_DaysFromEndDate && CurrentHour >= 0 && CurrentHour <= _4_HoursFromEndDate ) 
			            ,4
			            ,BLANK()
			        )
			    ,SELECTEDVALUE( TiposHorario[Tipo] ) = "Execução" && _4_DaysExecucao = 0 && CurrentMonth = _4_MonthsFromStartDate,
			        IF.EAGER(
			            ( CurrentDay >= _4_DaysFromStartDate && CurrentDay <= _4_DaysFromEndDate )
			            && ( CurrentHour >= _4_HoursFromStartDate && CurrentHour <= _4_HoursFromEndDate )
			            ,4
			            ,BLANK()
			        )
			    ,BLANK()
			)
			```
		formatString: 0
		displayFolder: Controlo de Horas
		lineageTag: 2116d545-f1ac-479c-b24a-60d2b5cf9306

