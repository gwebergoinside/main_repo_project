	measure 'Capacidade - Ferias e Aus' = ```
			
			-- subtrai as férias e ausencias e adiciona as Horas Extras
			var __ferias = CALCULATE( [HorasDias] , FILTER(Horarios, Horarios[Descricao] = "Férias" ) )
			RETURN
			-- SUM(Horarios[Capacidade]) - __ferias - SUM(Horarios[Ausencia]) 
			[Capacidade Planeada (h)] + SUM(Horarios[quantidade]) - SUM(Horarios[Ausencia])
			```
