	measure 'Diff_Plan vs Ativ - Inicio(M)' = ```
			
			SUMX(
			    SUMMARIZE(
			        Apontamentos,
			        Apontamentos[Date]
			        ,"soma"
			        ,CALCULATE(
			            IF.EAGER(
			            MIN( Apontamentos[Planeado | Hora Inicio])  = BLANK()
			                ,ABS( 
			                    DATEDIFF( 
			                        MAX(Apontamentos[HoraFim])
			                        ,MIN( Apontamentos[HoraIni])
			                    , MINUTE
			                    )
			                )
			                ,IF.EAGER( MIN(Apontamentos[HoraIni]) = BLANK()
			                    ,ABS( 
			                        DATEDIFF( 
			                            MAX( Apontamentos[Planeado | Hora Fim]) 
			                            ,MIN( Apontamentos[Planeado | Hora Inicio])
			                        , MINUTE
			                        )
			                    )
			                    ,ABS(
			                        DATEDIFF( 
			                            MIN( Apontamentos[Planeado | Hora Inicio]) 
			                            ,MIN(Apontamentos[HoraIni]) 
			                        ,MINUTE 
			                        )
			                    )
			                )
			            )
			        )
			    )
			    ,[soma] 
			) / DISTINCTCOUNT( Apontamentos[Date] )
			```
		displayFolder: Controlo de Horas
		lineageTag: bd826c1e-3af5-4b2f-bb90-3aeb2d2b92f9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

