	partition CanaisTitulos-c51df2c0-e93e-49eb-b6c3-1b9b8285f092 = m
		mode: import
		source =
				let
				    Origem = Sql.Database(Org, BD, [Query="Select#(lf)    trc.codCanal,#(lf)    trc.runsConsumidos,#(lf)    trc.runsPlaneados As runsPlaneados1,#(lf)    tr.codtitulo,#(lf)    c.nome#(lf)From#(lf)    Titulos_Runs tr Inner Join#(lf)    Titulos_RunsCanais trc On trc.codigoRun = tr.codRun Inner Join#(lf)    T_Canais c On trc.codCanal = c.codigo"])
				in
				    Origem

