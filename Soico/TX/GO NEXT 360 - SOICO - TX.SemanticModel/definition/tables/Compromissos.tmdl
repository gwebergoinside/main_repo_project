	partition Compromissos-2f93b593-ce80-480a-8660-e956daaf8a8a = m
		mode: import
		source =
				let
				    Origem = Sql.Database(Org, BD, [Query="SELECT #(lf)#(tab)isnull([Compromissos].[id_comp],0) AS COD_COMPROMISSO,#(lf)#(tab)isnull(Compromissos_Execucao.id,0) AS COD_COMPROMISSO_EXECUCAO,#(lf)#(tab)[Compromissos].codExterno AS NUMERO_PEDIDO_COMPRA,#(lf)#(tab)RIGHT('00000000' + CAST([processo] AS VARCHAR),8) AS NUMERO_PROCESSO,#(lf)#(tab)[Compromissos_linha].[episodio] AS NUMERO_EPISODIO,#(lf)#(tab)RIGHT('00000000' + CAST([processo] AS VARCHAR),8) + RIGHT('000' + CAST([Compromissos_linha].[episodio] AS VARCHAR),3) AS NUMERO_PROCESSO_EPISODIO,#(lf)#(tab)isnull(planocontrato.NumContrato,0) AS COD_CONTRATO,#(lf)#(tab)isnull(Contratos.Estado,0) AS COD_CONTRATO_ESTADO,#(lf)#(tab)isnull(Contratos.TipoContrato,0) AS COD_TIPO_CONTRATO, #(lf)#(tab)isnull(Programas.origem,'00') AS COD_ORIGEM,#(lf)#(tab)isnull(planocontrato.CodPlano,0) AS COD_CONTRATO_PLANO,#(lf)#(tab)RTRIM(isnull(fichas_videotape.codgenero,'00')) AS COD_GENERO,#(lf)#(tab)isnull(titulos.[codtitulo],0) AS Cod_Titulo,#(lf)#(tab)isnull(titulos.Estado,0) AS Cod_Titulo_Estado,#(lf)#(tab)(CASE WHEN PlanoContrato.Departamento='' THEN 'N' ELSE isnull(PlanoContrato.Departamento, 'N') END) AS COD_DEPARTAMENTO,#(lf)#(tab)T_Departamentos.Codigo AS Cod_DEP_Departamento,#(lf)#(tab)T_Departamentos.Nome AS Desc_Departamento,#(lf)#(tab)isnull([Compromissos].[conta_poc],0) AS COD_CONTAS_POC,#(lf)#(tab)Contas_POC.Descricao As Desc_Conta_POC,#(lf)#(tab)isnull([Compromissos].[id_terceiro],0) AS COD_COMPROMISSO_TERCEIROS,#(lf)#(tab)T_Terceiros.nome AS DESC__COMPROMISSO_TERCEIROS,#(lf)#(tab)[Compromissos].descricao AS Descricao,#(lf)#(tab)isnull([Compromissos].[cod_moeda],0) AS COD_MOEDA,#(lf)#(tab)[Compromissos].[Cambio] AS CAMBIO,#(lf)#(tab)Compromissos.[estado] as COD_COMPROMISSO_ESTADO,#(lf)#(tab)Compromissos_Estados.descricao_estado_compromisso AS DESC_COMPROMISSO_ESTADO,#(lf)#(tab)isnull(programas.[area],0) AS COD_AREA,#(tab)#(lf)#(tab)upper(case when tp3.cod2='' or tp3.cod2 is null then '0' else tp3.cod2 end) AS cod_pais_facturacao_contrato,#(lf)#(tab)upper(case when tp2.cod2='' or tp2.cod2 is null then '0' else tp2.cod2 end) AS COD_PAIS_FORMATO,#(lf)#(tab)upper(case when tp.cod2='' or tp.cod2 is null then '0' else tp.cod2 end) AS cod_pais_producao_episodio,#(tab)#(lf)#(tab)RTRIM(compromissos.[cod_canal]) AS COD_CANAL,#(lf)#(tab)[aprovEstado] AS COD_ESTADO_APROVACAO,#(lf)#(tab)[aprovPor] AS UTILIZADOR_APROVACAO,#(lf)#(tab)[data] AS DATA_REGISTO,#(lf)#(tab)[data_compromisso] AS DATA_COMPROMISSO,#(lf)#(tab)[aprovData] AS DATA_APROVACAO,#(lf)#(tab)[dataConclusao] AS DATA_CONCLUSAO,#(lf)#(tab)dataExecucao AS DATA_EXECUCAO,#(lf)#(tab)--(CASE WHEN [data] IS NULL THEN CAST('1-1-1990' AS DATETIME) ELSE [data] END) AS DATA_REGISTO,#(lf)#(tab)--(CASE WHEN [data_compromisso] IS NULL THEN CAST('1-1-1990' AS DATETIME) ELSE [data_compromisso] END) AS DATA_COMPROMISSO,#(lf)#(tab)--(CASE WHEN [aprovData] IS NULL THEN CAST('1-1-1990' AS DATETIME) ELSE [aprovData] END) AS DATA_APROVACAO,#(lf)#(tab)--(CASE WHEN [dataConclusao] IS NULL THEN CAST('1-1-1990' AS DATETIME) ELSE [dataConclusao] END) AS DATA_CONCLUSAO,#(lf)#(tab)--(CASE WHEN dataExecucao IS NULL THEN CAST('1-1-1990' AS DATETIME) ELSE dataExecucao END) AS DATA_EXECUCAO,#(lf)#(tab)[Compromissos_linha].[valor] AS VAL_COMPROMISSO,#(lf)#(tab)--cast([Compromissos_linha].[valor]/[Compromissos].[Cambio] as decimal(18,2)) AS VAL_COMPROMISSO_MOEDALOCAL, --calcular #(lf)#(tab)isnull([Compromissos_Execucao_linha].valorexecutado,0) AS VAL_COMPROMISSO_EXECUCAO,#(lf)#(tab)--isnull(cast([Compromissos_Execucao_linha].valorexecutado/[Compromissos].[Cambio] as decimal(18,2)),0) AS VAL_COMPROMISSO_EXECUCAO_MOEDALOCAL, -- calcular#(lf)#(tab)OT.Valor as VAL_ORCAMENTO,#(lf)#(tab)OT.Cambio as Cambio_Orcamento#(lf)--#(tab)isnull(cast(OT.Valor/OT.Cambio as decimal(18,2)),0) as VAL_ORCAMENTO_MOEDALOCAL, --calcular #(lf)--#(tab)isnull(cast([Compromissos_linha].[valor]/[Compromissos].[Cambio] as decimal(18,2))-cast(OT.Valor/OT.Cambio as decimal(18,2)),0) AS VAL_DIFERENCA_CAMBIAL --calcular#(lf)FROM #(lf)Compromissos #(lf)#(tab)INNER JOIN Compromissos_linha ON [Compromissos].[id_comp]=[Compromissos_linha].[id_comp] #(lf)#(tab)INNER JOIN Compromissos_Estados On Compromissos.estado = Compromissos_Estados.estado_compromisso#(lf)#(tab)Inner Join T_Departamentos On Compromissos.departamento = T_Departamentos.Codigo#(lf)#(tab)Inner Join Contas_POC On Compromissos.conta_poc = Contas_POC.Conta_POC#(lf)#(tab)Inner Join T_Terceiros On Compromissos.id_terceiro = T_Terceiros.id_terceiro#(lf)#(tab)LEFT OUTER JOIN Compromissos_Execucao ON [Compromissos].[id_comp]=[Compromissos_Execucao].id_compromisso #(lf)#(tab)LEFT OUTER JOIN Compromissos_Execucao_Linha ON [Compromissos_Execucao].id=[Compromissos_Execucao_Linha].id_Execucao and [Compromissos_Execucao_Linha].episodio=[Compromissos_linha].episodio#(lf)#(tab)inner join titulos ON titulos.numero_processo=processo and titulos.numepisodio=Compromissos_linha.episodio#(lf)#(tab)inner join planocontrato on planocontrato.codplano=titulos.codplano#(lf)#(tab)inner join contratos on contratos.numcontrato=PlanoContrato.numcontrato#(lf)#(tab)inner join fichas_videotape on fichas_videotape.numero_processo=titulos.numero_processo and fichas_videotape.episodio=titulos.numepisodio#(lf)#(tab)inner join programas on programas.numero_processo = fichas_videotape.numero_processo#(lf)#(tab)LEFT OUTER JOIN T_PAISES TP ON  TP.Codigo_pais=Fichas_Videotape.Pais#(lf)#(tab)LEFT OUTER JOIN T_PAISES TP2 ON TP2.Codigo_pais=Programas.cod_pais_formato#(lf)#(tab)LEFT OUTER JOIN T_PAISES TP3 ON TP3.Codigo_pais=contratos.cod_pais_facturacao #(lf)#(tab)LEFT OUTER JOIN#(lf)#(tab)(select CodTitulo,Max(Cambio) as Cambio,SUM(Valor) AS Valor#(lf)#(tab)from titulosOrcamento,Custos_Rubricas#(lf)#(tab)where conta_Poc=codigo AND FlagConsumo=1#(lf)#(tab)group by CodTitulo) AS OT on OT.CodTitulo=titulos.codtitulo --and OT.conta_Poc=Compromissos.conta_Poc#(lf)#(tab)--#(tab)#(tab)INNER JOIN Custos_Rubricas CR ON OT.conta_Poc=CR.codigo AND CR.FlagConsumo=1#(lf)WHERE (YEAR(DATA_COMPROMISSO)>= year(getdate())-4 AND (YEAR(DATA_COMPROMISSO)<=YEAR(GETDATE()))) AND #(lf)#(tab)upper(isnull(RIGHT(contratos.cod_pais_facturacao,2),0))<>'1'#(lf)#(lf)--#(tab)and Compromissos.COD_MOEDA <> 'EUR'#(lf)--and [Compromissos_linha].numero_processo_episodio = 17715013002#(lf)#(lf)#(tab)--and [Compromissos].[id_comp]= 117761"])
				in
				    Origem

	annotation PBI_ResultType = Table

