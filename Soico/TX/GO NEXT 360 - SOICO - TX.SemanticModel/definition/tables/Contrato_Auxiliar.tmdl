	partition Contrato_Auxiliar-344e68a7-ebcf-4f56-b003-7c6375e8acc1 = calculated
		mode: import
		source = ```
				
				VAR _1 =
				    SELECTCOLUMNS(
				        Contratos
				        ,"CodContrato",Contratos[CodContrato]
				        ,"COD_CONTRATO",Contratos[COD_CONTRATO]
				    )
				VAR _2 =
				    SELECTCOLUMNS(
				        Consumos
				        ,"CodContrato", Consumos[CodContrato]
				        ,"COD_CONTRATO", Consumos[COD_CONTRATO]
				    )
				VAR RESULT = UNION( _1,FILTER( _2, [CodContrato] <> BLANK() ) )
				RETURN
				SUMMARIZE( 
				    RESULT
				    ,[CodContrato]
				    ,[COD_CONTRATO]
				)
				```

