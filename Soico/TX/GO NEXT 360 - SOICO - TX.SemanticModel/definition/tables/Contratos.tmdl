	column RunsExisIlim =
			
			IF.EAGER(
			    Contratos[RunIlim] = TRUE() || Contratos[NUMERO_DE_RUNS] = 900 , 0,
			    [# Runs]-[# Runs Consumed]
			)
		formatString: 0
		lineageTag: 38a57148-0c85-4b11-a9d9-571a0eede668
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Ano de Expiração' = IF.EAGER( Contratos[DATA_FIM_TITULO] = BLANK(), "Ilimitado", FORMAT( Contratos[DATA_FIM_TITULO], "YYYY" ) )
		dataType: string
		lineageTag: 2bfb109e-d4ea-471b-a95b-36047e208a75
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column Flag_Perdadireitos = ```
			
			Var _1 = Contratos[NUMERO_DE_RUNS] - Contratos[NUMERO_DE_RUNS_CONSUMIDOS]
			Var _2 = Contratos[NUMERO_DE_RUNS_CONSUMIDOS]
			
			Return 
			
			IF.EAGER( ( (_1 > 0|| _2 = 0) && (Contratos[DATA_FIM_TITULO] < NOW() && NOT ISBLANK(Contratos[Data_fim_titulo]))) || Contratos[Descricao_Estado] = "Perda de Direitos", 1,0 )
			
			```
		formatString: 0
		lineageTag: f6dac1aa-2053-41c8-965b-0fa1068fc759
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag Stock' = IF.EAGER( Contratos[DATA_FIM_TITULO] > now() -1 || Contratos[DATA_FIM_TITULO] = BLANK(), 1,0 )
		formatString: 0
		lineageTag: b952d52c-4f2e-4049-92bc-201734edba03
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DataPlaneamento = ```
			
			 var _1 =LOOKUPVALUE(PlanFormatos[Data], PlanFormatos[NUMERO_PROCESSO], Contratos[NUMERO_PROCESSO])
			 Return 
			 IF.EAGER(_1 <> BLANK(), "Sim","Não")
			```
		lineageTag: 01567e03-ba87-4032-baca-5d3d26cdec6a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Flag Existencias' = IF.EAGER( Contratos[DATA_FIM_TITULO] > STARTOFMONTH(Contratos[DATA_COMPRA]) -1 || Contratos[DATA_FIM_TITULO] = BLANK(), 1,0 )
		formatString: 0
		lineageTag: 935c7562-93bf-4da1-8903-96a81b863e31
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Ultima Exibicao' = ```
			
			    CALCULATE (
			        MAX ( Consumos[DATA_CONSUMO] ),
			        FILTER ( Consumos, Consumos[COD_TITULO] = Contratos[COD_TITULO] )
			    )
			```
