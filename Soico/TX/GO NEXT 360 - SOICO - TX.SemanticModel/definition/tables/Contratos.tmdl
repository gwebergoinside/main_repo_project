	partition Contratos-3a51833b-5438-409d-bd95-5419bf408420 = m
		mode: import
		source =
				let
				    SQL = "Select
				    PlanoContrato.cod_canal As COD_CANAL,
				    Contratos.CodProposta,
				    Contratos.NumContrato As COD_CONTRATO,
				    Right('00000000' + Cast(Programas.numero_processo As VARCHAR), 8) As NUMERO_PROCESSO,
				    Right('00000000' + Cast(Programas.numero_processo As VARCHAR), 8) + Right('000' + Cast(Fichas_Videotape.episodio As
				    VARCHAR), 3) As NUMERO_PROCESSO_EPISODIO,
				    Right('000' + Cast(Fichas_Videotape.episodio As VARCHAR), 3) As EPISODIO,
				    Contratos.Estado As COD_CONTRATO_ESTADO,
				    Contratos.TipoContrato As COD_CONTRATO_TIPO,
				    Contratos.origem As COD_ORIGEM,
				    Contratos.CodDistribuidor As COD_DISTRIBUIDOR,
				    Contratos.coddistribuidor_facturacao As COD_ENTIDADE_FACTURACAO,
				    PlanoContrato.CodPlano As COD_CONTRATO_PLANO,
				    Programas.area As COD_AREA,
				    Fichas_Videotape.codgenero As COD_GENERO,
				    PlanoContrato.tipo_conteudo As COD_TIPO_CONTEUDO,
				    Titulos.CodTitulo As COD_TITULO,
				    Titulos.Estado As COD_TITULO_ESTADO,
				    Contratos.moeda As COD_MOEDA,
				    Upper(TP3.cod2) As COD_PAIS_FACTURACAO,
				    Upper(TP2.cod2) As COD_PAIS_FORMATO,
				    Upper(TP2.descricao_pais) As DESC_PAIS_FORMATO,
				    Upper(TP.cod2) As COD_PAIS_PRODUCAO,
				    PlanoContrato.departamento As COD_DEPARTAMENTO,
				    PlanoContrato.CCAnalitico COD_CC_ORCAMENTO,
				    Contratos.DataRegisto As DATA_REGISTO,
				    Contratos.DataContrato As DATA_CONTRATO,
				    Contratos.DataAprovacao As DATA_APROVACAO,
				    Contratos.ValorContrato,
				    Contratos.ValorOutros,
				    PlanoContrato.numero_de_episodios As Total_Episodios_Plano,
				    PlanoContrato.Data_inicio_acontecimento As DATA_INICIO_ACONTECIMENTO,
				    PlanoContrato.data_fim_acontecimento As DATA_FIM_ACONTECIMENTO,
				    PlanoContrato.data_compra DATA_COMPRA,
				    (Select
				         Min(Titulos.DataInicio) As Expr1
				     From
				         Titulos Inner Join
				         PlanoContrato As PC2 On PC2.CodPlano = Titulos.CodPlano
				     Where
				         PC2.NumContrato = PlanoContrato.NumContrato) As Data_Inicio_Contrato,
				    (Select
				         Max(Titulos_2.DataInicio) As Expr1
				     From
				         Titulos As Titulos_2 Inner Join
				         PlanoContrato As PC2 On PC2.CodPlano = Titulos_2.CodPlano
				     Where
				         PC2.NumContrato = PlanoContrato.NumContrato) As Data_Final_Contrato,
				    Titulos.DataInicio As DATA_INICIO_TITULO,
				    Titulos.DataFim As DATA_FIM_TITULO,
				    Titulos.flagDataIlimitada,
				    Titulos.NumRun NUMERO_DE_RUNS,
				    IsNull(Titulos.RunsConsumidos, 0) NUMERO_DE_RUNS_CONSUMIDOS,
				    Cast(((Titulos.DuracaoMinima + Titulos.DuracaoMaxima) / 2) As decimal(18,2)) / 60 DURACAO_MEDIA_TITULO_HORAS,
				    Cast((Titulos.DuracaoMinima + Titulos.DuracaoMaxima) / 2 As decimal(18,2)) DURACAO_MEDIA_TITULO_MINUTOS,
				    Consumos.amortizacao As PERCENTAGEM_AMORTIZADA,
				    EstadosTitulos.Situacao As SITUACAO_ESTADO_TITULO,
				    PlanoContrato.Cambio CAMBIO,
				    Cast(IsNull(Titulos.TotalCustos, 0) As DEcimal(18,2)) VALOR_DIREITOS,
				    Cast(IsNull(Titulos.TotalOutrosCustos, 0) As DEcimal(18,2)) VALOR_OUTROS_CUSTOS,
				    Cast(IsNull(Titulos.TotalCustos_moeda_original, 0) As DEcimal(18,2)) VALOR_DIREITOS_MOEDA_ORIGINAL,
				    Cast(IsNull(Titulos.CustosConsumidos, 0) As DEcimal(18,2)) VALOR_DIREITOS_CONSUMIDOS,
				    Cast(IsNull(Titulos.OutrosCustosConsumidos, 0) As DEcimal(18,2)) VALOR_OUTROS_CUSTOS_CONSUMIDOS,
				    Cast(IsNull(Cast(((IsNull(Titulos.CustosConsumidos, 0) * PlanoContrato.Cambio) * (Consumos.amortizacao /
				    100.00)) As decimal(18,2)), 0) As DEcimal(18,2)) VALOR_DIREITOS_CONSUMIDOS_MOEDA_ORIGINAL,
				    Cast(IsNull(Titulos.TotalCustos, 0) - IsNull(Titulos.CustosConsumidos, 0) As decimal(18,2))
				    VALOR_DIREITOS_EXISTENCIAS,
				    Cast(IsNull(Titulos.TotalOutrosCustos, 0) - IsNull(Titulos.OutrosCustosConsumidos, 0) As DEcimal(18,2))
				    VALOR_OUTROS_CUSTOS_EXISTENCIAS,
				    Cast(IsNull(Titulos.TotalCustos_moeda_original, 0) - IsNull(Cast(((IsNull(Titulos.CustosConsumidos, 0) *
				    PlanoContrato.Cambio) * (Consumos.amortizacao / 100.00)) As decimal(18,2)), 0) As DEcimal(18,2))
				    VALOR_DIREITOS_EXISTENCIAS_MOEDA_ORIGINAL,
				    (Case
				        When (Titulos.flagDataIlimitada = 1 Or
				            Titulos.DataFim > GetDate()) And Titulos.NumRun - Titulos.RunsConsumidos > 0 And EstadosTitulos.Situacao =
				            'C'
				        Then 1
				        Else 0
				    End) As IN_STOCK,
				    Contratos.CodContrato,
				    (Select
				         Min(Propostas_Detalhe.ID_Plano) Id_Plano
				     From
				         Propostas_Detalhe
				     Where
				         Propostas_Detalhe.CodPlano = PlanoContrato.CodPlano) IDPlano,
				    IsNull((Select
				         efv.TextValue
				     From
				         SOICO_SharedServices.dbo.ExtendedFieldValue efv
				     Where
				         efv.ExtendedFieldId = 39 And
				         efv.BusinessObject = PlanoContrato.CodPlano), 'DEFINIR'),
				    Contratos.Referencia,
				    Contratos.Direitos_cedidos,
				    Contratos.Outras_condicoes,
				    Contratos.n_proposta,
				    PlanoContrato.CodAlvo,
				    PlanoContrato.FaixaHoraria,
				    ContratosEstados.*,
				    Contratos.Descricao,
				    Distribuidores.Nome As Desc_Distribuidor,
				    T_Origens.descricao_origem As Desc_Origem,
				    TP2.descricao_pais,
				    EstadosTitulos.Descricao As Descricao_Estado
				From
				    Contratos Inner Join
				    PlanoContrato On Contratos.NumContrato = PlanoContrato.NumContrato Inner Join
				    Titulos As Titulos On PlanoContrato.CodPlano = Titulos.CodPlano Inner Join
				    EstadosTitulos On EstadosTitulos.CodEstado = Titulos.Estado Inner Join
				    Fichas_Videotape On Fichas_Videotape.numero_processo = Titulos.Numero_processo
				            And Fichas_Videotape.episodio = Titulos.NumEpisodio Inner Join
				    Programas On Programas.numero_processo = Fichas_Videotape.numero_processo Left Outer Join
				    t_Paises TP On TP.codigo_pais = Fichas_Videotape.Pais Left Outer Join
				    t_Paises TP2 On TP2.codigo_pais = Programas.Cod_Pais_Formato Left Outer Join
				    t_Paises TP3 On TP3.codigo_pais = Contratos.cod_pais_facturacao Left Outer Join
				    (Select
				         Consumos.id_titulo,
				         Sum(Consumos.amortizacao) amortizacao
				     From
				         Consumos
				     Group By
				         Consumos.id_titulo) As Consumos On Consumos.id_titulo = Titulos.CodTitulo Inner Join
				    ContratosEstados On Contratos.Estado = ContratosEstados.CodEstado Inner Join
				    Distribuidores On Contratos.CodDistribuidor = Distribuidores.CodDistribuidor Inner Join
				    T_Origens On Contratos.origem = T_Origens.codigo_origem",
				    Source = Sql.Database(Org, BD, [Query = SQL]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"", "Flag_TipoAmortizacao"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"DATA_COMPRA", type date}, {"DATA_APROVACAO", type date}, {"DATA_CONTRATO", type date}, {"DATA_REGISTO", type date}, {"DATA_INICIO_ACONTECIMENTO", type date}, {"DATA_FIM_ACONTECIMENTO", type date}, {"Data_Inicio_Contrato", type date}, {"Data_Final_Contrato", type date}, {"DATA_INICIO_TITULO", type date}}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Changed Type",{{"Descricao", "Desc_Estado"}}),
				    #"Filtered Rows" = Table.SelectRows(#"Renamed Columns1", each [Descricao_Estado] <> "Anulado")
				in
				    #"Filtered Rows"

