	column Status___ = ```
			
			IF.EAGER( [# Runs] * [# Titles - Contratos] = [# Runs Consumed], "Sem Runs disponíveis",
			    IF.EAGER( [# Runs Consumed] = 0,"Estreia",
			        IF.EAGER( [# Runs Consumed] = 1, "2ª Run", 
