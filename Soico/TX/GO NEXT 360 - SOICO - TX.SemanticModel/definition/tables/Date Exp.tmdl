	partition 'Date Exp-e4b9b5e7-f317-4412-8ffe-354938aaa325' = calculated
		mode: import
		source = ```
				var a =year(min(Contratos[DATA_INICIO_TITULO]))
				var b=YEAR(max(Contratos[DATA_FIM_TITULO]))
				var dates=filter(CALENDARAUTO(),
				year([Date])>=a && YEAR([Date])<=b)
				
				RETURN
				    ADDCOLUMNS(
				        Dates,
				        "Ano", YEAR ( [Date] ),
				        "Mês", SWITCH(MONTH([Date]),1,"Jan",2,"Feb",3,"Mar",4,"Apr",5,"May",6,"Jun",7,"Jul",8,"Aug",9,"Sep",10,"Oct",11,"Nov",12,"Dec"),
				        "NºMês", MONTH ( [Date] ),
				        "Trimestre",  CONCATENATE("Trimestre ",ROUNDUP(MONTH([date])/3,0)),
						"Dia Semana" ,SWITCH(WEEKDAY([Date]),1,"Sunday",2,"Monday",3,"Tuesday",4,"Wednesday",5,"Thursday",6,"Friday",7,"Saturday"),
						"Nº dia Semana",  WEEKDAY([Date]),
						"Dia" , DAY([Date])		
				)
				```

