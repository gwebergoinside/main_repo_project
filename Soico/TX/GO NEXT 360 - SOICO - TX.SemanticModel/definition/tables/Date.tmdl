	partition Date-8d523701-f9c5-46e8-b726-2892a1387686 = calculated
		mode: import
		source = ```
				var a =year(min(Contratos[DATA_COMPRA]))
				var b=YEAR(max(Contratos[DATA_COMPRA]))
				var dates=filter(CALENDARAUTO(),
				year([Date])>=a && YEAR([Date])<=b)
				
				RETURN
				    ADDCOLUMNS(
				        Dates,
				        "Ano", YEAR ( [Date] ),
				        "Mês", SWITCH(MONTH([Date]),1,"Jan",2,"Fev",3,"Mar",4,"Abr",5,"Mai",6,"Jun",7,"Jul",8,"Ago",9,"Set",10,"Out",11,"Nov",12,"Dez"),
				        "NºMês", MONTH ( [Date] ),
				        "Trimestre",  CONCATENATE("Trimestre ",ROUNDUP(MONTH([date])/3,0)),
						"Dia Semana" ,SWITCH(WEEKDAY([Date]),1,"Sunday",2,"Monday",3,"Tuesday",4,"Wednesday",5,"Thursday",6,"Friday",7,"Saturday"),
						"Nº dia Semana",  WEEKDAY([Date]),
						"Dia" , DAY([Date])
						
				)
				
				```

