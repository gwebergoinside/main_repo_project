	measure Stock_Existencias_DataCompra =
			
			VAR _1 =calculate( DISTINCTCOUNT(Contratos[COD_TITULO]), Filter(all('Date_Existencias'), 'Date_Existencias'[Date] < DATE( SELECTEDVALUE( 'Date_Existencias'[Ano] ), SELECTEDVALUE( 'Date_Existencias'[Mes] )+1, 1 )  ), USERELATIONSHIP('Date'[Date], Date_Existencias[Date]) )
			RETURN
			IF.EAGER( _1 = 0, BLANK(),
			    IF.EAGER(SELECTEDVALUE('Date_Existencias'[Date])> DATE( YEAR(NOW()),MONTH(NOW())-1, 1),
			    BLANK()
			    , _1 )
			)
		formatString: 0
		displayFolder: Existências
		lineageTag: c98cd38b-f412-40bc-bdf5-d27d7331e2bd

	measure Stock_Existencias_Consumo = ```
			
			VAR _1 = 
			CALCULATE( SUM('Consumos'[Index])
			    ,USERELATIONSHIP( 'Canais Existencias'[codigo] , Consumos[COD_CANAL] )
			    ,REMOVEFILTERS( Contratos[Descricao_Estado] )
			    ,REMOVEFILTERS( Contratos[DataPlaneamento] ) 
			    ,Consumos[Data fim_titulo] > SELECTEDVALUE('Date_Existencias'[Date]) || Consumos[Data fim_titulo] = BLANK()
			    ,REMOVEFILTERS(Contratos[Flag Stock])
			    ,USERELATIONSHIP( Date_Existencias[Date], 'Date Cons'[Date])
			 )
			RETURN
			IF.EAGER( _1 = 0, BLANK(), _1 )
			```
		formatString: 0
