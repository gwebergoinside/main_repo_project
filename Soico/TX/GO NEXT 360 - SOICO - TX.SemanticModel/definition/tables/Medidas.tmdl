	measure Existencias_DataCompra =
			
			VAR _1 =calculate( SUM(contratos[VALOR_DIREITOS_EXISTENCIAS]), Filter(all('Date_Existencias'), 'Date_Existencias'[Date] < DATE( SELECTEDVALUE( 'Date_Existencias'[Ano] ), SELECTEDVALUE( 'Date_Existencias'[Mes] )+1, 1 )  ), USERELATIONSHIP('Date'[Date], Date_Existencias[Date]) ) --YEAR( Contratos[DATA_FIM_TITULO])  = SELECTEDVALUE('Date'[Ano]) && MONTH(Contratos[DATA_FIM_TITULO]) > 6 --MONTH(SELECTEDVALUE('Date'[Date])
			--)  ||  Contratos[DATA_FIM_TITULO] =BLANK() ))))
			RETURN
			IF.EAGER( _1 = 0, BLANK(),
			    IF.EAGER(SELECTEDVALUE('Date_Existencias'[Date])> DATE( YEAR(NOW()),MONTH(NOW())-1, 1),
			    BLANK()
			    , _1 )
			)
