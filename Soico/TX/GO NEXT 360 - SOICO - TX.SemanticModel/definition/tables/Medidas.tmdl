	measure 'Duração Média Episódio (h)' =
			
			Var __seg = AVERAGE(Contratos[DURACAO_MEDIA_TITULO_MINUTOS])
			RETURN
			IF.EAGER( ISBLANK(__seg) , BLANK() ,
			RIGHT ( "0" & INT ( __seg / 60 ), 2 )
			    & ":"
			    & RIGHT (
			        "0"
			            & INT ( ( __seg - INT (__seg / 60 ) * 60 ) ),
			        2
			    ))
