			VAR _FVOC= CALCULATE( DISTINCTCOUNT(Custos[Episodio]), USERELATIONSHIP( Calendario[Date], Custos[Data] ), USERELATIONSHIP( Canais[codigo], Custos[CodCanal] ) )
			RETURN
			IF( _FVD = 0, BLANK(), _FVD)
