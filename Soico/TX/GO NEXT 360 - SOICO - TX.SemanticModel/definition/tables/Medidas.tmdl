	measure '2Run Apoio' = ```
			
			VAR _1 = [# EpisodiosStockExistencias]
			VAR _2 = [# Runs_Stock Existencia Final]
			VAR _3 = [# Qtd Runs_Existencias]
			VAR _4 = SELECTEDVALUE(Titulos[RunIlimitado])
			VAR _5 = [1Run] 
			VAR _6 = [Runs_Exist_consumidas]
			RETURN
			SWITCH(
			    TRUE()
			    ,_4 = TRUE(), BLANK()
			    ,_2 < 1, BLANK()
			    ,ISBLANK( _5 ), _2
			    ,_1 = 1 && _2 > 0 && ISBLANK(_6), _3 - _5
			    ,_2 = 1  && ISBLANK(_6), 0
			    ,ISBLANK( _6 ), _2
			    , ( ( NOT isblank( _1 ) || _1 <> 0 ) && ( NOT ISBLANK( _2 ) || _2 <> 0 ) ) && (_1-_2 = 0 || _1-_2 = 1 ) , 1
			    , BLANK() 
