			// IF.EAGER( [# EpisodiosStockExistencias] = 1 && [# Runs_Stock Existencia Final] > 0 && ISBLANK([Runs_Exist_consumidas]),  _3 - _5,
			// IF.EAGER( [# Runs_Stock Existencia Final] = 1  && ISBLANK([Runs_Exist_consumidas]), 0, 
			// --IF.EAGER( ISBLANK( [Runs_Exist_consumidas] ), _3 - _5,
