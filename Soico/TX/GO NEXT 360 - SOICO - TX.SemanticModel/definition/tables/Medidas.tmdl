	measure 'VALOR_MED_EPI - Contratos' = ```
			
			VAR _1 = CALCULATE( SUM( Consumos[VALOR_DIREITOS_CONSUMO]), TREATAS( VALUES( Contratos[COD_TITULO] ), Consumos[COD_TITULO] ) )
			VAR _2 = CALCULATE( SUM( Consumos[VALOR_OUTROS_CUSTOS_CONSUMO]), TREATAS( VALUES( Contratos[COD_TITULO] ), Consumos[COD_TITULO] ) )
			VAR CUSTO_TOTAL = _1 + _2
			VAR Num_Ep = CALCULATE( SUM( Consumos[Index]), TREATAS( VALUES( Contratos[COD_TITULO] ), Consumos[COD_TITULO] ) )
			RETURN 
			Divide(CUSTO_TOTAL,Num_Ep)
