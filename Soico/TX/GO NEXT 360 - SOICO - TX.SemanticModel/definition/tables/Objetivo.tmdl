	partition Objetivo-b9dcde8a-d9d9-409d-9cfe-1030b579d662 = m
		mode: import
		source =
				let
				    Origem = Sql.Database(Org, BD_Budget, [Query="Select#(lf)    negociacaoObjectivos.utiId,#(lf)    negociacaoObjectivos.tipPubId,#(lf)    negociacaoObjectivos.canCodigo,#(lf)    negociacaoObjectivos.negObjTipo,#(lf)    negociacaoObjectivos.negObjValor,#(lf)    negociacaoObjectivos.negObjValorBruto,#(lf)    negociacaoObjectivos.negObjMes,#(lf)    negociacaoObjectivos.negObjAno,#(lf)    negociacaoObjectivos.perId,#(lf)    negociacaoObjectivos.negObjId#(lf)From#(lf)    negociacaoObjectivos#(lf)Where#(lf)    negociacaoObjectivos.negObjAno >= Year(GetDate()) - 3"])
				in
				    Origem

