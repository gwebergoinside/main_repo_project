		source =
				let
				    Source = Sql.Database(Org, BD, [Query="Select P.Numero_Processo,#(lf)#(tab)Replace(ISNULL((Select ISNULL(CE.description,'') +  'BRKLINE'  #(lf)#(tab)#(tab)from [Cast] C #(lf)#(tab)#(tab)Left join CastEntityTypes CET on CET.ID = c.CastEntityTypeId#(lf)#(tab)#(tab)LEFT JOIN CastType CT on CT.Id = CET.CastTypeID#(lf)#(tab)#(tab)LEFT JOIN CastEntity CE on CE.ID = CET.CastEntityID#(lf)#(tab)#(tab)Where C.Contextid = P.numero_Processo#(lf)#(tab)#(tab)AND ISNULL(CE.description,'') <>''#(lf)#(tab)#(tab)AND CT.Description = 'Intérpretes'#(lf)#(tab)#(tab)ORDER BY CT.Description, CE.Description#(lf)#(tab)#(tab)FOR XML PATH ('')),''), 'BRKLINE', CHAR(13)  ) Atores,#(lf)#(tab)Replace(ISNULL((Select ISNULL(CT.description,'') + ' ' + ISNULL(CE.description,'') +  'BRKLINE'  #(lf)#(tab)#(tab)from [Cast] C #(lf)#(tab)#(tab)Left join CastEntityTypes CET on CET.ID = c.CastEntityTypeId#(lf)#(tab)#(tab)LEFT JOIN CastType CT on CT.Id = CET.CastTypeID#(lf)#(tab)#(tab)LEFT JOIN CastEntity CE on CE.ID = CET.CastEntityID#(lf)#(tab)#(tab)Where C.Contextid = P.numero_Processo#(lf)#(tab)#(tab)AND ISNULL(CE.description,'') <>''#(lf)#(tab)#(tab)AND CT.Description != 'Intérpretes'#(lf)#(tab)#(tab)ORDER BY CT.Description, CE.Description#(lf)#(tab)#(tab)FOR XML PATH ('') ),''), 'BRKLINE', CHAR(13)  ) Casts,#(lf)#(tab)Replace(ISNULL((Select Convert(varchar, pfd.data, 105) + ' ' + Left(dbo.csegundoshoras(hora),5) + ' ' + Right('000' + cast(pfd.Episodio as varchar),3) + ' ' + t.nome +  'BRKLINE' #(lf)#(tab)#(tab)#(tab)From Plan_Formatos_detalhe pfd #(lf)#(tab)#(tab)#(tab)Inner join t_canais T on T.codigo = pfd.cod_canal#(lf)#(tab)#(tab)#(tab)Where pfd.numero_Processo = P.numero_Processo #(lf)#(tab)#(tab)#(tab)And pfd.data < Cast(GetDate() as date)#(lf)#(tab)#(tab)#(tab)order by data desc FOR XML PATH ('')),''), 'BRKLINE', CHAR(13)  )  'ExibicaoPassada',#(lf)#(tab)Replace(ISNULL((Select Convert(varchar, pfd.data, 105) + ' ' + Left(dbo.csegundoshoras(hora),5) + ' ' +  Right('000' + cast(pfd.Episodio as varchar),3) + ' ' + t.nome + 'BRKLINE' #(lf)#(tab)#(tab)#(tab)From Plan_Formatos_detalhe pfd #(lf)#(tab)#(tab)#(tab)Inner join t_canais T on T.codigo = pfd.cod_canal#(lf)#(tab)#(tab)#(tab)Where pfd.numero_Processo = P.numero_Processo #(lf)#(tab)#(tab)#(tab)And pfd.data >= Cast(GetDate() as date)#(lf)#(tab)#(tab)#(tab)order by data FOR XML PATH ('')),''), 'BRKLINE',  CHAR(13) ) 'ExibicaoFutura'#(lf)#(tab)#(tab)#(tab)--ISNULL((Select Top 1 fullpath from GODASHBOARD_PROGRAMAS_POSTER GP Where p.numero_processo = GP.numero_processo),'') PosterDefault#(lf)from Programas P"])
				in
