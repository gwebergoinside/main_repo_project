	partition Titulos-e01cf929-de3c-420b-83a0-4ca9ae2b24f7 = m
		mode: import
		source =
				let
				    Origem = Sql.Database(Org, BD, [Query="Select#(lf)    Titulos.CodTitulo,#(lf)    Titulos.NumEpisodio,#(lf)    Titulos.Estado,#(lf)    Titulos.DataFim,#(lf)    Titulos.Titulo As Nome_Episodio,#(lf)    Programas.ano As [Year Production],#(lf)    Right('00000000' + Cast(Titulos.Numero_processo As VARCHAR), 8) As numero_processo,#(lf)    Programas.titulo,#(lf)    Programas.numero_de_episodios,#(lf)    Programas.ano,#(lf)    Programas.genero,#(lf)    Programas.origem,#(lf)    Programas.pais,#(lf)    Programas.distribuidor,#(lf)    Programas.produtor,#(lf)    Programas.data_inicio_acontecimento,#(lf)    Programas.data_fim_acontecimento,#(lf)    Programas.Cod_Pais_Formato,#(lf)    Programas.CodIntencaoConteudo,#(lf)    Programas.Sigla,#(lf)    Programas.flagTituloIncluiEpisodio,#(lf)    Programas.refExterna,#(lf)    Programas.data_cria,#(lf)    Programas.resumo_sintetico,#(lf)    Programas.pesquisa,#(lf)    Programas.temporada#(lf)From#(lf)    Titulos Inner Join#(lf)    Fichas_Videotape On Titulos.Numero_processo = Fichas_Videotape.numero_processo#(lf)            And Titulos.NumEpisodio = Fichas_Videotape.episodio Inner Join#(lf)    Programas On Fichas_Videotape.numero_processo = Programas.numero_processo"])
				in
				    Origem

	annotation PBI_QueryRelationships = {"columnCount":4,"keyColumnNames":[],"queryRelationships":[],"columnIdentities":["Section1/Titulos/Origem.{Numero_processo,0}","Section1/Titulos/Origem.{NumEpisodio,1}","Section1/Titulos/Origem.{CodTitulo,2}","Section1/Titulos/Origem.{Titulo,3}"],"ColumnCount":4,"KeyColumnNames":[],"ColumnIdentities":["Section1/Titulos/Origem.{Numero_processo,0}","Section1/Titulos/Origem.{NumEpisodio,1}","Section1/Titulos/Origem.{CodTitulo,2}","Section1/Titulos/Origem.{Titulo,3}"],"RelationshipInfo":[]}

	annotation PBI_ResultType = Table

